@page
@model TransactionReportModel

<div class="card shadow-lg mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
            <div class="d-flex align-items-center">
                <img src="~/images/lCC Logo.jpg" alt="LCC Logo" style="height: 60px; margin-right: 15px;" />
                <img src="~/images/ICT-Works Logo.jpg" alt="ICT Works Logo" style="height: 60px;" />
            </div>
            <h2 class="mb-0 fw-bold text-primary">Transaction Report</h2>
        </div>

        <!-- Filters -->
        <form method="get" class="row g-3 mb-3">
            <div class="col-md-2">
                <label class="form-label fw-semibold">Start Date</label>
                <input type="date" class="form-control" asp-for="StartDate" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">End Date</label>
                <input type="date" class="form-control" asp-for="EndDate" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Shift</label>
                <select class="form-control">
                    <option value="">All</option>
                    <option>Shift One</option>
                    <option>Shift Two</option>
                    <option>Shift Three</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Payment Method</label>
                <select class="form-control">
                    <option value="">All</option>
                    <option>Cash</option>
                    <option>Card</option>
                    <option>eTag</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100 shadow-sm">
                    <i class="bi bi-funnel"></i> Filter
                </button>
            </div>
        </form>

        <!-- Table -->
        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle text-center">
                <thead class="table-dark">
                    <tr>
                        <th><a asp-route-sortOrder="lane_Nr" class="text-white text-decoration-none">Lane Id</a></th>
                        <th><a asp-route-sortOrder="trx_Sequence_Nr" class="text-white text-decoration-none">Transaction #</a></th>
                        <th><a asp-route-sortOrder="TransactionDateTime" class="text-white text-decoration-none">Date</a></th>
                        <th><a asp-route-sortOrder="operational_Shift" class="text-white text-decoration-none">Shift</a></th>
                        <th><a asp-route-sortOrder="toll_Operator_ID" class="text-white text-decoration-none">Operator</a></th>
                        <th><a asp-route-sortOrder="lane_Name" class="text-white text-decoration-none">Lane</a></th>
                        <th><a asp-route-sortOrder="method_of_Payment" class="text-white text-decoration-none">Payment</a></th>
                        <th>Collector Class</th>
                        <th>AVC Class</th>
                        <th>Final Class</th>
                        <th><a asp-route-sortOrder="tariff" class="text-white text-decoration-none">Amount</a></th>
                        <th>Card Number</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Transactions.Any())
                    {
                        foreach (var t in Model.Transactions)
                        {
                            <tr>
                                <td>@t.lane_Nr</td>
                                <td>@t.trx_Sequence_Nr</td>
                                <td>@t.TransactionDateTime.ToString("dd/MM/yyyy")</td>
                                <td>@t.operational_Shift</td>
                                <td>@t.toll_Operator_ID</td>
                                <td>@t.lane_Name</td>
                                <td>@t.method_of_Payment</td>
                                <td>@t.toll_Collector_Class</td>
                                <td>@t.avC_Class</td>
                                <td>@t.final_Class</td>
                                <td class="fw-bold text-success">@t.tariff.ToString("C")</td>
                                <td>@t.tac_Card_Number</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="12" class="text-center text-muted">No transactions found</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
