@page
@model MIS.Web.Pages.Reports.TransactionReportModel
@{
    var reportGeneratedAt = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
    var currentUserId = User.Identity?.Name ?? "Unknown User";
    var reportVersion = "1.0.0";

    var serializerOptions = new System.Text.Json.JsonSerializerOptions
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
    };
    var transactionsJson = System.Text.Json.JsonSerializer.Serialize(Model.Transactions, serializerOptions);
}

<div class="card shadow-lg mb-4">
    <div class="card-body">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
            <div class="d-flex align-items-center">
                <img src="~/images/ICT-Works Logo.jpg" alt="ICT Works Logo" style="height: 120px; width 120px;" />
            </div>
            <h2 class="mb-0 fw-bold text-primary">Transaction Report</h2>
            <div></div>
        </div>

        <!-- Filters -->
        <form method="get" class="row g-3 mb-3">
            <div class="col-md-3">
                <label class="form-label fw-semibold">Start Date & Time</label>
                <input type="datetime-local" class="form-control" name="StartDate" value="@Model.StartDate.ToString("yyyy-MM-ddTHH:mm")" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">End Date & Time</label>
                <input type="datetime-local" class="form-control" name="EndDate" value="@Model.EndDate.ToString("yyyy-MM-ddTHH:mm")" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Lane</label>
                <input type="text" class="form-control" asp-for="lane_Nr" placeholder="Lane #" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Operator</label>
                <input type="text" class="form-control" asp-for="TollOperatorID" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Shift</label>
                <select class="form-control" asp-for="Shift">
                    <option value="">All</option>
                    <option>Shift One</option>
                    <option>Shift Two</option>
                    <option>Shift Three</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Payment Method</label>
                <select class="form-control" asp-for="PaymentMethod">
                    <option value="">All</option>
                    <option>Cash Transaction</option>
                    <option>Exempt Transaction</option>
                    <option>Violation</option>
                    <option>Prepaid Transaction - RFID Tag</option>
                    <option>Prepaid Transaction - Card</option>
                    <option>Bank Card (NFC - Post Paid)</option>
                    <option>QR Code / Barcode</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <a asp-page-handler="ExportExcel"
                asp-route-StartDate="@Model.StartDate.ToString("s")" 
                asp-route-EndDate="@Model.EndDate.ToString("s")" 
                asp-route-lane_Nr="@Model.lane_Nr" 
                asp-route-TollOperatorID="@Model.TollOperatorID"
                asp-route-Shift="@Model.Shift"
                asp-route-PaymentMethod="@Model.PaymentMethod" 
                class="btn btn-success w-100"> 
                <i class="bi bi-file-earmark-excel"></i> Export Excel </a> 
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="button" id="btnDownloadPdf" class="btn btn-danger w-100">
                    <i class="bi bi-file-earmark-pdf"></i> Export PDF
                </button>
            </div>
        </form>

        <!-- Table -->
        <div class="table-responsive">
            <table class="table table-bordered table-hover text-center align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Lane</th>
                        <th>Transaction #</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Shift</th>
                        <th>Operator</th>
                        <th>Lane Name</th>
                        <th>Payment</th>
                        <th>Collector Class</th>
                        <th>AVC Class</th>
                        <th>Final Class</th>
                        <th>Amount</th>
                        <th>Card #</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Transactions.Any())
                    {
                        foreach (var t in Model.Transactions)
                        {
                            <tr>
                                <td>@t.lane_Nr</td>
                                <td>@t.trx_Sequence_Nr</td>
                                <td>@t.TransactionDateTime.ToString("dd/MM/yyyy")</td>
                                <td>@t.TransactionDateTime.ToString("HH:mm:ss")</td>
                                <td>@t.operational_Shift</td>
                                <td>@t.toll_Operator_ID</td>
                                <td>@t.lane_Name</td>
                                <td>@t.method_of_Payment</td>
                                <td>@t.toll_Collector_Class</td>
                                <td>@t.avC_Class</td>
                                <td>@t.final_Class</td>
                                <td>@t.tariff</td>
                                <td>@t.tac_Card_Number</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="13" class="text-muted">No transactions found</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Summary -->
        <div class="alert alert-info mt-3">
            <strong>Summary:</strong>
            Filtered: @Model.FilteredRowCount rows | Sum: @Model.FilteredTariffSum <br />
            Total: @Model.TotalRowCount rows | Sum: @Model.TotalTariffSum
        </div>

        <!-- Footer -->
        <div class="mt-4 p-3 border-top bg-light">
            <div class="row">
                <div class="col-md-4">Report Name: Transaction Details Report<br />Date: @reportGeneratedAt</div>
                <div class="col-md-4">User ID: @currentUserId</div>
                <div class="col-md-4 text-end">Version: @reportVersion</div>
            </div>
        </div>
    </div>
</div>

<!-- Scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<script>
    const transactions = @Html.Raw(transactionsJson);

    document.getElementById("btnDownloadPdf").addEventListener("click", async function () {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "a4" });

        // === Load logos ===
        const [logo1, logo2] = await Promise.all([
            new Promise(resolve => { const img = new Image(); img.src = "/images/lCC Logo.jpg"; img.onload = () => resolve(img); }),
            new Promise(resolve => { const img = new Image(); img.src = "/images/ICT-Works Logo.jpg"; img.onload = () => resolve(img); })
        ]);

        // === Logos 
        doc.addImage(logo1, "JPEG", 40, 40, 100, 100);   
        doc.addImage(logo2, "JPEG", 700, 40, 100, 100);  

        // === Title (center, away from logos) ===
        doc.setFontSize(18);
        doc.setFont("helvetica", "bold");
        const pageWidth = doc.internal.pageSize.getWidth();
        const title = "LEKKI CONCESSION COMPANY LIMITED\nCONSERVATION TOLL PLAZA";
        const titleLines = doc.splitTextToSize(title, pageWidth - 200);
        let yPos = 80; // start above logos
        titleLines.forEach(line => {
            doc.text(line, pageWidth / 2, yPos, { align: "center" });
            yPos += 25;
        });

        // Optional: add a divider line under title
        // doc.setLineWidth(0.5);
        // doc.line(40, yPos, pageWidth - 40, yPos);
        // yPos += 20;

        // === Applied Filters (start after logos) ===
        yPos = 200; // leave space below stacked logos
        doc.setFontSize(10);
        const appliedFilters = {
            "Start Date": document.querySelector('input[name="StartDate"]').value || "All",
            "End Date": document.querySelector('input[name="EndDate"]').value || "All",
            "Lane": document.querySelector('input[name="lane_Nr"]').value || "All",
            "Operator": document.querySelector('input[name="TollOperatorID"]').value || "All",
            "Shift": document.querySelector('select[name="Shift"]').value || "All",
            "Payment Method": document.querySelector('select[name="PaymentMethod"]').value || "All"
        };
        for (const [k, v] of Object.entries(appliedFilters)) {
            doc.text(`${k}: ${v}`, 40, yPos);
            yPos += 12;
        }

        // === Table with ALL rows ===
        const headers = [[
            "Lane","Trx #","Date","Time","Shift","Operator","Lane Name",
            "Payment","Collector","AVC","Final","Amount","Card"
        ]];

        const rows = transactions.map(t => [
            t.lane_Nr ?? "",
            t.trx_Sequence_Nr ?? "",
            t.transactionDateTime ? new Date(t.transactionDateTime).toLocaleDateString() : "",
            t.transactionDateTime ? new Date(t.transactionDateTime).toLocaleTimeString() : "",
            t.operational_Shift ?? "",
            t.toll_Operator_ID ?? "",
            t.lane_Name ?? "",
            t.method_of_Payment ?? "",
            t.toll_Collector_Class ?? "",
            t.avC_Class ?? "",
            t.final_Class ?? "",
            t.tariff ?? "",
            t.tac_Card_Number ?? ""
        ]);

        doc.autoTable({
            head: headers,
            body: rows,
            startY: yPos + 20,
            theme: "grid",
            headStyles: { fillColor: [52, 152, 219] },
            styles: { fontSize: 8, cellPadding: 3, overflow: "linebreak" },
            margin: { top: 50, bottom: 30 },
            pageBreak: "auto",
            didDrawPage: function (data) {
                // Repeat title on each page (optional)
                doc.setFontSize(18);
                doc.text("TRANSACTION DETAILS REPORT", pageWidth / 2, 175, { align: "center" });
            }
        });

        // === Summary Section ===
        const finalY = doc.lastAutoTable.finalY + 20;
        doc.setFontSize(12);
        doc.setFont("helvetica", "bold");
        doc.text("Summary", 40, finalY);
        doc.setFont("helvetica", "normal");
        doc.text(`Filtered Count: @Model.FilteredRowCount | Filtered Sum: @Model.FilteredTariffSum`, 40, finalY + 15);
        doc.text(`Total Count: @Model.TotalRowCount | Total Sum: @Model.TotalTariffSum`, 40, finalY + 30);

        // === Footer Metadata ===
        const footerY = finalY + 60;
        doc.text(`Report Generated: @reportGeneratedAt`, 40, footerY);
        doc.text(`User ID: @currentUserId`, 300, footerY);
        doc.text(`Version: @reportVersion`, 550, footerY);

        // Save PDF
        doc.save("TransactionReport.pdf");
    });
</script>


