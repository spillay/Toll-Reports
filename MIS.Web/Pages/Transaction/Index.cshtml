@page
@model MIS.Web.Pages.Reports.TransactionReportModel
@{
    var reportGeneratedAt = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
    var currentUserId = User.Identity?.Name ?? "Unknown User";
    var reportVersion = "1.0.0";
}

<div class="card shadow-lg mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
            <h2 class="mb-0 fw-bold text-primary">Transaction Report</h2>
        </div>

        <!-- Filters -->
        <form method="get" class="row g-3 mb-3">
            <div class="col-md-3">
        <label class="form-label fw-semibold">Start Date & Time</label>
        <input type="datetime-local" class="form-control" id="startDate" name="StartDate" />
    </div>
    <div class="col-md-3">
        <label class="form-label fw-semibold">End Date & Time</label>
        <input type="datetime-local" class="form-control" id="endDate" name="EndDate" />
    </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Lane</label>
                <input type="text" class="form-control" asp-for="lane_Nr" placeholder="Lane #" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Toll Operator</label>
                <input type="text" class="form-control" asp-for="TollOperatorID" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Shift</label>
                <select class="form-control" asp-for="Shift">
                    <option value="">All</option>
                    <option>Shift One</option>
                    <option>Shift Two</option>
                    <option>Shift Three</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Payment Method</label>
                <select class="form-control" asp-for="PaymentMethod">
                    <option value="">All</option>
                    <option>Cash Transaction</option>
                    <option>Exempt Transaction</option>
                    <option>Violation</option>
                    <option>Prepaid Transaction - RFID Tag</option>
                    <option>Prepaid Transaction - Card</option>
                    <option>Bank Card (NFC - Post Paid)</option>
                    <option>QR Code / Barcode</option>
                </select>
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <a asp-page-handler="ExportExcel"
                   asp-route-StartDate="@Model.StartDate.ToString("yyyy-MM-ddTHH:mm")"
                   asp-route-EndDate="@Model.EndDate.ToString("yyyy-MM-ddTHH:mm")"
                   asp-route-lane_Nr="@Model.lane_Nr"
                   asp-route-TollOperatorID="@Model.TollOperatorID"
                   asp-route-Shift="@Model.Shift"
                   asp-route-PaymentMethod="@Model.PaymentMethod"
                   class="btn btn-success w-100">
                    <i class="bi bi-file-earmark-excel"></i> Export Excel
                </a>
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button type="button" id="btnDownloadPdf" class="btn btn-danger w-100">
                    <i class="bi bi-file-earmark-pdf"></i> Export PDF
                </button>
            </div>


        </form>

        <!-- Table -->
        <div class="table-responsive">
            <table class="table table-bordered table-hover text-center align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Lane</th>
                        <th>Transaction #</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Shift</th>
                        <th>Operator</th>
                        <th>Lane Name</th>
                        <th>Payment</th>
                        <th>Collector Class</th>
                        <th>AVC Class</th>
                        <th>Final Class</th>
                        <th>Amount</th>
                        <th>Card #</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Transactions?.Any() ?? false)
                    {
                        foreach (var t in Model.Transactions)
                        {
                            <tr>
                                <td>@t.lane_Nr</td>
                                <td>@t.trx_Sequence_Nr</td>
                                <td>@t.TransactionDateTime.ToString("dd/MM/yyyy")</td>
                                <td>@t.TransactionDateTime.ToString("HH:mm:ss")</td>
                                <td>@t.operational_Shift</td>
                                <td>@t.toll_Operator_ID</td>
                                <td>@t.lane_Name</td>
                                <td>@t.method_of_Payment</td>
                                <td>@t.toll_Collector_Class</td>
                                <td>@t.avC_Class</td>
                                <td>@t.final_Class</td>
                                <td>@t.tariff</td>
                                <td>@t.tac_Card_Number</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="13" class="text-muted">No transactions found</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="alert alert-info mt-3">
            <strong>Summary:</strong>
            Filtered: @Model.FilteredRowCount rows | Sum: @Model.FilteredTariffSum <br />
            Total: @Model.TotalRowCount rows | Sum: @Model.TotalTariffSum
        </div>

        <!-- Footer -->
        <div class="mt-4 p-3 border-top bg-light">
            <div class="row">
                <div class="col-md-4">Report Name: Transaction Details Report<br />Date: @reportGeneratedAt</div>
                <div class="col-md-4">User ID: @currentUserId</div>
                <div class="col-md-4 text-end">Version: @reportVersion</div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>

<script>
    // Make sure transactions are available in JS
    const transactions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Transactions));

    document.getElementById("btnDownloadPdf").addEventListener("click", function () {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "a4" });

        doc.setFontSize(16);
        doc.text("Transaction Report", 40, 40);

        const startDate = document.querySelector('input[name="StartDate"]').value;
        const endDate = document.querySelector('input[name="EndDate"]').value;
        const lane = document.querySelector('select[name="lane_Nr"]').value;
        const shift = document.querySelector('select[name="Shift"]').value;
        const paymentMethod = document.querySelector('select[name="PaymentMethod"]').value;

        const start = startDate ? new Date(startDate) : null;
        const end = endDate ? new Date(endDate) : null;

        const filtered = transactions.filter(t => {
            const trxDateTime = new Date(t.trx_Date + " " + t.trx_Time);

            const dateMatch = (!start || trxDateTime >= start) && (!end || trxDateTime <= end);
            const laneMatch = !lane || t.lane_Nr == lane;
            const shiftMatch = !shift || t.operational_Shift === shift;
            const paymentMatch = !paymentMethod || t.method_of_Payment === paymentMethod;

            return dateMatch && laneMatch && shiftMatch && paymentMatch;
        });

        const body = filtered.map(t => [
            t.lane_Nr, t.trx_Sequence_Nr, t.trx_Date, t.trx_Time,
            t.operational_Shift, t.toll_Operator_ID, t.lane_Name, t.method_of_Payment,
            t.toll_Collector_Class, t.avC_Class, t.final_Class, t.tariff, t.tac_Card_Number
        ]);

        doc.autoTable({
            head: [['Lane','Trx #','Date','Time','Shift','Operator','Lane Name','Payment','Collector','AVC','Final','Amount','Card']],
            body: body,
            startY: 60,
            theme: 'grid',
            headStyles: { fillColor: [52, 152, 219] },
            styles: { fontSize: 9, cellPadding: 4, overflow: 'linebreak' }
        });

        doc.save("TransactionReport.pdf");
    });
</script>

