@model MIS.Web.Models.VarientPerfomanceInputModel
@{
    
    var reportVersion = "1";
    string currentUserId = "Lucky";
    DateTime reportGeneratedAt = DateTime.Now;
}



<div class="card shadow-lg mb-4">
    <div class="card-body">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
            <div></div>
            <h2 class="mb-0 fw-bold text-primary">VarientPerfomances Report</h2>
            <div></div>
        </div>

        <!-- Filters -->
         @* @Html.Partial("_TransactionFilters", Model)  
      *@

        <!-- Table -->
        <div class="table-responsive">

            <table class="table table-bordered table-hover text-center align-middle">
                <thead class="table-dark">
                    <tr>
                       
                        <th>Shift Date</th>
                        <th>Shift Discreption</th>
                        <th>Operator</th>
                        <th>Cash Expected</th>
                        <th>Cash declared</th>
                        <th>Cash declared Difference</th>
                        
                    </tr>
                </thead>
                 <tbody>
                    @foreach (var c in Model.VarientPerfomances)
                    { <tr>
                       
                        <td>@c.shiftDate</td>
                        <td>@c.shiftDescription</td>
                        <td>@c.tollOperator</td>
                        <td>@c.NominalTariff</td>
                        <td>@c.NettAmount</td>
                         <td>@(c.NettAmount - c.NominalTariff)</td>
                        </tr>

                    }
                </tbody> 
            </table>
            <!-- Pagination Section -->
            <div class="mt-4 d-flex flex-column flex-md-row justify-content-between align-items-center border-top pt-3">
                <div class="text-muted mb-2 mb-md-0">
                    Showing page <strong>@Model.PageNumber</strong> of
                    <strong>@((int)Math.Ceiling((double)Model.TotalCount / Model.PageSize))</strong> —
                    Total records: <strong>@Model.TotalCount</strong>
                </div>

                <nav aria-label="VarientPerfomance pagination">
                    <ul class="pagination pagination-sm mb-0 flex-wrap justify-content-center">
                        @if (Model.PageNumber > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("VarientPerfomances", "VarientPerfomance", new { page = Model.PageNumber - 1, pageSize = Model.PageSize })">
                                    &laquo; Previous
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link">&laquo; Previous</span>
                            </li>
                        }

                        @{
                            int totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
                            int startPage = Math.Max(1, Model.PageNumber - 2);
                            int endPage = Math.Min(totalPages, Model.PageNumber + 2);

                            for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("VarientPerfomances", "VarientPerfomance", new { page = i, pageSize = Model.PageSize })">@i</a>
                                </li>
                            }
                        }

                        @if (Model.PageNumber < (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize))
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("VarientPerfomances", "VarientPerfomance", new { page = Model.PageNumber + 1, pageSize = Model.PageSize })">
                                    Next &raquo;
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link">Next &raquo;</span>
                            </li>
                        }
                    </ul>
                </nav>
            </div>


        </div>


        <!-- Footer -->
         <div class="mt-4 p-3 border-top bg-light">
            <div class="row">
                <div class="col-md-4">Report Name: VarientPerfomances Details Report<br />Date: @reportGeneratedAt</div>
                 <div class="col-md-4">User ID: @currentUserId</div> 
                <div class="col-md-4 text-end">Version: @reportVersion</div>
            </div>
        </div> 
    </div>
</div>
