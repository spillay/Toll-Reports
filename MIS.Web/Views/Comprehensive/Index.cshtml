    @model MIS.Web.Models.Comprehensive.PageComprehensiveModel
    @using System.Text.Json

    @{
        var reportGeneratedAt = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
        var currentUserId = User.FindFirst("firstName")?.Value ?? (User.Identity?.Name ?? "Lucky");

        var reportVersion = "3.0.0.0";

        var items = Model.Items ?? new List<MIS.Web.Models.Comprehensive.ComprehensiveModel>();
        var grandTotalCount = items.Count;
        var grandTotalRevenue = items.Sum(x => x.AmountInclusive ?? 0);

        var safeGrandCount = grandTotalCount == 0 ? 1 : grandTotalCount;
        var safeGrandRevenue = Math.Abs(grandTotalRevenue) < 0.0000001 ? 1 : grandTotalRevenue;

        var groupByLabel = Model.Input?.GroupBy switch
        {
            "Shift" => "OPERATIONAL SHIFT",
            "Lane" => "LANE",
            "DiscountType" => "DISCOUNT TYPE",
            "Classification" => "CLASSIFICATION",
            "TransactionType" => "METHOD OF PAYMENT",
            "MethodOfPayment" => "METHOD OF PAYMENT",
            _ => "METHOD OF PAYMENT"
        };
    }

    <div class="card shadow-lg mb-4">
        <div class="card-body">

            <div class="text-center mb-3 border-bottom pb-2">
                <h2 class="fw-bold text-primary mb-0">COMPREHENSIVE REPORT</h2>
            </div>

            <form method="get" asp-controller="Comprehensive" asp-action="Index" class="row g-3 mb-3">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Start Date and Time</label>
                    <input type="datetime-local" class="form-control" name="StartDate"
                           value="@Model.Input.StartDate.ToString("yyyy-MM-ddTHH:mm")" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">End Date and Time</label>
                    <input type="datetime-local" class="form-control" name="EndDate"
                           value="@Model.Input.EndDate.ToString("yyyy-MM-ddTHH:mm")" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Operational Shift</label>
                    <div class="border rounded p-2" style="max-height:150px; overflow-y:auto;">
                        @foreach (var s in Model.Shifts)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       name="ShiftIds" value="@s.Id"
                                       @(Model.Input.ShiftIds.Contains(s.Id) ? "checked" : "") />
                                <label class="form-check-label">@s.Name</label>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Toll Operator</label>
                    <div class="border rounded p-2" style="max-height:150px; overflow-y:auto;">
                        @foreach (var op in Model.TollOperators)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       name="OperatorIds" value="@op.Id"
                                       @(Model.Input.OperatorIds.Contains(op.Id) ? "checked" : "") />
                                <label class="form-check-label">@op.Name</label>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Lane</label>
                    <div class="border rounded p-2" style="max-height:150px; overflow-y:auto;">
                        @foreach (var ln in Model.Lanes)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       name="LaneIds" value="@ln.Id"
                                       @(Model.Input.LaneIds.Contains(ln.Id) ? "checked" : "") />
                                <label class="form-check-label">@ln.Name</label>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Payment Method</label>
                    <div class="border rounded p-2" style="max-height:150px; overflow-y:auto;">
                        @foreach (var pm in Model.PaymentMethods)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       name="PaymentMethodIds" value="@pm.Id"
                                       @(Model.Input.PaymentMethodIds.Contains(pm.Id) ? "checked" : "") />
                                <label class="form-check-label">@pm.Name</label>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Lane Discount Type</label>
                    <div class="border rounded p-2" style="max-height:150px; overflow-y:auto;">
                        @foreach (var dt in Model.DiscountTypes)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       name="DiscountTypeIds" value="@dt.Id"
                                       @(Model.Input.DiscountTypeIds.Contains(dt.Id) ? "checked" : "") />
                                <label class="form-check-label">@dt.Name</label>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Classification</label>
                    <div class="border rounded p-2" style="max-height:150px; overflow-y:auto;">
                        @foreach (var tc in Model.Classifications)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       name="TollClassIds" value="@tc.Id"
                                       @(Model.Input.TollClassIds.Contains(tc.Id) ? "checked" : "") />
                                <label class="form-check-label">@tc.Name</label>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button id="btnDownloadPdf" type="button" class="btn btn-danger w-100 shadow-sm">Export PDF</button>
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button id="btnDownloadExcel" type="button" class="btn btn-success w-100 shadow-sm">Export Excel</button>
                </div>

                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100 shadow-sm">Filter</button>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-bordered table-striped text-center align-middle">
                    <thead class="table-primary">
                        <tr>
                            <th>@groupByLabel</th>
                            <th></th>
                            @foreach (var cls in Model.TollClasses)
                            {
                                <th>@(cls == "Motor Cycle" ? "Class M" : cls)</th>
                            }
                            <th>TOTAL</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.GroupedDataTyped != null && Model.GroupedDataTyped.Any())
                        {
                            foreach (var row in Model.GroupedDataTyped)
                            {
                                <tr>
                                    <td class="fw-bold">@row.Method</td>
                                    <td>Count:<br />Count %:<br />Revenue:<br />Revenue %:</td>

                                    @foreach (var cls in Model.TollClasses)
                                    {
                                        var dataCell = row.Classes.TryGetValue(cls, out var m)
                                        ? m
                                        : new MIS.Web.Models.Comprehensive.PageComprehensiveModel.ClassMetrics();

                                        <td>
                                            @dataCell.Count<br />
                                            @dataCell.CountPercent.ToString("0.##")%<br />
                                            @dataCell.Revenue.ToString("N2")<br />
                                            @dataCell.RevenuePercent.ToString("0.##")%
                                        </td>
                                    }

                                    <td class="fw-semibold">
                                        @row.TotalCount<br />
                                        @row.TotalCountPercent.ToString("0.##")%<br />
                                        @row.TotalRevenue.ToString("N2")<br />
                                        @row.TotalRevenuePercent.ToString("0.##")%
                                    </td>
                                </tr>
                            }

                            <tr class="fw-bold bg-light">
                                <td>Grand Total</td>
                                <td>Count:<br />Count %:<br />Revenue:<br />Revenue %:</td>

                                @foreach (var cls in Model.TollClasses)
                                {
                                    var totalCount = items.Count(x => string.Equals(x.ManualTollClassName, cls, StringComparison.OrdinalIgnoreCase));
                                    var totalRevenue = items.Where(x => string.Equals(x.ManualTollClassName, cls, StringComparison.OrdinalIgnoreCase))
                                    .Sum(x => x.AmountInclusive ?? 0);

                                    var countPct = (decimal)totalCount / safeGrandCount * 100m;
                                    var revPct = (decimal)totalRevenue / (decimal)safeGrandRevenue * 100m;

                                    <td>
                                        @totalCount<br />
                                        @countPct.ToString("0.##")%<br />
                                        @totalRevenue.ToString("N2")<br />
                                        @revPct.ToString("0.##")%
                                    </td>
                                }

                                <td>
                                    @grandTotalCount<br />@((decimal)grandTotalCount / safeGrandCount * 100m)%<br />
                                    @grandTotalRevenue.ToString("N2")<br />@((decimal)grandTotalRevenue / (decimal)safeGrandRevenue * 100m)%
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td colspan="@(Model.TollClasses.Count + 3)" class="text-center text-muted">No data found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-4 p-3 border-top">
                <table class="table table-borderless w-100 mb-0 align-middle">
                    <tr>
                        <td class="fw-bold text-dark">Report Name: Comprehensive Report</td>
                        <td><strong>Date and Time:</strong> @reportGeneratedAt</td>
                    <td><strong>User ID:</strong> @currentUserId</td>
                        <td class="text-end">Page <strong>1</strong> of <strong>1</strong></td>
                    </tr>
                    <tr>
                        <td colspan="4">
                            <small class="text-muted">Reports Module Version: <strong>@reportVersion</strong></small>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", () => {

      const groupedData = @Html.Raw(JsonSerializer.Serialize(
                    Model.GroupedDataTyped ?? new List<MIS.Web.Models.Comprehensive.PageComprehensiveModel.GroupedRow>()
            ));
      const tollClasses = @Html.Raw(JsonSerializer.Serialize(Model.TollClasses ?? new List<string>()));
      const items = @Html.Raw(JsonSerializer.Serialize(
                    Model.Items ?? new List<MIS.Web.Models.Comprehensive.ComprehensiveModel>()
            ));

      const groupByLabel = @Html.Raw(JsonSerializer.Serialize(groupByLabel));
      const reportGeneratedAt = '@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")';
      const currentUserId = '@(User.Identity?.Name ?? "Lucky")';
      const reportVersion = '@reportVersion';

      //  Consistent header color you requested
      const HEADER_BLUE = [41, 128, 185];

      //  Filters text 
      const filterText = {
        "Start Date and Time": '@Model.Input.StartDate.ToString("dd/MM/yyyy HH:mm")',
        "End Date and Time": '@Model.Input.EndDate.ToString("dd/MM/yyyy HH:mm")',
        "Operational Shift": '@(Model.FilterTextOperationalShift ?? "All")',
        "Toll Operator": '@(Model.FilterTextOperators ?? "All")',
        "Lane": '@(Model.FilterTextLanes ?? "All")',
        "Payment Method": '@(Model.FilterTextPaymentMethods ?? "All")',
        "Lane Discount Type": '@(Model.FilterTextDiscountTypes ?? "All")',
        "Classification": '@(Model.FilterTextClassifications ?? "All")'
      };

      const n = (v) => (Number(v) || 0);
      const fmtMoney = (v) => n(v).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const fmtPct = (v) => `${n(v).toFixed(2)}%`;

      const grandTotalCount = items.length;
      const grandTotalRevenue = items.reduce((sum, x) => sum + n(x.AmountInclusive), 0);

      const safeCount = grandTotalCount === 0 ? 1 : grandTotalCount;
      const safeRevenue = Math.abs(grandTotalRevenue) < 0.0000001 ? 1 : grandTotalRevenue;

      const percentOfCount = (value) => (n(value) / safeCount) * 100;
      const percentOfRevenue = (value) => (n(value) / safeRevenue) * 100;

      // Build export table rows (PDF + Excel share this)
      function buildExportMatrix() {
        const headers = [groupByLabel, ""].concat(
          tollClasses.map(cls => (cls === "Motor Cycle" ? "Class M" : cls))
        ).concat(["TOTAL"]);

        const rows = [];

        // Body rows
        (groupedData || []).forEach(row => {
          const labelCol = "Count:\nCount %:\nRevenue:\nRevenue %:";

          const classCells = tollClasses.map(cls => {
            const cell = (row.Classes && row.Classes[cls]) ? row.Classes[cls] : { Count: 0, Revenue: 0 };
            const c = n(cell.Count);
            const r = n(cell.Revenue);

            return [
              `${c}`,
              `${fmtPct(percentOfCount(c))}`,
              `${fmtMoney(r)}`,
              `${fmtPct(percentOfRevenue(r))}`
            ].join("\n");
          });

          const rowCount = n(row.TotalCount);
          const rowRev = n(row.TotalRevenue);

          const totalCell = [
            `${rowCount}`,
            `${fmtPct(percentOfCount(rowCount))}`,
            `${fmtMoney(rowRev)}`,
            `${fmtPct(percentOfRevenue(rowRev))}`
          ].join("\n");

          rows.push([
            row.Method ?? "",
            labelCol,
            ...classCells,
            totalCell
          ]);
        });

        // Grand Total row (computed from items, not hardcoded)
        const grandLabelCol = "Count:\nCount %:\nRevenue:\nRevenue %:";
        const grandClassCells = tollClasses.map(cls => {
          const classCount = items.filter(x => (x.ManualTollClassName || "").toLowerCase() === (cls || "").toLowerCase()).length;
          const classRevenue = items
            .filter(x => (x.ManualTollClassName || "").toLowerCase() === (cls || "").toLowerCase())
            .reduce((s, x) => s + n(x.AmountInclusive), 0);

          return [
            `${classCount}`,
            `${fmtPct(percentOfCount(classCount))}`,
            `${fmtMoney(classRevenue)}`,
            `${fmtPct(percentOfRevenue(classRevenue))}`
          ].join("\n");
        });

        const grandTotalCell = [
          `${grandTotalCount}`,
          `${fmtPct(percentOfCount(grandTotalCount))}`,
          `${fmtMoney(grandTotalRevenue)}`,
          `${fmtPct(percentOfRevenue(grandTotalRevenue))}`
        ].join("\n");

        rows.push(["Grand Total", grandLabelCol, ...grandClassCells, grandTotalCell]);

        return { headers, rows };
      }

     
      // ✅ PDF EXPORT
      async function exportPdf() {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "a4" });

        const pageWidth = doc.internal.pageSize.getWidth();
        const pageHeight = doc.internal.pageSize.getHeight();
        const margin = 40;

        const loadImage = (src) => new Promise(res => {
          const img = new Image();
          img.crossOrigin = "Anonymous";
          img.onload = () => res(img);
          img.onerror = () => res(null);
          img.src = src;
        });

        const [leftLogo, rightLogo] = await Promise.all([
          loadImage("/images/lCC Logo.jpg"),
          loadImage("/images/ICT-Works Logo.jpg")
        ]);

        // Header
        if (leftLogo) doc.addImage(leftLogo, "JPEG", margin, 25, 70, 70);
        if (rightLogo) doc.addImage(rightLogo, "JPEG", pageWidth - margin - 70, 25, 70, 70);

        doc.setFont("helvetica", "bold");
        doc.setFontSize(16);
        doc.text("LEKKI CONCESSION COMPANY LIMITED", pageWidth / 2, 45, { align: "center" });
        doc.text("CONSERVATION TOLL PLAZA", pageWidth / 2, 65, { align: "center" });
        doc.text("COMPREHENSIVE REPORT", pageWidth / 2, 90, { align: "center" });

        // Filters block
        let y = 120;
        doc.setFont("helvetica", "normal");
        doc.setFontSize(10);
        doc.text("Filters Used:", margin, y);
        y += 14;

        Object.entries(filterText).forEach(([k, v]) => {
          doc.text(`${k}: ${v}`, margin, y);
          y += 12;
        });

        const { headers, rows } = buildExportMatrix();

        doc.autoTable({
          head: [headers],
          body: rows,
          startY: y + 10,
          theme: "grid",
          headStyles: { fillColor: HEADER_BLUE, textColor: 255 },
          styles: { fontSize: 8.5, halign: "center", valign: "middle" },
          bodyStyles: { cellPadding: 4 },

          // Make the last row (Grand Total) stand out
          didParseCell: function (data) {
            const isGrandTotalRow = data.row.index === rows.length - 1;
            if (isGrandTotalRow) {
              data.cell.styles.fontStyle = "bold";
              data.cell.styles.fillColor = [245, 245, 245];
            }
            // Make first column bold for readability
            if (data.section === "body" && data.column.index === 0) {
              data.cell.styles.fontStyle = "bold";
            }
          },

          // Footer (page X of Y)
          didDrawPage: function (data) {
            const pageCount = doc.internal.getNumberOfPages();
            const currentPage = data.pageNumber;
            const footerY = pageHeight - 25;

            doc.setFontSize(10);
            doc.setFont("helvetica", "normal");

            doc.text("Report Name: Comprehensive Report", margin, footerY);
            doc.text(`Date and Time: ${reportGeneratedAt}`, pageWidth / 2.3, footerY);
            doc.text(`User ID: ${currentUserId}`, pageWidth / 1.55, footerY);
            doc.text(`Page ${currentPage} of ${pageCount}`, pageWidth - margin, footerY, { align: "right" });

            doc.setFontSize(9);
            doc.text(`Reports Module Version Number: ${reportVersion}`, margin, footerY + 14);
          }
        });

        doc.save(`Comprehensive_Report_${new Date().toISOString().replace(/[:.]/g, "-")}.pdf`);
      }

      // ✅ EXCEL EXPORT (SheetJS) 
      function exportExcel() {
        const { headers, rows } = buildExportMatrix();

        const aoa = [];

        aoa.push(["COMPREHENSIVE REPORT"]);
        aoa.push([]);
        aoa.push(["Filters Used:"]);
        Object.entries(filterText).forEach(([k, v]) => aoa.push([`${k}: ${v}`]));
        aoa.push([]);
        aoa.push(headers);

        // Add body rows
        rows.forEach(r => aoa.push(r));

        aoa.push([]);
        aoa.push([`Report Name: Comprehensive Report`, `Date and Time: ${reportGeneratedAt}`, `User ID: ${currentUserId}`, `Page 1 of 1`]);
        aoa.push([`Reports Module Version Number: ${reportVersion}`]);

        const ws = XLSX.utils.aoa_to_sheet(aoa);

        // Column widths
        ws["!cols"] = headers.map(() => ({ wch: 22 }));

        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, "Comprehensive Report");

        XLSX.writeFile(wb, `Comprehensive_Report_${new Date().toISOString().replace(/[:.]/g, "-")}.xlsx`);
      }

      const btnPdf = document.getElementById("btnDownloadPdf");
      const btnExcel = document.getElementById("btnDownloadExcel");

      if (btnPdf) btnPdf.addEventListener("click", exportPdf);
      if (btnExcel) btnExcel.addEventListener("click", exportExcel);
    });
</script>