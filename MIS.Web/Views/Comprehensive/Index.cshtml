@removeTagHelper "Microsoft.AspNetCore.Mvc.TagHelpers.OptionTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers"
@model MIS.Web.Models.Comprehensive.PageComprehensiveModel
@using System.Text.Json

@{
    ViewData["Title"] = "Comprehensive Report";

    var reportGeneratedAt = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
    var currentUserId = @User.FindFirst("firstName")?.Value ?? "Unknown User";
    var reportVersion = "3.0.0.0";

    var grandTotalCount = Model.Items.Count();
    var grandTotalRevenue = Model.Items.Sum(x => x.AmountInclusive);
    if (grandTotalCount == 0) grandTotalCount = 1;
    if (grandTotalRevenue == 0) grandTotalRevenue = 1;
}

<div class="card shadow-lg mb-4">
    <div class="card-body">

        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
            <h2 class="mb-0 fw-bold text-primary text-center w-100">COMPREHENSIVE REPORT</h2>
        </div>

        <!-- FILTER SECTION -->
        <form method="get" asp-controller="Comprehensive" asp-action="Index" class="row g-3 mb-3">

            <!-- Start Date -->
            <div class="col-md-3">
                <label class="form-label fw-semibold">Start Date and Time</label>
                <input type="datetime-local" class="form-control" name="StartDate"
                       value="@Model.Input.StartDate.ToString("yyyy-MM-ddTHH:mm")" />
            </div>

            <!-- End Date -->
            <div class="col-md-3">
                <label class="form-label fw-semibold">End Date and Time</label>
                <input type="datetime-local" class="form-control" name="EndDate"
                       value="@Model.Input.EndDate.ToString("yyyy-MM-ddTHH:mm")" />
            </div>

            <!-- Operational Shift -->
            <div class="col-md-3">
                <label class="form-label fw-semibold">Operational Shift</label>
                <select class="form-select" name="Shift">
                    <option value="">-All-</option>
                    @foreach (var s in Model.Shifts ?? new List<string>())
                    {
                        <option value="@s" @(Model.Input.Shift == s ? "selected" : null)>@s</option>
                    }
                </select>
            </div>

            <!-- Toll Operator ID -->
            <div class="col-md-3">
                <label class="form-label fw-semibold">Toll Operator</label>
                <select class="form-select" name="TollOperatorID">
                    <option value="">All</option>
                    @foreach (var op in Model.TollOperators)
                    {
                        <option value="@op" @(Model.Input.TollOperatorID == op ? "selected" : null)>@op</option>
                    }
                </select>
            </div>

            <!-- Lane -->
            <div class="col-md-3">
                <label class="form-label fw-semibold">Lane</label>
                <select class="form-select" name="LaneName">
                    <option value="">-All-</option>
                    @foreach (var lane in Model.Lanes ?? new List<string>())
                    {
                        <option value="@lane" @(Model.Input.LaneName == lane ? "selected" : null)>@lane</option>
                    }
                </select>
            </div>

            <!-- Method of Payment -->
            <div class="col-md-3">
                <label class="form-label fw-semibold">Method of Payment</label>
                <select class="form-select" name="MethodOfPayment">
                    <option value="">-All-</option>
                    @foreach (var m in Model.PaymentMethods ?? new List<string>())
                    {
                        <option value="@m" @(Model.Input.MethodOfPayment == m ? "selected" : null)>@m</option>
                    }
                </select>
            </div>

            <!-- Lane Discount Type -->
            <div class="col-md-3">
                <label class="form-label fw-semibold">Lane Discount Type</label>
                <select class="form-select" name="DiscountType">
                    <option value="">-All-</option>
                    @foreach (var d in Model.DiscountTypes ?? new List<string>())
                    {
                        <option value="@d" @(Model.Input.DiscountType == d ? "selected" : null)>@d</option>
                    }
                </select>
            </div>

            <!-- Classification -->
            <div class="col-md-3">
                <label class="form-label fw-semibold">Classification</label>
                <select class="form-select" name="Classification">
                    <option value="">-All-</option>
                    @foreach (var c in Model.Classifications ?? new List<string>())
                    {
                        var display = c == "Motor Cycle" ? "Class M" : c;
                        <option value="@c" @(Model.Input.Classification == c ? "selected" : null)>@display</option>
                    }
                </select>
            </div>

            <!-- Export Buttons -->
            <div class="col-md-2 d-flex align-items-end">
                <button id="btnDownloadPdf" type="button" class="btn btn-danger w-100 shadow-sm">
                    <i class="bi bi-file-earmark-pdf"></i> Export PDF
                </button>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button id="btnDownloadExcel" type="button" class="btn btn-success w-100 shadow-sm">
                    <i class="bi bi-file-earmark-excel"></i> Export Excel
                </button>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100 shadow-sm">
                    <i class="bi bi-funnel"></i> Filter
                </button>
            </div>

        </form>


        <!-- TABLE -->
        <div class="table-responsive">
            <table class="table table-bordered table-striped text-center align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>@(Model.Input.GroupBy == "TransactionType" ? "METHOD OF PAYMENT" : "METHOD OF PAYMENT")</th>
                        <th></th>
                        @foreach (var cls in Model.TollClasses)
                        {
                            <th>@(cls == "Motor Cycle" ? "Class M" : cls)</th>
                        }
                        <th>TOTAL</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.GroupedDataTyped.Any())
                    {
                        foreach (var row in Model.GroupedDataTyped)
                        {
                            var rowTotalCount = row.TotalCount;
                            var rowTotalRevenue = row.TotalRevenue;
                            var rowCountPercent = (double)rowTotalCount / grandTotalCount * 100;
                            var rowRevenuePercent = (double)rowTotalRevenue / grandTotalRevenue * 100;

                            <tr>
                                <td class="fw-bold">@row.Method</td>
                                <td>Count:<br />Count %:<br />Revenue:<br />Revenue %:</td>

                                @foreach (var cls in Model.TollClasses)
                                {
                                    var data = row.Classes.ContainsKey(cls)
                                    ? row.Classes[cls]
                                    : new MIS.Web.Models.Comprehensive.PageComprehensiveModel.ClassMetrics();

                                    var classCountPercent = (double)data.Count / grandTotalCount * 100;
                                    var classRevenuePercent = (double)data.Revenue / grandTotalRevenue * 100;

                                    <td>
                                        @data.Count<br />
                                        @classCountPercent.ToString("0.##")%<br />
                                        @data.Revenue.ToString("N2")<br />
                                        @classRevenuePercent.ToString("0.##")%
                                    </td>
                                }

                                <td>
                                    @rowTotalCount<br />
                                    @rowCountPercent.ToString("0.##")%<br />
                                    @rowTotalRevenue.ToString("N2")<br />
                                    @rowRevenuePercent.ToString("0.##")%
                                </td>
                            </tr>
                        }

                        <!-- GRAND TOTAL -->
                        <tr class="fw-bold bg-light">
                            <td>Grand Total</td>
                            <td>Count:<br />Count %:<br />Revenue:<br />Revenue %:</td>

                            @foreach (var cls in Model.TollClasses)
                            {
                                var totalCount = Model.Items.Count(x => x.ManualTollClass == cls);
                                var totalRevenue = Model.Items.Where(x => x.ManualTollClass == cls).Sum(x => x.AmountInclusive);
                                var countPercent = (double)totalCount / grandTotalCount * 100;
                                var revenuePercent = (double)totalRevenue / grandTotalRevenue * 100;

                                <td>
                                    @totalCount<br />
                                    @countPercent.ToString("0.##")<br />
                                    @totalRevenue.ToString("N2")<br />
                                    @revenuePercent.ToString("0.##")
                                </td>
                            }

                            <td>
                                @Model.Items.Count()<br />100<br />
                                @Model.Items.Sum(x => x.AmountInclusive).ToString("N2")<br />100
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr><td colspan="@(Model.TollClasses.Count + 2)" class="text-center text-muted">No data found</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- FOOTER -->
        <div class="mt-4 p-3 border-top">
            <table class="table table-borderless w-100 mb-0 align-middle">
                <tr>
                    <td class="fw-bold text-dark"> Report Name: Comprehensive Report</td>
                    <td><strong>Date and Time:</strong> @reportGeneratedAt</td>
                    <td><strong>User:</strong>  @User.FindFirst("firstName")?.Value</td>
                    <td class="text-end">Page <strong>1</strong> of <strong>1</strong></td>
                </tr>
                <tr>
                    <td colspan="4">
                        <small class="text-muted">
                            Reports Module Version:
                            <strong>@reportVersion</strong>
                        </small>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>

<!-- ====== EXPORT SCRIPTS ====== -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const groupedData = @Html.Raw(JsonSerializer.Serialize(Model.GroupedDataTyped ?? new List<MIS.Web.Models.Comprehensive.PageComprehensiveModel.GroupedRow>()));
        const tollClasses = @Html.Raw(JsonSerializer.Serialize(Model.TollClasses));
        const items = @Html.Raw(JsonSerializer.Serialize(Model.Items ?? new List<MIS.Web.Models.Comprehensive.ComprehensiveModel>()));
        const groupByLabel = '@(Model.Input.GroupBy == "TransactionType" ? "METHOD OF PAYMENT" : "METHOD OF PAYMENT")';
        const reportGeneratedAt = '@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")';
        const currentUserId = '@(User.Identity?.Name ?? "Lucky")';
        const reportVersion = "2.0.0.11";

        /* === PDF EXPORT === */
        document.getElementById("btnDownloadPdf").addEventListener("click", async () => {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "a4" });
            const pageWidth = doc.internal.pageSize.getWidth();
            const pageHeight = doc.internal.pageSize.getHeight();
            const margin = 40;

            const loadImage = src => new Promise(res => {
                const img = new Image(); img.crossOrigin = 'Anonymous';
                img.onload = () => res(img); img.onerror = () => res(null); img.src = src;
            });
            const [leftLogo, rightLogo] = await Promise.all([
                loadImage('/images/lCC Logo.jpg'),
                loadImage('/images/ICT-Works Logo.jpg')
            ]);
            if (leftLogo) doc.addImage(leftLogo, 'JPEG', margin, 30, 80, 80);
            if (rightLogo) doc.addImage(rightLogo, 'JPEG', pageWidth - margin - 80, 30, 80, 80);

            doc.setFont("helvetica", "bold");
            doc.setFontSize(16);
            doc.text("LEKKI CONCESSION COMPANY LIMITED", pageWidth / 2, 50, { align: "center" });
            doc.text("CONSERVATION TOLL PLAZA", pageWidth / 2, 70, { align: "center" });
            doc.text("COMPREHENSIVE REPORT", pageWidth / 2, 100, { align: "center" });

            let y = 150;
            doc.setFontSize(10);
            doc.text("Filters Used:", margin, y);
            y += 14;
            const filters = {
                "Start Date and Time": '@Model.Input.StartDate.ToString("dd/MM/yyyy HH:mm")',
                "End Date and Time": '@Model.Input.EndDate.ToString("dd/MM/yyyy HH:mm")',
                "Operational Shift": '@(string.IsNullOrEmpty(Model.Input.Shift) ? "All" : Model.Input.Shift)',
                "Toll Operator ID": '@(string.IsNullOrEmpty(Model.Input.TollOperatorID) ? "All" : Model.Input.TollOperatorID)',
                "Lane": '@(string.IsNullOrEmpty(Model.Input.LaneName) ? "All" : Model.Input.LaneName)',
                "Payment Method": '@(string.IsNullOrEmpty(Model.Input.MethodOfPayment) ? "All" : Model.Input.MethodOfPayment)',
                "Classification": '@(string.IsNullOrEmpty(Model.Input.Classification) ? "All" : Model.Input.Classification)'
            };
            for (const [key, val] of Object.entries(filters)) {
                doc.text(`${key}: ${val}`, margin, y);
                y += 12;
            }

            const headers = [groupByLabel, ""].concat(tollClasses).concat(["TOTAL"]);
            const grandTotalCount = items.length || 1;
            const grandTotalRevenue = items.reduce((sum, x) => sum + (x.AmountInclusive || 0), 0) || 1;
            const rows = [];

            groupedData.forEach(g => {
                const secondCol = "Count\nCount %\nRevenue\nRevenue %";
                const classCells = tollClasses.map(cls => {
                    const cm = g.Classes?.[cls] || { Count: 0, Revenue: 0 };
                    const countPercent = ((cm.Count / grandTotalCount) * 100).toFixed(2);
                    const revenuePercent = ((cm.Revenue / grandTotalRevenue) * 100).toFixed(2);
                    return `${cm.Count}\n${countPercent}%\n${cm.Revenue.toFixed(2)}\n${revenuePercent}%`;
                });
                const totalCell = `${g.TotalCount}\n${((g.TotalCount / grandTotalCount) * 100).toFixed(2)}%\n${g.TotalRevenue.toFixed(2)}\n${((g.TotalRevenue / grandTotalRevenue) * 100).toFixed(2)}%`;
                rows.push([g.Method || "", secondCol, ...classCells, totalCell]);
            });

            // === GRAND TOTAL ===
            const classTotals = tollClasses.map(cls => {
                const count = items.filter(x => x.ManualTollClass === cls).length;
                const revenue = items.filter(x => x.ManualTollClass === cls).reduce((s, x) => s + (x.AmountInclusive || 0), 0);
                return { cls, count, revenue };
            });
            const grandCells = classTotals.map(c => {
                const countPct = ((c.count / grandTotalCount) * 100).toFixed(2);
                const revPct = ((c.revenue / grandTotalRevenue) * 100).toFixed(2);
                return `${c.count}\n${countPct}%\n${c.revenue.toFixed(2)}\n${revPct}%`;
            });
            const totalCell = `${grandTotalCount}\n100%\n${grandTotalRevenue.toFixed(2)}\n100%`;
            rows.push(["Grand Total", "Count:\nCount %:\nRevenue:\nRevenue %:", ...grandCells, totalCell]);

            doc.autoTable({
                head: [headers],
                body: rows,
                startY: y + 10,
                theme: 'grid',
                headStyles: { fillColor: [52, 152, 219], textColor: 255 },
                styles: { fontSize: 9, halign: 'center', valign: 'middle' },
                didDrawPage: data => {
                    const pageCount = doc.internal.getNumberOfPages();
                    const currentPage = data.pageNumber;
                    const footerY = pageHeight - 30;
                    doc.setFontSize(10);
                    doc.text(`Report Name: Comprehensive Report`, margin, footerY);
                    doc.text(`Date and Time: ${reportGeneratedAt}`, pageWidth / 2.8, footerY);
                    doc.text(`User ID: ${currentUserId}`, pageWidth / 1.6, footerY);
                    doc.text(`Page ${currentPage} of ${pageCount}`, pageWidth - margin, footerY, { align: 'right' });
                    doc.setFontSize(9);
                    doc.text(`Reports Module Version Number: ${reportVersion}`, margin, footerY + 14);
                }
            });

            doc.save(`Comprehensive_Report_${new Date().toISOString().replace(/[:.]/g, '-')}.pdf`);
        });

        /* === EXCEL EXPORT === */
        document.getElementById("btnDownloadExcel").addEventListener("click", function () {
            const headers = [groupByLabel].concat(tollClasses).concat(["TOTAL"]);
            const grandTotalCount = items.length || 1;
            const grandTotalRevenue = items.reduce((sum, x) => sum + (x.AmountInclusive || 0), 0) || 1;
            const rows = [];

            groupedData.forEach(g => {
                const method = g.Method || "";
                rows.push([method, ...tollClasses.map(cls => g.Classes?.[cls]?.Count || 0), g.TotalCount]);
                rows.push(["Count %", ...tollClasses.map(cls => (((g.Classes?.[cls]?.Count || 0) / grandTotalCount) * 100).toFixed(2) + "%"), ((g.TotalCount / grandTotalCount) * 100).toFixed(2) + "%"]);
                rows.push(["Revenue", ...tollClasses.map(cls => g.Classes?.[cls]?.Revenue.toFixed(2) || "0.00"), g.TotalRevenue.toFixed(2)]);
                rows.push(["Revenue %", ...tollClasses.map(cls => (((g.Classes?.[cls]?.Revenue || 0) / grandTotalRevenue) * 100).toFixed(2) + "%"), ((g.TotalRevenue / grandTotalRevenue) * 100).toFixed(2) + "%"]);
                rows.push([]);
            });

            // === GRAND TOTAL ===
            const classTotals = tollClasses.map(cls => {
                const count = items.filter(x => x.ManualTollClass === cls).length;
                const revenue = items.filter(x => x.ManualTollClass === cls).reduce((s, x) => s + (x.AmountInclusive || 0), 0);
                return { cls, count, revenue };
            });
            rows.push([]);
            rows.push(["Grand Total:"]);
            rows.push(["Count", ...classTotals.map(c => c.count), grandTotalCount]);
            rows.push(["Count %", ...classTotals.map(c => ((c.count / grandTotalCount) * 100).toFixed(2) + "%"), "100%"]);
            rows.push(["Revenue", ...classTotals.map(c => c.revenue.toFixed(2)), grandTotalRevenue.toFixed(2)]);
            rows.push(["Revenue %", ...classTotals.map(c => ((c.revenue / grandTotalRevenue) * 100).toFixed(2) + "%"), "100%"]);

            // === FOOTER ===
            rows.push([]);
            rows.push([
                "Report Name: Comprehensive Report", "",
                `Date and Time:\n${reportGeneratedAt}`, "",
                `User ID:\n${currentUserId}`, "", "", "Page 1 of 1"
            ]);
            rows.push([`Reports Module Version Number: ${reportVersion}`]);

            const ws = XLSX.utils.aoa_to_sheet([headers, ...rows]);
            ws['!cols'] = Array(headers.length).fill({ wch: 20 });
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "Comprehensive Report");
            XLSX.writeFile(wb, `Comprehensive_Report_${new Date().toISOString().replace(/[:.]/g, '-')}.xlsx`);
        });
    });
</script>
