@model MIS.Web.Models.DailyCashup.PageDailyCashupModel
@removeTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using System
@using System.Linq
@using System.Collections.Generic

@{
    // Always works: MVC View + Razor Pages view context
    var req = ViewContext.HttpContext.Request;

    var startQuery = req.Query["StartDate"].ToString();
    var endQuery   = req.Query["EndDate"].ToString();

    var selectedShiftIdsQuery = req.Query["shiftIds"];
    var selectedUserIdsQuery  = req.Query["systemUserIds"];

    // Footer meta
    var reportGeneratedAt = DateTime.Now;
    var currentUser = @User.FindFirst("firstName")?.Value ?? "Unknown User";

    var reportVersion = "3.0.0.0";

    // Items
    var items = Model?.Items ?? new List<MIS.Web.Models.DailyCashup.DailyCashupModel>();

    // Group by shift
    var grouped = items
        .OrderBy(x => x.ShiftDescription ?? "")
        .ThenBy(x => x.TollOperator ?? "")
        .GroupBy(x => x.ShiftDescription ?? "-- Unknown Shift --")
        .ToList();

    // Paging (safe)
    int currentPage = 1;
    int pageSize = 10;
    int totalPages = 1;
    int totalCount = items.Count;

    int TryReadInt(string prop, int fallback)
    {
        try
        {
            var p = Model?.GetType().GetProperty(prop);
            if (p == null) return fallback;
            var val = p.GetValue(Model);
            if (val == null) return fallback;
            return Convert.ToInt32(val);
        }
        catch { return fallback; }
    }

    currentPage = TryReadInt("page", TryReadInt("Page", 1));
    pageSize    = TryReadInt("pageSize", TryReadInt("PageSize", 10));
    totalPages  = TryReadInt("totalPages", TryReadInt("TotalPages", 1));
    totalCount  = TryReadInt("totalCount", TryReadInt("TotalCount", totalCount));

    // Friendly filter display
    var selectedShiftNames = (Model?.ShiftOptions ?? new List<MIS.Web.Models.DailyCashup.CheckItemModel<int>>())
        .Where(x => x.Selected || selectedShiftIdsQuery.Contains(x.Id.ToString()))
        .Select(x => x.Name)
        .ToList();

    var selectedOperatorNames = (Model?.TollOperatorOptions ?? new List<MIS.Web.Models.DailyCashup.CheckItemModel<long>>())
        .Where(x => x.Selected || selectedUserIdsQuery.Contains(x.Id.ToString()))
        .Select(x => x.Name)
        .ToList();

    string shiftDisplay = selectedShiftNames.Any() ? string.Join(", ", selectedShiftNames) : "All";
    string opDisplay    = selectedOperatorNames.Any() ? string.Join(", ", selectedOperatorNames) : "All";
}

<div class="card shadow-lg mb-4">
    <div class="card-body">

        <!-- HEADER -->
        <div class="position-relative border-bottom pb-2 mb-3">
            <h2 class="fw-bold text-primary text-center mb-0">DAILY CASH REPORT</h2>
        </div>

        <!-- EXPORT BUTTONS -->
        <div class="row mb-3">
            <div class="col-md-2 me-2">
                <button id="btnExportPDF" class="btn btn-danger w-100 shadow-sm">
                    <i class="bi bi-file-earmark-pdf"></i> Export PDF
                </button>
            </div>

            <div class="col-md-2">
                <button id="btnExportExcel" class="btn btn-success w-100 shadow-sm">
                    <i class="bi bi-file-earmark-excel"></i> Export Excel
                </button>
            </div>
        </div>

        <!-- FILTERS (consistent layout, now multi-checklist) -->
        <form method="get" action="@Url.Action("Index", "DailyCashup")" class="row g-3 mb-4">

            <!-- Start Date -->
            <div class="col-md-3">
                <label class="form-label fw-semibold">Start Date & Time</label>
                <input type="datetime-local" name="StartDate" class="form-control"
                       value="@(!string.IsNullOrEmpty(startQuery)
                                ? startQuery
                                : Model?.StartDate.ToString("yyyy-MM-ddTHH:mm"))" />
            </div>

            <!-- End Date -->
            <div class="col-md-3">
                <label class="form-label fw-semibold">End Date & Time</label>
                <input type="datetime-local" name="EndDate" class="form-control"
                       value="@(!string.IsNullOrEmpty(endQuery)
                                ? endQuery
                                : Model?.EndDate.ToString("yyyy-MM-ddTHH:mm"))" />
            </div>

            <!-- Shift Checklist -->
            <div class="col-md-3">
                <label class="form-label fw-semibold">Operational Shift</label>
                <div class="border rounded p-2" style="max-height:180px; overflow:auto; background:#fff;">
                    @if (Model?.ShiftOptions != null && Model.ShiftOptions.Any())
                    {
                        foreach (var s in Model.ShiftOptions)
                        {
                            var isChecked = selectedShiftIdsQuery.Contains(s.Id.ToString()) || s.Selected;

                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="shiftIds"
                                       value="@s.Id"
                                       id="shift_@s.Id"
                                       @(isChecked ? "checked" : "") />
                                <label class="form-check-label" for="shift_@s.Id">@s.Name</label>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted">No shifts loaded.</div>
                    }
                </div>
            </div>

            <!-- Operator Checklist -->
            <div class="col-md-3">
                <label class="form-label fw-semibold">Toll Operator</label>
                <div class="border rounded p-2" style="max-height:180px; overflow:auto; background:#fff;">
                    @if (Model?.TollOperatorOptions != null && Model.TollOperatorOptions.Any())
                    {
                        foreach (var op in Model.TollOperatorOptions)
                        {
                            var isChecked = selectedUserIdsQuery.Contains(op.Id.ToString()) || op.Selected;

                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="systemUserIds"
                                       value="@op.Id"
                                       id="op_@op.Id"
                                       @(isChecked ? "checked" : "") />
                                <label class="form-check-label" for="op_@op.Id">@op.Name</label>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted">No operators loaded.</div>
                    }
                </div>
            </div>

            <!-- Filter Button -->
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-primary w-100 px-4">Apply Filters</button>
            </div>
        </form>

        <!-- TABLE -->
        <div class="table-responsive">
            <table class="table table-bordered align-middle" id="dailyCashupTable">
                <thead class="table-light text-center">
                    <tr>
                        <th>Operational Day</th>
                        <th>Operational Shift</th>
                        <th>Toll Operator</th>
                        <th class="text-end">Lane Cash</th>
                        <th class="text-end">Top-ups</th>
                        <th class="text-end">Total Cash Expected</th>
                        <th class="text-end">Cash Declared</th>
                        <th class="text-end">Surplus / Shortage</th>
                        <th class="text-end">Total Banked</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        double grandLane = 0, grandTop = 0, grandExpected = 0, grandDeclared = 0, grandBanked = 0;
                    }

                    @foreach (var shift in grouped)
                    {
                        double shiftLane = 0, shiftTop = 0, shiftExpected = 0, shiftDeclared = 0, shiftBanked = 0;

                        foreach (var item in shift)
                        {
                            var expected = item.NettAmount + item.ActualAmount;
                            var declared = item.TotalDeclared;
                            var surplus = declared - expected;
                            var surplusDisplay = Math.Abs(surplus);
                            var banked = declared;

                            shiftLane += item.NettAmount;
                            shiftTop += item.ActualAmount;
                            shiftExpected += expected;
                            shiftDeclared += declared;
                            shiftBanked += banked;

                            grandLane += item.NettAmount;
                            grandTop += item.ActualAmount;
                            grandExpected += expected;
                            grandDeclared += declared;
                            grandBanked += banked;

                            <tr>
                                <td>@item.ShiftDate.ToString("dd/MM/yyyy")</td>
                                <td>@(item.ShiftDescription ?? "")</td>
                                <td>@item.TollOperator</td>

                                <td class="text-end">@item.NettAmount.ToString("N2")</td>
                                <td class="text-end">@item.ActualAmount.ToString("N2")</td>
                                <td class="text-end">@expected.ToString("N2")</td>
                                <td class="text-end">@declared.ToString("N2")</td>

                                <td class="text-end @(surplus > 0 ? "text-primary fw-bold" : surplus < 0 ? "text-danger fw-bold" : "text-muted fw-bold")">
                                    @surplusDisplay.ToString("N2")
                                </td>

                                <td class="text-end fw-bold">@banked.ToString("N2")</td>
                            </tr>
                        }

                        var shiftSurplus = Math.Abs( shiftDeclared-shiftExpected );

                        <tr class="fw-bold table-light">
                            <td colspan="3" class="text-end">Total Shift @shift.Key</td>

                            <td class="text-end">@shiftLane.ToString("N2")</td>
                            <td class="text-end">@shiftTop.ToString("N2")</td>
                            <td class="text-end">@shiftExpected.ToString("N2")</td>
                            <td class="text-end">@shiftDeclared.ToString("N2")</td>
                             <td class="text-end @(shiftSurplus > 0 ? "text-primary fw-bold" : shiftSurplus < 0 ? "text-danger fw-bold" : "text-muted fw-bold")">
                                    @shiftSurplus.ToString("N2")
                                </td>
                            <td class="text-end">@shiftBanked.ToString("N2")</td>
                        </tr>

                        <tr><td colspan="9" style="border-top:none;border-bottom:none;"></td></tr>
                    }

                    <!-- GRAND TOTAL -->
                    <tr class="fw-bold text-white" style="background-color:#1b4b72;">
                        <td colspan="3" class="text-end">Operational Day Total</td>
                        <td class="text-end">@grandLane.ToString("N2")</td>
                        <td class="text-end">@grandTop.ToString("N2")</td>
                        <td class="text-end">@grandExpected.ToString("N2")</td>
                        <td class="text-end">@grandDeclared.ToString("N2")</td>
                        <td class="text-end">@Math.Abs(grandExpected - grandDeclared).ToString("N2")</td>
                        <td class="text-end">@grandBanked.ToString("N2")</td>
                    </tr>

                </tbody>
            </table>
        </div>

        <!-- PAGINATION -->
        @if (totalPages > 1)
        {
            var startVal = !string.IsNullOrEmpty(startQuery) ? startQuery : Model.StartDate.ToString("yyyy-MM-ddTHH:mm:ss");
            var endVal   = !string.IsNullOrEmpty(endQuery) ? endQuery : Model.EndDate.ToString("yyyy-MM-ddTHH:mm:ss");

            <div class="d-flex justify-content-center mt-3">
                <nav aria-label="Daily Cashup Page Navigation">
                    <ul class="pagination">

                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               href="@Url.Action("Index", new {
                                   page = currentPage - 1,
                                   pageSize = pageSize,
                                   StartDate = startVal,
                                   EndDate = endVal,
                                   shiftIds = selectedShiftIdsQuery.ToArray(),
                                   systemUserIds = selectedUserIdsQuery.ToArray()
                               })">« Prev</a>
                        </li>

                        @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                        {
                            <li class="page-item @(currentPage == i ? "active" : "")">
                                <a class="page-link"
                                   href="@Url.Action("Index", new {
                                       page = i,
                                       pageSize = pageSize,
                                       StartDate = startVal,
                                       EndDate = endVal,
                                       shiftIds = selectedShiftIdsQuery.ToArray(),
                                       systemUserIds = selectedUserIdsQuery.ToArray()
                                   })">@i</a>
                            </li>
                        }

                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link"
                               href="@Url.Action("Index", new {
                                   page = currentPage + 1,
                                   pageSize = pageSize,
                                   StartDate = startVal,
                                   EndDate = endVal,
                                   shiftIds = selectedShiftIdsQuery.ToArray(),
                                   systemUserIds = selectedUserIdsQuery.ToArray()
                               })">Next »</a>
                        </li>

                    </ul>
                </nav>
            </div>
        }

        <!-- FOOTER -->
        <div class="mt-4 p-3 border-top bg-light">
            <table class="table table-borderless w-100 mb-0">
                <tr>
                    <td style="width:35%;"><strong>Daily Cash Report</strong></td>
                    <td style="width:30%;"><strong>Date and Time:</strong><br /><em>@reportGeneratedAt.ToString("dd/MM/yyyy HH:mm:ss")</em></td>
                    <td style="width:25%;"><strong>User ID:</strong><br /><em>@currentUser</em></td>
                    <td style="width:10%;" class="text-end">Page @currentPage of @totalPages</td>
                </tr>
                <tr>
                    <td colspan="4"><strong>Reports Module Version Number:</strong> @reportVersion</td>
                </tr>
            </table>
        </div>

            </div>
        </div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>

    <script>
        /* =========================================================
           HELPERS
           ========================================================= */

        function fileStamp() {
            const d = new Date();
            const pad = n => String(n).padStart(2, "0");
            return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}_${pad(d.getHours())}-${pad(d.getMinutes())}-${pad(d.getSeconds())}`;
        }

        function toNum(v) {
            const n = Number(v);
            return Number.isFinite(n) ? n : 0;
        }

        function fmt2(n) {
            return toNum(n).toFixed(2);
        }

        function safeDateText(value) {
            try {
                const dt = new Date(value);
                if (isNaN(dt.getTime())) return "";
                const dd = String(dt.getDate()).padStart(2, "0");
                const mm = String(dt.getMonth() + 1).padStart(2, "0");
                const yyyy = dt.getFullYear();
                return `${dd}/${mm}/${yyyy}`;
            } catch {
                return "";
            }
        }

        function groupByShift(rows) {
            const groups = {};
            (rows || []).forEach(r => {
                const key = r.ShiftDescription || "-- Unknown Shift --";
                if (!groups[key]) groups[key] = [];
                groups[key].push(r);
            });

            return {
                groups,
                keys: Object.keys(groups)
            };
        }

        function computeTotals(rows) {
            const t = {
                lane: 0,
                top: 0,
                expected: 0,
                declared: 0,
                banked: 0
            };

            (rows || []).forEach(r => {
                const lane = toNum(r.NettAmount);
                const top = toNum(r.ActualAmount);
                const expected = lane + top;
                const declared = toNum(r.TotalDeclared);
                const banked = declared;

                t.lane += lane;
                t.top += top;
                t.expected += expected;
                t.declared += declared;
                t.banked += banked;
            });

            return t;
        }

        function getExportMeta() {
            return {
                company: "LEKKI CONCESSION COMPANY (LCC)",
                bridge: "MIS REPORTING SYSTEM",
                title: "DAILY CASH REPORT",
                generatedAt: new Date().toLocaleString(),
                userId: "@currentUser",
                version: "@reportVersion",
                startDate: "@(Model?.StartDate.ToString("dd/MM/yyyy HH:mm") ?? "-")",
                endDate: "@(Model?.EndDate.ToString("dd/MM/yyyy HH:mm") ?? "-")",
                shift: "@shiftDisplay",
                operator: "@opDisplay",
                leftLogo: "/images/LCC Logo.jpg",
                rightLogo: "/images/ICT-Works Logo.jpg"
            };
        }

        function loadImage(src) {
            return new Promise(resolve => {
                if (!src) {
                    resolve(null);
                    return;
                }

                const img = new Image();
                img.crossOrigin = "anonymous";
                img.onload = () => resolve(img);
                img.onerror = () => resolve(null);
                img.src = src;
            });
        }

        /* =========================================================
           PDF BUILDERS
           ========================================================= */

        function drawPdfHeader(doc, pageWidth, margin, meta, leftLogo, rightLogo) {
            const logoW = 60;
            const logoH = 60;
            const topY = 20;

            if (leftLogo) {
                doc.addImage(leftLogo, "JPEG", margin, topY, logoW, logoH);
            }

            if (rightLogo) {
                doc.addImage(rightLogo, "JPEG", pageWidth - margin - logoW, topY, logoW, logoH);
            }

            doc.setFont("helvetica", "bold");
            doc.setFontSize(14);
            doc.text(meta.company, pageWidth / 2, 40, { align: "center" });

            doc.setFontSize(12);
            doc.text(meta.bridge, pageWidth / 2, 58, { align: "center" });

            doc.setFontSize(16);
            doc.text(meta.title, pageWidth / 2, 80, { align: "center" });
        }

        function drawPdfFilters(doc, margin, startY, meta) {
            let y = startY;

            doc.setFont("helvetica", "bold");
            doc.setFontSize(10);
            doc.text("Filters Used:", margin, y);

            y += 14;
            doc.setFont("helvetica", "normal");

            doc.text(`Start Date: ${meta.startDate}`, margin, y);
            y += 14;

            doc.text(`End Date: ${meta.endDate}`, margin, y);
            y += 14;

            doc.text(`Shift: ${meta.shift}`, margin, y);
            y += 14;

            doc.text(`Operator: ${meta.operator}`, margin, y);
            y += 16;

            return y;
        }

        function drawPdfFooter(doc, pageWidth, pageHeight, margin, meta, pageNumber, totalPages) {
            const row1Y = pageHeight - 28;
            const row2Y = pageHeight - 14;

            doc.setFont("helvetica", "bold");
            doc.setFontSize(9);
            doc.text(`${meta.title} (Report name)`, margin, row1Y);

            doc.setFont("helvetica", "normal");
            doc.text(`Date and Time: ${meta.generatedAt}`, pageWidth / 2, row1Y, { align: "center" });
            doc.text(`User ID: ${meta.userId}`, pageWidth - 170, row1Y);
            doc.text(`Page ${pageNumber} of ${totalPages}`, pageWidth - margin, row1Y, { align: "right" });

            doc.setFontSize(8);
            doc.text(`Reports Module Version Number: ${meta.version}`, margin, row2Y);
        }

        function addPdfFooters(doc, meta) {
            const pageWidth = doc.internal.pageSize.getWidth();
            const pageHeight = doc.internal.pageSize.getHeight();
            const margin = 40;
            const totalPages = doc.internal.getNumberOfPages();

            for (let i = 1; i <= totalPages; i++) {
                doc.setPage(i);
                drawPdfFooter(doc, pageWidth, pageHeight, margin, meta, i, totalPages);
            }
        }

        function buildPdfBody(rows) {
            const { groups, keys } = groupByShift(rows);
            const body = [];

            const dayTotals = {
                lane: 0,
                top: 0,
                expected: 0,
                declared: 0,
                banked: 0
            };

            keys.forEach(shift => {
                const shiftRows = groups[shift] || [];
                const shiftTotals = computeTotals(shiftRows);

                dayTotals.lane += shiftTotals.lane;
                dayTotals.top += shiftTotals.top;
                dayTotals.expected += shiftTotals.expected;
                dayTotals.declared += shiftTotals.declared;
                dayTotals.banked += shiftTotals.banked;

                body.push([
                    {
                        content: `SHIFT: ${shift}`,
                        colSpan: 9,
                        styles: {
                            halign: "left",
                            fillColor: [230, 230, 230],
                            fontStyle: "bold"
                        }
                    }
                ]);

                shiftRows.forEach(r => {
                    const expected = toNum(r.NettAmount) + toNum(r.ActualAmount);
                    const declared = toNum(r.TotalDeclared);
                    const surplus = Math.abs(declared - expected);
                    const banked = declared;

                    body.push([
                        safeDateText(r.ShiftDate),
                        r.ShiftDescription || "",
                        r.TollOperator || "",
                        fmt2(r.NettAmount),
                        fmt2(r.ActualAmount),
                        fmt2(expected),
                        fmt2(declared),
                        fmt2(surplus),
                        fmt2(banked)
                    ]);
                });

                const shiftSurplus = Math.abs(shiftTotals.declared - shiftTotals.expected);

                body.push([
                    {
                        content: `Total Shift ${shift}`,
                        colSpan: 3,
                        styles: {
                            halign: "right",
                            fillColor: [245, 245, 245],
                            fontStyle: "bold"
                        }
                    },
                    fmt2(shiftTotals.lane),
                    fmt2(shiftTotals.top),
                    fmt2(shiftTotals.expected),
                    fmt2(shiftTotals.declared),
                    fmt2(shiftSurplus),
                    fmt2(shiftTotals.banked)
                ]);

                body.push([
                    {
                        content: "",
                        colSpan: 9,
                        styles: {
                            lineWidth: 0,
                            minCellHeight: 6
                        }
                    }
                ]);
            });

            body.push([
                {
                    content: "Operational Day Total",
                    colSpan: 3,
                    styles: {
                        halign: "right",
                        fillColor: [27, 75, 114],
                        textColor: 255,
                        fontStyle: "bold"
                    }
                },
                fmt2(dayTotals.lane),
                fmt2(dayTotals.top),
                fmt2(dayTotals.expected),
                fmt2(dayTotals.declared),
                fmt2(Math.abs(dayTotals.expected - dayTotals.declared)),
                fmt2(dayTotals.banked)
            ]);

            return body;
        }

        /* =========================================================
           EXCEL BUILDERS
           ========================================================= */

        function buildExcelRows(rows) {
            const { groups, keys } = groupByShift(rows);
            const sheet = [];

            sheet.push([
                "Operational Day",
                "Operational Shift",
                "Toll Operator",
                "Lane Cash",
                "Top-ups",
                "Total Cash Expected",
                "Cash Declared",
                "Surplus / Shortage",
                "Total Banked"
            ]);

            const dayTotals = {
                lane: 0,
                top: 0,
                expected: 0,
                declared: 0,
                banked: 0
            };

            keys.forEach(shift => {
                const shiftRows = groups[shift] || [];
                const shiftTotals = computeTotals(shiftRows);

                dayTotals.lane += shiftTotals.lane;
                dayTotals.top += shiftTotals.top;
                dayTotals.expected += shiftTotals.expected;
                dayTotals.declared += shiftTotals.declared;
                dayTotals.banked += shiftTotals.banked;

                sheet.push([`SHIFT: ${shift}`, "", "", "", "", "", "", "", ""]);

                shiftRows.forEach(r => {
                    const expected = toNum(r.NettAmount) + toNum(r.ActualAmount);
                    const declared = toNum(r.TotalDeclared);
                    const surplus = Math.abs(declared - expected);
                    const banked = declared;

                    sheet.push([
                        safeDateText(r.ShiftDate),
                        r.ShiftDescription || "",
                        r.TollOperator || "",
                        fmt2(r.NettAmount),
                        fmt2(r.ActualAmount),
                        fmt2(expected),
                        fmt2(declared),
                        fmt2(surplus),
                        fmt2(banked)
                    ]);
                });

                const shiftSurplus = Math.abs(shiftTotals.declared - shiftTotals.expected);

                sheet.push([
                    `Total Shift ${shift}`,
                    "",
                    "",
                    fmt2(shiftTotals.lane),
                    fmt2(shiftTotals.top),
                    fmt2(shiftTotals.expected),
                    fmt2(shiftTotals.declared),
                    fmt2(shiftSurplus),
                    fmt2(shiftTotals.banked)
                ]);

                sheet.push(["", "", "", "", "", "", "", "", ""]);
            });

            sheet.push([
                "Operational Day Total",
                "",
                "",
                fmt2(dayTotals.lane),
                fmt2(dayTotals.top),
                fmt2(dayTotals.expected),
                fmt2(dayTotals.declared),
                fmt2(Math.abs(dayTotals.expected - dayTotals.declared)),
                fmt2(dayTotals.banked)
            ]);

            return sheet;
        }

        function buildExcelWorkbook(rows, meta) {
            const wb = XLSX.utils.book_new();

            const aoa = [
                [meta.company],
                [meta.bridge],
                [meta.title],
                [],
                ["Filters Used:"],
                [`Start Date: ${meta.startDate}`],
                [`End Date: ${meta.endDate}`],
                [`Shift: ${meta.shift}`],
                [`Operator: ${meta.operator}`],
                []
            ];

            const tableRows = buildExcelRows(rows);
            const ws = XLSX.utils.aoa_to_sheet(aoa);

            XLSX.utils.sheet_add_aoa(ws, tableRows, { origin: `A${aoa.length + 1}` });

            ws["!cols"] = [
                { wch: 18 },
                { wch: 18 },
                { wch: 18 },
                { wch: 14 },
                { wch: 14 },
                { wch: 18 },
                { wch: 16 },
                { wch: 18 },
                { wch: 14 }
            ];

            ws["!margins"] = {
                left: 0.3,
                right: 0.3,
                top: 0.6,
                bottom: 0.6,
                header: 0.3,
                footer: 0.4
            };

            ws["!pageSetup"] = {
                orientation: "landscape",
                paperSize: 9,
                fitToWidth: 1,
                fitToHeight: 0
            };

            ws["!printHeader"] =
                `&C&16&"Arial,Bold"${meta.company}\n` +
                `&C&12&"Arial,Bold"${meta.bridge}\n` +
                `&C&14&"Arial,Bold"${meta.title}`;

            ws["!printFooter"] =
                `&L${meta.title} (Report name)` +
                `&CDate and Time: ${meta.generatedAt}` +
                `&RUser ID: ${meta.userId}    Page &P of &N\n` +
                `&LReports Module Version Number: ${meta.version}`;

            wb.Workbook = wb.Workbook || {};
            wb.Workbook.Views = [{ RTL: false }];

            XLSX.utils.book_append_sheet(wb, ws, "Daily Cashup Report");
            return wb;
        }

        /* =========================================================
           DATA SOURCE
           ========================================================= */

        const rawDailyCashup = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Items ?? new List<MIS.Web.Models.DailyCashup.DailyCashupModel>()
        ));

        /* =========================================================
           PDF EXPORT
           ========================================================= */

        document.getElementById("btnExportPDF")?.addEventListener("click", async function () {
            if (!rawDailyCashup || !rawDailyCashup.length) {
                alert("No data to export.");
                return;
            }

            const meta = getExportMeta();
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF({
                orientation: "landscape",
                unit: "pt",
                format: "a4"
            });

            const pageWidth = doc.internal.pageSize.getWidth();
            const margin = 40;

            const [leftLogo, rightLogo] = await Promise.all([
                loadImage(meta.leftLogo),
                loadImage(meta.rightLogo)
            ]);

            drawPdfHeader(doc, pageWidth, margin, meta, leftLogo, rightLogo);
            const startY = drawPdfFilters(doc, margin, 110, meta);

            doc.autoTable({
                head: [[
                    "Operational Day",
                    "Operational Shift",
                    "Toll Operator",
                    "Lane Cash",
                    "Top-ups",
                    "Total Cash Expected",
                    "Cash Declared",
                    "Surplus / Shortage",
                    "Total Banked"
                ]],
                body: buildPdfBody(rawDailyCashup),
                startY: startY,
                theme: "grid",
                styles: {
                    fontSize: 8,
                    cellPadding: 4,
                    overflow: "linebreak",
                    valign: "middle",
                    halign: "center"
                },
                headStyles: {
                    fillColor: [41, 128, 185],
                    textColor: 255,
                    fontStyle: "bold"
                },
                margin: {
                    top: 40,
                    right: margin,
                    bottom: 46,
                    left: margin
                },
                didDrawPage: function (data) {
                    if (data.pageNumber > 1) {
                        drawPdfHeader(doc, pageWidth, margin, meta, leftLogo, rightLogo);
                    }
                }
            });

            addPdfFooters(doc, meta);
            doc.save(`Daily_Cashup_Report_${fileStamp()}.pdf`);
        });

        /* =========================================================
           EXCEL EXPORT
           ========================================================= */

        document.getElementById("btnExportExcel")?.addEventListener("click", function () {
            if (!rawDailyCashup || !rawDailyCashup.length) {
                alert("No data to export.");
                return;
            }

            const meta = getExportMeta();
            const wb = buildExcelWorkbook(rawDailyCashup, meta);
            XLSX.writeFile(wb, `Daily_Cashup_Report_${fileStamp()}.xlsx`);
        });
    </script>
}
}