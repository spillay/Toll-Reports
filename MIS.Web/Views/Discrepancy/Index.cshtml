@model MIS.Web.Models.Discrepancy.PageDiscrepancyModel
@using System.Linq
@using Microsoft.AspNetCore.Http
@using System.Text.Json
@removeTagHelper "Microsoft.AspNetCore.Mvc.TagHelpers.OptionTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers"

@{
    ViewData["Title"] = "Discrepancy Report";

    var reportGeneratedAt = DateTime.Now;
    var currentUser = User.Identity?.Name ?? "Lucky";
    var reportVersion = "3.0.0.0";
    var filters = Model.Filters;

    // ============================
    // Pagination
    // ============================
    int maxPagesToShow = 3;
    int startPage = Math.Max(1, Model.page - 1);
    int endPage = Math.Min(Model.totalPages, startPage + maxPagesToShow - 1);

    if (endPage - startPage + 1 < maxPagesToShow && startPage > 1)
        startPage = Math.Max(1, endPage - maxPagesToShow + 1);

    Func<int, string> PageUrl = (p) =>
    {
        var q = new Dictionary<string, string?>
        {
            ["Filters.StartDate"] = filters.StartDate.ToString("s"),
            ["Filters.EndDate"] = filters.EndDate.ToString("s"),
            ["Filters.toll_Operator_ID"] = filters.toll_Operator_ID,
            ["Filters.Shift"] = filters.Shift,
            ["Filters.PaymentMethod"] = filters.PaymentMethod,
            ["Filters.TakenAction"] = filters.TakenAction,
            ["Filters.lane_Nr"] = filters.lane_Nr,
            ["page"] = p.ToString(),
            ["pageSize"] = Model.pageSize.ToString()
        };
        return Url.Action("Index", "Discrepancy") + QueryString.Create(q);
    };

    // ============================
    // PAGE TOTALS (current grid page)
    // ============================
    var pageCount = Model.Items.Count;
    var pageTariffSum = Model.Items.Sum(d => d.Tariff);
    var pageUpdatedTariffSum = Model.Items.Sum(d => d.Updated_Tariff);
    var pageDifferenceSum = Model.Items.Sum(d => d.Updated_Tariff - d.Tariff);

    // ============================
    // SUMMARY TOTALS (based on page data in this view)
    // NOTE: exports will recompute these using the full export data set.
    // ============================
    var full = Model.Items;

    int summaryCount = full.Count;
    decimal summaryDiff = full.Sum(d => d.Updated_Tariff - d.Tariff);
    int operatorCorrect = full.Count(d => d.TakenAction == "Operator Correct");
    int avcCorrect = full.Count(d => d.TakenAction == "AVC Correct");
    int bothIncorrect = full.Count(d => d.TakenAction == "Both Incorrect");
}

<div class="card shadow-lg mb-4">
    <div class="card-body">

        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
            <h2 class="mb-0 fw-bold text-primary text-center w-100">DISCREPANCY REPORT</h2>
        </div>

        <!-- EXPORT BUTTONS -->
        <div class="row mb-3">
            <div class="col-md-2 d-flex align-items-end me-2">
                <button id="btnDownloadPdf" type="button" class="btn btn-danger w-100 shadow-sm">
                    <i class="bi bi-file-earmark-pdf"></i> Export PDF
                </button>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button id="btnDownloadExcel" type="button" class="btn btn-success w-100 shadow-sm">
                    <i class="bi bi-file-earmark-excel"></i> Export Excel
                </button>
            </div>
        </div>

        <!-- FILTER FORM -->
        <form method="get" asp-controller="Discrepancy" asp-action="Index" class="row g-3 mb-3">

            <div class="col-md-2">
                <label class="form-label fw-semibold">Start Date And Time</label>
                <input type="datetime-local"
                       class="form-control"
                       name="Filters.StartDate"
                       value="@filters.StartDate.ToString("yyyy-MM-ddTHH:mm")" />
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">End Date And Time</label>
                <input type="datetime-local"
                       class="form-control"
                       name="Filters.EndDate"
                       value="@filters.EndDate.ToString("yyyy-MM-ddTHH:mm")" />
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Toll Operator ID</label>
                <select class="form-select" name="Filters.toll_Operator_ID">
                    <option value="">All</option>
                    @foreach (var op in ViewBag.TollOperators as List<string> ?? new())
                    {
                        <option value="@op" @(filters.toll_Operator_ID == op ? "selected" : "")>@op</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Operational Shift</label>
                <select class="form-select" name="Filters.Shift">
                    <option value="">All</option>
                    @foreach (var s in ViewBag.Shifts as List<string> ?? new())
                    {
                        <option value="@s" @(filters.Shift == s ? "selected" : "")>@s</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Method of Payment</label>
                <select class="form-select" name="Filters.PaymentMethod">
                    <option value="">All</option>
                    @foreach (var p in ViewBag.PaymentMethods as List<string> ?? new())
                    {
                        <option value="@p" @(filters.PaymentMethod == p ? "selected" : "")>@p</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Lane</label>
                <select class="form-select" name="Filters.lane_Nr">
                    <option value="">All</option>
                    @foreach (var lane in ViewBag.Lanes as List<string> ?? new())
                    {
                        <option value="@lane" @(filters.lane_Nr == lane ? "selected" : "")>@lane</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Action Taken</label>
                <select class="form-select" name="Filters.TakenAction">
                    <option value="">All</option>
                    @foreach (var a in ViewBag.TakenActions as List<string> ?? new())
                    {
                        <option value="@a" @(filters.TakenAction == a ? "selected" : "")>@a</option>
                    }
                </select>
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    Apply Filters
                </button>
            </div>

        </form>


        <!-- TABLE -->
        @if (Model.Items != null && Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered text-center align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Lane Number</th>
                            <th>Transaction Sequence Number</th>
                            <th>Transaction Date</th>
                            <th>Transaction Time</th>
                            <th>Operational Shift</th>
                            <th>Toll Operator ID</th>
                            <th>Method Of Payment</th>
                            <th>Toll Collector Class</th>
                            <th>AVC Class</th>
                            <th>Final Class</th>
                            <th>Tariff</th>
                            <th>Updated Tariff</th>
                            <th>Tariff Difference</th>
                            <th>Action Taken</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Items)
                        {
                            var diff = d.Updated_Tariff - d.Tariff;

                            <tr>
                                <td>@d.Lane_Nr</td>
                                <td>@d.Trx_Sequence_Nr</td>
                                <td>@d.Trx_Date</td>
                                <td>@d.Trx_Time</td>
                                <td>@d.Operational_Shift</td>
                                <td>@d.Toll_Operator_ID</td>
                                <td>@d.Method_of_Payment</td>
                                <td>@d.Toll_Collector_Class</td>
                                <td>@d.AVC_Class</td>
                                <td>@d.Final_Class</td>
                                <td>@d.Tariff.ToString("N2")</td>
                                <td>@d.Updated_Tariff.ToString("N2")</td>
                                <td>@diff.ToString("N2")</td>
                                <td>@d.TakenAction</td>
                            </tr>
                        }

                        <!-- PAGE TOTAL ROW -->
                        <tr class="fw-bold table-secondary">
                            <td colspan="10" class="text-end">Page Totals:</td>
                            <td>@pageTariffSum.ToString("N2")</td>
                            <td>@pageUpdatedTariffSum.ToString("N2")</td>
                            <td>@pageDifferenceSum.ToString("N2")</td>
                            <td>@pageCount</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- PAGINATION + TOTALS -->
            <div class="mt-4 d-flex flex-column flex-md-row justify-content-between align-items-center border-top pt-3">

                <!-- Totals -->
                <div class="mb-3 mb-md-0">
                    <h6>Total Discrepancy Count: <strong>@summaryCount</strong></h6>
                    <h6>Total Tariff Difference: <strong>@summaryDiff.ToString("N2")</strong></h6>
                </div>

                <!-- Pagination -->
                <nav>
                    <ul class="pagination">

                        <!-- Previous -->
                        <li class="page-item @(Model.page <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@(Model.page <= 1 ? "#" : PageUrl(Model.page - 1))">
                                &laquo; Previous
                            </a>
                        </li>

                        <li class="page-item disabled">
                            <a class="page-link bg-light text-dark">
                                Page <strong>@Model.page</strong> of <strong>@Model.totalPages</strong>
                            </a>
                        </li>

                        <!-- Next -->
                        <li class="page-item @(Model.page >= Model.totalPages ? "disabled" : "")">
                            <a class="page-link" href="@(Model.page >= Model.totalPages ? "#" : PageUrl(Model.page + 1))">
                                Next &raquo;
                            </a>
                        </li>

                    </ul>
                </nav>

            </div>

            <!-- SUMMARY TABLE -->
            <div class="mt-4 w-50">
                <table class="">
                    <tbody>
                        <tr>
                            <td><strong>Total Discrepancy Count</strong></td>
                            <td>@summaryCount</td>
                        </tr>
                        <tr>
                            <td><strong>Total Tariff Difference</strong></td>
                            <td>@summaryDiff.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td><strong>Operator Correct</strong></td>
                            <td>@operatorCorrect</td>
                        </tr>
                        <tr>
                            <td><strong>AVC Correct</strong></td>
                            <td>@avcCorrect</td>
                        </tr>
                        <tr>
                            <td><strong>Both Incorrect</strong></td>
                            <td>@bothIncorrect</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- FOOTER -->
            <div class="mt-4 p-3 border-top">
                <table class="table table-borderless w-100 mb-0 align-middle">
                    <tr>
                        <td class="fw-bold text-dark">@ViewData["Title"]</td>
                        <td><strong>Date and Time:</strong> @reportGeneratedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td><strong>User ID:</strong> @currentUser</td>
                        <td class="text-end">Page <strong>@Model.page</strong> of <strong>@Model.totalPages</strong></td>
                    </tr>
                    <tr>
                        <td colspan="4">
                            <small class="text-muted">
                                Reports Module Version:
                                <strong>@reportVersion</strong>
                            </small>
                        </td>
                    </tr>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-warning text-center mt-4">
                No discrepancy records found for the selected filters.
            </div>
        }
    </div>
</div>


<!-- ====== PDF & Excel Export Scripts ====== -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", () => {

        /* ============================================================
         * 1. FULL NON-PAGINATED EXPORT DATA (From Controller)
         * ============================================================ */
        const exportData = @Html.Raw(JsonSerializer.Serialize(
                        Model.ExportItems ?? new List<MIS.Web.Models.Discrepancy.DiscrepancyModel>()
                ));

        const reportGeneratedAt = '@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")';
        const currentUser       = '@(User.Identity?.Name ?? "Lucky")';
        const reportVersion     = "2.0.0.11";

        const filterText = {
            "Start Date":     '@Model.Filters.StartDate.ToString("dd/MM/yyyy HH:mm")',
            "End Date":       '@Model.Filters.EndDate.ToString("dd/MM/yyyy HH:mm")',
            "Toll Operator":  '@(Model.Filters.toll_Operator_ID ?? "All")',
            "Shift":          '@(Model.Filters.Shift ?? "All")',
            "Payment Method": '@(Model.Filters.PaymentMethod ?? "All")',
            "Lane":           '@(Model.Filters.lane_Nr ?? "All")',
            "Action Taken":   '@(Model.Filters.TakenAction ?? "All")'
        };



        /* ============================================================
         * 2. PDF EXPORT — FULL CORPORATE DESIGN (LCC + ICT WORKS)
         * ============================================================ */
        document.getElementById("btnDownloadPdf").addEventListener("click", async () => {

            if (!exportData.length) {
                alert("No data available to export.");
                return;
            }

            const { jsPDF } = window.jspdf;
            const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "a4" });

            const pageWidth  = doc.internal.pageSize.getWidth();
            const pageHeight = doc.internal.pageSize.getHeight();
            const margin     = 50;



            /* --------------------------
               Load LCC + ICT Logos
            -------------------------- */
            const loadImage = (src) => new Promise((resolve) => {
                const img = new Image();
                img.crossOrigin = "Anonymous";
                img.onload = () => resolve(img);
                img.onerror = () => resolve(null);
                img.src = src;
            });

            const [logoLeft, logoRight] = await Promise.all([
                loadImage("/images/lCC Logo.jpg"),
                loadImage("/images/ICT-Works Logo.jpg")
            ]);

            if (logoLeft)  doc.addImage(logoLeft,  "JPEG", margin,               25, 80, 80);
            if (logoRight) doc.addImage(logoRight, "JPEG", pageWidth - margin - 80, 25, 80, 80);



            /* --------------------------
               Header Section
            -------------------------- */
            doc.setFont("helvetica", "bold");
            doc.setFontSize(18);
            doc.text("LEKKI CONCESSION COMPANY LIMITED", pageWidth / 2, 60, { align: "center" });

            doc.setFontSize(14);
            doc.text("CONSERVATION TOLL PLAZA", pageWidth / 2, 85, { align: "center" });

            doc.setFontSize(13);
            doc.text("DISCREPANCY REPORT", pageWidth / 2, 110, { align: "center" });



            /* --------------------------
               Filters Section
            -------------------------- */
            let y = 145;

            doc.setFont("helvetica", "bold");
            doc.setFontSize(11);
            doc.text("FILTERS USED:", margin, y);
            y += 15;

            doc.setFont("helvetica", "normal");
            doc.setFontSize(10);

            for (const [label, value] of Object.entries(filterText)) {
                doc.text(`${label}: ${value}`, margin, y);
                y += 12;
            }



            /* --------------------------
               Table Content
            -------------------------- */
            const tableHeaders = [
                "Lane Number", "Transaction Sequence Number", "Transaction Date", "Transaction Time", "Operational Shift", "Toll Operator",
                "Method of Payment", "Toll Collector Class", "AVC Class", "Final Class",
                "Tariff", "Updated Tariff", "Tariff Difference", "Action Taken"
            ];

            const tableRows = exportData.map(d => [
                d.Lane_Nr ?? "",
                d.Trx_Sequence_Nr ?? "",
                d.Trx_Date ?? "",
                d.Trx_Time ?? "",
                d.Operational_Shift ?? "",
                d.Toll_Operator_ID ?? "",
                d.Method_of_Payment ?? "",
                d.Toll_Collector_Class ?? "",
                d.AVC_Class ?? "",
                d.Final_Class ?? "",
                (d.Tariff ?? 0).toFixed(2),
                (d.Updated_Tariff ?? 0).toFixed(2),
                ((d.Updated_Tariff ?? 0) - (d.Tariff ?? 0)).toFixed(2),
                d.TakenAction ?? ""
            ]);



            /* --------------------------
               Footer on EVERY PAGE
            -------------------------- */
            function drawFooter(doc) {

                const pageCount = doc.internal.getNumberOfPages();
                const footerY = pageHeight - 30;

                for (let i = 1; i <= pageCount; i++) {
                    doc.setPage(i);

                    doc.setFont("helvetica", "normal");
                    doc.setFontSize(10);

                    doc.text("Discrepancy Report", margin, footerY);
                    doc.text(`Date: ${reportGeneratedAt}`, pageWidth / 2.5, footerY);
                    doc.text(`User: ${currentUser}`, pageWidth / 1.5, footerY);
                    doc.text(`Page ${i} of ${pageCount}`, pageWidth - margin, footerY, { align: "right" });

                    doc.setFontSize(9);
                    doc.text(`Reports Module Version: ${reportVersion}`, margin, footerY + 12);
                }
            }



            /* --------------------------
               Draw Table
            -------------------------- */
            doc.autoTable({
                startY: y + 10,
                head: [tableHeaders],
                body: tableRows,
                theme: "grid",
                margin: { left: margin, right: margin },
                styles: { fontSize: 9, halign: "center" },
                headStyles: { fillColor: [41, 128, 185], textColor: 255 }
            });



            /* --------------------------
               Summary Section (LAST page)
            -------------------------- */
               const finalY = doc.lastAutoTable.finalY + 10;

            const summary = {
                totalCount: exportData.length,
                totalDiff: exportData.reduce((t, d) =>
                    t + (((d.Updated_Tariff ?? 0) - (d.Tariff ?? 0))), 0),
                operatorCorrect: exportData.filter(x => x.TakenAction === "Operator Correct").length,
                avcCorrect:      exportData.filter(x => x.TakenAction === "AVC Correct").length,
                bothIncorrect:   exportData.filter(x => x.TakenAction === "Both Incorrect").length
            };

            doc.setFont("helvetica", "bold");
            doc.setFontSize(11);

            const line1 =
                `Total Count: ${summary.totalCount}     ` +
                `Total Difference: ${summary.totalDiff.toFixed(2)}`;

            doc.text(line1, margin, finalY);

            const line2 =
                `Operator Correct: ${summary.operatorCorrect}     ` +
                `AVC Correct: ${summary.avcCorrect}     ` +
                `Both Incorrect: ${summary.bothIncorrect}`;

            doc.text(line2, margin, finalY + 20);

            drawFooter(doc);


            doc.save(`Discrepancy_Report_${new Date().toISOString().replace(/[:.]/g, '-')}.pdf`);
        });




        /* ============================================================
         * 3. EXCEL EXPORT — FULL SUMMARY
         * ============================================================ */
        document.getElementById("btnDownloadExcel").addEventListener("click", () => {

            if (!exportData.length) {
                alert("No data available to export.");
                return;
            }

             const headers = [
                "Lane Number", "Transaction Sequence Number", "Transaction Date", "Transaction Time", "Operational Shift", "Toll Operator",
                "Method of Payment", "Toll Collector Class", "AVC Class", "Final Class",
                "Tariff", "Updated Tariff", "Tariff Difference", "Action Taken"
            ];

            const rows = exportData.map(d => [
                d.Lane_Nr,
                d.Trx_Sequence_Nr,
                d.Trx_Date,
                d.Trx_Time,
                d.Operational_Shift,
                d.Toll_Operator_ID,
                d.Method_of_Payment,
                d.Toll_Collector_Class,
                d.AVC_Class,
                d.Final_Class,
                Number(d.Tariff ?? 0),
                Number(d.Updated_Tariff ?? 0),
                Number((d.Updated_Tariff ?? 0) - (d.Tariff ?? 0)),
                d.TakenAction
            ]);

            const summaryRows = [
                [],
                ["Total Discrepancy Count", exportData.length],
                ["Total Tariff Difference", exportData.reduce((t, d) =>
                    t + (((d.Updated_Tariff ?? 0) - (d.Tariff ?? 0))), 0)],
                ["Operator Correct", exportData.filter(x => x.TakenAction === "Operator Correct").length],
                ["AVC Correct",      exportData.filter(x => x.TakenAction === "AVC Correct").length],
                ["Both Incorrect",   exportData.filter(x => x.TakenAction === "Both Incorrect").length]
            ];

            const ws = XLSX.utils.aoa_to_sheet([headers, ...rows, ...summaryRows]);
            ws["!cols"] = Array(headers.length).fill({ wch: 20 });

            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "Discrepancy Report");

            XLSX.writeFile(wb, `Discrepancy_Report_${new Date().toISOString().replace(/[:.]/g, '-')}.xlsx`);
        });

    });
</script>


