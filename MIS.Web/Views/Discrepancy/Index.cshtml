@model MIS.Web.Models.Discrepancy.PageDiscrepancyModel
@using System.Linq
@using Microsoft.AspNetCore.Http
@using System.Text.Json
@using MIS.Web.Models.Discrepancy
@using System.Globalization
@removeTagHelper "Microsoft.AspNetCore.Mvc.TagHelpers.OptionTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers"

@{
    var reportVersion   = "3.0.0.0";
    var currentUserId = User.FindFirst("firstName")?.Value ?? "Unknown User";
    var reportGenerated = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");

    var filters = Model.Filters ?? new DiscrepancyInputModel();

    var items = Model.Items ?? new List<DiscrepancyModel>();

    // Prefer ExportItems for totals/summary (full dataset), else fallback to items
    var summarySource = (Model.ExportItems != null && Model.ExportItems.Any())
        ? Model.ExportItems
        : items;

    var summaryCount = summarySource.Count;

    var totalDifference = summarySource.Sum(x => x.TariffDifference);

    var operatorCorrect = summarySource.Count(x => string.Equals(x.TakenAction, "AVC Error", StringComparison.OrdinalIgnoreCase));
    var avcCorrect      = summarySource.Count(x => string.Equals(x.TakenAction, "Toll Collector Error", StringComparison.OrdinalIgnoreCase));
    var bothIncorrect   = summarySource.Count(x => string.Equals(x.TakenAction, "Both Incorrect", StringComparison.OrdinalIgnoreCase));

    // Helpers for checkbox checked state (case-insensitive)
    bool IsChecked(List<string> selected, string value)
        => selected?.Any(x => string.Equals(x?.Trim(), value?.Trim(), StringComparison.OrdinalIgnoreCase)) == true;
}

<style>
    /* Print: push summary onto its own last page */
   

    .filter-box {
        border: 1px solid #e5e5e5;
        border-radius: 10px;
        padding: 10px 12px;
        max-height: 180px;
        overflow: auto;
        background: #fff;
    }

    .filter-box .form-check {
        margin-bottom: 6px;
    }

    .filter-box .form-check-label {
        cursor: pointer;
    }
</style>

<div class="card shadow-lg mb-4">
    <div class="card-body">

        <!-- ====== HEADER ====== -->
        <div class="text-center mb-3 border-bottom pb-2">
            <h2 class="fw-bold text-primary mb-0">DISCREPANCY REPORT</h2>
        </div>

        <!-- ====== EXPORT BUTTONS ====== -->
        <div class="row mb-3 no-print">
            <div class="col-md-2 me-2">
                <button id="btnDownloadPdf" class="btn btn-danger w-100 shadow-sm" type="button">
                    <i class="bi bi-file-earmark-pdf"></i> Export PDF
                </button>
            </div>

            <div class="col-md-2">
                <button id="btnDownloadExcel" class="btn btn-success w-100 shadow-sm" type="button">
                    <i class="bi bi-file-earmark-excel"></i> Export Excel
                </button>
            </div>
        </div>

        <!-- ====== FILTERS (CHECKLISTS) ====== -->
        <form method="get"
              asp-controller="Discrepancy"
              asp-action="Index"
              id="filterForm"
              class="mb-4 no-print">

            <div class="row g-3">

                <!-- Start Date -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Start Date & Time</label>
                    <input type="datetime-local"
                           name="Filters.StartDate"
                           class="form-control"
                           value="@(filters.StartDate.ToString("yyyy-MM-ddTHH:mm"))" />
                </div>

                <!-- End Date -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold">End Date & Time</label>
                    <input type="datetime-local"
                           name="Filters.EndDate"
                           class="form-control"
                           value="@(filters.EndDate.ToString("yyyy-MM-ddTHH:mm"))" />
                </div>

                <!-- Shift checklist -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Operational Shift</label>
                    <div class="filter-box">
                        @foreach (var shift in filters.Shifts ?? new List<string>())
                        {
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="Filters.SelectedShifts"
                                       value="@shift"
                                       @(IsChecked(filters.SelectedShifts, shift) ? "checked" : "") />
                                <label class="form-check-label">@shift</label>
                            </div>
                        }
                    </div>
                </div>

                <!-- Operator checklist -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Toll Operator ID</label>
                    <div class="filter-box">
                        @foreach (var op in filters.TollOperators ?? new List<string>())
                        {
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="Filters.SelectedTollOperators"
                                       value="@op"
                                       @(IsChecked(filters.SelectedTollOperators, op) ? "checked" : "") />
                                <label class="form-check-label">@op</label>
                            </div>
                        }
                    </div>
                </div>

                <!-- Lane checklist -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Lane</label>
                    <div class="filter-box">
                        @foreach (var lane in filters.Lanes ?? new List<string>())
                        {
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="Filters.SelectedLanes"
                                       value="@lane"
                                       @(IsChecked(filters.SelectedLanes, lane) ? "checked" : "") />
                                <label class="form-check-label">@lane</label>
                            </div>
                        }
                    </div>
                </div>

                <!-- Payment checklist -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Method of Payment</label>
                    <div class="filter-box">
                        @foreach (var pm in filters.PaymentMethods ?? new List<string>())
                        {
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="Filters.SelectedPaymentMethods"
                                       value="@pm"
                                       @(IsChecked(filters.SelectedPaymentMethods, pm) ? "checked" : "") />
                                <label class="form-check-label">@pm</label>
                            </div>
                        }
                    </div>
                </div>

                <!-- Taken Action checklist -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Taken Action</label>
                    <div class="filter-box">
                        @foreach (var act in filters.TakenActions ?? new List<string>())
                        {
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="Filters.SelectedTakenActions"
                                       value="@act"
                                       @(IsChecked(filters.SelectedTakenActions, act) ? "checked" : "") />
                                <label class="form-check-label">@act</label>
                            </div>
                        }
                    </div>
                </div>

                <!-- Apply -->
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        Apply Filters
                    </button>
                </div>
            </div>

            <!-- Reset to page 1 when applying filters -->
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="pageSize" value="@Model.pageSize" />
        </form>

        <!-- ====== TABLE ====== -->
        <div class="table-responsive mt-3">
            <table class="table table-striped table-bordered align-middle text-center">
                <thead class="table-light">
                    <tr>
                        <th>Lane</th>
                        <th>Sequence</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Shift</th>
                        <th>Operator</th>
                        <th>Payment</th>
                        <th>Toll Collector</th>
                        <th>AVC</th>
                        <th>Updated Tariff</th>
                        <th>Tariff</th>
                        <th>Final Class</th>
                        <th>Difference</th>
                        <th>Taken Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if (items.Any())
                    {
                        foreach (var t in items)
                        {
                            var hideClasses =
                                string.Equals((t.Toll_Collector_Class ?? "").Trim(),
                                              (t.AVC_Class ?? "").Trim(),
                                              StringComparison.OrdinalIgnoreCase);

                            <tr>
                                <td>@t.Lane_Nr</td>
                                <td>@t.Trx_Sequence_Nr</td>
                                <td>@t.Trx_Date</td>
                                <td>@t.Trx_Time</td>
                                <td>@t.Operational_Shift</td>
                                <td>@t.Toll_Operator_ID</td>
                                <td>@t.Method_of_Payment</td>
                                <td>@(hideClasses ? "" : t.Toll_Collector_Class)</td>
                                <td>@(hideClasses ? "" : t.AVC_Class)</td>
                                <td>@t.Updated_Tariff.ToString("N2")</td>
                                <td>@t.Tariff.ToString("N2")</td>
                                <td>@t.Final_Class</td>
                                <td>@t.TariffDifference.ToString("N2")</td>
                                <td>@t.TakenAction</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="14" class="py-3 text-muted">
                                No data available for the selected filters.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- ====== PAGINATION ====== -->
        @if (Model.totalPages > 1)
        {
            int startPage = Math.Max(1, Model.page - 1);
            int endPage   = Math.Min(Model.totalPages, Model.page + 1);

            <div class="mt-4 d-flex flex-column flex-md-row justify-content-between align-items-center border-top pt-3 no-print">

                <!-- Totals -->
                <div class="mb-2 mb-md-0">
                    <h6>Total Records: <strong>@Model.totalCount</strong></h6>
                    <h6>Total Difference: <strong>@totalDifference.ToString("N2")</strong></h6>
                </div>

                <nav>
                    <ul class="pagination">

                        <!-- Prev -->
                        <li class="page-item @(Model.page <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               href="@($"{Url.Action("Index","Discrepancy")}?{BuildQueryString(filters, Model.page - 1, Model.pageSize)}")">
                                Previous
                            </a>
                        </li>

                        <!-- Page Numbers -->
                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == Model.page ? "active" : "")">
                                <a class="page-link"
                                   href="@($"{Url.Action("Index","Discrepancy")}?{BuildQueryString(filters, i, Model.pageSize)}")">
                                    @i
                                </a>
                            </li>
                        }

                        <!-- Next -->
                        <li class="page-item @(Model.page >= Model.totalPages ? "disabled" : "")">
                            <a class="page-link"
                               href="@($"{Url.Action("Index","Discrepancy")}?{BuildQueryString(filters, Model.page + 1, Model.pageSize)}")">
                                Next
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }

        <!-- ====== FOOTER ====== -->
        <div class="mt-4 border-top pt-3">
            <table class="table table-borderless mb-0">
                <tr>
                    <td><strong>Discrepancy Report</strong></td>
                    <td><strong>Date And Time:</strong> @reportGenerated</td>
                    <td><strong>User:</strong> @currentUserId</td>
                    <td class="text-end">Page <strong>@Model.page</strong> of <strong>@(Model.totalPages == 0 ? 1 : Model.totalPages)</strong></td>
                </tr>
                <tr>
                    <td colspan="4">
                        <small class="text-muted">Reports Module Version Number: <strong>@reportVersion</strong></small>
                    </td>
                </tr>
            </table>
        </div>

        <!-- ====== SUMMARY (LAST PAGE WHEN PRINTING) ====== -->
        <div class="print-page-break"></div>

        @if (Model.totalPages <= 1 || Model.page == Model.totalPages)
        {
            <div class="card mt-4 border">
                <div class="card-body">
                <h5 class="mb-3 fw-bold">Summary</h5>

                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="small text-muted">Total Count</div>
                        <div class="fw-bold">@summaryCount</div>
                    </div>

                    <div class="col-md-3">
                        <div class="small text-muted">Total Difference</div>
                        <div class="fw-bold">@totalDifference.ToString("N2")</div>
                    </div>

                    <div class="col-md-2">
                        <div class="small text-muted">Operator Correct</div>
                        <div class="fw-bold">@operatorCorrect</div>
                    </div>

                    <div class="col-md-2">
                        <div class="small text-muted">AVC Correct</div>
                        <div class="fw-bold">@avcCorrect</div>
                    </div>

                    <div class="col-md-2">
                        <div class="small text-muted">Both Incorrect</div>
                        <div class="fw-bold">@bothIncorrect</div>
                    </div>
                </div>
            </div>
        </div>
        }
    </div>
</div>

@functions {

    private string BuildQueryString(DiscrepancyInputModel f, int page, int pageSize)
    {
        var q = new List<string>();

        // dates
        q.Add($"Filters.StartDate={Uri.EscapeDataString(f.StartDate.ToString("yyyy-MM-ddTHH:mm:ss"))}");
        q.Add($"Filters.EndDate={Uri.EscapeDataString(f.EndDate.ToString("yyyy-MM-ddTHH:mm:ss"))}");

        // paging
        q.Add($"page={page}");
        q.Add($"pageSize={pageSize}");

        // lists
        AddList(q, "Filters.SelectedShifts", f.SelectedShifts);
        AddList(q, "Filters.SelectedTollOperators", f.SelectedTollOperators);
        AddList(q, "Filters.SelectedLanes", f.SelectedLanes);
        AddList(q, "Filters.SelectedPaymentMethods", f.SelectedPaymentMethods);
        AddList(q, "Filters.SelectedTakenActions", f.SelectedTakenActions);

        return string.Join("&", q);
    }

    private void AddList(List<string> q, string key, List<string> list)
    {
        if (list == null || list.Count == 0) return;

        foreach (var v in list.Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x.Trim()))
        {
            q.Add($"{key}={Uri.EscapeDataString(v)}");
        }
    }
}

<!-- EXPORT LIBS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>


<script>
    document.addEventListener("DOMContentLoaded", () => {

        // ==========================
        // DATA + META
        // ==========================
        const data = @Html.Raw(JsonSerializer.Serialize(
                        Model.ExportItems ?? new List<MIS.Web.Models.Discrepancy.DiscrepancyModel>()
                ));

        const reportGeneratedAt = '@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")';

        // ✅ Safe user name (fallback avoids blank exports)
        const currentUserId = '@(User.FindFirst("firstName")?.Value ?? "Unknown User")';

        const reportVersion = "3.0.0.0";
        const reportNamePdf = "DISCREPANCY REPORT";
        const reportNameFooter = "Discrepancy Report";

        const fileStamp = () => new Date().toISOString().replace(/[:.]/g, "-");
        const hasData = () => Array.isArray(data) && data.length > 0;

        // ==========================
        // FILTERS (All collapsing)
        // ==========================
        const allShifts         = @Html.Raw(JsonSerializer.Serialize(Model.Filters?.Shifts ?? new List<string>()));
        const allOperators      = @Html.Raw(JsonSerializer.Serialize(Model.Filters?.TollOperators ?? new List<string>()));
        const allLanes          = @Html.Raw(JsonSerializer.Serialize(Model.Filters?.Lanes ?? new List<string>()));
        const allPaymentMethods = @Html.Raw(JsonSerializer.Serialize(Model.Filters?.PaymentMethods ?? new List<string>()));
        const allTakenActions   = @Html.Raw(JsonSerializer.Serialize(Model.Filters?.TakenActions ?? new List<string>()));

        const selectedShifts         = @Html.Raw(JsonSerializer.Serialize(Model.Filters?.SelectedShifts ?? new List<string>()));
        const selectedOperators      = @Html.Raw(JsonSerializer.Serialize(Model.Filters?.SelectedTollOperators ?? new List<string>()));
        const selectedLanes          = @Html.Raw(JsonSerializer.Serialize(Model.Filters?.SelectedLanes ?? new List<string>()));
        const selectedPaymentMethods = @Html.Raw(JsonSerializer.Serialize(Model.Filters?.SelectedPaymentMethods ?? new List<string>()));
        const selectedTakenActions   = @Html.Raw(JsonSerializer.Serialize(Model.Filters?.SelectedTakenActions ?? new List<string>()));

        function cleanList(arr) {
            if (!Array.isArray(arr)) return [];
            return arr
                .filter(x => x !== null && x !== undefined)
                .map(x => String(x).trim())
                .filter(x => x.length > 0);
        }

        // ✅ if none selected OR selected covers all => "All"
        function labelAll(selectedList, allList) {
            const selected = cleanList(selectedList);
            const all = cleanList(allList);

            if (selected.length === 0) return "All";
            if (all.length > 0 && selected.length >= all.length) return "All";

            return selected.join(", ");
        }

        const filtersUsed = {
            "Start Date": "@(Model.Filters?.StartDate.ToString("dd/MM/yyyy HH:mm") ?? "")",
            "End Date": "@(Model.Filters?.EndDate.ToString("dd/MM/yyyy HH:mm") ?? "")",
            "Shift": labelAll(selectedShifts, allShifts),
            "Toll Operator": labelAll(selectedOperators, allOperators),
            "Lane": labelAll(selectedLanes, allLanes),
            "Payment Method": labelAll(selectedPaymentMethods, allPaymentMethods),
            "Taken Action": labelAll(selectedTakenActions, allTakenActions)
        };

        // ==========================
        // HELPERS
        // ==========================
        const toNum = v => Number(v || 0);

        function safeStr(v) {
            return (v === null || v === undefined) ? "" : String(v);
        }

        function loadImage(src) {
            return new Promise(resolve => {
                const img = new Image();
                img.crossOrigin = "Anonymous";
                img.onload = () => resolve(img);
                img.onerror = () => resolve(null);
                img.src = src;
            });
        }

        // ✅ Landing-page style centered header
        // Returns the bottom Y position (so you can start filters below it)
        function drawCenteredHeader(doc, pageWidth, margin, leftLogo, rightLogo, reportTitle) {
            const topY = 25;

            if (leftLogo)  doc.addImage(leftLogo,  "JPEG", margin, topY, 80, 80);
            if (rightLogo) doc.addImage(rightLogo, "JPEG", pageWidth - margin - 80, topY, 80, 80);

            let y = 60;

            doc.setFont("helvetica", "bold");
            doc.setFontSize(14);
            doc.text("LEKKI CONCESSION COMPANY LIMITED", pageWidth / 2, y, { align: "center" });

            y += 18;
            doc.setFontSize(12);
            doc.text("LEKKI-IKOYI LINK BRIDGE", pageWidth / 2, y, { align: "center" });

            y += 26;
            doc.setFontSize(16);
            doc.text(reportTitle || "REPORT NAME", pageWidth / 2, y, { align: "center" });

            return y;
        }

        function drawFiltersBlock(doc, margin, startY, filters) {
            let y = startY;

            doc.setFont("helvetica", "normal");
            doc.setFontSize(10);

            doc.text("FILTERS USED:", margin, y);
            y += 14;

            Object.entries(filters).forEach(([k, v]) => {
                doc.text(`${k}: ${safeStr(v)}`, margin, y);
                y += 12;
            });

            return y;
        }

        function addSummaryPage(doc, margin, totalCount, totalDiff) {
            doc.addPage();

            const y0 = 100;
            doc.setFont("helvetica", "bold");
            doc.setFontSize(14);
            doc.text("SUMMARY", margin, y0);

            doc.setFont("helvetica", "normal");
            doc.setFontSize(11);
            doc.text(`Total Record Count: ${totalCount}`, margin, y0 + 25);
            doc.text(`Total Difference Value: ${totalDiff.toFixed(2)}`, margin, y0 + 45);
        }

        function addFooters(doc, pageWidth, pageHeight, margin) {
            const totalPages = doc.internal.getNumberOfPages();

            for (let i = 1; i <= totalPages; i++) {
                doc.setPage(i);

                const footerY = pageHeight - 30;

                doc.setFont("helvetica", "normal");
                doc.setFontSize(10);

                doc.text(reportNameFooter, margin, footerY);
                doc.text(`Date: ${reportGeneratedAt}`, pageWidth / 2.2, footerY);
                doc.text(`User: ${currentUserId}`, pageWidth / 1.5, footerY);
                doc.text(`Page ${i} of ${totalPages}`, pageWidth - margin, footerY, { align: "right" });

                doc.setFontSize(9);
                doc.text(`Reports Module Version Number: ${reportVersion}`, margin, footerY + 14);
            }
        }

        // ==========================
        // TABLE BUILDERS
        // ==========================
        const headers = [
            "Lane", "Sequence", "Date", "Time", "Shift", "Operator",
            "Payment", "Collector", "AVC", "Final", "Tariff", "Updated", "Diff", "Action"
        ];

        function buildRows(items) {
            return items.map(t => {
                const collector = safeStr(t.Toll_Collector_Class).trim();
                const avc       = safeStr(t.AVC_Class).trim();
                const hide      = collector.toLowerCase() === avc.toLowerCase();

                const tariff  = toNum(t.Tariff);
                const updated = toNum(t.Updated_Tariff);
                const diff    = updated - tariff;

                return [
                    safeStr(t.Lane_Nr),
                    safeStr(t.Trx_Sequence_Nr),
                    safeStr(t.Trx_Date),
                    safeStr(t.Trx_Time),
                    safeStr(t.Operational_Shift),
                    safeStr(t.Toll_Operator_ID),
                    safeStr(t.Method_of_Payment),
                    hide ? "" : collector,
                    hide ? "" : avc,
                    safeStr(t.Final_Class),
                    tariff.toFixed(2),
                    updated.toFixed(2),
                    diff.toFixed(2),
                    safeStr(t.TakenAction)
                ];
            });
        }

        // ==========================
        // PDF EXPORT
        // ==========================
        document.getElementById("btnDownloadPdf")?.addEventListener("click", async () => {

            if (!hasData()) {
                alert("No data available to export.");
                return;
            }

            if (!window.jspdf) {
                alert("jsPDF not loaded. Check layout scripts.");
                return;
            }

            const { jsPDF } = window.jspdf;
            const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "a4" });

            const pageWidth  = doc.internal.pageSize.getWidth();
            const pageHeight = doc.internal.pageSize.getHeight();
            const margin     = 50;

            // Load logos once
            const [leftLogo, rightLogo] = await Promise.all([
                loadImage("/images/lCC Logo.jpg"),
                loadImage("/images/ICT-Works Logo.jpg")
            ]);

            // ✅ Header (centered)
            const headerBottomY = drawCenteredHeader(doc, pageWidth, margin, leftLogo, rightLogo, reportNamePdf);

            // ✅ Filters
            const filtersBottomY = drawFiltersBlock(doc, margin, headerBottomY + 35, filtersUsed);

            // ✅ Table
            const rows = buildRows(data);

            doc.autoTable({
                head: [headers],
                body: rows,
                startY: filtersBottomY + 10,
                theme: "grid",
                styles: { fontSize: 9, halign: "center" },
                headStyles: { fillColor: [41, 128, 185], textColor: 255 }
            });

            // ✅ Summary page
            const totalCount = data.length;
            const totalDiff  = data.reduce((s, x) => s + (toNum(x.Updated_Tariff) - toNum(x.Tariff)), 0);
            addSummaryPage(doc, margin, totalCount, totalDiff);

            addFooters(doc, pageWidth, pageHeight, margin);

            doc.save(`Discrepancy_Report_${fileStamp()}.pdf`);
        });

        // ==========================
        // EXCEL EXPORT
        // ==========================
        document.getElementById("btnDownloadExcel")?.addEventListener("click", () => {

            if (!hasData()) {
                alert("No data available to export.");
                return;
            }

            if (!window.XLSX) {
                alert("XLSX not loaded. Check layout scripts.");
                return;
            }

            // Filters block
            const filterRows = [];
            filterRows.push(["FILTERS USED"]);
            Object.entries(filtersUsed).forEach(([k, v]) => filterRows.push([k, v]));
            filterRows.push([]);

            // Data rows (numeric cells kept numeric for Excel)
            const rows = data.map(t => {
                const collector = safeStr(t.Toll_Collector_Class).trim();
                const avc       = safeStr(t.AVC_Class).trim();
                const hide      = collector.toLowerCase() === avc.toLowerCase();

                const tariff  = toNum(t.Tariff);
                const updated = toNum(t.Updated_Tariff);
                const diff    = updated - tariff;

                return [
                    safeStr(t.Lane_Nr),
                    safeStr(t.Trx_Sequence_Nr),
                    safeStr(t.Trx_Date),
                    safeStr(t.Trx_Time),
                    safeStr(t.Operational_Shift),
                    safeStr(t.Toll_Operator_ID),
                    safeStr(t.Method_of_Payment),
                    hide ? "" : collector,
                    hide ? "" : avc,
                    safeStr(t.Final_Class),
                    tariff,
                    updated,
                    diff,
                    safeStr(t.TakenAction)
                ];
            });

            // Totals + meta
            const totalCount = data.length;
            const totalDiff  = data.reduce((s, x) => s + (toNum(x.Updated_Tariff) - toNum(x.Tariff)), 0);

            rows.push([]);
            rows.push(["Total Record Count", totalCount]);
            rows.push(["Total Difference Value", totalDiff.toFixed(2)]);
            rows.push([]);
            rows.push(["Generated", reportGeneratedAt, "User", currentUserId, "Version", reportVersion]);

            const ws = XLSX.utils.aoa_to_sheet([...filterRows, headers, ...rows]);
            ws["!cols"] = Array(headers.length).fill({ wch: 18 });

            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "Discrepancy Report");

            XLSX.writeFile(wb, `Discrepancy_Report_${fileStamp()}.xlsx`);
        });

    });
</script>

