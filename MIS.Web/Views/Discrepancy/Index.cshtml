@model MIS.Web.Models.Discrepancy.PageDiscrepancyModel
@using System.Text.Json

@{
    ViewData["Title"] = "Discrepancy Report";
}

<div class="card shadow-lg mb-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
        <div></div>
        <h2 class="mb-0 fw-bold text-primary">Discrepancy Report</h2>
        <div></div>
    </div>

    <!-- Export Button -->
    <div class="row mb-3">
        <div class="col-md-2 d-flex align-items-end me-2">
            <button id="btnDownloadPdf" type="button" class="btn btn-danger w-100 shadow-sm">
                <i class="bi bi-file-earmark-pdf"></i> Export PDF
            </button>
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button id="btnDownloadExcel" type="button" class="btn btn-success w-100 shadow-sm">
                <i class="bi bi-file-earmark-excel"></i> Export Excel
            </button>
        </div>
    </div>

    <div class="card-body">
        <form method="get" class="row g-3 mb-3">
            <div class="col-md-2">
                <label class="form-label fw-semibold">Start Date</label>
                <input type="date" class="form-control" asp-for="Filters.StartDate" />
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">End Date</label>
                <input type="date" class="form-control" asp-for="Filters.EndDate" />
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Lane No</label>
                <select class="form-select" asp-for="Filters.lane_Nr">
                    <option value="">All</option>
                    @for (int i = 1; i <= 8; i++)
                    {
                        <option value="@i">@i</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Shift</label>
                <select class="form-select" asp-for="Filters.Shift">
                    <option value="">All</option>
                    <option value="Shift 1">Shift 1</option>
                    <option value="Shift 2">Shift 2</option>
                    <option value="Shift 3">Shift 3</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Payment Method</label>
                <select class="form-select" asp-for="Filters.PaymentMethod">
                    <option value="">All</option>
                    <option value="Cash">Cash</option>
                    <option value="Card">Card</option>
                    <option value="E-tag">E-tag</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Action</label>
                <select class="form-select" asp-for="Filters.TakenAction">
                    <option value="">All</option>
                    <option>Both Correct</option>
                    <option>Operator Correct</option>
                    <option>AVC Correct</option>
                    <option>Both Incorrect</option>
                </select>
            </div>

            <div class="col-12 text-end">
                <button type="submit" class="btn btn-primary mt-3">Filter</button>
            </div>
        </form>

        @if (Model.Items != null && Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered align-middle">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>Lane</th>
                            <th>Sequence</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Shift</th>
                            <th>Operator</th>
                            <th>Lane Name</th>
                            <th>Payment</th>
                            <th>Collector Class</th>
                            <th>AVC Class</th>
                            <th>Final Class</th>
                            <th>Tariff</th>
                            <th>Updated Tariff</th>
                            <th>Tariff Difference</th>
                            <th>Action Taken</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Items)
                        {
                            <tr>
                                <td>@d.lane_Nr</td>
                                <td>@d.trx_Sequence_Nr</td>
                                <td>@d.trx_Date</td>
                                <td>@d.trx_Time</td>
                                <td>@d.operational_Shift</td>
                                <td>@d.toll_Operator_ID</td>
                                <td>@d.lane_Name</td>
                                <td>@d.method_of_Payment</td>
                                <td>@d.toll_Collector_Class</td>
                                <td>@d.avC_Class</td>
                                <td>@d.final_Class</td>
                                <td>@d.tariff.ToString("C")</td>
                                <td>@d.updated_tariff.ToString("C")</td>
                                <td>
                                    @{
                                        var diff = d.updated_tariff - d.tariff;
                                    }
                                    @diff.ToString("C")
                                </td>
                                <td>@d.takenAction</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3">
                <div>
                    <p class="mb-0">Showing page @Model.page of @Model.totalPages</p>
                </div>
                <div>
                    <p class="mb-0 fw-bold">Total Records: <span>@Model.TotalRecords</span></p>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning text-center">No discrepancy records found for the selected filters.</div>
        }

    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script>
        document.getElementById('exportBtn').addEventListener('click', () => {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF();

            doc.text("Discrepancy Report", 14, 15);

            const data = @Html.Raw(JsonSerializer.Serialize(Model.Items ?? new List<MIS.Web.Models.Discrepancy.DiscrepancyModel>()));
            let y = 25;
            data.forEach((item, index) => {
                const tariff = item.tariff || 0;
                const updated = item.updated_tariff || 0;
                const diff = updated - tariff;
                doc.text(`${index + 1}. Lane: ${item.lane_Nr} | Seq: ${item.trx_Sequence_Nr} | Final: ${item.final_Class} | Diff: ${diff}`, 10, y);
                y += 7;
                if (y > 270) {
                    doc.addPage();
                    y = 20;
                }
            });

            doc.save("DiscrepancyReport.pdf");
        });
    </script>
}
