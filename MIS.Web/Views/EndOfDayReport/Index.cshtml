@model MIS.Web.Models.EndOfDay.PageEndOfDayModel
@using MIS.Web.Models.EndOfDay

@{
    ViewData["Title"] = "End Of Day Report";

    string generatedAt = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
    string userId = User.Identity?.Name ?? "Lucky";
    string version = "3.0.0.0";

    // Safe loading
    var report = Model.Report ?? new EndOfDayReportViewModel();
    var theoretical = report.TheoreticalIncome ?? new List<TheoreticalIncomeRowViewModel>();
    var discounts = report.Discounts ?? new DiscountsViewModel();
    var exempts = report.Exempts ?? new ExemptsViewModel();
    var other = report.OtherIncome ?? new OtherIncomeViewModel();
    var recon = report.Reconciliation ?? new ReconciliationViewModel();
    var totals = report.Totals ?? new EndOfDayTotalsViewModel();

    // Metric lookup
    var map = theoretical.ToDictionary(
        x => x.Metric.Trim().ToLower(),
        x => x
    );

    TheoreticalIncomeRowViewModel? Get(string key)
        => map.GetValueOrDefault(key.Trim().ToLower());

    var traffic = Get("traffic");
    var nominal = Get("nominal tariff");
    var trafficNominal = Get("traffic x nominal tariff");
    var penalty = Get("cash penalty");
    var totalTheoRow = Get("total theoretical income");

    decimal totalTheo = totalTheoRow?.Total ?? ((trafficNominal?.Total ?? 0) + (penalty?.Total ?? 0));

    decimal exemptsTotal = exempts.TotalExemptAmount;

    decimal anonTotal =
        discounts.ClassM_AnonymousAmount +
        discounts.ClassI_AnonymousAmount +
        discounts.ClassII_AnonymousAmount +
        discounts.ClassIII_AnonymousAmount;

    decimal indivTotal =
        discounts.ClassM_IndividualAmount +
        discounts.ClassI_IndividualAmount +
        discounts.ClassII_IndividualAmount +
        discounts.ClassIII_IndividualAmount;

    decimal corpTotal =
        discounts.ClassM_CorporateAmount +
        discounts.ClassI_CorporateAmount +
        discounts.ClassII_CorporateAmount +
        discounts.ClassIII_CorporateAmount;

    decimal staffTotal =
        discounts.ClassM_StaffAmount +
        discounts.ClassI_StaffAmount +
        discounts.ClassII_StaffAmount +
        discounts.ClassIII_StaffAmount;

    decimal providedTotal = discounts.TotalDiscountAmount;

    decimal totalDiscountedIncome = totalTheo - exemptsTotal - providedTotal;

    decimal totalIncomeA = totals.TotalIncomeA;
    decimal totalAccountedB = totals.TotalAccountedB;
    decimal unreconciled = totals.UnreconciledDiscrepancy;
}

<!-- ===================================== -->
<!--             PAGE WRAPPER              -->
<!-- ===================================== -->
<div class="card shadow-lg p-4 mb-4">

    <!-- ========================= -->
    <!--        PAGE HEADER        -->
    <!-- ========================= -->
    <div class="border-bottom pb-2 mb-3 text-center">
        <h2 class="fw-bold text-primary mb-0">END OF DAY REPORT</h2>
    </div>

    <!-- ========================= -->
    <!--       EXPORT BUTTONS      -->
    <!-- ========================= -->
    <div class="row mb-4">
        <div class="col-md-2 me-2">
            <button id="btnDownloadPdf" class="btn btn-danger w-100 shadow-sm">
                <i class="bi bi-file-earmark-pdf"></i> Export PDF
            </button>
        </div>

        <div class="col-md-2">
            <button id="btnDownloadExcel" class="btn btn-success w-100 shadow-sm">
                <i class="bi bi-file-earmark-excel"></i> Export Excel
            </button>
        </div>
    </div>

    <!-- ========================= -->
    <!--          FILTERS          -->
    <!-- ========================= -->
    <form method="get" asp-action="Index" class="row g-3 mb-4">
        <div class="col-md-3">
            <label class="form-label fw-semibold">Select Date</label>
            <input type="date"
                   name="reportDate"
                   class="form-control"
                   value="@Model.StartDate.ToString("yyyy-MM-dd")"
                   required />
        </div>

        <div class="col-md-3 d-flex align-items-end">
            <button class="btn btn-primary w-100 shadow-sm">Apply Filter</button>
        </div>
    </form>

    <!-- ========================= -->
    <!--      DATE INFORMATION     -->
    <!-- ========================= -->
    <div class="mb-4 small">
        <div><strong>Start Date and Time:</strong> @Model.StartDate</div>
        <div><strong>End Date and Time:</strong> @Model.EndDate</div>
        <div><strong>Operational Day:</strong> @Model.StartDate.ToString("dd MMMM yyyy")</div>
        <div><strong>Operational Shift:</strong> -All-</div>
    </div>

    <!-- ===================================== -->
    <!--         SECTION: THEORETICAL INCOME   -->
    <!-- ===================================== -->
    <h5 class="fw-bold text-secondary mt-4 mb-2">THEORETICAL INCOME</h5>
    <div class="table-responsive">
        <table class="table table-bordered align-middle text-end">

            <thead class="table-light text-center">
                <tr>
                    <th class="text-start">Metric</th>
                    <th>Class M</th>
                    <th>Class I</th>
                    <th>Class II</th>
                    <th>Class III</th>
                    <th>Total</th>
                </tr>
            </thead>

            <tbody>

                @* ------------ Traffic Row ------------ *@
                <tr>
                    <td class="fw-semibold text-start">Traffic</td>
                    <td>@traffic?.ClassM</td>
                    <td>@traffic?.ClassI</td>
                    <td>@traffic?.ClassII</td>
                    <td>@traffic?.ClassIII</td>
                    <td>@traffic?.Total</td>
                </tr>

                @* ------------ Nominal Tariff ------------ *@
                <tr>
                    <td class="fw-semibold text-start">Nominal Tariff</td>
                    <td>@nominal?.ClassM</td>
                    <td>@nominal?.ClassI</td>
                    <td>@nominal?.ClassII</td>
                    <td>@nominal?.ClassIII</td>
                    <td></td>
                </tr>

                @* ------------ Traffic x Nominal ------------ *@
                <tr class="fw-bold">
                    <td class="text-start"><em>Traffic × Nominal Tariff</em></td>
                    <td>@trafficNominal?.ClassM</td>
                    <td>@trafficNominal?.ClassI</td>
                    <td>@trafficNominal?.ClassII</td>
                    <td>@trafficNominal?.ClassIII</td>
                    <td>@trafficNominal?.Total</td>
                </tr>

                @* ------------ Penalty ------------ *@
                <tr>
                    <td class="fw-semibold text-start">Cash Penalty</td>
                    <td>@penalty?.ClassM</td>
                    <td>@penalty?.ClassI</td>
                    <td>@penalty?.ClassII</td>
                    <td>@penalty?.ClassIII</td>
                    <td>@penalty?.Total</td>
                </tr>

                @* ------------ Total Theoretical ------------ *@
                <tr class="fw-bold table-light">
                    <td class="text-start">TOTAL THEORETICAL INCOME</td>
                    <td colspan="4"></td>
                    <td>@totalTheo.ToString("N2")</td>
                </tr>

                @* ------------ EXEMPTS ------------ *@
                <tr>
                    <td class="fw-semibold text-start">LESS: EXEMPTS</td>
                    <td>@exempts.ClassM_ExemptAmount</td>
                    <td>@exempts.ClassI_ExemptAmount</td>
                    <td>@exempts.ClassII_ExemptAmount</td>
                    <td>@exempts.ClassIII_ExemptAmount</td>
                    <td>@exemptsTotal</td>
                </tr>

                @* ------------ DISCOUNT HEADER ------------ *@
                <tr class="table-light fw-bold">
                    <td colspan="6" class="text-start">LESS: DISCOUNT</td>
                </tr>

                @* ------------ Each Discount Row ------------ *@
                <tr>
                    <td class="text-start">Anonymous 5%</td>
                    <td>@discounts.ClassM_AnonymousAmount</td>
                    <td>@discounts.ClassI_AnonymousAmount</td>
                    <td>@discounts.ClassII_AnonymousAmount</td>
                    <td>@discounts.ClassIII_AnonymousAmount</td>
                    <td>@(-anonTotal)</td>
                </tr>

                <tr>
                    <td class="text-start">Individual 10%</td>
                    <td>@discounts.ClassM_IndividualAmount</td>
                    <td>@discounts.ClassI_IndividualAmount</td>
                    <td>@discounts.ClassII_IndividualAmount</td>
                    <td>@discounts.ClassIII_IndividualAmount</td>
                    <td>@(-indivTotal)</td>
                </tr>

                <tr>
                    <td class="text-start">Corporate 10%</td>
                    <td>@discounts.ClassM_CorporateAmount</td>
                    <td>@discounts.ClassI_CorporateAmount</td>
                    <td>@discounts.ClassII_CorporateAmount</td>
                    <td>@discounts.ClassIII_CorporateAmount</td>
                    <td>@(-corpTotal)</td>
                </tr>

                <tr>
                    <td class="text-start">Staff 100%</td>
                    <td>@discounts.ClassM_StaffAmount</td>
                    <td>@discounts.ClassI_StaffAmount</td>
                    <td>@discounts.ClassII_StaffAmount</td>
                    <td>@discounts.ClassIII_StaffAmount</td>
                    <td>@(-staffTotal)</td>
                </tr>

                <tr class="fw-bold">
                    <td class="text-start">Discount Provided</td>
                    <td colspan="4"></td>
                    <td>@(-providedTotal)</td>
                </tr>

                @* ------------ TOTAL DISCOUNTED ------------ *@
                <tr class="fw-bold table-light">
                    <td class="text-start">TOTAL DISCOUNTED INCOME</td>
                    <td colspan="4"></td>
                    <td>@totalDiscountedIncome</td>
                </tr>

            </tbody>

        </table>
    </div>

    <!-- ===================================== -->
    <!--           SECTION: OTHER INCOME       -->
    <!-- ===================================== -->
    <h5 class="fw-bold text-secondary mt-4 mb-2">OTHER INCOME</h5>

    <div class="table-responsive">
        <table class="table table-bordered align-middle text-end">

            <tbody>

                <tr class="fw-bold table-light">
                    <td class="text-start">OTHER INCOME</td>
                    <td colspan="4"></td>
                    <td>@other.TotalOtherIncome</td>
                </tr>

                <tr>
                    <td class="text-start">Account Payments (Top-up)</td>
                    <td colspan="4"></td>
                    <td>@other.TotalTopupAmount</td>
                </tr>

                <tr><td class="text-start ps-4">Cash</td><td colspan="4"></td><td>@other.CashTopupAmount</td></tr>
                <tr><td class="text-start ps-4">Switch</td><td colspan="4"></td><td>@other.SwitchTopupAmount</td></tr>
                <tr><td class="text-start ps-4">Digital (EFT)</td><td colspan="4"></td><td>@other.DigitalTopupAmount</td></tr>
                <tr><td class="text-start">Cash Declared Surplus</td><td colspan="4"></td><td>@other.CashSurplusShortage</td></tr>

                <tr class="fw-bold table-light">
                    <td class="text-start">(A) TOTAL INCOME</td>
                    <td colspan="4"></td>
                    <td>@totalIncomeA</td>
                </tr>

            </tbody>

        </table>
    </div>

    <!-- ===================================== -->
    <!--      SECTION: ACCOUNTED FOR AS FOLLOWS -->
    <!-- ===================================== -->
    <h5 class="fw-bold text-secondary mt-4 mb-2">Accounted for as follows:</h5>

    <div class="table-responsive">
        <table class="table table-bordered align-middle text-end">

            <tbody>

                <tr><td class="text-start">Cash Declared</td><td colspan="4"></td><td>@recon.CashDeclared</td></tr>
                <tr><td class="text-start">Cash Banked</td><td colspan="4"></td><td>@recon.CashBanked</td></tr>
                <tr><td class="text-start">Cash Banked (Surplus) Shortage</td><td colspan="4"></td><td>@recon.CashSurplusShortage</td></tr>
                <tr><td class="text-start">Switch</td><td colspan="4"></td><td>@recon.SwitchAmount</td></tr>
                <tr><td class="text-start">Digital</td><td colspan="4"></td><td>@recon.DigitalAmount</td></tr>

                <!-- PREPAID -->
                <tr class="fw-bold table-light">
                    <td class="text-start">Pre-Paid Account Transactions</td>
                    <td colspan="4"></td>
                    <td>@recon.PrePaidTotal</td>
                </tr>

                <tr><td class="text-start ps-4">Smart Card</td><td colspan="4"></td><td>@recon.SmartCardAmount</td></tr>
                <tr><td class="text-start ps-4">ETC TAG</td><td colspan="4"></td><td>@recon.ETCTagAmount</td></tr>

                <!-- OTHER LANE -->
                <tr class="fw-bold table-light">
                    <td class="text-start">Other Lane Transactions</td>
                    <td colspan="4"></td>
                    <td>@recon.OtherLaneTotal</td>
                </tr>

                <tr><td class="text-start ps-4">Violation</td><td colspan="4"></td><td>@recon.ViolationAmount</td></tr>
                <tr><td class="text-start ps-4">Exemptions</td><td colspan="4"></td><td>@recon.ExemptionsAmount</td></tr>

                <tr><td class="text-start">Collector Debt</td><td colspan="4"></td><td>@recon.CollectorDebt</td></tr>
                <tr><td class="text-start">Cash Declared Shortages</td><td colspan="4"></td><td>@recon.CashShortages</td></tr>

                <tr class="fw-bold table-light">
                    <td class="text-start">(B) TOTAL ACCOUNTED FOR</td>
                    <td colspan="4"></td>
                    <td>@totalAccountedB</td>
                </tr>

                <tr class="fw-bold">
                    <td class="text-start">UN-RECONCILED DISCREPANCY</td>
                    <td colspan="4"></td>
                    <td>@unreconciled</td>
                </tr>
            </tbody>

        </table>

        <table id="eodExportTableTheo" class="d-none">
            <thead>
                <tr>
                    <th>Metric</th>
                    <th>Class M</th>
                    <th>Class I</th>
                    <th>Class II</th>
                    <th>Class III</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                <tr><td>Traffic</td><td>@traffic?.ClassM</td><td>@traffic?.ClassI</td><td>@traffic?.ClassII</td><td>@traffic?.ClassIII</td><td>@traffic?.Total</td></tr>
                <tr><td>Nominal Tariff</td><td>@nominal?.ClassM</td><td>@nominal?.ClassI</td><td>@nominal?.ClassII</td><td>@nominal?.ClassIII</td><td></td></tr>
                <tr><td>Traffic × Nominal Tariff</td><td>@trafficNominal?.ClassM</td><td>@trafficNominal?.ClassI</td><td>@trafficNominal?.ClassII</td><td>@trafficNominal?.ClassIII</td><td>@trafficNominal?.Total</td></tr>
                <tr><td>Cash Penalty</td><td>@penalty?.ClassM</td><td>@penalty?.ClassI</td><td>@penalty?.ClassII</td><td>@penalty?.ClassIII</td><td>@penalty?.Total</td></tr>
                <tr><td><b>Total Theoretical Income</b></td><td></td><td></td><td></td><td></td><td>@totalTheo</td></tr>

                <tr><td>Exempts</td><td>@exempts.ClassM_ExemptAmount</td><td>@exempts.ClassI_ExemptAmount</td><td>@exempts.ClassII_ExemptAmount</td><td>@exempts.ClassIII_ExemptAmount</td><td>@exemptsTotal</td></tr>

                <tr><td>Anonymous 5%</td><td>@discounts.ClassM_AnonymousAmount</td><td>@discounts.ClassI_AnonymousAmount</td><td>@discounts.ClassII_AnonymousAmount</td><td>@discounts.ClassIII_AnonymousAmount</td><td>@(-anonTotal)</td></tr>
                <tr><td>Individual 10%</td><td>@discounts.ClassM_IndividualAmount</td><td>@discounts.ClassI_IndividualAmount</td><td>@discounts.ClassII_IndividualAmount</td><td>@discounts.ClassIII_IndividualAmount</td><td>@(-indivTotal)</td></tr>
                <tr><td>Corporate 10%</td><td>@discounts.ClassM_CorporateAmount</td><td>@discounts.ClassI_CorporateAmount</td><td>@discounts.ClassII_CorporateAmount</td><td>@discounts.ClassIII_CorporateAmount</td><td>@(-corpTotal)</td></tr>
                <tr><td>Staff 100%</td><td>@discounts.ClassM_StaffAmount</td><td>@discounts.ClassI_StaffAmount</td><td>@discounts.ClassII_StaffAmount</td><td>@discounts.ClassIII_StaffAmount</td><td>@(-staffTotal)</td></tr>

                <tr><td><b>Total Discounted Income</b></td><td></td><td></td><td></td><td></td><td>@totalDiscountedIncome</td></tr>
            </tbody>
        </table>
        <table id="eodExportTableOther" class="d-none">
            <thead>
                <tr><th>Metric</th><th>Total</th></tr>
            </thead>
            <tbody>
                <tr><td>Account Payments (Top-up)</td><td>@other.TotalTopupAmount</td></tr>
                <tr><td>Cash</td><td>@other.CashTopupAmount</td></tr>
                <tr><td>Switch</td><td>@other.SwitchTopupAmount</td></tr>
                <tr><td>Digital (EFT)</td><td>@other.DigitalTopupAmount</td></tr>
                <tr><td>Cash Declared Surplus</td><td>@other.CashSurplusShortage</td></tr>
                <tr><td><b>Total Income (A)</b></td><td>@totalIncomeA</td></tr>
            </tbody>
        </table>
        <table id="eodExportTableAccounted" class="d-none">
            <thead>
                <tr><th>Metric</th><th>Total</th></tr>
            </thead>
            <tbody>
                <tr><td>Cash Declared</td><td>@recon.CashDeclared</td></tr>
                <tr><td>Cash Banked</td><td>@recon.CashBanked</td></tr>
                <tr><td>Cash Banked (Surplus) Shortage</td><td>@recon.CashSurplusShortage</td></tr>
                <tr><td>Switch</td><td>@recon.SwitchAmount</td></tr>
                <tr><td>Digital</td><td>@recon.DigitalAmount</td></tr>

                <tr><td>Prepaid: Smart Card</td><td>@recon.SmartCardAmount</td></tr>
                <tr><td>Prepaid: ETC Tag</td><td>@recon.ETCTagAmount</td></tr>

                <tr><td>Violations</td><td>@recon.ViolationAmount</td></tr>
                <tr><td>Exemptions</td><td>@recon.ExemptionsAmount</td></tr>
                <tr><td>Collector Debt</td><td>@recon.CollectorDebt</td></tr>
                <tr><td>Cash Declared Shortages</td><td>@recon.CashShortages</td></tr>

                <tr><td><b>Total Accounted (B)</b></td><td>@totalAccountedB</td></tr>
                <tr><td><b>Un-Reconciled Discrepancy</b></td><td>@unreconciled</td></tr>
            </tbody>
        </table>

    </div>

    <!-- ===================================== -->
    <!--               FOOTER                  -->
    <!-- ===================================== -->
    <div class="mt-4 p-3 border-top bg-light small">
        <div class="row">
            <div class="col-md-4"><strong>Date and Time:</strong> @generatedAt</div>
            <div class="col-md-4"><strong>User ID:</strong> @userId</div>
            <div class="col-md-4 text-end">Page 1 of 1</div>
        </div>
        <div class="mt-2"><strong>Reports Module Version:</strong> @version</div>
    </div>

</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", async () => {

            const { jsPDF } = window.jspdf;

            // Load images dynamically so it works on ALL PCs
            const loadImage = (src) =>
                new Promise(resolve => {
                    const img = new Image();
                    img.crossOrigin = "Anonymous";
                    img.onload = () => resolve(img);
                    img.onerror = () => resolve(null);
                    img.src = src;
                });

            const logoLeft  = await loadImage("/images/LCC Logo.jpg");
            const logoRight = await loadImage("/images/ICT-Works Logo.jpg");

            document.getElementById("btnDownloadPdf").addEventListener("click", async () => {

                const doc = new jsPDF("p", "pt", "a4");
                const margin = 40;
                let y = margin;

                /* ------------------------------------------------------
                 * CORPORATE HEADER WITH TWO LOGOS
                 * ------------------------------------------------------ */
                if (logoLeft)  doc.addImage(logoLeft, "JPEG", margin, 20, 70, 70);
                if (logoRight) doc.addImage(logoRight, "JPEG", doc.internal.pageSize.width - margin - 70, 20, 70, 70);

                doc.setFont("helvetica", "bold");
                doc.setFontSize(14);
                doc.text("LEKKI CONCESSION COMPANY LIMITED", doc.internal.pageSize.width / 2, 40, { align: "center" });

                doc.setFontSize(12);
                doc.text("LEKKI-IKOYI LINK BRIDGE", doc.internal.pageSize.width / 2, 60, { align: "center" });

                doc.setFontSize(13);
                doc.text("END OF DAY REPORT", doc.internal.pageSize.width / 2, 80, { align: "center" });

                y = 110;

                /* ------------------------------------------------------
                 * REPORT FILTER METADATA
                 * ------------------------------------------------------ */
                doc.setFont("helvetica", "normal");
                doc.setFontSize(10);

                doc.text(`Month: @Model.StartDate.ToString("MMMM yyyy")`, margin, y);      y += 15;
                doc.text(`Start Date and Time: @Model.StartDate.ToString("dd/MM/yyyy hh:mm tt")`, margin, y); y += 15;
                doc.text(`End Date and Time: @Model.EndDate.ToString("dd/MM/yyyy hh:mm tt")`, margin, y); y += 15;
                doc.text(`Operational Day: @Model.StartDate.ToString("dd MMMM yyyy")`, margin, y); y += 15;
                doc.text(`Operational Shift: -All-`, margin, y); y += 20;

                /* ------------------------------------------------------
                 * SECTION: THEORETICAL INCOME
                 * ------------------------------------------------------ */
                doc.setFont("helvetica", "bold");
                doc.setFontSize(11);
                doc.text("THEORETICAL INCOME", margin, y);
                y += 10;

                doc.autoTable({
                    startY: y,
                    html: "#eodExportTableTheo",
                    theme: "grid",
                    styles: { fontSize: 9, halign: "right" },
                    headStyles: { fillColor: [230, 230, 230], textColor: 0 },
                    margin: { left: margin, right: margin }
                });

                y = doc.lastAutoTable.finalY + 25;

                /* ------------------------------------------------------
                 * SECTION: OTHER INCOME
                 * ------------------------------------------------------ */
                doc.setFont("helvetica", "bold");
                doc.setFontSize(11);
                doc.text("OTHER INCOME", margin, y);
                y += 10;

                doc.autoTable({
                    startY: y,
                    html: "#eodExportTableOther",
                    theme: "grid",
                    styles: { fontSize: 9, halign: "right" },
                    headStyles: { fillColor: [230, 230, 230], textColor: 0 },
                    margin: { left: margin, right: margin }
                });

                y = doc.lastAutoTable.finalY + 25;

                /* ------------------------------------------------------
                 * SECTION: ACCOUNTED FOR
                 * ------------------------------------------------------ */
                doc.setFont("helvetica", "bold");
                doc.setFontSize(11);
                doc.text("Accounted for as follows:", margin, y);
                y += 10;

                doc.autoTable({
                    startY: y,
                    html: "#eodExportTableAccounted",
                    theme: "grid",
                    styles: { fontSize: 9, halign: "right" },
                    headStyles: { fillColor: [230, 230, 230], textColor: 0 },
                    margin: { left: margin, right: margin }
                });

                /* ------------------------------------------------------
                 * FOOTER
                 * ------------------------------------------------------ */
                const footerY = doc.internal.pageSize.height - 35;

                doc.setFontSize(9);
                doc.text("Date and Time: @generatedAt", margin, footerY);
                doc.text("User ID: @userId", margin + 220, footerY);
                doc.text("Page 1 of 1", doc.internal.pageSize.width - margin, footerY, { align: "right" });

                doc.text("Reports Module Version Number: @version", margin, footerY + 12);

                doc.save("EndOfDayReport.pdf");
            });
        });
    </script>

    <script>
        document.getElementById("btnDownloadExcel").addEventListener("click", () => {

            const wb = XLSX.utils.book_new();
            const ws = [];

            // HEADER
            ws.push(["LEKKI CONCESSION COMPANY LIMITED"]);
            ws.push(["LEKKI-IKOYI LINK BRIDGE"]);
            ws.push(["END OF DAY REPORT"]);
            ws.push([]);
            ws.push([`Month: @Model.StartDate.ToString("MMMM yyyy")`]);
            ws.push([`Start Date and Time: @Model.StartDate.ToString("dd/MM/yyyy hh:mm tt")`]);
            ws.push([`End Date and Time: @Model.EndDate.ToString("dd/MM/yyyy hh:mm tt")`]);
            ws.push([`Operational Day: @Model.StartDate.ToString("dd MMMM yyyy")`]);
            ws.push(["Operational Shift: -All-"]);
            ws.push([]);
            ws.push([]);

            // THEORETICAL INCOME
            ws.push(["THEORETICAL INCOME"]);
            ws.push(["Metric", "Class M", "Class I", "Class II", "Class III", "Total"]);

            // Insert table rows from hidden HTML
            const theo = document.querySelectorAll("#eodExportTableTheo tbody tr");
            theo.forEach(row => {
                const cells = [...row.children].map(c => c.innerText);
                ws.push(cells);
            });

            ws.push([]);
            ws.push([]);

            // OTHER INCOME
            ws.push(["OTHER INCOME"]);
            const other = document.querySelectorAll("#eodExportTableOther tbody tr");
            other.forEach(row => {
                ws.push([...row.children].map(c => c.innerText));
            });

            ws.push([]);
            ws.push([]);

            // ACCOUNTED FOR
            ws.push(["ACCOUNTED FOR AS FOLLOWS"]);
            const accRows = document.querySelectorAll("#eodExportTableAccounted tbody tr");
            accRows.forEach(row => {
                ws.push([...row.children].map(c => c.innerText));
            });

            ws.push([]);
            ws.push(["Date and Time:", "@generatedAt"]);
            ws.push(["User ID:", "@userId"]);
            ws.push(["Reports Module Version Number:", "@version"]);

            const sheet = XLSX.utils.aoa_to_sheet(ws);

            // Set column widths
            sheet["!cols"] = [
                { wch: 35 },
                { wch: 12 },
                { wch: 12 },
                { wch: 12 },
                { wch: 12 },
                { wch: 16 }
            ];

            XLSX.utils.book_append_sheet(wb, sheet, "EndOfDay");

            XLSX.writeFile(wb, "EndOfDayReport.xlsx");
        });
    </script>


}

