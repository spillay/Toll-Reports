<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MIS.Web</title>

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Custom styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MIS.Web.styles.css" asp-append-version="true" />

    <style>
        /* Modern navbar */
        .navbar {
            background-color: #f8f9fa;
        }

        .navbar-brand {
            font-weight: bold;
            font-size: 1.5rem;
        }

        .nav-link {
            font-weight: 500;
            transition: color 0.2s;
        }

            .nav-link:hover {
                color: #0d6efd;
            }

        footer {
            padding: 1rem 0;
            font-size: 0.9rem;
            text-align: center;
        }

        /* Sidebar styling similar to nopCommerce */
        .sidebar {
            width: 250px;
            min-height: 100vh;
            background-color: #2d3238;
            color: #fff;
        }

            .sidebar h4 {
                font-size: 1.2rem;
                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
                padding-bottom: 0.5rem;
            }

            .sidebar .nav-link {
                font-weight: 500;
                color: #cfd8dc;
                border-radius: 8px;
                padding: 10px 15px;
                transition: background 0.2s, color 0.2s;
            }

                .sidebar .nav-link:hover,
                .sidebar .nav-link.active {
                    background-color: #495057;
                    color: #fff;
                }

            .sidebar i {
                font-size: 1.1rem;
            }

        /* Adjust main content to match the full layout */
        .content {
            background-color: #f8f9fa;
        }
    </style>
</head>
<body class="bg-light">

    <header>
        <nav class="navbar navbar-expand-lg navbar-light shadow-sm mb-4">
            <div class="container">

                <a class="navbar-brand" href="#">
                    <img src="~/images/lCC Logo.jpg" alt="LCC Logo" style="height: 100px; width 100px;" />
                </a>
                
                <div class="mx-auto text-center">
                    <h2 class="fw-bold text-secondary mb-0">
                        LEKKI CONCESSION COMPANY LIMITED <br />
                        CONSERVATION TOLL PLAZA
                    </h2>
                </div>
                <div>
                    <img src="~/images/ICT-Works Logo.jpg" alt="ICT Works Logo" style="height: 100px; width 100px;" />
                </div>
            </div>
        </nav>
    </header>


    <main class="d-flex">
        <!-- Sidebar -->
        <nav class="sidebar bg-body bg-transparent p-3 vh-100">
            <ul class="nav flex-column">
                <li class="nav-item mb-2">
                    <a class="nav-link text-dark" asp-controller="Transaction" asp-action="transaction" asp-route-page="1" asp-route-pageSize="10">
                        <i class="bi bi-cash-stack me-2"></i> Transactions
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link text-dark" asp-area="" asp-page="/Discrepancy/Discrepancy">
                        <i class="bi bi-exclamation-triangle me-2"></i> Discrepancies
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link text-dark" asp-area="" asp-page="/Comprehensive/Comprehensive">
                        <i class="bi bi-graph-up me-2"></i> Comprehensive
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link text-dark" asp-controller="VarientPerfomance" asp-action="VarientPerfomances" asp-route-page="1" asp-route-pageSize="10">
                        <i class="bi bi-graph-up me-2"></i> Staff Variant and Perfomance
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link text-dark"
                       asp-controller="Traffic"
                       asp-action="HourlyReport"
                       asp-route-page="1"
                       asp-route-pageSize="10">
                        <i class="bi bi-graph-up me-2"></i> Hourly Traffic Report
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link text-dark"
                       asp-controller="DailyTraffic"
                       asp-action="Index"
                       asp-route-page="1"
                       asp-route-pageSize="10">
                        <i class="bi bi-graph-up me-2"></i> Daily Traffic Report
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link text-dark"
                       asp-controller="MonthlyTraffic"
                       asp-action="Index"
                       asp-route-page="1"
                       asp-route-pageSize="10">
                        <i class="bi bi-graph-up me-2"></i> Monthly Traffic Report
                    </a>
                </li>
                
            </ul>
        </nav>

        <!-- Page Content -->
        <div class="content flex-grow-1 p-4 bg-light">
            <div class="card shadow-sm mb-5">
                <div class="card-body">
                    @RenderBody()
                </div>
            </div>
        </div>
    </main>




    <footer class="border-top bg-white text-muted">
        &copy; 2025 - MIS.Web
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        $('#myDropdown').change(function () {
            console.log("change");
            var selectedValue = $(this).val();
            $.ajax({
                url: '@Url.Action("Transaction", "Menu")',
                type: 'GET',
                data: { value: selectedValue },
                success: function (response) {
                    console.log('Action called successfully:', response);
                },
                error: function (error) {
                    console.error('Error:', error);
                }
            });
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
