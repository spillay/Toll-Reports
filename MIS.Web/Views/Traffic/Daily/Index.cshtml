@model MIS.Web.Models.Traffic.Daily.PageDailyTrafficModel
@using System.Text.Json

@{
    ViewData["Title"] = "Daily Traffic Report";

    var reportGeneratedAt = DateTime.Now;
    var currentUser = @User.FindFirst("firstName")?.Value ?? "Unknown User";
    var reportVersion = "3.0.0.0";

    var input = Model.Filters ?? new MIS.Web.Models.Traffic.Daily.DailyTrafficInputModel();
    var classifications = Model.Classifications ?? new List<string>();
}
<div class="card shadow-lg mb-4">
    <div class="card-body">

        <!-- Header -->
        <div class="text-center mb-3 border-bottom pb-2">
            <h2 class="mb-0 fw-bold text-primary">DAILY TRAFFIC REPORT</h2>
        </div>


        <!-- Export Buttons -->
        <div class="row mb-3">
            <div class="col-md-2 me-2">
                <button id="btnDownloadPdf" class="btn btn-danger w-100">
                    <i class="bi bi-file-earmark-pdf"></i> Export PDF
                </button>
            </div>
            <div class="col-md-2">
                <button id="btnDownloadExcel" class="btn btn-success w-100">
                    <i class="bi bi-file-earmark-excel"></i> Export Excel
                </button>
            </div>
        </div>

        <!-- Filter Form -->
        @await Html.PartialAsync("~/Views/Traffic/Daily/_DailyTrafficFilters.cshtml", Model)

        <!-- Data Table -->
        <div class="table-responsive mt-3">
            <table class="table table-bordered table-striped text-center align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th></th>
                        @foreach (var cls in classifications)
                        {
                            <th>@cls</th>
                        }
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        var grouped = Model.Items
                        .GroupBy(x => x.Date.Date)
                        .OrderBy(g => g.Key);

                        var totalsPerClass = classifications.ToDictionary(c => c, c => 0);

                        foreach (var group in grouped)
                        {
                            int rowTotal = group.Sum(x => x.Count);

                            <!-- Traffic Row -->
                            <tr>
                                <td>@group.Key.ToString("dd/MM/yyyy")</td>
                                <td>Traffic</td>

                                @foreach (var cls in classifications)
                                {
                                    int count = group.FirstOrDefault(x => x.Classification == cls)?.Count ?? 0;
                                    <td>@count</td>
                                    totalsPerClass[cls] += count;
                                }

                                <td>@rowTotal</td>
                            </tr>

                            <!-- DAILY PERCENTAGES USING GRAND TOTAL (CALCULATED LATER) -->
                            <tr>
                                <td></td>
                                <td>Percentage</td>

                                @foreach (var cls in classifications)
                                {
                                    int count = group.FirstOrDefault(x => x.Classification == cls)?.Count ?? 0;

                                    <!-- TEMP place-holder -->
                                    <td class="daily-percent" data-count="@count"></td>
                                }

                                <td class="daily-total" data-rowtotal="@rowTotal"></td>
                            </tr>
                        }

                        <!-- NOW WE CAN COMPUTE GRAND TOTAL -->
                        var grandTotal = totalsPerClass.Values.Sum();

                        <!-- Now populate daily percentages using grandTotal -->
                        <script>
                            document.querySelectorAll(".daily-percent").forEach(cell => {
                                const count = parseInt(cell.dataset.count);
                                const pct = @grandTotal > 0 ? (count / @grandTotal * 100).toFixed(2) : "0.00";
                                cell.innerHTML = pct + "%";
                            });

                            document.querySelectorAll(".daily-total").forEach(cell => {
                                const total = parseInt(cell.dataset.rowtotal);
                                const pct = @grandTotal > 0 ? (total / @grandTotal * 100).toFixed(2) : "0.00";
                                cell.innerHTML = pct + "%";
                            });
                        </script>


                        <!-- PERIOD STATS -->
                        var averages = totalsPerClass.ToDictionary(
                        kv => kv.Key,
                        kv => grouped.Count() > 0 ? (int)Math.Round((double)kv.Value / grouped.Count()) : 0
                        );

                        var maximums = classifications.ToDictionary(
                        cls => cls,
                        cls => Model.Items
                        .Where(x => x.Classification == cls)
                        .GroupBy(x => x.Date.Date)
                        .Select(g => g.Sum(x => x.Count))
                        .DefaultIfEmpty(0)
                        .Max()
                        );

                        var percentagesForPeriod = classifications.ToDictionary(
                        cls => cls,
                        cls => grandTotal > 0
                        ? (double)totalsPerClass[cls] / grandTotal * 100
                        : 0
                        );

                        double totalPercentForPeriod = grandTotal > 0
                        ? (double)grandTotal / grandTotal * 100
                        : 0;


                        <!-- TOTAL ROW -->
                        <tr class="table-secondary fw-bold">
                            <td>Total for the Period</td>
                            <td></td>
                            @foreach (var cls in classifications)
                            {
                                <td>@totalsPerClass[cls]</td>
                            }
                            <td>@grandTotal</td>
                        </tr>

                        <!-- PERCENTAGE ROW BASED ON GRAND TOTAL -->
                        <tr class="table-secondary fw-bold">
                            <td>Percentage for the Period</td>
                            <td></td>
                            @foreach (var cls in classifications)
                            {
                                <td>@percentagesForPeriod[cls].ToString("0.00")%</td>
                            }
                            <td>@totalPercentForPeriod.ToString("0.00")%</td>
                        </tr>

                        <!-- AVERAGE -->
                        <tr class="table-secondary fw-bold">
                            <td>Average</td>
                            <td></td>
                            @foreach (var cls in classifications)
                            {
                                <td>@averages[cls]</td>
                            }
                            <td>@averages.Values.Sum()</td>
                        </tr>

                        <!-- MAXIMUM -->
                        <tr class="table-secondary fw-bold">
                            <td>Maximum</td>
                            <td></td>
                            @foreach (var cls in classifications)
                            {
                                <td>@maximums[cls]</td>
                            }
                            <td>@maximums.Values.Sum()</td>
                        </tr>

                    }
                    else
                    {
                        <tr>
                            <td colspan="@(classifications.Count + 3)" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                No data available for the selected filters.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>


        <!-- HEADER BLOCK - MATCHES YOUR SCREENSHOT -->
        <div class="border-bottom pb-2 mb-3">
            <table class="table table-borderless mb-0 w-100">
                <tr class="align-top">
                    <!-- Report Name -->
                    <td style="width: 35%;">
                        <strong>Daily Traffic Report</strong><br />
                        
                    </td>

                    <!-- Date and Time -->
                    <td style="width: 30%;">
                        <strong>Date and Time:</strong><br />
                        <em>@reportGeneratedAt.ToString("dd/MM/yyyy HH:mm:ss")</em>
                    </td>

                    <!-- User ID -->
                    <td style="width: 25%;">
                        <strong>User ID:</strong><br />
                        <em>@currentUser</em>
                    </td>

                    <!-- Page 1 of X -->
                    <td style="width: 10%; white-space: nowrap;" class="text-end">
                        Page 1 of 1
                    </td>
                </tr>

                <!-- VERSION ROW -->
                <tr>
                    <td colspan="4">
                        <strong>Reports Module Version Number:</strong>
                        <span>@reportVersion</span>
                    </td>
                </tr>
            </table>
        </div>



    </div>
</div>

<!-- Scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>

<script>
    document.getElementById("btnDownloadPdf").addEventListener("click", async function () {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "a4" });

        const pageWidth = doc.internal.pageSize.getWidth();
        const pageHeight = doc.internal.pageSize.getHeight();
        const margin = 40;

        // === LOGOS ===
        const logoWidth = 90, logoHeight = 90, logoY = 25;
        const leftLogoPath = '/images/lCC Logo.jpg';
        const rightLogoPath = '/images/ICT-Works Logo.jpg';

        const loadImage = src => new Promise(resolve => {
            const img = new Image();
            img.crossOrigin = 'Anonymous';
            img.onload = () => resolve(img);
            img.onerror = () => resolve(null);
            img.src = src;
        });

        const [leftLogo, rightLogo] = await Promise.all([
            loadImage(leftLogoPath),
            loadImage(rightLogoPath)
        ]);

        if (leftLogo) doc.addImage(leftLogo, 'JPEG', margin, logoY, logoWidth, logoHeight);
        if (rightLogo) doc.addImage(rightLogo, 'JPEG', pageWidth - margin - logoWidth, logoY, logoWidth, logoHeight);

             // === TITLE SECTION (Corporate Standard Layout) ===
            doc.setFont("helvetica", "bold");

            // Main Organisation
            doc.setFontSize(18);
            doc.text("LEKKI CONCESSION COMPANY LIMITED", pageWidth / 2, logoY + 35, { align: "center" });

            // Bridge Name
            doc.setFontSize(14);
            doc.text("LEKKI-IKOYI LINK BRIDGE", pageWidth / 2, logoY + 55, { align: "center" });

            // Report Name
            doc.setFontSize(13);
            doc.text("DAILY TRAFFIC REPORT", pageWidth / 2, logoY + 75, { align: "center" });
       

        // === FILTERS ===
        const startY = logoY + logoHeight + 50;
        doc.setFont("helvetica", "normal");
        doc.setFontSize(10);

        const filters = {
            "Start Date": '@Model.Filters.StartDate.ToString("dd/MM/yyyy")',
            "End Date": '@Model.Filters.EndDate.ToString("dd/MM/yyyy")',
            "Classification": '@(Model.Filters.ClassificationList != null && Model.Filters.ClassificationList.Any()  ? string.Join(", ", Model.Filters.ClassificationList) : "All")',
            "Operational Day": '@(Model.Filters.OperationalDay ? "Yes" : "No")'
        };

        let y = startY;
        doc.text("Filters Used:", margin, y);
        y += 14;

        for (const [key, value] of Object.entries(filters)) {
            doc.text(`${key}: ${value}`, margin, y);
            y += 12;
        }

        // === TABLE DATA ===
        const trafficData = @Html.Raw(JsonSerializer.Serialize(Model.Items ?? new List<MIS.Web.Models.Traffic.Daily.DailyTrafficModel>()));
        const classifications = @Html.Raw(JsonSerializer.Serialize(Model.Classifications ?? new List<string>()));

        const headers = ["Date", "", ...classifications, "Total"];
        const rows = [];

        // Group by day
        const grouped = {};
        trafficData.forEach(item => {
            const date = item.Date?.split("T")[0];
            if (!grouped[date]) grouped[date] = [];
            grouped[date].push({
                classification: item.Classification,
                count: item.Count
            });
        });

        // Compute Grand Total
        const totals = classifications.map(c =>
            trafficData.filter(x => x.Classification === c).reduce((a, b) => a + (b.Count || 0), 0)
        );
        const grandTotal = totals.reduce((a, b) => a + b, 0);

        // Build rows per date
        for (const [date, list] of Object.entries(grouped)) {

            const rowTotal = list.reduce((sum, i) => sum + (i.count || 0), 0);

            // Traffic Row
            const trafficRow = [date, "Traffic"];
            classifications.forEach(c => {
                const found = list.find(x => x.classification === c);
                trafficRow.push(found ? found.count : 0);
            });
            trafficRow.push(rowTotal);
            rows.push(trafficRow);

            // Percentage Row (based on GRAND TOTAL)
            const percentRow = ["", "Percentage"];
            classifications.forEach(c => {
                const found = list.find(x => x.classification === c);
                const count = found ? found.count : 0;
                const pct = grandTotal > 0 ? (count / grandTotal * 100) : 0;
                percentRow.push(`${pct.toFixed(2)}%`);
            });

            // total percentage for that day
            const dayPct = grandTotal > 0 ? (rowTotal / grandTotal * 100) : 0;
            percentRow.push(`${dayPct.toFixed(2)}%`);

            rows.push(percentRow);
        }

        // ADD FOOTER TOTALS
        rows.push(["", "Total for the Period", ...totals, grandTotal]);

        // PERCENTAGE FOOTER
        const footerPct = ["", "Percentage for the Period"];
        totals.forEach(t => {
            const pct = grandTotal > 0 ? (t / grandTotal * 100) : 0;
            footerPct.push(`${pct.toFixed(2)}%`);
        });
        footerPct.push("100%");
        rows.push(footerPct);

        // AVERAGE
        const daysCount = Object.keys(grouped).length || 1;
        rows.push(["", "Average",
            ...totals.map(t => Math.round(t / daysCount)),
            Math.round(grandTotal / daysCount)
        ]);

        // MAXIMUM
        rows.push(["", "Maximum",
            ...classifications.map(c => {
                const byDay = {};
                trafficData.filter(x => x.Classification === c).forEach(x => {
                    const d = x.Date?.split("T")[0];
                    byDay[d] = (byDay[d] || 0) + (x.Count || 0);
                });
                return Math.max(...Object.values(byDay), 0);
            }),
            ""
        ]);

        // === RENDER TABLE ===
        doc.autoTable({
            head: [headers],
            body: rows,
            startY: y + 10,
            theme: 'grid',
            headStyles: { fillColor: [41, 128, 185], textColor: 255 },
            styles: { fontSize: 9, cellPadding: 4, overflow: 'linebreak' },
            columnStyles: { 0: { cellWidth: 70 }, 1: { cellWidth: 80 } },
            didDrawPage: function () {
            const pageCount = doc.internal.getNumberOfPages();
            const currentPage = doc.internal.getCurrentPageInfo().pageNumber;
            const footerY = pageHeight - 30;

            doc.setFont("helvetica", "normal");
            doc.setFontSize(9);

            doc.text("LEKKI CONCESSION COMPANY LIMITED", margin, footerY);
            doc.text(`Generated: ${new Date().toLocaleString()}`, pageWidth / 2.5, footerY);
            doc.text(`User ID: Lucky`, pageWidth - margin - 120, footerY);
            doc.text(`Page ${currentPage} of ${pageCount}`, pageWidth - margin, footerY, { align: "right" });

            doc.text("Reports Module Version: 2.0.0.11", margin, footerY + 12);
        }
        });

        doc.save(`Daily_Traffic_Report_${new Date().toISOString().replace(/[:.]/g, '-')}.pdf`);
    });
</script>


<script>
    document.getElementById("btnDownloadExcel").addEventListener("click", function () {

        const trafficData = @Html.Raw(JsonSerializer.Serialize(Model.Items ?? new List<MIS.Web.Models.Traffic.Daily.DailyTrafficModel>()));
        const classifications = @Html.Raw(JsonSerializer.Serialize(Model.Classifications ?? new List<string>()));

        if (!trafficData.length) {
            alert("No data available to export.");
            return;
        }

        // Group by day
        const grouped = {};
        trafficData.forEach(item => {
            const date = item.Date?.split("T")[0];
            if (!grouped[date]) grouped[date] = [];
            grouped[date].push({
                classification: item.Classification,
                count: item.Count
            });
        });

        // Compute Grand Total
        const totals = classifications.map(c =>
            trafficData.filter(x => x.Classification === c).reduce((a, b) => a + (b.Count || 0), 0)
        );
        const grandTotal = totals.reduce((a, b) => a + b, 0);

        const headers = ["Date", "", ...classifications, "Total"];
        const excelRows = [];

        // Build rows per day
        for (const [date, list] of Object.entries(grouped)) {

            const rowTotal = list.reduce((sum, i) => sum + (i.count || 0), 0);

            // Traffic
            const trafficRow = [date, "Traffic"];
            classifications.forEach(c => {
                const found = list.find(x => x.classification === c);
                trafficRow.push(found ? found.count : 0);
            });
            trafficRow.push(rowTotal);
            excelRows.push(trafficRow);

            // Percent Row (using GRAND TOTAL)
            const percentRow = ["", "Percentage"];
            classifications.forEach(c => {
                const found = list.find(x => x.classification === c);
                const count = found ? found.count : 0;
                const pct = grandTotal > 0 ? (count / grandTotal * 100) : 0;
                percentRow.push(`${pct.toFixed(2)}%`);
            });

            const dayPct = grandTotal > 0 ? (rowTotal / grandTotal * 100) : 0;
            percentRow.push(`${dayPct.toFixed(2)}%`);

            excelRows.push(percentRow);
        }

        // Footer rows
        excelRows.push(["", "Total for the Period", ...totals, grandTotal]);

        // Percent Footer Row
        const footerPct = ["", "Percentage for the Period"];
        totals.forEach(t => {
            const pct = grandTotal > 0 ? (t / grandTotal * 100) : 0;
            footerPct.push(`${pct.toFixed(2)}%`);
        });
        footerPct.push("100%");
        excelRows.push(footerPct);

        const daysCount = Object.keys(grouped).length || 1;

        // Averages
        excelRows.push(["", "Average",
            ...totals.map(t => Math.round(t / daysCount)),
            Math.round(grandTotal / daysCount)
        ]);

        // Maximum
        excelRows.push(["", "Maximum",
            ...classifications.map(c => {
                const byDay = {};
                trafficData.filter(x => x.Classification === c).forEach(x => {
                    const d = x.Date?.split("T")[0];
                    byDay[d] = (byDay[d] || 0) + (x.Count || 0);
                });
                return Math.max(...Object.values(byDay), 0);
            }), ""
        ]);

        // === CREATE & DOWNLOAD EXCEL ===
        const wb = XLSX.utils.book_new();
        const ws = XLSX.utils.aoa_to_sheet([headers, ...excelRows]);

        ws['!cols'] = headers.map(() => ({ wch: 15 }));

        XLSX.utils.book_append_sheet(wb, ws, "Daily Traffic Report");

        const filename = `Daily_Traffic_Report_${new Date().toISOString().replace(/[:.]/g, '-')}.xlsx`;
        XLSX.writeFile(wb, filename);
    });
</script>



