@model MIS.Web.Models.Traffic.Daily.PageDailyTrafficModel
@using System.Text.Json

@{
    ViewData["Title"] = "Daily Traffic Report";

    var reportGeneratedAt = DateTime.Now;
    var currentUser = User.Identity?.Name ?? "Lucky";
    var reportVersion = "1.0.0";

    var input = Model.Filters ?? new MIS.Web.Models.Traffic.Daily.DailyTrafficInputModel();
    var classifications = Model.Classifications ?? new List<string>();
}
<div class="card shadow-lg mb-4">
    <div class="card-body">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
            <h2 class="mb-0 fw-bold text-primary">Daily Traffic Report</h2>
        </div>

        <!-- Export Buttons -->
        <div class="row mb-3">
            <div class="col-md-2 me-2">
                <button id="btnDownloadPdf" class="btn btn-danger w-100">
                    <i class="bi bi-file-earmark-pdf"></i> Export PDF
                </button>
            </div>
            <div class="col-md-2">
                <button id="btnDownloadExcel" class="btn btn-success w-100">
                    <i class="bi bi-file-earmark-excel"></i> Export Excel
                </button>
            </div>
        </div>

        <!-- Filter Form -->
        @Html.Partial("_DailyTrafficFilters.cshtml", Model.Filters)

        <!-- Data Table -->
        <div class="table-responsive mt-3">
            <table class="table table-bordered table-striped text-center align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Traffic / %</th>
                        @foreach (var cls in classifications)
                        {
                            <th>@cls</th>
                        }
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        var grouped = Model.Items.GroupBy(x => x.Date.Date).OrderBy(g => g.Key);
                        var totalsPerClass = classifications.ToDictionary(c => c, c => 0);

                        foreach (var group in grouped)
                        {
                            int rowTotal = group.Sum(x => x.Count);

                            <!-- Traffic Row -->
                            <tr>
                                <td>@group.Key.ToString("dd/MM/yyyy")</td>
                                <td>Traffic</td>
                                @foreach (var cls in classifications)
                                {
                                    int count = group.FirstOrDefault(x => x.Classification == cls)?.Count ?? 0;
                                    <td>@count</td>
                                    totalsPerClass[cls] += count;
                                }
                                <td>@rowTotal</td>
                            </tr>

                            <!-- Percentage Row -->
                            <tr>
                                <td></td>
                                <td>Percentage</td>
                                @foreach (var cls in classifications)
                                {
                                    int count = group.FirstOrDefault(x => x.Classification == cls)?.Count ?? 0;
                                    double percent = rowTotal > 0 ? (double)count / rowTotal * 100 : 0;
                                    <td>@percent.ToString("0.00")%</td>
                                }
                                <td>100%</td>
                            </tr>
                        }

                        <!-- Statistics -->
                        var grandTotal = totalsPerClass.Values.Sum();
                        var daysCount = grouped.Count();
                        var averages = totalsPerClass.ToDictionary(kv => kv.Key, kv => daysCount > 0 ? (int)Math.Round((double)kv.Value / daysCount) : 0);

                        var maximums = classifications.ToDictionary(cls => cls,
                        cls => Model.Items.Where(x => x.Classification == cls)
                        .GroupBy(x => x.Date.Date)
                        .Select(g => g.Sum(x => x.Count))
                        .DefaultIfEmpty(0)
                        .Max());

                        <!-- Totals -->
                        <tr class="table-secondary fw-bold">
                            <td>Total for the Month</td>
                            <td></td>
                            @foreach (var cls in classifications)
                            {
                                <td>@totalsPerClass[cls]</td>
                            }
                            <td>@grandTotal</td>
                        </tr>

                        <tr class="table-secondary fw-bold">
                            <td>Average</td>
                            <td></td>
                            @foreach (var cls in classifications)
                            {
                                <td>@averages[cls]</td>
                            }
                            <td>@averages.Values.Sum()</td>
                        </tr>

                        <tr class="table-secondary fw-bold">
                            <td>Maximum</td>
                            <td></td>
                            @foreach (var cls in classifications)
                            {
                                <td>@maximums[cls]</td>
                            }
                            <td>@maximums.Values.Sum()</td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(classifications.Count + 3)" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                No data available for the selected filters.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Footer -->
        <div class="mt-4 p-3 border-top bg-light">
            <table class="table table-borderless w-100 mb-0">
                <tr>
                    <td style="width: 35%;">
                        <strong>Daily Traffic Report</strong>
                    </td>
                    <td style="width: 25%;">
                        <strong>Date and Time:</strong><br />
                        <em>@reportGeneratedAt.ToString("dd/MM/yyyy HH:mm:ss")</em>
                    </td>
                    <td style="width: 25%;">
                        <strong>User ID:</strong><br />
                        <em>@currentUser</em>
                    </td>
                    <td class="text-end" style="width: 15%;">
                        Version: <strong>@reportVersion</strong>
                    </td>
                </tr>
            </table>
        </div>

    </div>
</div>

<!-- Scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>

<script>
    document.getElementById("btnDownloadPdf").addEventListener("click", async function () {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "a4" });

        const pageWidth = doc.internal.pageSize.getWidth();
        const pageHeight = doc.internal.pageSize.getHeight();
        const margin = 40;

        // === LOGOS ===
        const logoWidth = 90, logoHeight = 90, logoY = 25;
        const leftLogoPath = '/images/lCC Logo.jpg';
        const rightLogoPath = '/images/ICT-Works Logo.jpg';

        const loadImage = src => new Promise(resolve => {
            const img = new Image();
            img.crossOrigin = 'Anonymous';
            img.onload = () => resolve(img);
            img.onerror = () => resolve(null);
            img.src = src;
        });

        const [leftLogo, rightLogo] = await Promise.all([
            loadImage(leftLogoPath),
            loadImage(rightLogoPath)
        ]);

        if (leftLogo) doc.addImage(leftLogo, 'JPEG', margin, logoY, logoWidth, logoHeight);
        if (rightLogo) doc.addImage(rightLogo, 'JPEG', pageWidth - margin - logoWidth, logoY, logoWidth, logoHeight);

        // === TITLE ===
        doc.setFont("helvetica", "bold");
        doc.setFontSize(16);
        doc.text("Daily Traffic Report", pageWidth / 2, logoY + 50, { align: "center" });

        // === FILTERS SECTION ===
        const startY = logoY + logoHeight + 20;
        doc.setFont("helvetica", "normal");
        doc.setFontSize(10);
        const filters = {
            "Start Date": '@Model.Filters.StartDate.ToString("dd/MM/yyyy")',
            "End Date": '@Model.Filters.EndDate.ToString("dd/MM/yyyy")',
            "Classification": '@(Model.Filters.Classification ?? "All")',
            "Operational Day": '@(Model.Filters.OperationalDay ? "Yes" : "No")'
        };
        let y = startY;
        doc.text("Filters Used:", margin, y);
        y += 14;
        for (const [key, value] of Object.entries(filters)) {
            doc.text(`${key}: ${value}`, margin, y);
            y += 12;
        }

        // === TABLE DATA ===
        const trafficData = @Html.Raw(JsonSerializer.Serialize(Model.Items ?? new List<MIS.Web.Models.Traffic.Daily.DailyTrafficModel>()));
        const classifications = @Html.Raw(JsonSerializer.Serialize(Model.Classifications ?? new List<string>()));

        const headers = ["Date", "Traffic / %", ...classifications, "Total"];
        const rows = [];

        // Normalize PascalCase names to JS
        const grouped = {};
        trafficData.forEach(item => {
            const date = item.Date?.split("T")[0];
            if (!grouped[date]) grouped[date] = [];
            grouped[date].push({
                classification: item.Classification,
                count: item.Count
            });
        });

        // Build rows per date
        for (const [date, list] of Object.entries(grouped)) {
            const total = list.reduce((sum, i) => sum + (i.count || 0), 0);

            // Traffic Row
            const trafficRow = [date, "Traffic"];
            classifications.forEach(c => {
                const found = list.find(x => x.classification === c);
                trafficRow.push(found ? found.count : 0);
            });
            trafficRow.push(total);
            rows.push(trafficRow);

            // Percentage Row
            const percentRow = ["", "Percentage"];
            classifications.forEach(c => {
                const found = list.find(x => x.classification === c);
                const val = found ? (found.count / total * 100) : 0;
                percentRow.push(total > 0 ? `${val.toFixed(2)}%` : "0.00%");
            });
            percentRow.push("100%");
            rows.push(percentRow);
        }

        // === TOTALS, AVERAGES, MAX ===
        const totals = classifications.map(c =>
            trafficData.filter(x => x.Classification === c).reduce((a, b) => a + (b.Count || 0), 0)
        );
        const grandTotal = totals.reduce((a, b) => a + b, 0);

        rows.push(["", "Total for the Month", ...totals, grandTotal]);
        rows.push(["", "Average", ...totals.map(t => Math.round(t / Object.keys(grouped).length)), Math.round(grandTotal / Object.keys(grouped).length)]);
        rows.push(["", "Maximum", ...classifications.map(c => {
            const byDay = {};
            trafficData.filter(x => x.Classification === c).forEach(x => {
                const d = x.Date?.split("T")[0];
                byDay[d] = (byDay[d] || 0) + (x.Count || 0);
            });
            return Math.max(...Object.values(byDay), 0);
        }), ""]);

        // === TABLE RENDER ===
        doc.autoTable({
            head: [headers],
            body: rows,
            startY: y + 10,
            theme: 'grid',
            headStyles: { fillColor: [41, 128, 185], textColor: 255 },
            styles: { fontSize: 9, cellPadding: 4, overflow: 'linebreak' },
            columnStyles: { 0: { cellWidth: 70 }, 1: { cellWidth: 80 } },
            didDrawPage: function (data) {
                const pageCount = doc.internal.getNumberOfPages();
                const currentPage = doc.internal.getCurrentPageInfo().pageNumber;
                const footerY = pageHeight - 50;

                doc.setFontSize(10);
                doc.text("Daily Traffic Report", margin, footerY);
                doc.text(`Date & Time: ${new Date().toLocaleString()}`, pageWidth / 2.3, footerY);
                doc.text(`User ID: Lucky`, pageWidth / 1.6, footerY);
                doc.text(`Page ${currentPage} of ${pageCount}`, pageWidth - margin, footerY, { align: 'right' });
                doc.setFontSize(9);
                doc.text("Reports Module Version Number: 1.0.0", margin, footerY + 14);
            }
        });

        // === SAVE ===
        doc.save(`Daily_Traffic_Report_${new Date().toISOString().replace(/[:.]/g, '-')}.pdf`);
    });
</script>

<script>
    document.getElementById("btnDownloadExcel").addEventListener("click", function () {
        const trafficData = @Html.Raw(JsonSerializer.Serialize(Model.Items ?? new List<MIS.Web.Models.Traffic.Daily.DailyTrafficModel>()));
        const classifications = @Html.Raw(JsonSerializer.Serialize(Model.Classifications ?? new List<string>()));

        if (!trafficData.length) {
            alert("No data available to export.");
            return;
        }

        // === Normalize PascalCase C# properties ===
        const grouped = {};
        trafficData.forEach(item => {
            const date = item.Date?.split("T")[0];
            if (!grouped[date]) grouped[date] = [];
            grouped[date].push({
                classification: item.Classification,
                count: item.Count
            });
        });

        // === Prepare headers ===
        const headers = ["Date", "Traffic / %", ...classifications, "Total"];
        const excelRows = [];

        // === Build per-date rows ===
        for (const [date, list] of Object.entries(grouped)) {
            const total = list.reduce((sum, i) => sum + (i.count || 0), 0);

            // Traffic row
            const trafficRow = [date, "Traffic"];
            classifications.forEach(c => {
                const found = list.find(x => x.classification === c);
                trafficRow.push(found ? found.count : 0);
            });
            trafficRow.push(total);
            excelRows.push(trafficRow);

            // Percentage row
            const percentRow = ["", "Percentage"];
            classifications.forEach(c => {
                const found = list.find(x => x.classification === c);
                const val = found ? (found.count / total * 100) : 0;
                percentRow.push(total > 0 ? `${val.toFixed(2)}%` : "0.00%");
            });
            percentRow.push("100%");
            excelRows.push(percentRow);
        }

        // === Totals / Averages / Maximums ===
        const totals = classifications.map(c =>
            trafficData.filter(x => x.Classification === c).reduce((a, b) => a + (b.Count || 0), 0)
        );
        const grandTotal = totals.reduce((a, b) => a + b, 0);
        const daysCount = Object.keys(grouped).length || 1;

        excelRows.push(["", "Total for the Month", ...totals, grandTotal]);
        excelRows.push(["", "Average", ...totals.map(t => Math.round(t / daysCount)), Math.round(grandTotal / daysCount)]);
        excelRows.push(["", "Maximum", ...classifications.map(c => {
            const byDay = {};
            trafficData.filter(x => x.Classification === c).forEach(x => {
                const d = x.Date?.split("T")[0];
                byDay[d] = (byDay[d] || 0) + (x.Count || 0);
            });
            return Math.max(...Object.values(byDay), 0);
        }), ""]);

        // === Create Workbook and Export ===
        const wb = XLSX.utils.book_new();
        const ws = XLSX.utils.aoa_to_sheet([headers, ...excelRows]);

        // Style width for better readability
        const colWidths = headers.map(() => ({ wch: 15 }));
        ws['!cols'] = colWidths;

        XLSX.utils.book_append_sheet(wb, ws, "Daily Traffic Report");

        const filename = `Daily_Traffic_Report_${new Date().toISOString().replace(/[:.]/g, '-')}.xlsx`;
        XLSX.writeFile(wb, filename);
    });
</script>


