

@model MIS.Web.Models.Traffic.Daily.DailyTrafficInputModel

@{
    var classes = new List<string> { "Class 1", "Class 2", "Class 4", "Class M" };
}

<form method="get" asp-controller="DailyTraffic" asp-action="Index" id="filterForm">
    <div class="row g-3 align-items-end">
        <!-- Start Date -->
        <div class="col-md-3">
            <label class="form-label">Start Date</label>
            <input type="date" name="startDate" class="form-control"
                   value="@(Model?.StartDate.ToString("yyyy-MM-dd") ?? "")" />
        </div>

        <!-- End Date -->
        <div class="col-md-3">
            <label class="form-label">End Date</label>
            <input type="date" name="endDate" class="form-control"
                   value="@(Model?.EndDate.ToString("yyyy-MM-dd") ?? "")" />
        </div>

        <!-- Classification -->
        <div class="col-md-3">
            <label class="form-label">Classification</label>
            <select name="classification" class="form-select">
                <option value="">All</option>
                @foreach (var cls in classes)
                {
                    <option value="@cls" selected=@(Model?.Classification == cls ? "selected" : null)>@cls</option>
                }
            </select>
        </div>

        <!-- Operational Day -->
        <div class="col-md-3">
            <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" name="operationalDay"
                       value="true" @(Model?.OperationalDay == true ? "checked" : "") id="operationalDay" />
                <label class="form-check-label" for="operationalDay">Operational Day</label>
            </div>
        </div>

        <!-- Shifts -->
        <div class="col-md-6">
            <label class="form-label">Shifts</label>
            <div>
                @for (int i = 1; i <= 3; i++)
                {
                    var shiftName = i switch { 1 => "Shift 1", 2 => "Shift 2", 3 => "Shift 3", _ => "" };
                    bool isChecked = Model?.Shifts?.Contains(i) == true;
                    <div class="form-check form-check-inline">
                        <input class="form-check-input shift-checkbox" type="checkbox"
                               name="shifts" value="@i" @(isChecked ? "checked" : "") id="shift_@i"
                               @(!Model?.OperationalDay == true ? "disabled" : "") />
                        <label class="form-check-label" for="shift_@i">@shiftName</label>
                    </div>
                }
            </div>
        </div>

        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
    </div>
</form>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        const opCheckbox = document.getElementById('operationalDay');
        const shiftBoxes = document.querySelectorAll('.shift-checkbox');
        const filterForm = document.getElementById('filterForm');

        if (!filterForm) {
            return;
        }

        // safe toggle function — guard if opCheckbox missing
        function toggleShifts() {
            const isOperationalDay = opCheckbox ? opCheckbox.checked : false;

            shiftBoxes.forEach(cb => {
                cb.disabled = !isOperationalDay;
            });
        }

        // On submit: ensure we send exactly one operationalDay value and enable shift checkboxes
        filterForm.addEventListener('submit', function (e) {


            // Remove any existing operationalDay inputs to avoid duplicate values
            const existingOpFields = filterForm.querySelectorAll('input[name="operationalDay"]');
            existingOpFields.forEach(el => {
                // keep the actual checkbox element; remove hidden duplicates only
                if (el !== opCheckbox) el.remove();
            });

            if (opCheckbox) {

                const opHidden = document.createElement('input');
                opHidden.type = 'hidden';
                opHidden.name = 'operationalDay';
                opHidden.value = opCheckbox.checked ? 'true' : 'false';
                filterForm.appendChild(opHidden);

            } else {
                // If checkbox missing, still ensure a value is sent (false)
                const opHidden = document.createElement('input');
                opHidden.type = 'hidden';
                opHidden.name = 'operationalDay';
                opHidden.value = 'false';
                filterForm.appendChild(opHidden);

            }

            // Enable all shift checkboxes before submission (disabled inputs are not submitted)
            shiftBoxes.forEach(cb => {
                const originalDisabled = cb.disabled;
                cb.disabled = false;

            });

        });

        toggleShifts();

        // watch for changes (guard opCheckbox may be null)
        if (opCheckbox) {
            opCheckbox.addEventListener('change', function () {

                toggleShifts();
            });
        }

        shiftBoxes.forEach(cb => {

        });

        // Export button handlers (placeholder)
        document.getElementById('btnDownloadPdf')?.addEventListener('click', function () {
            alert('PDF export functionality to be implemented');
        });

        document.getElementById('btnDownloadExcel')?.addEventListener('click', function () {
            alert('Excel export functionality to be implemented');
        });
    });
</script>
