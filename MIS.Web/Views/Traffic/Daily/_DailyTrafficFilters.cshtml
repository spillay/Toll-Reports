@model MIS.Web.Models.Traffic.Daily.DailyTrafficInputModel
@removeTagHelper "Microsoft.AspNetCore.Mvc.TagHelpers.OptionTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers"


@{
    var classes = new List<string> { "Class 1", "Class 2", "Class 4", "Motor Cycle" };
}

<form method="get" asp-controller="DailyTraffic" asp-action="Index" id="filterForm" class="mb-4">
    <div class="row g-3 align-items-end">
        <!-- Start Date -->
        <div class="col-md-3">
            <label class="form-label fw-semibold">Start Date</label>
            <input type="date" name="startDate" class="form-control"
                   value="@(Model?.StartDate.ToString("yyyy-MM-dd") ?? "")" required />
        </div>

        <!-- End Date -->
        <div class="col-md-3">
            <label class="form-label fw-semibold">End Date</label>
            <input type="date" name="endDate" class="form-control"
                   value="@(Model?.EndDate.ToString("yyyy-MM-dd") ?? "")" required />
        </div>

        <!-- Classification -->
        <div class="col-md-3">
            <label class="form-label fw-semibold">Class</label>
            <select name="classification" class="form-select">
                <option value="">All</option>
                @foreach (var cls in classes)
                {
                    <option value="@cls" @(Model?.Classification == cls ? "selected" : "")>@cls</option>
                }
            </select>
        </div>

        <!-- Operational Day -->
        <div class="col-md-3">
            <div class="form-check mt-4">
                <input class="form-check-input" type="checkbox" id="operationalDay"
                       name="operationalDay" value="true"
                       @(Model?.OperationalDay == true ? "checked" : "") />
                <label class="form-check-label fw-semibold" for="operationalDay">Operational Day</label>
            </div>
        </div>

        <!-- Shifts -->
        <div class="col-md-6">
            <label class="form-label fw-semibold">Operational Shift</label>
            <div>
                @for (int i = 1; i <= 3; i++)
                {
                    var shiftName = i switch { 1 => "Shift 1", 2 => "Shift 2", 3 => "Shift 3", _ => "" };
                    bool isChecked = Model?.Shifts?.Contains(i) == true;
                    <div class="form-check form-check-inline">
                        <input class="form-check-input shift-checkbox" type="checkbox"
                               name="shifts" value="@i"
                               @(isChecked ? "checked" : "")
                               @(Model?.OperationalDay != true ? "disabled" : "") />
                        <label class="form-check-label" for="shift_@i">@shiftName</label>
                    </div>
                }
            </div>
        </div>

        <!-- Submit -->
        <div class="col-md-3 mt-3">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
    </div>
</form>
