@using MIS.Web.Models.Traffic.Hourly
@model PageHourlyTrafficModel

@{
    var classifications = ViewBag.Classifications as List<string> ?? new List<string>();
}

<div class="card shadow-lg mb-4">
    <div class="card-body">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
            <div></div>
            <h2 class="mb-0 fw-bold text-primary">Hourly Traffic Report</h2>
            <div></div>
        </div>

        <!-- Export Buttons -->
        <div class="row mb-3">
            <div class="col-md-2 d-flex align-items-end me-2">
                <button id="btnDownloadPdf" type="button" class="btn btn-danger w-100 shadow-sm">
                    <i class="bi bi-file-earmark-pdf"></i> Export PDF
                </button>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button id="btnDownloadExcel" type="button" class="btn btn-success w-100 shadow-sm">
                    <i class="bi bi-file-earmark-excel"></i> Export Excel
                </button>
            </div>
        </div>

        <!-- Filter Form -->
        @Html.Partial("Hourly/_HourlyTrafficFilters", Model.Input)

        <!-- Data Table -->
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle">
                <thead class="table-light text-center">
                    <tr>
                        <th>Date</th>
                        <th>Hour</th>
                        @foreach (var cls in classifications)
                        {
                            <th>@cls</th>
                        }
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        var dayGroups = Model.Items.GroupBy(x => x.Period.Date).OrderBy(g => g.Key);

                        foreach (var dayGroup in dayGroups)
                        {
                            var dailyTotals = classifications.ToDictionary(c => c, c => 0);

                            <!-- Day Header Row -->
                            <tr class="table-light fw-bold">
                                <td colspan="@(classifications.Count + 3)" class="text-start">
                                    @dayGroup.Key.ToString("dd/MM/yyyy")
                                </td>
                            </tr>

                            <!-- Hourly Breakdown -->
                            var hourlyGroups = dayGroup.GroupBy(x => x.Period.Hour).OrderBy(h => h.Key);

                            foreach (var hourGroup in hourlyGroups)
                            {
                                int rowTotal = 0;
                                <tr>
                                    <td></td>
                                    <td>@(new DateTime(1, 1, 1, hourGroup.Key, 0, 0).ToString("HH:mm"))</td>

                                    @foreach (var cls in classifications)
                                    {
                                        int count = hourGroup.FirstOrDefault(x => x.Classification == cls)?.Count ?? 0;
                                        <td>@count</td>
                                        rowTotal += count;
                                        dailyTotals[cls] += count;
                                    }
                                    <td>@rowTotal</td>
                                </tr>
                            }

                            var dailyGrandTotal = dailyTotals.Values.Sum();
                            var dailyPercentages = dailyTotals.ToDictionary(kv => kv.Key, kv => dailyGrandTotal > 0 ? (double)kv.Value / dailyGrandTotal * 100 : 0);
                            var dailyAverage = hourlyGroups.Count() > 0
                            ? dailyTotals.ToDictionary(kv => kv.Key, kv => (double)kv.Value / hourlyGroups.Count())
                            : dailyTotals.ToDictionary(kv => kv.Key, kv => 0.0);
                            var dailyMaximum = classifications.ToDictionary(cls => cls,
                            cls => dayGroup.Where(x => x.Classification == cls).Select(x => x.Count).DefaultIfEmpty(0).Max());

                            <!-- Daily Summary Rows -->
                            <tr class="fw-bold bg-light">
                                <td colspan="2">Total for the Day</td>
                                @foreach (var cls in classifications)
                                {
                                    <td>@dailyTotals[cls]</td>
                                }
                                <td>@dailyGrandTotal</td>
                            </tr>

                            <tr class="fw-bold bg-light">
                                <td colspan="2">Percentage</td>
                                @foreach (var cls in classifications)
                                {
                                    <td>@dailyPercentages[cls].ToString("0.00") %</td>
                                }
                                <td>100%</td>
                            </tr>

                            <tr class="fw-bold bg-light">
                                <td colspan="2">Average</td>
                                @foreach (var cls in classifications)
                                {
                                    <td>@Math.Round(dailyAverage[cls])</td>
                                }
                                <td>@Math.Round(dailyAverage.Values.Sum())</td>
                            </tr>

                            <tr class="fw-bold bg-light">
                                <td colspan="2">Maximum</td>
                                @foreach (var cls in classifications)
                                {
                                    <td>@dailyMaximum[cls]</td>
                                }
                                <td>@dailyMaximum.Values.Sum()</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(classifications.Count + 3)" class="text-center">
                                No data available for the selected range.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Inject server-side values safely
            const currentUser = '@(User.Identity?.Name ?? "Unknown User")';
            const reportGeneratedAt = '@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")';
            const reportVersion = '1.0';

            // Logo file paths (update if your logos are in a different folder or have different filenames)
            const leftLogoUrl = '/images/lCC Logo.jpg';         // left logo (LCC)
            const rightLogoUrl = '/images/ICT-Works Logo.jpg'; // right logo (ICT-Works)

            // Helper: load image and convert to data URL using a canvas (supports JPEG/PNG)
            function loadImageAsDataUrl(src) {
                return new Promise((resolve) => {
                    const img = new Image();
                    img.crossOrigin = 'Anonymous'; // attempt to avoid tainting canvas
                    img.onload = function () {
                        try {
                            const canvas = document.createElement('canvas');
                            canvas.width = img.naturalWidth;
                            canvas.height = img.naturalHeight;
                            const ctx = canvas.getContext('2d');
                            ctx.drawImage(img, 0, 0);
                            // Prefer PNG if source contains transparency; otherwise use JPEG
                            const mime = src.toLowerCase().endsWith('.png') ? 'image/png' : 'image/jpeg';
                            const dataUrl = canvas.toDataURL(mime);
                            resolve(dataUrl);
                        } catch (err) {
                            // If canvas is tainted or something fails, resolve null
                            console.warn('Could not convert image to data URL', src, err);
                            resolve(null);
                        }
                    };
                    img.onerror = function () {
                        // Image not found or failed to load
                        console.warn('Logo failed to load:', src);
                        resolve(null);
                    };
                    img.src = src;
                });
            }

            // === PDF Export ===
            document.getElementById("btnDownloadPdf").addEventListener("click", async function () {
                const { jsPDF } = window.jspdf;
                const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "a4" });

                const pageWidth = doc.internal.pageSize.getWidth();
                const pageHeight = doc.internal.pageSize.getHeight();
                const margin = 40;

                // Load logos in parallel; may return null if unavailable
                const [leftDataUrl, rightDataUrl] = await Promise.all([
                    loadImageAsDataUrl(leftLogoUrl),
                    loadImageAsDataUrl(rightLogoUrl)
                ]);

                // Add logos if available (scale to fit)
                const logoSize = { width: 80, height: 80 }; // visual size in PDF points
                if (leftDataUrl) {
                    try { doc.addImage(leftDataUrl, leftDataUrl.startsWith('data:image/png') ? 'PNG' : 'JPEG', margin, 30, logoSize.width, logoSize.height); }
                    catch (e) { console.warn('Failed to add left logo to PDF', e); }
                }
                if (rightDataUrl) {
                    try { doc.addImage(rightDataUrl, rightDataUrl.startsWith('data:image/png') ? 'PNG' : 'JPEG', pageWidth - margin - logoSize.width, 30, logoSize.width, logoSize.height); }
                    catch (e) { console.warn('Failed to add right logo to PDF', e); }
                }

                // Title (centered) and subtitle (centered)
                doc.setFont("helvetica", "bold");
                doc.setFontSize(14);
                doc.text("LEKKI CONCESSION COMPANY LIMITED", pageWidth / 2, 50, { align: "center" });

                doc.setFontSize(12);
                doc.text("Hourly Traffic Report", pageWidth / 2, 72, { align: "center" });

                // Metadata lines - LEFT aligned (you asked date should not be in the center)
                doc.setFont("helvetica", "normal");
                doc.setFontSize(10);
                const metaStartY = 110;
                doc.text(`Generated By: ${currentUser}`, margin, metaStartY);
                doc.text(`Date: ${reportGeneratedAt}`, margin, metaStartY + 14);
                doc.text(`Version: ${reportVersion}`, margin, metaStartY + 28);

                // Grab table headers & rows from DOM
                const table = document.querySelector("table");
                // If no table, bail out gracefully
                if (!table) {
                    alert('No table found to export.');
                    return;
                }

                const headers = Array.from(table.querySelectorAll("thead th"))
                                     .map(th => th.innerText.trim());

                // Collect rows: skip rows with colspan header (day headers) so the exported table is rectangular.
                // We'll export the full tbody, but convert day-header rows (the ones with colspan) into a single row with date in first column.
                const rawRows = Array.from(table.querySelectorAll("tbody tr"));
                const bodyRows = [];

                rawRows.forEach(tr => {
                    const tds = Array.from(tr.querySelectorAll("td"));
                    // If this is a day header row (colspan present), produce a single-row entry with date in first column and blanks afterwards.
                    if (tds.length === 1 && tds[0].hasAttribute('colspan')) {
                        const dateText = tds[0].innerText.trim();
                        // push a row where the first column is the date and the rest are empty to keep shape
                        const emptyRow = new Array(headers.length).fill('');
                        emptyRow[0] = dateText;
                        bodyRows.push(emptyRow);
                    } else {
                        // normal row: map all td text values (trimmed)
                        const values = tds.map(td => td.innerText.trim());
                        // If the row has fewer columns than headers (unlikely), pad
                        while (values.length < headers.length) values.push('');
                        bodyRows.push(values);
                    }
                });

                // autoTable - use light neutral head background and alternating very light rows
                doc.autoTable({
                    head: [headers],
                    body: bodyRows,
                    startY: metaStartY + 40,
                    theme: "grid",
                    styles: {
                        fontSize: 9,
                        cellPadding: 4,
                        halign: "center",
                        valign: "middle",
                        textColor: 20
                    },
                    headStyles: {
                        fillColor: [230, 230, 230], // neutral light gray
                        textColor: 20,
                        fontStyle: "bold"
                    },
                    alternateRowStyles: { fillColor: [250, 250, 250] },
                    margin: { left: margin, right: margin },
                    // Ensure day header rows (where first cell contains a date) are left-aligned and span visually
                    didParseCell: function (data) {
                        // If the cell is from a "day header" row we created (value looks like dd/MM/yyyy)
                        if (data.section === 'body' && data.row && data.row.cells && data.row.cells[0]) {
                            const firstCellText = String(data.row.cells[0].raw || '').trim();
                            // crude check for dd/MM/yyyy pattern — if match, left-align full row
                            if (/^\d{2}\/\d{2}\/\d{4}$/.test(firstCellText)) {
                                // left-align the first cell
                                data.row.cells[0].styles.halign = 'left';
                                // also set bold and slightly darker background for that whole row
                                for (let ci in data.row.cells) {
                                    data.row.cells[ci].styles.fontStyle = 'bold';
                                    data.row.cells[ci].styles.fillColor = [245, 245, 245];
                                }
                            }
                        }
                    }
                });

                // Footer pagination
                const pageCount = doc.internal.getNumberOfPages();
                for (let i = 1; i <= pageCount; i++) {
                    doc.setPage(i);
                    doc.setFontSize(9);
                    doc.setFont("helvetica", "normal");
                    doc.text(`Page ${i} of ${pageCount}`, pageWidth - margin, pageHeight - 10, { align: "right" });
                }

                // Save PDF
                const filename = `HourlyTrafficReport_${new Date().toISOString().slice(0,19).replace(/[:T]/g, "-")}.pdf`;
                doc.save(filename);
            });

            // === Excel Export ===
            document.getElementById("btnDownloadExcel").addEventListener("click", function () {
                const table = document.querySelector("table");
                if (!table) {
                    alert('No table found to export.');
                    return;
                }
                const wb = XLSX.utils.book_new();

                // Convert HTML table to sheet; this will include visible day header rows as rows with a single cell.
                const ws = XLSX.utils.table_to_sheet(table, { raw: true });

                // Optionally tweak header styles or column widths here (SheetJS has limited styling in browser)
                XLSX.utils.book_append_sheet(wb, ws, "Hourly Traffic Report");

                const filename = `HourlyTrafficReport_${new Date().toISOString().slice(0,19).replace(/[:T]/g, "-")}.xlsx`;
                XLSX.writeFile(wb, filename);
            });
        });
    </script>
}

