@model MIS.Web.Models.Traffic.Hourly.HourlyTrafficInputModel

@{
    var classes = new List<string> { "Class 1", "Class 2", "Class 4", "Class M" };
}

<form method="get" asp-controller="Traffic" asp-action="HourlyReport" id="filterForm" class="mb-4">
    <div class="row g-3 align-items-end">

        @* <!-- Start Date -->
        <div class="col-md-3">
            <label class="form-label">Start Date</label>
            <input type="date" name="startDate" class="form-control"
                   value="@Model.StartDate.ToString("yyyy-MM-dd")" />
        </div>

        <!-- End Date -->
        <div class="col-md-3">
            <label class="form-label">End Date</label>
            <input type="date" name="endDate" class="form-control"
                   value="@Model.EndDate.ToString("yyyy-MM-dd")" />
        </div> *@

        <div class="col-md-3">
            <label class="form-label fw-semibold">Start Date And Time</label>
            <input type="datetime-local" name="startDate" class="form-control"
                   value="@Model.StartDate.ToString("yyyy-MM-ddTHH:mm")" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-semibold">End Date And Time</label>
            <input type="datetime-local" name="endDate" class="form-control"
                   value="@Model.EndDate.ToString("yyyy-MM-ddTHH:mm")" />
        </div>

        <!-- Classification -->
        <div class="col-md-3">
            <label class="form-label">Class </label>
            <select name="classification" class="form-select">
                <option value="">All</option>
                @foreach (var cls in classes)
                {
                    <option value="@cls" selected="@(Model.Classification == cls ? "selected" : null)">@cls</option>
                }
            </select>
        </div>

        <!-- Operational Day -->
        <div class="col-md-3">
            <label class="form-label d-block">Operational Day</label>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="operationalDay"
                       id="opYes" value="true" @(Model.OperationalDay ? "checked" : "")>
                <label class="form-check-label" for="opYes">Yes</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="operationalDay"
                       id="opNo" value="false" @(!Model.OperationalDay ? "checked" : "")>
                <label class="form-check-label" for="opNo">No</label>
            </div>
        </div>

        <!-- Shifts -->
        <div class="col-12 mt-2">
            <label class="form-label">Operational Shift</label>
            <div id="shiftsContainer" class="mb-3">
                @for (int i = 1; i <= 3; i++)
                {
                    var shiftChecked = Model.Shifts?.Contains(i) == true ? "checked" : "";
                    <div class="form-check form-check-inline">
                        <input class="form-check-input shift-checkbox"
                               type="checkbox" name="shifts" value="@i" id="shift@i" @shiftChecked>
                        <label class="form-check-label" for="shift@i">Shift @i</label>
                    </div>
                }
            </div>
        </div>

        <!-- Filter Button -->
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
    </div>
</form>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const opYes = document.getElementById("opYes");
        const opNo = document.getElementById("opNo");
        const shiftCheckboxes = document.querySelectorAll(".shift-checkbox");

        function toggleShifts() {
            const enable = opYes?.checked;
            shiftCheckboxes.forEach(cb => {
                cb.disabled = !enable;
                if (!enable) cb.checked = false;
            });
        }

        if (opYes && opNo && shiftCheckboxes.length > 0) {
            toggleShifts();
            opYes.addEventListener("change", toggleShifts);
            opNo.addEventListener("change", toggleShifts);
        }
    });
</script>

