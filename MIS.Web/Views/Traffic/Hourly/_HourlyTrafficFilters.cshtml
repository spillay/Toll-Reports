@model MIS.Web.Models.Traffic.Hourly.PageHourlyTrafficModel

@{
    var input = Model.Input ?? new MIS.Web.Models.Traffic.Hourly.HourlyTrafficInputModel();
    var classes = Model.Classifications ?? new List<string>();

    var selected = (input.Classification ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries)
        .Select(x => x.Trim())
        .ToHashSet(StringComparer.OrdinalIgnoreCase);
}

<form method="get" asp-controller="Traffic" asp-action="HourlyReport" id="filterForm" class="mb-4">
    <div class="row g-3 align-items-end">

        <!-- Start DateTime -->
        <div class="col-md-3">
            <label class="form-label fw-semibold">Start Date And Time</label>
            <input type="datetime-local" name="startDate" class="form-control"
                   value="@input.StartDate.ToString("yyyy-MM-ddTHH:mm")" />
        </div>

        <!-- End DateTime -->
        <div class="col-md-3">
            <label class="form-label fw-semibold">End Date And Time</label>
            <input type="datetime-local" name="endDate" class="form-control"
                   value="@input.EndDate.ToString("yyyy-MM-ddTHH:mm")" />
        </div>

        <!-- Classes (Checklist) - SAME COL SIZE -->
        <div class="col-md-3">
            <label class="form-label fw-semibold">Class</label>

            <div class="border rounded p-2" style="max-height: 180px; overflow-y: auto;">
                @if (classes.Any())
                {
                    foreach (var cls in classes)
                    {
                        var isChecked = selected.Contains(cls);
                        var safeId = "cls_" + cls.Replace(" ", "_").Replace("/", "_").Replace("-", "_");

                        <div class="form-check">
                            <input class="form-check-input class-checkbox"
                                   type="checkbox"
                                   id="@safeId"
                                   value="@cls"
                                   @(isChecked ? "checked" : "") />
                            <label class="form-check-label" for="@safeId">@cls</label>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted small">No classifications found.</div>
                }
            </div>

            <!-- Hidden input sent to controller as CSV -->
            <input type="hidden" name="classification" id="classificationHidden" value="@input.Classification" />
        </div>

        <!-- Operational Day -->
        <div class="col-md-3">
            <label class="form-label d-block fw-semibold">Operational Day</label>

            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="operationalDay"
                       id="opYes" value="true" @(input.OperationalDay ? "checked" : "")>
                <label class="form-check-label" for="opYes">Yes</label>
            </div>

            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="operationalDay"
                       id="opNo" value="false" @(!input.OperationalDay ? "checked" : "")>
                <label class="form-check-label" for="opNo">No</label>
            </div>
        </div>

        <!-- Shifts -->
        <div class="col-12 mt-2">
            <label class="form-label fw-semibold">Operational Shift</label>
            <div id="shiftsContainer" class="mb-3">
                @for (int i = 1; i <= 3; i++)
                {
                    var shiftChecked = input.Shifts?.Contains(i) == true ? "checked" : "";
                    <div class="form-check form-check-inline">
                        <input class="form-check-input shift-checkbox"
                               type="checkbox" name="shifts" value="@i" id="shift@i" @shiftChecked>
                        <label class="form-check-label" for="shift@i">Shift @i</label>
                    </div>
                }
            </div>
        </div>

        <!-- Filter Button -->
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
    </div>
</form>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        // === Build comma-separated classification list for backend ===
        const form = document.getElementById("filterForm");
        const hidden = document.getElementById("classificationHidden");

        function syncClassesToHidden() {
            const checked = Array.from(document.querySelectorAll(".class-checkbox:checked"))
                .map(x => x.value.trim());
            hidden.value = checked.join(",");
        }

        if (form && hidden) {
            document.querySelectorAll(".class-checkbox").forEach(cb => {
                cb.addEventListener("change", syncClassesToHidden);
            });

            form.addEventListener("submit", function () {
                syncClassesToHidden();
            });

            // ✅ sync on load
            syncClassesToHidden();
        }

        // === Operational day shift enable/disable (same behavior) ===
        const opYes = document.getElementById("opYes");
        const opNo = document.getElementById("opNo");
        const shiftCheckboxes = document.querySelectorAll(".shift-checkbox");

        function toggleShifts() {
            const enable = opYes && opYes.checked;
            shiftCheckboxes.forEach(cb => {
                cb.disabled = !enable;
                if (!enable) cb.checked = false;
            });
        }

        if (opYes && opNo && shiftCheckboxes.length > 0) {
            toggleShifts();
            opYes.addEventListener("change", toggleShifts);
            opNo.addEventListener("change", toggleShifts);
        }
    });
</script>