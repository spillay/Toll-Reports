@model MIS.Web.Models.Traffic.PageTrafficModel
@using System.Globalization

@{
    var input = ViewBag.InputModel as MIS.Web.Models.Traffic.TrafficInputModel ?? new MIS.Web.Models.Traffic.TrafficInputModel
    {
        StartDate = DateTime.UtcNow.Date,
        EndDate = DateTime.UtcNow.Date.AddDays(1).AddSeconds(-1),
        Classification = ""
    };

    var reportVersion = "1";
    string currentUserId = User?.Identity?.Name ?? "Lucky";
    DateTime reportGeneratedAt = DateTime.Now;
}

<div class="card shadow-lg mb-4">
    <div class="card-body">

        <!-- ===== HEADER ===== -->
        <div class="text-center border-bottom pb-3 mb-4">
            <h2 class="fw-bold text-primary mb-0">Traffic Report</h2>
            <small class="text-muted">Hourly / Daily / Monthly Summary</small>
        </div>

        <!-- ===== FILTER FORM ===== -->
        <form method="get" asp-action="Traffic" asp-controller="Traffic" class="mb-4">
            <div class="row g-3 align-items-end">

                <div class="col-md-3">
                    <label for="StartDate" class="form-label">Start Date & Time</label>
                    <input type="datetime-local" id="StartDate" name="startDate" class="form-control"
                           value="@input.StartDate.ToString("yyyy-MM-ddTHH:mm")" />
                </div>

                <div class="col-md-3">
                    <label for="EndDate" class="form-label">End Date & Time</label>
                    <input type="datetime-local" id="EndDate" name="endDate" class="form-control"
                           value="@input.EndDate.ToString("yyyy-MM-ddTHH:mm")" />
                </div>

                <div class="col-md-3">
                    <label for="Classification" class="form-label">Classification</label>
                    <select id="Classification" name="classification" class="form-select">
                        <option value="">All</option>
                        @if (ViewBag.Classifications is IEnumerable<string> classifications)
                        {
                            foreach (var cls in classifications)
                            {
                                <option value="@cls" selected="@(input.Classification == cls)">
                                    @cls
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel"></i> Filter
                    </button>
                </div>
            </div>
        </form>

        <!-- ===== EXPORT BUTTONS ===== -->
        <div class="d-flex gap-2 mb-4">
            <button id="btnExportPdf" type="button" class="btn btn-danger flex-fill">
                <i class="bi bi-file-earmark-pdf"></i> Export PDF
            </button>
            <button id="btnExportExcel" type="button" class="btn btn-success flex-fill">
                <i class="bi bi-file-earmark-excel"></i> Export Excel
            </button>
        </div>

        <!-- ===== DATA TABLE ===== -->
        <div class="table-responsive">
            <table class="table table-bordered table-striped text-center align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Date / Period</th>
                        <th>Classification</th>
                        <th>Count</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.Items?.Any() == true)
                    {
                        foreach (var row in Model.Items)
                        {
                            <tr>
                                <td>@row.Date.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@row.Classification</td>
                                <td>@string.Format(CultureInfo.InvariantCulture, "{0:N0}", row.Count)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-muted py-3">No data available for the selected filters.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- ===== PAGINATION ===== -->
        @if (Model?.totalPages > 1)
        {
            <div class="mt-3 d-flex justify-content-between align-items-center">
                <div class="text-muted">
                    Page <strong>@Model.page</strong> of <strong>@Model.totalPages</strong> |
                    Records: <strong>@Model.totalCount</strong>
                </div>

                <ul class="pagination mb-0">
                    <li class="page-item @(Model.page <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           href="@Url.Action("Traffic", "Traffic", new { pageNumber = Model.page - 1, pageSize = Model.pageSize, startDate = input.StartDate.ToString("s"), endDate = input.EndDate.ToString("s"), classification = input.Classification })">Previous</a>
                    </li>

                    @for (int i = 1; i <= Model.totalPages; i++)
                    {
                        <li class="page-item @(i == Model.page ? "active" : "")">
                            <a class="page-link"
                               href="@Url.Action("Traffic", "Traffic", new { pageNumber = i, pageSize = Model.pageSize, startDate = input.StartDate.ToString("s"), endDate = input.EndDate.ToString("s"), classification = input.Classification })">@i</a>
                        </li>
                    }

                    <li class="page-item @(Model.page >= Model.totalPages ? "disabled" : "")">
                        <a class="page-link"
                           href="@Url.Action("Traffic", "Traffic", new { pageNumber = Model.page + 1, pageSize = Model.pageSize, startDate = input.StartDate.ToString("s"), endDate = input.EndDate.ToString("s"), classification = input.Classification })">Next</a>
                    </li>
                </ul>
            </div>
        }

        <!-- ===== FOOTER ===== -->
        <div class="mt-4 p-3 border-top bg-light small">
            <div class="d-flex justify-content-between">
                <span><strong>Generated by:</strong> @currentUserId</span>
                <span><strong>Date:</strong> @reportGeneratedAt</span>
                <span>Report @reportVersion</span>
            </div>
        </div>
    </div>
</div>

<!-- ===== EXPORT SCRIPTS ===== -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>

<script>
    const getQuery = () => {
        const params = new URLSearchParams();
        const s = document.getElementById("StartDate")?.value;
        const e = document.getElementById("EndDate")?.value;
        const c = document.getElementById("Classification")?.value;
        if (s) params.set("startDate", s);
        if (e) params.set("endDate", e);
        if (c) params.set("classification", c);
        return params.toString();
    };

    async function fetchAllTraffic() {
        const res = await fetch('/Traffic/GetAllTrafficJson?' + getQuery());
        const data = await res.json();
        return data.success ? data.data : [];
    }

    document.getElementById("btnExportPdf").onclick = async () => {
        const data = await fetchAllTraffic();
        if (!data.length) return alert("No data to export.");

        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: "landscape" });
        doc.text("Traffic Report (All Data)", 140, 20, { align: "center" });

        const rows = data.map(x => [
            x.period, x.classification, x.count
        ]);

        doc.autoTable({
            head: [["Period", "Classification", "Count"]],
            body: rows,
            startY: 30,
            styles: { fontSize: 8 },
            theme: "grid"
        });

        doc.save("Traffic_Report_All.pdf");
    };

    document.getElementById("btnExportExcel").onclick = async () => {
        const data = await fetchAllTraffic();
        if (!data.length) return alert("No data to export.");

        const ws = XLSX.utils.json_to_sheet(data);
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, "Traffic");
        XLSX.writeFile(wb, "Traffic_Report_All.xlsx");
    };
</script>
