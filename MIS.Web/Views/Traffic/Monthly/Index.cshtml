@model MIS.Web.Models.Traffic.Monthly.PageMonthlyTrafficModel
@using System.Globalization
@using System.Linq

@{
    var input = ViewBag.InputModel as MIS.Web.Models.Traffic.Monthly.MonthlyTrafficInputModel
                ?? new MIS.Web.Models.Traffic.Monthly.MonthlyTrafficInputModel();
    var classifications = ViewBag.Classifications as List<string> ?? new List<string>();

    // Common footer + PDF meta
    var reportGeneratedAt = DateTime.Now;
    var currentUser = User.Identity?.Name ?? "Lucky";
    var reportVersion = "2.0.0.11";

    // Filters for PDF "Filters Used" section
    string filterYear = input.Year?.ToString() ?? "All";
    string filterMonth = input.Month.HasValue
        ? CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(input.Month.Value)
        : "All";
    string filterOperationalMonth = input.OperationalMonth ? "Yes" : "No";
    string filterClass = string.IsNullOrEmpty(input.Classification) ? "All" : input.Classification;
    string filterShifts = (input.Shifts != null && input.Shifts.Any())
        ? string.Join(", ", input.Shifts)
        : "All";
}

<div class="card shadow-lg mb-4">
    <div class="card-body">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
            <div></div>
            <h2 class="mb-0 fw-bold text-center text-primary">MONTHLY TRAFFIC REPORT</h2>
            <div></div>
        </div>

        <!-- Export Buttons -->
        <div class="row mb-3">
            <div class="col-md-2 d-flex align-items-end me-2">
                <button id="btnDownloadPdf" type="button" class="btn btn-danger w-100 shadow-sm">
                    <i class="bi bi-file-earmark-pdf"></i> Export PDF
                </button>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button id="btnDownloadExcel" type="button" class="btn btn-success w-100 shadow-sm">
                    <i class="bi bi-file-earmark-excel"></i> Export Excel
                </button>
            </div>
        </div>

        <!-- Filter Form -->
        <form method="get" asp-controller="MonthlyTraffic" asp-action="Index" id="filterForm" class="mb-4">
            <div class="row g-3 align-items-end">
                <!-- Year -->
                <div class="col-md-3">
                    <label class="form-label">Year</label>
                    <select name="year" id="yearSelect" class="form-select">
                        <option value="">- All -</option>
                        @if (ViewBag.Years != null)
                        {
                            foreach (var y in ViewBag.Years as List<int>)
                            {
                                <option value="@y" selected="@(y == (input.Year ?? 0) ? "selected" : null)">@y</option>
                            }
                        }
                    </select>
                </div>

                <!-- Month -->
                <div class="col-md-3">
                    <label class="form-label">Month</label>
                    <select name="month" id="monthSelect" class="form-select" @(((ViewBag.Months as List<int>)?.Count ?? 0) == 0 ? "disabled" : "")>
                        <option value="">- All -</option>
                        @if (ViewBag.Months != null)
                        {
                            foreach (var m in ViewBag.Months as List<int>)
                            {
                                <option value="@m" selected="@(m == (input.Month ?? 0) ? "selected" : null)">
                                    @CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)
                                </option>
                            }
                        }
                    </select>
                </div>
                <!-- Classification -->
                <div class="col-md-3">
                    <label class="form-label">Class</label>
                    <select name="classification" class="form-select" id="classificationSelect">
                        <option value="">- All -</option>
                        <option value="Class 1">Class 1</option>
                        <option value="Class 2">Class 2</option>
                        <option value="Class 4">Class 4</option>
                        <option value="Class M">Class M</option>
                    </select>
                </div>

                <!-- Operational Month -->
                <div class="col-md-3">
                    <label class="form-label d-block">Operational Month</label>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="operationalMonth" id="opYes" value="true" @(input.OperationalMonth ? "checked" : "")>
                        <label class="form-check-label" for="opYes">Yes</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="operationalMonth" id="opNo" value="false" @(!input.OperationalMonth ? "checked" : "")>
                        <label class="form-check-label" for="opNo">No</label>
                    </div>
                </div>

                <!-- Shifts -->
                <div class="col-12 mt-2">
                    <label class="form-label">Operational Shifts</label>
                    <div id="shiftsContainer" class="mb-3">
                        @for (int i = 1; i <= 3; i++)
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input shift-checkbox" type="checkbox" name="shifts" value="@i" id="shift@i"
                                       @(input.Shifts.Contains(i) ? "checked" : "") @(input.OperationalMonth ? "" : "disabled")>
                                <label class="form-check-label" for="shift@i">
                                    Shift @i
                                </label>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                </div>
            </div>
        </form>

        <!-- Data Table -->
        <div class="table-responsive mt-3">
            <table class="table table-bordered table-striped text-center align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="min-width:140px">Date</th>
                        <th style="min-width:120px"></th>
                        @foreach (var cls in classifications)
                        {
                            <th>@cls</th>
                        }
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        var monthGroups = Model.Items
                        .GroupBy(x => new { x.Year, x.Month })
                        .OrderBy(g => g.Key.Year)
                        .ThenBy(g => g.Key.Month)
                        .ToList();

                        // Grand total for entire period (used for monthly % in Total column)
                        int grandTotalForPeriod = Model.Items.Sum(x => x.Count);

                        var globalTotals = classifications.ToDictionary(c => c, c => 0);
                        var globalMaximums = classifications.ToDictionary(c => c, c => 0);
                        int globalMaxTotalForMonth = 0;

                        foreach (var monthGroup in monthGroups)
                        {
                            var monthlyTotals = classifications.ToDictionary(c => c, c => 0);
                            int monthGrandTotal = monthGroup.Sum(x => x.Count);

                            var monthName = CultureInfo.CurrentCulture.DateTimeFormat
                            .GetMonthName(monthGroup.Key.Month) + " " + monthGroup.Key.Year;

                            <!-- Traffic Row -->
                            <tr>
                                <td>@monthName</td>
                                <td>Traffic</td>
                                @foreach (var cls in classifications)
                                {
                                    int count = monthGroup.FirstOrDefault(x => x.Classification == cls)?.Count ?? 0;
                                    <td>@count.ToString("N0")</td>

                                    monthlyTotals[cls] += count;
                                    globalTotals[cls] += count;
                                    globalMaximums[cls] = Math.Max(globalMaximums[cls], count);
                                }
                                <td>@monthGrandTotal.ToString("N0")</td>
                            </tr>

                            <!-- Percentage Row (per month) -->
                            <tr>
                                <td></td>
                                <td>Percentage</td>
                                @foreach (var cls in classifications)
                                {
                                    double percent = monthGrandTotal > 0
                                    ? (double)monthlyTotals[cls] / monthGrandTotal * 100
                                    : 0;
                                    <td>@percent.ToString("0.00")%</td>
                                }

                                @{
                                    // 🔥 This is the fix: monthly total % over the grand total for the period
                                    double monthTotalPercent = grandTotalForPeriod > 0
                                    ? (double)monthGrandTotal / grandTotalForPeriod * 100
                                    : 0;
                                }
                                <td>@monthTotalPercent.ToString("0.00")%</td>
                            </tr>

                            globalMaxTotalForMonth = Math.Max(globalMaxTotalForMonth, monthGrandTotal);
                        }

                        var grandTotal = globalTotals.Values.Sum();
                        var monthCount = monthGroups.Count;

                        var globalPercentages = globalTotals.ToDictionary(
                        kv => kv.Key,
                        kv => grandTotal > 0 ? (double)kv.Value / grandTotal * 100 : 0
                        );

                        var globalAverages = globalTotals.ToDictionary(
                        kv => kv.Key,
                        kv => monthCount > 0 ? kv.Value / monthCount : 0
                        );
                        var averageGrandTotal = monthCount > 0 ? grandTotal / monthCount : 0;

                        <tr class="table-secondary fw-bold">
                            <td colspan="2">Total for the Period</td>
                            @foreach (var cls in classifications)
                            {
                                <td>@globalTotals[cls].ToString("N0")</td>
                            }
                            <td>@grandTotal.ToString("N0")</td>
                        </tr>

                        <tr class="table-secondary fw-bold">
                            <td colspan="2">Percentage</td>
                            @foreach (var cls in classifications)
                            {
                                <td>@globalPercentages[cls].ToString("0.00")%</td>
                            }
                            <td>100.00%</td>
                        </tr>

                        <tr class="table-secondary fw-bold">
                            <td colspan="2">Average</td>
                            @foreach (var cls in classifications)
                            {
                                <td>@globalAverages[cls].ToString("N0")</td>
                            }
                            <td>@averageGrandTotal.ToString("N0")</td>
                        </tr>

                        <tr class="table-secondary fw-bold">
                            <td colspan="2">Maximum</td>
                            @foreach (var cls in classifications)
                            {
                                <td>@globalMaximums[cls].ToString("N0")</td>
                            }
                            <td>@globalMaxTotalForMonth.ToString("N0")</td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(classifications.Count + 3)" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                No data available for the selected filters.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

        <!-- FOOTER (Style like your screenshot) -->
        <div class="mt-4 p-3 border-top bg-light">
            <table class="table table-borderless w-100 mb-0">
                <tr class="align-top">
                    <td style="width: 35%;">
                        <strong>Monthly Traffic Report</strong><br />
                    </td>
                    <td style="width: 30%;">
                        <strong>Date and Time:</strong><br />
                        <em>@reportGeneratedAt.ToString("dd/MM/yyyy HH:mm:ss")</em>
                    </td>
                    <td style="width: 25%;">
                        <strong>User ID:</strong><br />
                        <em>@currentUser</em>
                    </td>
                    <td style="width: 10%;" class="text-end">
                        Page 1 of 1
                    </td>
                </tr>
                <tr>
                    <td colspan="4">
                        <strong>Reports Module Version Number:</strong> @reportVersion
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.29/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {

            // ================================================
            //  CONFIG VALUES FROM RAZOR
            // ================================================
            const currentUser = '@currentUser';
            const reportGeneratedAt = '@reportGeneratedAt.ToString("dd/MM/yyyy HH:mm:ss")';
            const reportVersion = '@reportVersion';

            const filters = {
                "Year": "@filterYear",
                "Month": "@filterMonth",
                "Operational Month": "@filterOperationalMonth",
                "Class": "@filterClass",
                "Shifts": "@filterShifts"
            };

            const leftLogoUrl = '/images/lCC Logo.jpg';
            const rightLogoUrl = '/images/ICT-Works Logo.jpg';

            // ==============================================================
            //  Convert image to base64 for PDF
            // ==============================================================
            async function imgToDataURL(src) {
                return new Promise(res => {
                    const img = new Image();
                    img.crossOrigin = "Anonymous";
                    img.onload = function () {
                        const c = document.createElement("canvas");
                        c.width = img.width;
                        c.height = img.height;
                        c.getContext("2d").drawImage(img, 0, 0);
                        res(c.toDataURL("image/jpeg"));
                    };
                    img.onerror = () => res(null);
                    img.src = src;
                });
            }

            // ==============================================================
            //  Extract Razor Table EXACTLY as shown on screen
            // ==============================================================
            function extractRazorTable() {

                const table = document.querySelector(".table.table-bordered");
                const headCells = [...table.querySelectorAll("thead th")].map(th => th.innerText.trim());

                let bodyRows = [...table.querySelectorAll("tbody tr")].map(tr =>
                    [...tr.querySelectorAll("td")].map(td => td.innerText.trim())
                );

                // ============================================================
                // FIX: ALIGN SUMMARY ROWS UNDER CLASS COLUMNS
                // Insert empty "" in front so it aligns under Traffic column
                // ============================================================
                const summaryLabels = [
                    "Total for the Period",
                    "Percentage",
                    "Average",
                    "Maximum"
                ];

                bodyRows = bodyRows.map(row => {

                    const label = row[0]?.trim();

                    if (summaryLabels.includes(label)) {
                        // Convert:
                        // ["Total for the Period", "", 58, 27, ...]
                        // INTO:
                        // ["", "Total for the Period", 58, 27, ...]
                        return ["", label, ...row.slice(1)];
                    }

                    return row;
                });

                return { headCells, bodyRows };
            }

            // ==============================================================
            //  PDF EXPORT  —  PERFECT Razor Replica
            // ==============================================================
            document.getElementById("btnDownloadPdf")?.addEventListener("click", async () => {

                const { jsPDF } = window.jspdf;
                const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "a4" });

                const pageWidth = doc.internal.pageSize.getWidth();
                const pageHeight = doc.internal.pageSize.getHeight();
                const margin = 40;

                // Load logos
                const leftLogo = await imgToDataURL(leftLogoUrl);
                const rightLogo = await imgToDataURL(rightLogoUrl);

                const logoY = 25;
                const logoSize = 80;

                if (leftLogo) doc.addImage(leftLogo, "JPEG", margin, logoY, logoSize, logoSize);
                if (rightLogo) doc.addImage(rightLogo, "JPEG", pageWidth - margin - logoSize, logoY, logoSize, logoSize);

                // Header Title
                doc.setFont("helvetica", "bold");
                doc.setFontSize(14);
                doc.text("LEKKI CONCESSION COMPANY LIMITED", pageWidth / 2, logoY + 20, { align: "center" });

                doc.setFontSize(12);
                doc.text("Monthly Traffic Report", pageWidth / 2, logoY + 45, { align: "center" });

                // Filters Used
                let y = logoY + logoSize + 25;
                doc.setFontSize(10);
                doc.setFont("helvetica", "normal");
                doc.text("Filters Used:", margin, y);
                y += 14;

                for (const [key, value] of Object.entries(filters)) {
                    doc.text(`${key}: ${value}`, margin, y);
                    y += 12;
                }

                const tableStartY = y + 10;

                // Extract Razor Table
                const { headCells, bodyRows } = extractRazorTable();

                // Render Table
                doc.autoTable({
                    head: [headCells],
                    body: bodyRows,
                    startY: tableStartY,
                    theme: "grid",
                    headStyles: {
                        fillColor: [41, 128, 185],
                        textColor: 255,
                        fontStyle: "bold"
                    },
                    styles: {
                        fontSize: 9,
                        cellPadding: 4,
                        halign: "center",
                        valign: "middle"
                    },
                    alternateRowStyles: { fillColor: [245, 245, 245] },

                    didParseCell: function (data) {
                        try {
                            const row = data.row;
                            const raw = row.cells[0]?.raw ?? "";

                            // MONTH HEADER ROWS (e.g., "April 2025")
                            if (/^\w+\s+\d{4}$/.test(raw)) {
                                Object.values(row.cells).forEach(c => {
                                    c.styles.fillColor = [240, 240, 240];
                                    c.styles.fontStyle = "bold";
                                    c.styles.halign = "left";
                                });
                            }
                        } catch (err) { }
                    },

                    didDrawPage: function (data) {
                        const pageCount = doc.internal.getNumberOfPages();
                        const pageNumber = doc.internal.getCurrentPageInfo().pageNumber;

                        const footerY = pageHeight - 30;
                        doc.setFontSize(9);

                        doc.text("Monthly Traffic Report", margin, footerY);
                        doc.text(`Date and Time: ${reportGeneratedAt}`, pageWidth / 2.4, footerY);
                        doc.text(`User ID: ${currentUser}`, pageWidth / 1.55, footerY);
                        doc.text(`Page ${pageNumber} of ${pageCount}`, pageWidth - margin, footerY, { align: "right" });

                        doc.text(`Reports Module Version Number: ${reportVersion}`, margin, footerY + 14);
                    }
                });

                doc.save(`Monthly_Traffic_Report_${new Date().toISOString().replace(/[:.]/g, "-")}.pdf`);
            });

            // ==============================================================
            //  EXCEL EXPORT — EXACT Razor Format
            // ==============================================================
            document.getElementById("btnDownloadExcel")?.addEventListener("click", () => {

                const { headCells, bodyRows } = extractRazorTable();

                const wsData = [headCells, ...bodyRows];

                const wb = XLSX.utils.book_new();
                const ws = XLSX.utils.aoa_to_sheet(wsData);

                // Column widths
                ws["!cols"] = headCells.map(() => ({ wpx: 140 }));

                XLSX.utils.book_append_sheet(wb, ws, "Monthly Traffic Report");

                XLSX.writeFile(wb, `Monthly_Traffic_Report_${new Date().toISOString().replace(/[:.]/g, "-")}.xlsx`);
            });

        });
    </script>
}





