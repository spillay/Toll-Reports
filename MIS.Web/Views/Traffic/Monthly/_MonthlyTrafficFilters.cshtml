@model MIS.Web.Models.Traffic.Monthly.PageMonthlyTrafficModel

@{
    var filters = Model.Filters ?? new MIS.Web.Models.Traffic.Monthly.MonthlyTrafficInputModel();
}

<form method="get" asp-controller="MonthlyTraffic" asp-action="Index" id="filterForm" class="mb-4">
    <div class="row g-3 align-items-end">

        <!-- Year -->
        <div class="col-md-2">
            <label class="form-label fw-semibold">Year</label>
            <select name="year" class="form-select" id="yearSelect">
                <option value="">- All -</option>
                @foreach (var y in Model.AvailableYears)
                {
                    <option value="@y" selected="@(filters.Year == y)">@y</option>
                }
            </select>
        </div>

        <!-- Month -->
        <div class="col-md-2">
            <label class="form-label fw-semibold">Month</label>
            <select name="month" class="form-select" id="monthSelect" @(filters.Year.HasValue ? "" : "disabled")>
                <option value="">- All -</option>
                @foreach (var m in Model.AvailableMonths)
                {
                    <option value="@m" selected="@(filters.Month == m)">
                        @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m) (@m)
                    </option>
                }
            </select>
        </div>

        <!-- Operational Month -->
        <div class="col-md-2">
            <div class="form-check mt-4">
                <input class="form-check-input" type="checkbox"
                       name="operationalMonth" value="true"
                       id="operationalMonth"
                       checked="@(filters.OperationalMonth)" />
                <label class="form-check-label fw-semibold" for="operationalMonth">Operational Month</label>
            </div>
        </div>

        <!-- Classification Checklist -->
        <div class="col-md-6">
            <label class="form-label fw-semibold">Classification</label>
            <div class="border rounded p-2" style="max-height:150px; overflow-y:auto;">
                @foreach (var cls in Model.AvailableClassifications ?? new List<string>())
                {
                    var isChecked = filters.Classifications?.Contains(cls) == true;

                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               name="classification"
                               value="@cls"
                               id="cls_@cls.Replace(" ", "_")"
                               checked="@(isChecked)" />
                        <label class="form-check-label" for="cls_@cls.Replace(" ", "_")">@cls</label>
                    </div>
                }
            </div>
        </div>

        <!-- Shifts -->
        <div class="col-md-4">
            <label class="form-label fw-semibold">Shifts</label>
            <div>
                @for (int i = 1; i <= 3; i++)
                {
                    var isChecked = filters.Shifts?.Contains(i) == true;

                    <div class="form-check form-check-inline">
                        <input class="form-check-input shift-checkbox"
                               type="checkbox"
                               name="shifts"
                               value="@i"
                               id="shift_@i"
                               checked="@(isChecked)"
                               disabled="@(!filters.OperationalMonth)" />
                        <label class="form-check-label" for="shift_@i">Shift @i</label>
                    </div>
                }
            </div>
        </div>

        <!-- Submit -->
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
    </div>
</form>

<script>
    // Enable/disable shifts when operational month toggles
    (function () {
        const op = document.getElementById('operationalMonth');
        const shiftBoxes = document.querySelectorAll('.shift-checkbox');

        function sync() {
            const enabled = op.checked;
            shiftBoxes.forEach(cb => {
                cb.disabled = !enabled;
                if (!enabled) cb.checked = false;
            });
        }

        op?.addEventListener('change', sync);
        sync();
    })();
</script>