@model MIS.Web.Models.Traffic.TrafficInputModel
<form method="get" asp-action="Traffic" asp-controller="Traffic">
    <div class="row mb-3">

        <!-- Start Date & Time -->
        <div class="col-md-3">
            <label for="StartDate" class="form-label">Start Date & Time</label>
            <input type="datetime-local" id="StartDate" name="StartDate" class="form-control"
                   value="@(Model?.StartDate.ToString("yyyy-MM-ddTHH:mm") ?? "")" />
        </div>

        <!-- End Date & Time -->
        <div class="col-md-3">
            <label for="EndDate" class="form-label">End Date & Time</label>
            <input type="datetime-local" id="EndDate" name="EndDate" class="form-control"
                   value="@(Model?.EndDate.ToString("yyyy-MM-ddTHH:mm") ?? "")" />
        </div>

       

        <!-- Classification -->
        <div class="col-md-3">
            <label for="Classification" class="form-label">Classification</label>
            <select id="Classification" name="Classification" class="form-select">
                <option value="">All</option>
                @if (ViewBag.Classifications != null)
                {
                    foreach (var Classification in ViewBag.Classifications)
                    {
                        var selected = (Model?.Classification == Classification) ? "selected" : "";
                        @Html.Raw($"<option value='{Classification}' {selected}>{Classification}</option>")
                    }
                }
            </select>
        </div>

        <!-- Filter Button -->
        <div class="col-md-3 mt-3 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>

    </div>
</form>