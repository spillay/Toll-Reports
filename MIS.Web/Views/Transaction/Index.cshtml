@model MIS.Web.Models.TransactionInputModel
@using System.Text.Json

@{
    var reportVersion = "3.0.0.0";
    var currentUserId = User.FindFirst("firstName")?.Value ?? (User.Identity?.Name ?? "Lucky");
    var reportGenerated = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
    var items = Model.items ?? new List<MIS.Web.Models.Transaction.TransactionModel>();

    // Always keep paging safe, even when there is no data
    var currentPage = Model.page <= 0 ? 1 : Model.page;
    var totalPages = Model.totalPages <= 0 ? 1 : Model.totalPages;

    string FilterText(List<string> selected, List<string> allOptions)
    {
        selected ??= new List<string>();
        allOptions ??= new List<string>();

        var sel = selected
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        var all = allOptions
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (!sel.Any()) return "All";
        if (all.Any() && sel.Count >= all.Count) return "All";

        return string.Join(", ", sel);
    }

    var shiftText = FilterText(Model.SelectedShifts, Model.Shifts);
    var operatorText = FilterText(Model.SelectedTollOperators, Model.TollOperators);
    var laneText = FilterText(Model.SelectedLanes, Model.Lanes);
    var paymentText = FilterText(Model.SelectedPaymentMethods, Model.PaymentMethods);
    var collectorClassText = FilterText(Model.SelectedTollCollectorClasses, Model.TollCollectorClasses);

    var filters = Model;
    int startPage = Math.Max(1, currentPage - 1);
    int endPage = Math.Min(totalPages, currentPage + 1);
}

<div class="card shadow-lg mb-4">
    <div class="card-body">

        <div class="text-center mb-3 border-bottom pb-2">
            <h2 class="fw-bold text-primary mb-0">TRANSACTION DETAILS REPORT</h2>
        </div>

        <div class="row mb-3">
            <div class="col-md-2 me-2">
                <button id="btnDownloadPdf" class="btn btn-danger w-100 shadow-sm" type="button">
                    <i class="bi bi-file-earmark-pdf"></i> Export PDF
                </button>
            </div>

            <div class="col-md-2">
                <button id="btnDownloadExcel" class="btn btn-success w-100 shadow-sm" type="button">
                    <i class="bi bi-file-earmark-excel"></i> Export Excel
                </button>
            </div>
        </div>

        @Html.Partial("_TransactionFilters", Model)

        <div class="alert alert-light border mt-3">
            <div class="row g-2 small">
                <div class="col-md-3"><strong>Start:</strong> @Model.StartDate.ToString("dd/MM/yyyy HH:mm")</div>
                <div class="col-md-3"><strong>End:</strong> @Model.EndDate.ToString("dd/MM/yyyy HH:mm")</div>
                <div class="col-md-3"><strong>Shift:</strong> @shiftText</div>
                <div class="col-md-3"><strong>Operator:</strong> @operatorText</div>
                <div class="col-md-3"><strong>Lane:</strong> @laneText</div>
                <div class="col-md-3"><strong>Payment:</strong> @paymentText</div>
                <div class="col-md-3"><strong>Collector Class:</strong> @collectorClassText</div>
            </div>
        </div>

        <div class="table-responsive mt-3">
            <table class="table table-striped table-bordered align-middle text-center">
                <thead class="table-light">
                    <tr>
                        <th>Lane</th>
                        <th>Sequence No.</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Shift</th>
                        <th>Toll Operator</th>
                        <th>Payment Method</th>
                        <th>Collector Class</th>
                        <th>AVC Class</th>
                        <th>Final Class</th>
                        <th>Tariff</th>
                        <th>Tag/Card</th>
                    </tr>
                </thead>

                <tbody>
                    @if (items.Any())
                    {
                        foreach (var t in items)
                        {
                            <tr>
                                <td>@t.lane_Nr</td>
                                <td>@t.trx_Sequence_Nr</td>
                                <td>@t.trx_Date</td>
                                <td>@t.trx_Time</td>
                                <td>@t.operational_Shift</td>
                                <td>@t.toll_Operator_ID</td>
                                <td>@t.method_of_Payment</td>
                                <td>@t.toll_Collector_Class</td>
                                <td>@t.avC_Class</td>
                                <td>@t.final_Class</td>
                                <td>@(t.tariff?.ToString("N2") ?? "0.00")</td>
                                <td>@t.tac_Card_Number</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="12" class="py-3 text-muted">
                                No data available for the selected filters.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- SUMMARY: show on last page, and also works correctly when no data -->
        @if (totalPages <= 1 || currentPage == totalPages)
        {
            <div class="mt-4 border-top pt-3">
                <h5 class="fw-bold mb-3">Summary</h5>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="border rounded p-3 bg-light">
                            <h6 class="fw-bold">Filters Used</h6>
                            <div class="small">
                                <div><strong>Start Date:</strong> @Model.StartDate.ToString("dd/MM/yyyy HH:mm")</div>
                                <div><strong>End Date:</strong> @Model.EndDate.ToString("dd/MM/yyyy HH:mm")</div>
                                <div><strong>Shift:</strong> @shiftText</div>
                                <div><strong>Toll Operator:</strong> @operatorText</div>
                                <div><strong>Lane:</strong> @laneText</div>
                                <div><strong>Payment Method:</strong> @paymentText</div>
                                <div><strong>Toll Collector Class:</strong> @collectorClassText</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border rounded p-3 bg-light">
                            <h6 class="fw-bold">Totals</h6>
                            <div class="small">
                                <div><strong>Total Transaction Count:</strong> @Model.totalCount</div>
                                <div><strong>Total Transaction Value:</strong> @Model.TotalTariff.ToString("N2")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- PAGINATION-->
        <div class="mt-4 d-flex flex-column flex-md-row justify-content-between align-items-center border-top pt-3">

            @if (totalPages > 1)
            {
                <nav>
                    <ul class="pagination mb-0">

                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Transaction", "Transaction", new {
                                page = currentPage - 1,
                                pageSize = Model.pageSize,
                                SelectedShifts = filters.SelectedShifts,
                                SelectedTollOperators = filters.SelectedTollOperators,
                                SelectedLanes = filters.SelectedLanes,
                                SelectedPaymentMethods = filters.SelectedPaymentMethods,
                                SelectedTollCollectorClasses = filters.SelectedTollCollectorClasses,
                                StartDate = filters.StartDate.ToString("yyyy-MM-ddTHH:mm"),
                                EndDate = filters.EndDate.ToString("yyyy-MM-ddTHH:mm")
                            })">Previous</a>
                        </li>

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Transaction", "Transaction", new {
                                    page = i,
                                    pageSize = Model.pageSize,
                                    SelectedShifts = filters.SelectedShifts,
                                    SelectedTollOperators = filters.SelectedTollOperators,
                                    SelectedLanes = filters.SelectedLanes,
                                    SelectedPaymentMethods = filters.SelectedPaymentMethods,
                                    SelectedTollCollectorClasses = filters.SelectedTollCollectorClasses,
                                    StartDate = filters.StartDate.ToString("yyyy-MM-ddTHH:mm"),
                                    EndDate = filters.EndDate.ToString("yyyy-MM-ddTHH:mm")
                                })">@i</a>
                            </li>
                        }

                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Transaction", "Transaction", new {
                                page = currentPage + 1,
                                pageSize = Model.pageSize,
                                SelectedShifts = filters.SelectedShifts,
                                SelectedTollOperators = filters.SelectedTollOperators,
                                SelectedLanes = filters.SelectedLanes,
                                SelectedPaymentMethods = filters.SelectedPaymentMethods,
                                SelectedTollCollectorClasses = filters.SelectedTollCollectorClasses,
                                StartDate = filters.StartDate.ToString("yyyy-MM-ddTHH:mm"),
                                EndDate = filters.EndDate.ToString("yyyy-MM-ddTHH:mm")
                            })">Next</a>
                        </li>

                    </ul>
                </nav>
            }

        </div>

        <div class="mt-4 border-top pt-3">
            <table class="table table-borderless mb-0">
                <tr>
                    <td><strong>Transaction Details Report</strong></td>
                    <td><strong>Date And Time:</strong> @reportGenerated</td>
                    <td><strong>User:</strong> @currentUserId</td>
                    <td class="text-end">Page <strong>@currentPage</strong> of <strong>@totalPages</strong></td>
                </tr>
                <tr>
                    <td colspan="4">
                        <small class="text-muted">Reports Module Version Number: <strong>@reportVersion</strong></small>
                    </td>
                </tr>
            </table>
        </div>

    </div>
</div>

<!-- EXPORT LIBS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>

<script>
document.addEventListener("DOMContentLoaded", () => {

    const txData = @Html.Raw(JsonSerializer.Serialize(Model.ExportItems ?? new List<MIS.Web.Models.Transaction.TransactionModel>()));

    const reportGeneratedAt = '@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")';
    const currentUserId = '@currentUserId';
    const reportVersion = "3.0.0.0";

    const filtersUsed = {
        "Start Date": '@Model.StartDate.ToString("dd/MM/yyyy HH:mm")',
        "End Date": '@Model.EndDate.ToString("dd/MM/yyyy HH:mm")',
        "Shift": '@shiftText',
        "Toll Operator": '@operatorText',
        "Lane": '@laneText',
        "Payment Method": '@paymentText',
        "Toll Collector Class": '@collectorClassText'
    };

    const fileStamp = () => new Date().toISOString().replace(/[:.]/g, "-");
    const hasData = () => Array.isArray(txData) && txData.length > 0;

    function safe(obj, ...keys) {
        for (const k of keys) {
            if (obj && obj[k] !== undefined && obj[k] !== null) return obj[k];
        }
        return "";
    }

    function toNumber(value) {
        const num = Number(value);
        return isNaN(num) ? 0 : num;
    }

    function formatAmount(value) {
        return toNumber(value).toFixed(2); // plain number, no currency symbol
    }

    const headers = [
        "Lane", "Sequence", "Date", "Time", "Shift", "Operator",
        "Payment", "Collector", "AVC", "Final", "Tariff", "Tag/Card"
    ];

    function buildRows(data) {
        return data.map(t => ([
            safe(t, "lane_Nr", "Lane_Nr"),
            safe(t, "trx_Sequence_Nr", "Trx_Sequence_Nr"),
            safe(t, "trx_Date", "Trx_Date"),
            safe(t, "trx_Time", "Trx_Time"),
            safe(t, "operational_Shift", "Operational_Shift"),
            safe(t, "toll_Operator_ID", "Toll_Operator_ID"),
            safe(t, "method_of_Payment", "Method_of_Payment"),
            safe(t, "toll_Collector_Class", "Toll_Collector_Class"),
            safe(t, "avC_Class", "AVC_Class"),
            safe(t, "final_Class", "Final_Class"),
            formatAmount(safe(t, "tariff", "Tariff")),
            safe(t, "tac_Card_Number", "Tac_Card_Number")
        ]));
    }

    function computeTotals(data) {
        const totalCount = data.length;
        const totalValue = data.reduce((sum, t) => sum + toNumber(safe(t, "tariff", "Tariff")), 0);
        return { totalCount, totalValue };
    }

    async function loadImage(src) {
        return new Promise(resolve => {
            const img = new Image();
            img.crossOrigin = "Anonymous";
            img.onload = () => resolve(img);
            img.onerror = () => resolve(null);
            img.src = src;
        });
    }

    function drawHeader(doc, pageWidth, margin, leftLogo, rightLogo, reportName) {
        const topY = 30;

        if (leftLogo) doc.addImage(leftLogo, "JPEG", margin, topY, 70, 70);
        if (rightLogo) doc.addImage(rightLogo, "JPEG", pageWidth - margin - 70, topY, 70, 70);

        let centerY = 60;

        doc.setFont("helvetica", "bold");
        doc.setFontSize(14);
        doc.text("LEKKI CONCESSION COMPANY LIMITED", pageWidth / 2, centerY, { align: "center" });

        centerY += 20;

        doc.setFontSize(12);
        doc.text("LEKKI-IKOYI LINK BRIDGE", pageWidth / 2, centerY, { align: "center" });

        centerY += 25;

        doc.setFontSize(16);
        doc.text(reportName || "TRANSACTION DETAILS REPORT", pageWidth / 2, centerY, { align: "center" });
    }

    function drawFilters(doc, margin, startY, filters) {
        let y = startY;
        doc.setFontSize(10);
        doc.setFont("helvetica", "normal");
        doc.text("FILTERS USED:", margin, y);
        y += 14;

        for (const [k, v] of Object.entries(filters)) {
            doc.text(`${k}: ${v}`, margin, y);
            y += 12;
        }
        return y;
    }

    function addSummaryLastPage(doc, margin, totals, filters) {
        doc.addPage();

        doc.setFont("helvetica", "bold");
        doc.setFontSize(16);
        doc.text("SUMMARY", margin, 70);

        doc.setFont("helvetica", "normal");
        doc.setFontSize(11);

        let y = 100;
        doc.text("FILTERS USED:", margin, y);
        y += 18;

        for (const [k, v] of Object.entries(filters)) {
            doc.text(`${k}: ${v}`, margin, y);
            y += 14;
        }

        y += 12;
        doc.setFont("helvetica", "bold");
        doc.text(`Total Transaction Count: ${totals.totalCount}`, margin, y);
        doc.text(`Total Transaction Value: ${formatAmount(totals.totalValue)}`, margin, y + 20);
    }

    function addFooters(doc, pageWidth, pageHeight, margin) {
        const totalPages = doc.internal.getNumberOfPages();

        for (let i = 1; i <= totalPages; i++) {
            doc.setPage(i);

            const footerY = pageHeight - 30;
            doc.setFontSize(10);
            doc.setFont("helvetica", "normal");

            doc.text("Transaction Details Report", margin, footerY);
            doc.text(`Date: ${reportGeneratedAt}`, pageWidth / 2.2, footerY);
            doc.text(`User: ${currentUserId}`, pageWidth / 1.5, footerY);
            doc.text(`Page ${i} of ${totalPages}`, pageWidth - margin, footerY, { align: "right" });

            doc.setFontSize(9);
            doc.text(`Reports Module Version Number: ${reportVersion}`, margin, footerY + 14);
        }
    }

    document.getElementById("btnDownloadPdf")?.addEventListener("click", async () => {
        if (!hasData()) {
            alert("No data available to export.");
            return;
        }

        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "a4" });

        const pageWidth = doc.internal.pageSize.getWidth();
        const pageHeight = doc.internal.pageSize.getHeight();
        const margin = 50;

        const [leftLogo, rightLogo] = await Promise.all([
            loadImage('/images/lCC Logo.jpg'),
            loadImage('/images/ICT-Works Logo.jpg')
        ]);

        drawHeader(doc, pageWidth, margin, leftLogo, rightLogo);
        const afterFiltersY = drawFilters(doc, margin, 130, filtersUsed);

        const tableRows = buildRows(txData);

        doc.autoTable({
            head: [headers],
            body: tableRows,
            startY: afterFiltersY + 10,
            theme: "grid",
            styles: { fontSize: 9, halign: "center" },
            headStyles: { fillColor: [41, 128, 185], textColor: 255 }
        });

        const totals = computeTotals(txData);
        addSummaryLastPage(doc, margin, totals, filtersUsed);
        addFooters(doc, pageWidth, pageHeight, margin);

        doc.save(`Transaction_Report_${fileStamp()}.pdf`);
    });

    document.getElementById("btnDownloadExcel")?.addEventListener("click", () => {
        if (!hasData()) {
            alert("No data available to export.");
            return;
        }

        const rows = buildRows(txData);
        const totals = computeTotals(txData);

        rows.unshift([]);
        rows.unshift(["FILTERS USED"]);
        rows.unshift(["Payment Method", filtersUsed["Payment Method"]]);
        rows.unshift(["Toll Collector Class", filtersUsed["Toll Collector Class"]]);
        rows.unshift(["Lane", filtersUsed["Lane"]]);
        rows.unshift(["Toll Operator", filtersUsed["Toll Operator"]]);
        rows.unshift(["Shift", filtersUsed["Shift"]]);
        rows.unshift(["End Date", filtersUsed["End Date"]]);
        rows.unshift(["Start Date", filtersUsed["Start Date"]]);

        rows.push([]);
        rows.push(["Total Transaction Count", totals.totalCount]);
        rows.push(["Total Transaction Value", formatAmount(totals.totalValue)]);
        rows.push([]);
        rows.push(["Generated", reportGeneratedAt, "User", currentUserId, "Version", reportVersion]);

        const ws = XLSX.utils.aoa_to_sheet([headers, ...rows]);
        ws["!cols"] = Array(headers.length).fill({ wch: 18 });

        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, "Transaction Report");
        XLSX.writeFile(wb, `Transaction_Report_${fileStamp()}.xlsx`);
    });

});
</script>
