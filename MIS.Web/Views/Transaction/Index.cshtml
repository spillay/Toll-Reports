@model MIS.Web.Models.TransactionInputModel
@using System.Text.Json

@{
    var reportVersion   = "3.0.0.0";
    var currentUserId   = User.Identity?.Name ?? "Lucky";
    var reportGenerated = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
    var items           = Model.items ?? new List<MIS.Web.Models.Transaction.TransactionModel>();
}
<div class="card shadow-lg mb-4">
    <div class="card-body">

        <!-- ====== HEADER ====== -->
        <div class="text-center mb-3 border-bottom pb-2">
            <h2 class="fw-bold text-primary mb-0">TRANSACTION DETAILS REPORT</h2>
        </div>


        <!-- ====== EXPORT BUTTONS ====== -->
        <div class="row mb-3">
            <div class="col-md-2 me-2">
                <button id="btnDownloadPdf" class="btn btn-danger w-100 shadow-sm">
                    <i class="bi bi-file-earmark-pdf"></i> Export PDF
                </button>
            </div>

            <div class="col-md-2">
                <button id="btnDownloadExcel" class="btn btn-success w-100 shadow-sm">
                    <i class="bi bi-file-earmark-excel"></i> Export Excel
                </button>
            </div>
        </div>


        <!-- ====== FILTERS PARTIAL ====== -->
        @Html.Partial("_TransactionFilters", Model)


        <!-- ====== TABLE ====== -->
        <div class="table-responsive mt-3">
            <table class="table table-striped table-bordered align-middle text-center">
                <thead class="table-light">
                    <tr>
                        <th>Lane</th>
                        <th>Sequence No.</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Shift</th>
                        <th>Toll Operator</th>
                        <th>Payment Method</th>
                        <th>Collector Class</th>
                        <th>AVC Class</th>
                        <th>Final Class</th>
                        <th>Tariff</th>
                        <th>Tag/Card</th>
                    </tr>
                </thead>

                <tbody>
                    @if (items.Any())
                    {
                        foreach (var t in items)
                        {
                            <tr>
                                <td>@t.lane_Nr</td>
                                <td>@t.trx_Sequence_Nr</td>
                                <td>@t.trx_Date</td>
                                <td>@t.trx_Time</td>
                                <td>@t.operational_Shift</td>
                                <td>@t.toll_Operator_ID</td>
                                <td>@t.method_of_Payment</td>
                                <td>@t.toll_Collector_Class</td>
                                <td>@t.avC_Class</td>
                                <td>@t.final_Class</td>
                                <td>@(t.tariff?.ToString("N2") ?? "0.00")</td>
                                <td>@t.tac_Card_Number</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="12" class="py-3 text-muted">
                                No data available for the selected filters.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>


        <!-- ====== PAGINATION ====== -->
        @if (Model.totalPages > 1)
        {
            var filters = Model;
            int startPage = Math.Max(1, Model.page - 1);
            int endPage   = Math.Min(Model.totalPages, Model.page + 1);

            <div class="mt-4 d-flex flex-column flex-md-row justify-content-between align-items-center border-top pt-3">

                <!-- Totals -->
                <div class="mb-2 mb-md-0">
                    <h6>Total Transactions: <strong>@Model.totalCount</strong></h6>
                    <h6>Total Value: <strong>@Model.TotalTariff.ToString("N2")</strong></h6>
                </div>

                <nav>
                    <ul class="pagination">

                        <!-- Prev -->
                        <li class="page-item @(Model.page <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Transaction","Transaction", new {
                                page = Model.page - 1,
                                pageSize = Model.pageSize,
                                lane_Nr = filters.lane_Nr,
                                TollOperatorID = filters.TollOperatorID,
                                Shift = filters.Shift,
                                PaymentMethod = filters.PaymentMethod,
                                StartDate = filters.StartDate.ToString("yyyy-MM-ddTHH:mm"),
                                EndDate = filters.EndDate.ToString("yyyy-MM-ddTHH:mm")
                            })">Previous</a>
                        </li>

                        <!-- Page numbers -->
                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == Model.page ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Transaction", "Transaction", new {
                                    page = i,
                                    pageSize = Model.pageSize,
                                    lane_Nr = filters.lane_Nr,
                                    TollOperatorID = filters.TollOperatorID,
                                    Shift = filters.Shift,
                                    PaymentMethod = filters.PaymentMethod,
                                    StartDate = filters.StartDate.ToString("yyyy-MM-ddTHH:mm"),
                                    EndDate = filters.EndDate.ToString("yyyy-MM-ddTHH:mm")
                                })">@i</a>
                            </li>
                        }

                        <!-- Next -->
                        <li class="page-item @(Model.page >= Model.totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Transaction","Transaction", new {
                                page = Model.page + 1,
                                pageSize = Model.pageSize,
                                lane_Nr = filters.lane_Nr,
                                TollOperatorID = filters.TollOperatorID,
                                Shift = filters.Shift,
                                PaymentMethod = filters.PaymentMethod,
                                StartDate = filters.StartDate.ToString("yyyy-MM-ddTHH:mm"),
                                EndDate = filters.EndDate.ToString("yyyy-MM-ddTHH:mm")
                            })">Next</a>
                        </li>

                    </ul>
                </nav>

            </div>
        }


        <!-- ====== FOOTER ====== -->
        <div class="mt-4 border-top pt-3">
            <table class="table table-borderless mb-0">
                <tr>
                    <td><strong>Transaction Details Report</strong></td>
                    <td><strong>Date/Time:</strong> @reportGenerated</td>
                    <td><strong>User:</strong> @currentUserId</td>
                    <td class="text-end">Page <strong>@Model.page</strong> of <strong>@Model.totalPages</strong></td>
                </tr>
                <tr>
                    <td colspan="4">
                        <small class="text-muted">Version: <strong>@reportVersion</strong></small>
                    </td>
                </tr>
            </table>
        </div>

    </div>
</div>


<!-- EXPORT SCRIPTS  -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>


<script>
document.addEventListener("DOMContentLoaded", () => {

    // 1. FULL EXPORT DATA FROM BACKEND 
     
    const txData = @Html.Raw(JsonSerializer.Serialize(
        Model.ExportItems ?? new List<MIS.Web.Models.Transaction.TransactionModel>()
    ));

    const reportGeneratedAt = '@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")';
    const currentUserId     = '@(User.Identity?.Name ?? "Lucky")';
    const reportVersion     = "2.0.0.11";

     // 2. PDF EXPORT (FULL LCC FORMAT)
  
    document.getElementById("btnDownloadPdf").addEventListener("click", async () => {

        if (!txData.length) {
            alert("No data available to export.");
            return;
        }

        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "a4" });

        const pageWidth  = doc.internal.pageSize.getWidth();
        const pageHeight = doc.internal.pageSize.getHeight();
        const margin     = 50;


        /* ========== LOAD LOGOS ========== */
        const loadImage = src => new Promise(resolve => {
            const img = new Image();
            img.crossOrigin = "Anonymous";
            img.onload = () => resolve(img);
            img.onerror = () => resolve(null);
            img.src = src;
        });

        const [leftLogo, rightLogo] = await Promise.all([
            loadImage('/images/lCC Logo.jpg'),
            loadImage('/images/ICT-Works Logo.jpg')
        ]);

        if (leftLogo)  doc.addImage(leftLogo,  "JPEG", margin, 25, 80, 80);
        if (rightLogo) doc.addImage(rightLogo, "JPEG", pageWidth - margin - 80, 25, 80, 80);



        /* ========== HEADER ========== */
        doc.setFont("helvetica", "bold");
        doc.setFontSize(18);
        doc.text("LEKKI CONCESSION COMPANY LIMITED", pageWidth / 2, 60, { align: "center" });

        doc.setFontSize(14);
        doc.text("TRANSACTION DETAILS REPORT", pageWidth / 2, 90, { align: "center" });



        /* ========== FILTERS USED ========== */
        let y = 130;
        doc.setFontSize(10);
        doc.setFont("helvetica", "normal");

        const filters = {
            "Start Date": '@Model.StartDate.ToString("dd/MM/yyyy HH:mm")',
            "End Date": '@Model.EndDate.ToString("dd/MM/yyyy HH:mm")',
            "Shift": '@(Model.Shift ?? "All")',
            "Toll Operator": '@(Model.TollOperatorID ?? "All")',
            "Lane": '@(Model.lane_Nr ?? "All")',
            "Payment Method": '@(Model.PaymentMethod ?? "All")'
        };

        doc.text("FILTERS USED:", margin, y);
        y += 14;

        for (const [k, v] of Object.entries(filters)) {
            doc.text(`${k}: ${v}`, margin, y);
            y += 12;
        }



        /* ========== TABLE DATA SAFE PARSER ========== */
        const safe = (obj, ...keys) => keys.find(k => obj[k] !== undefined) ? obj[keys.find(k => obj[k] !== undefined)] : "";

        const headers = [
            "Lane", "Sequence", "Date", "Time", "Shift", "Operator",
            "Payment", "Collector", "AVC", "Final", "Tariff", "Tag/Card"
        ];

        const rows = txData.map(t => [
            safe(t, "lane_Nr", "Lane_Nr"),
            safe(t, "trx_Sequence_Nr", "Trx_Sequence_Nr"),
            safe(t, "trx_Date", "Trx_Date"),
            safe(t, "trx_Time", "Trx_Time"),
            safe(t, "operational_Shift", "Operational_Shift"),
            safe(t, "toll_Operator_ID", "Toll_Operator_ID"),
            safe(t, "method_of_Payment", "Method_of_Payment"),
            safe(t, "toll_Collector_Class", "Toll_Collector_Class"),
            safe(t, "avC_Class", "AVC_Class"),
            safe(t, "final_Class", "Final_Class"),
            Number(safe(t, "tariff", "Tariff") || 0).toFixed(2),
            safe(t, "tac_Card_Number", "Tac_Card_Number")
        ]);

        doc.autoTable({
            head: [headers],
            body: rows,
            startY: y + 10,
            theme: "grid",
            styles: { fontSize: 9, halign: "center" },
            headStyles: { fillColor: [41, 128, 185], textColor: 255 },

            didDrawPage: ({ pageNumber }) => {
                const totalPages = doc.internal.getNumberOfPages();
                const footerY    = pageHeight - 30;

                doc.setFontSize(10);
                doc.text("Transaction Details Report", margin, footerY);
                doc.text(`Date: ${reportGeneratedAt}`, pageWidth / 2.2, footerY);
                doc.text(`User: ${currentUserId}`, pageWidth / 1.5, footerY);
                doc.text(`Page ${pageNumber} of ${totalPages}`, pageWidth - margin, footerY, { align: "right" });

                doc.setFontSize(9);
                doc.text(`Reports Module Version Number: ${reportVersion}`, margin, footerY + 14);
            }
        });



        /* ========== TOTALS ========== */
        const totalCount = txData.length;
        const totalValue = txData.reduce((s, t) => s + Number(safe(t, "tariff", "Tariff") || 0), 0);

        const totalsY = doc.lastAutoTable.finalY + 30;

        doc.setFont("helvetica", "bold");
        doc.setFontSize(11);
        doc.text(`Total Transaction Count: ${totalCount}`, margin, totalsY);
        doc.text(`Total Transaction Value: ${totalValue.toFixed(2)}`, margin, totalsY + 20);



        /* ========== SAVE PDF ========== */
        doc.save(`Transaction_Report_${new Date().toISOString().replace(/[:.]/g, '-')}.pdf`);
    });

      //3. EXCEL EXPORT (FULL LCC FORMAT)
  
    document.getElementById("btnDownloadExcel").addEventListener("click", () => {

        if (!txData.length) {
            alert("No data available to export.");
            return;
        }

        const safe = (obj, ...keys) => keys.find(k => obj[k] !== undefined) ? obj[keys.find(k => obj[k] !== undefined)] : "";

        const headers = [
            "Lane", "Sequence", "Date", "Time", "Shift", "Operator",
            "Payment", "Collector", "AVC", "Final", "Tariff", "Tag/Card"
        ];

        const rows = txData.map(t => [
            safe(t, "lane_Nr", "Lane_Nr"),
            safe(t, "trx_Sequence_Nr", "Trx_Sequence_Nr"),
            safe(t, "trx_Date", "Trx_Date"),
            safe(t, "trx_Time", "Trx_Time"),
            safe(t, "operational_Shift", "Operational_Shift"),
            safe(t, "toll_Operator_ID", "Toll_Operator_ID"),
            safe(t, "method_of_Payment", "Method_of_Payment"),
            safe(t, "toll_Collector_Class", "Toll_Collector_Class"),
            safe(t, "avC_Class", "AVC_Class"),
            safe(t, "final_Class", "Final_Class"),
            Number(safe(t, "tariff", "Tariff") || 0),
            safe(t, "tac_Card_Number", "Tac_Card_Number")
        ]);

        const totalValue = txData.reduce((s, t) => s + Number(safe(t, "tariff", "Tariff") || 0), 0);

        rows.push([]);
        rows.push(["Total Transaction Count", txData.length]);
        rows.push(["Total Transaction Value", totalValue.toFixed(2)]);
        rows.push([]);
        rows.push(["Generated", reportGeneratedAt, "User", currentUserId, "Version", reportVersion]);

        const ws = XLSX.utils.aoa_to_sheet([headers, ...rows]);
        ws["!cols"] = Array(headers.length).fill({ wch: 18 });

        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, "Transaction Report");

        XLSX.writeFile(wb, `Transaction_Report_${new Date().toISOString().replace(/[:.]/g, '-')}.xlsx`);
    });

});
</script>


