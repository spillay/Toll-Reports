@model MIS.Web.Models.TransactionInputModel
@using System.Text.Json

@{
    var reportVersion = "2.0.0.11";
    var currentUserId = User.Identity?.Name ?? "Lucky";
    DateTime reportGeneratedAt = DateTime.Now;
}

<div class="card shadow-lg mb-4">
    <div class="card-body">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
            <h2 class="mb-0 fw-bold text-primary text-center w-100">TRANSACTION DETAILS REPORT</h2>
        </div>

        <!-- Export Buttons -->
        <div class="row mb-3">
            <div class="col-md-2 d-flex align-items-end me-2">
                <button id="btnDownloadPdf" type="button" class="btn btn-danger w-100 shadow-sm">
                    <i class="bi bi-file-earmark-pdf"></i> Export PDF
                </button>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button id="btnDownloadExcel" type="button" class="btn btn-success w-100 shadow-sm">
                    <i class="bi bi-file-earmark-excel"></i> Export Excel
                </button>
            </div>
        </div>


        <!-- Filters -->
        @Html.Partial("_TransactionFilters", Model)

        <!-- Table -->
        <div class="table-responsive mt-3">
            <table class="table table-striped table-bordered align-middle text-center">
                <thead class="table-light">
                    <tr>
                        <th>Lane Number</th>
                        <th>Transaction Sequence Number</th>
                        <th>Transaction Date</th>
                        <th>Transaction Time</th>
                        <th>Operational Shift</th>
                        <th>Toll Operator ID</th>
                        <th>Method of Payment</th>
                        <th>Toll Collector Class</th>
                        <th>AVC Class</th>
                        <th>Final Class</th>
                        <th>Tariff </th>
                        <th>Tag / Card Number</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.items != null && Model.items.Any())
                    {
                        foreach (var item in Model.items)
                        {
                            <tr>
                                <td>@item.lane_Nr</td>
                                <td>@item.trx_Sequence_Nr</td>
                                <td>@item.trx_Date</td>
                                <td>@item.trx_Time</td>
                                <td>@item.operational_Shift</td>
                                <td>@item.toll_Operator_ID</td>
                                <td>@item.method_of_Payment</td>
                                <td>@item.toll_Collector_Class</td>
                                <td>@item.avC_Class</td>
                                <td>@item.final_Class</td>
                                <td>@item.tariff?.ToString("N2")</td>
                                <td>@item.tac_Card_Number</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="12" class="text-muted py-3">No data available for the selected filters.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @{
            var filters = Model as MIS.Web.Models.TransactionInputModel;
            int startPage = Math.Max(1, Model.page - 1);
            int endPage = Math.Min(Model.totalPages, Model.page + 1);
        }

        <div class="mt-4 d-flex flex-column flex-md-row justify-content-between align-items-center border-top pt-3">
            <div class="text-muted mb-2 mb-md-0">
              <h6> Total Transaction Count: <strong>@Model.totalCount</strong></h6> 
                <h6>Total Transaction Value : <strong>@Model.TotalTariff.ToString("N2")</strong></h6>
                
            </div>


            <nav aria-label="Transaction pagination">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.page <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Transaction", "Transaction", new {
                            page = Model.page - 1,
                            pageSize = Model.pageSize,
                            lane_Nr = filters?.lane_Nr,
                            TollOperatorID = filters?.TollOperatorID,
                            Shift = filters?.Shift,
                            PaymentMethod = filters?.PaymentMethod,
                            StartDate = filters?.StartDate.ToString("yyyy-MM-ddTHH:mm"),
                            EndDate = filters?.EndDate.ToString("yyyy-MM-ddTHH:mm")
                        })">&laquo; Previous</a>
                    </li>

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == Model.page ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Transaction", "Transaction", new {
                                page = i,
                                pageSize = Model.pageSize,
                                lane_Nr = filters?.lane_Nr,
                                TollOperatorID = filters?.TollOperatorID,
                                Shift = filters?.Shift,
                                PaymentMethod = filters?.PaymentMethod,
                                StartDate = filters?.StartDate.ToString("yyyy-MM-ddTHH:mm"),
                                EndDate = filters?.EndDate.ToString("yyyy-MM-ddTHH:mm")
                            })">@i</a>
                        </li>
                    }

                    <li class="page-item @(Model.page >= Model.totalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Transaction", "Transaction", new {
                            page = Model.page + 1,
                            pageSize = Model.pageSize,
                            lane_Nr = filters?.lane_Nr,
                            TollOperatorID = filters?.TollOperatorID,
                            Shift = filters?.Shift,
                            PaymentMethod = filters?.PaymentMethod,
                            StartDate = filters?.StartDate.ToString("yyyy-MM-ddTHH:mm"),
                            EndDate = filters?.EndDate.ToString("yyyy-MM-ddTHH:mm")
                        })">Next &raquo;</a>
                    </li>
                </ul>
            </nav>
        </div>

        <!-- Footer -->
            <div class="mt-4 p-3 border-top ">
                <table class="table table-borderless w-100 mb-0 align-middle">
                    <tr>
                        <td class="fw-bold text-dark">Transaction Details Report</td>
                        <td><strong>Date and Time:</strong> @reportGeneratedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td><strong>User ID:</strong> @currentUserId</td>
                        <td class="text-end">
                            Page <strong>@Model.page</strong> of <strong>@Model.totalPages</strong>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="4">
                            <small class="text-muted">
                                Reports Module Version Number: <strong>@reportVersion</strong>
                            </small>
                        </td>
                    </tr>
                </table>
            </div>


    </div>
</div>

<!-- ====== PDF + Excel Export Scripts ====== -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>

<script>
document.addEventListener("DOMContentLoaded", () => {

    /* ====================================================
     * 1. BUILD API URL (Dynamic - Works on ALL PCs)
     * ==================================================== */
    const baseApiUrl = '@ViewData["TransactionApi"]';

    const queryParams = new URLSearchParams({
        startDate: '@Model.StartDate.ToString("yyyy-MM-ddTHH:mm:ss")',
        endDate: '@Model.EndDate.ToString("yyyy-MM-ddTHH:mm:ss")',
        page: '@Model.page',
        pageSize: '@Model.pageSize',
        exportAll: "true"
    });

    if ('@(Model.Shift)' !== "")
        queryParams.append("operationalShift", '@Model.Shift');

    if ('@(Model.TollOperatorID)' !== "")
        queryParams.append("tollOperators", '@Model.TollOperatorID');

    if ('@(Model.lane_Nr)' !== "")
        queryParams.append("laneNames", '@Model.lane_Nr');

    if ('@(Model.PaymentMethod)' !== "")
        queryParams.append("paymentMethods", '@Model.PaymentMethod');

    const exportUrl = `${baseApiUrl}?${queryParams.toString()}`;

    const reportGeneratedAt = '@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")';
    const currentUserId = '@(User.Identity?.Name ?? "Lucky")';
    const reportVersion = "2.0.0.11";


    /* ====================================================
     * 2. FETCH EXPORT DATA
     * ==================================================== */
    async function fetchExportData() {
        try {
            const res = await fetch(exportUrl);

            if (!res.ok) {
                alert("❌ API Error: " + res.status);
                return null;
            }

            const data = await res.json();
            return data.items || data.Items || [];
        }
        catch (err) {
            alert("❌ Network Error: " + err);
            return null;
        }
    }


    /* ====================================================
     * 3. PDF EXPORT
     * ==================================================== */
    document.getElementById("btnDownloadPdf").addEventListener("click", async () => {
        const txData = await fetchExportData();
        if (!txData) return;

        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "a4" });

        const pageWidth = doc.internal.pageSize.getWidth();
        const pageHeight = doc.internal.pageSize.getHeight();
        const margin = 50;

        const totalCount = txData.length;
        const totalValue = txData.reduce((s, t) => s + (Number(t.Tariff) || 0), 0);

        // Load logos
        const loadImage = src => new Promise(resolve => {
            const img = new Image();
            img.crossOrigin = 'Anonymous';
            img.onload = () => resolve(img);
            img.onerror = () => resolve(null);
            img.src = src;
        });

        const [leftLogo, rightLogo] = await Promise.all([
            loadImage('/images/lCC Logo.jpg'),
            loadImage('/images/ICT-Works Logo.jpg')
        ]);

        if (leftLogo) doc.addImage(leftLogo, "JPEG", margin, 25, 80, 80);
        if (rightLogo) doc.addImage(rightLogo, "JPEG", pageWidth - margin - 80, 25, 80, 80);

        // Header
        doc.setFont("helvetica", "bold");
        doc.setFontSize(18);
        doc.text("LEKKI CONCESSION COMPANY LIMITED", pageWidth / 2, 60, { align: "center" });

        doc.setFontSize(14);
        doc.text("TRANSACTION DETAILS REPORT", pageWidth / 2, 90, { align: "center" });

        // Filters
        let y = 130;
        doc.setFont("helvetica", "normal");
        doc.setFontSize(10);

        const filters = {
            "Start Date": '@Model.StartDate.ToString("dd/MM/yyyy HH:mm")',
            "End Date": '@Model.EndDate.ToString("dd/MM/yyyy HH:mm")',
            "Shift": '@(Model.Shift ?? "All")',
            "Toll Operator": '@(Model.TollOperatorID ?? "All")',
            "Lane": '@(Model.lane_Nr ?? "All")',
            "Payment Method": '@(Model.PaymentMethod ?? "All")'
        };

        doc.text("FILTERS USED:", margin, y);
        y += 14;

        for (const [k, v] of Object.entries(filters)) {
            doc.text(`${k}: ${v}`, margin, y);
            y += 12;
        }

        // Table headers
        const headers = [
            "Lane Number", "Transaction Sequence", "Transaction Date", "Transaction Time", "Operational Shift", "Toll Operator ID",
            "Method of Payment", "Collector Class", "AVC", "Final Class",
            "Tariff", "Tag/Card"
        ];

        const rows = txData.map(t => [
            t.Lane_Nr ?? '',
            t.Trx_Sequence_Nr ?? '',
            t.Trx_Date ?? '',
            t.Trx_Time ?? '',
            t.Operational_Shift ?? '',
            t.Toll_Operator_ID ?? '',
            t.Method_of_Payment ?? '',
            t.Toll_Collector_Class ?? '',
            t.AVC_Class ?? '',
            t.Final_Class ?? '',
            (Number(t.Tariff ?? 0)).toFixed(2),
            t.Tac_Card_Number ?? ''
        ]);

        doc.autoTable({
            head: [headers],
            body: rows,
            theme: 'grid',
            startY: y + 10,
            styles: { fontSize: 9, halign: 'center' },
            headStyles: { fillColor: [41, 128, 185], textColor: 255 },

            didDrawPage: ({ pageNumber }) => {
                const pageCount = doc.internal.getNumberOfPages();
                const footerY = pageHeight - 30;

                doc.setFontSize(10);
                doc.text("Transaction Details Report", margin, footerY);
                doc.text(`Date: ${reportGeneratedAt}`, pageWidth / 2.2, footerY);
                doc.text(`User: ${currentUserId}`, pageWidth / 1.5, footerY);
                doc.text(`Page ${pageNumber} of ${pageCount}`, pageWidth - margin, footerY, { align: "right" });

                doc.setFontSize(9);
                doc.text(`Version: ${reportVersion}`, margin, footerY + 14);
            }
        });

        const totalsY = doc.lastAutoTable.finalY + 30;
        doc.setFont("helvetica", "bold");
        doc.setFontSize(11);
        doc.text(`Total Transaction Count: ${totalCount}`, margin, totalsY);
        doc.text(`Total Transaction Value: ${totalValue.toFixed(2)}`, margin, totalsY + 20);

        doc.save(`Transaction_Report_${new Date().toISOString().replace(/[:.]/g, '-')}.pdf`);
    });


    /* ====================================================
     * 4. EXCEL EXPORT
     * ==================================================== */
    document.getElementById("btnDownloadExcel").addEventListener("click", async () => {
        const txData = await fetchExportData();
        if (!txData) return;

        const totalCount = txData.length;
        const totalValue = txData.reduce((s, t) => s + (Number(t.Tariff) || 0), 0);

        const headers = [
            "Lane Number", "Transaction Sequence", "Transaction Date", "Transaction Time", "Operational Shift", "Toll Operator ID",
            "Method of Payment", "Collector Class", "AVC", "Final Class",
            "Tariff", "Tag/Card"
        ];

        const rows = txData.map(t => [
            t.Lane_Nr ?? '',
            t.Trx_Sequence_Nr ?? '',
            t.Trx_Date ?? '',
            t.Trx_Time ?? '',
            t.Operational_Shift ?? '',
            t.Toll_Operator_ID ?? '',
            t.Method_of_Payment ?? '',
            t.Toll_Collector_Class ?? '',
            t.AVC_Class ?? '',
            t.Final_Class ?? '',
            Number(t.Tariff ?? 0),
            t.Tac_Card_Number ?? ''
        ]);

        rows.push([]);
        rows.push(["Total Transaction Count", totalCount]);
        rows.push(["Total Transaction Value", totalValue.toFixed(2)]);
        rows.push([]);
        rows.push(["Generated", reportGeneratedAt, "User", currentUserId, "Version", reportVersion]);

        const ws = XLSX.utils.aoa_to_sheet([headers, ...rows]);
        ws["!cols"] = Array(12).fill({ wch: 18 });

        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, "Transactions");

        XLSX.writeFile(wb, `Transaction_Report_${new Date().toISOString().replace(/[:.]/g, '-')}.xlsx`);
    });

});
</script>









