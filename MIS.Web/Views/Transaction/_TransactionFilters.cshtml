@model MIS.Web.Models.TransactionInputModel

<form method="get"
      asp-controller="Transaction"
      asp-action="Transaction"
      id="filterForm"
      class="mb-4">

    <div class="row g-3">

        <div class="col-md-3">
            <label class="form-label fw-semibold">Start Date & Time</label>
            <input type="datetime-local"
                   name="StartDate"
                   class="form-control"
                   value="@(Model?.StartDate.ToString("yyyy-MM-ddTHH:mm") ?? "")" />
        </div>

        <div class="col-md-3">
            <label class="form-label fw-semibold">End Date & Time</label>
            <input type="datetime-local"
                   name="EndDate"
                   class="form-control"
                   value="@(Model?.EndDate.ToString("yyyy-MM-ddTHH:mm") ?? "")" />
        </div>

        <!-- Shift checklist -->
        <div class="col-md-3">
            <label class="form-label fw-semibold d-flex justify-content-between align-items-center">
                <span>Operational Shift</span>
                <span>
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="toggleAll('SelectedShifts', true)">All</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleAll('SelectedShifts', false)">Clear</button>
                </span>
            </label>

            <div class="border rounded p-2" style="max-height:170px; overflow:auto;">
                @foreach (var shift in Model.Shifts ?? new List<string>())
                {
                    var id = "shift_" + shift.Replace(" ", "_");
                    var isChecked = Model.SelectedShifts?.Contains(shift) == true;

                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               name="SelectedShifts"
                               value="@shift"
                               id="@id"
                               @(isChecked ? "checked" : "") />
                        <label class="form-check-label" for="@id">@shift</label>
                    </div>
                }
            </div>
        </div>

        <!-- Operator checklist -->
        <div class="col-md-3">
            <label class="form-label fw-semibold d-flex justify-content-between align-items-center">
                <span>Toll Operator ID</span>
                <span>
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="toggleAll('SelectedTollOperators', true)">All</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleAll('SelectedTollOperators', false)">Clear</button>
                </span>
            </label>

            <div class="border rounded p-2" style="max-height:170px; overflow:auto;">
                @foreach (var op in Model.TollOperators ?? new List<string>())
                {
                    var id = "op_" + op.Replace(" ", "_");
                    var isChecked = Model.SelectedTollOperators?.Contains(op) == true;

                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               name="SelectedTollOperators"
                               value="@op"
                               id="@id"
                               @(isChecked ? "checked" : "") />
                        <label class="form-check-label" for="@id">@op</label>
                    </div>
                }
            </div>
        </div>

        <!-- Lane checklist -->
        <div class="col-md-3">
            <label class="form-label fw-semibold d-flex justify-content-between align-items-center">
                <span>Lane</span>
                <span>
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="toggleAll('SelectedLanes', true)">All</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleAll('SelectedLanes', false)">Clear</button>
                </span>
            </label>

            <div class="border rounded p-2" style="max-height:170px; overflow:auto;">
                @foreach (var lane in Model.Lanes ?? new List<string>())
                {
                    var id = "lane_" + lane.Replace(" ", "_");
                    var isChecked = Model.SelectedLanes?.Contains(lane) == true;

                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               name="SelectedLanes"
                               value="@lane"
                               id="@id"
                               @(isChecked ? "checked" : "") />
                        <label class="form-check-label" for="@id">@lane</label>
                    </div>
                }
            </div>
        </div>

        <!-- Payment checklist -->
        <div class="col-md-3">
            <label class="form-label fw-semibold d-flex justify-content-between align-items-center">
                <span>Method of Payment</span>
                <span>
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="toggleAll('SelectedPaymentMethods', true)">All</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleAll('SelectedPaymentMethods', false)">Clear</button>
                </span>
            </label>

            <div class="border rounded p-2" style="max-height:170px; overflow:auto;">
                @foreach (var pm in Model.PaymentMethods ?? new List<string>())
                {
                    var id = "pm_" + pm.Replace(" ", "_");
                    var isChecked = Model.SelectedPaymentMethods?.Contains(pm) == true;

                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               name="SelectedPaymentMethods"
                               value="@pm"
                               id="@id"
                               @(isChecked ? "checked" : "") />
                        <label class="form-check-label" for="@id">@pm</label>
                    </div>
                }
            </div>
        </div>

        <div class="col-md-3 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Apply Filters</button>
        </div>
    </div>
</form>

<script>
    function toggleAll(name, checked) {
        document.querySelectorAll(`input[name="${name}"]`).forEach(cb => cb.checked = checked);
    }
</script>