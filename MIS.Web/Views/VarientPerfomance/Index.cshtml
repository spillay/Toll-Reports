@using System.Text.Json
@model MIS.Web.Models.VarientPerfomanceInputModel
@using System.Linq

@{
    ViewData["Title"] = "Staff Performance Report";
    var reportVersion = "3.0.0.0";
    var currentUser = User.Identity?.Name ?? "Lucky";
    var reportGeneratedAt = DateTime.Now;

    int maxPagesToShow = 3;
    int startPage = Math.Max(1, Model.page - 1);
    int endPage = Math.Min(Model.totalPages, startPage + maxPagesToShow - 1);
    if (endPage - startPage + 1 < maxPagesToShow && startPage > 1)
        startPage = Math.Max(1, endPage - maxPagesToShow + 1);

    // Compute Grand Total ONLY from valid operator rows ---
    var coreItems = Model.items
        .Where(x =>
            !(x.TollOperator == "—" ||                    
              (x.ShiftDescription ?? "")
                   .StartsWith("TOTAL", StringComparison.OrdinalIgnoreCase))) // ignore API subtotal rows
        .ToList();

    // GRAND TOTALS
    var grandExpected = coreItems.Sum(i => i.NominalTariff);
    var grandDeclared = coreItems.Sum(i => i.NettAmount);

    // Always compute Difference from Expected - Declared
    var grandDiff = grandExpected - grandDeclared;


}

<div class="card shadow-lg mb-4">
    <div class="card-body">

        <!-- HEADER -->
        <div class="text-center border-bottom mb-3 pb-2">
            <h2 class="fw-bold text-primary mb-0">STAFF PERFORMANCE REPORT</h2>
        </div>

        <!-- EXPORT BUTTONS -->
        <div class="row mb-3">
            <div class="col-md-2">
                <button id="btnDownloadPdf" class="btn btn-danger w-100 shadow-sm">
                    <i class="bi bi-file-earmark-pdf"></i> Export PDF
                </button>
            </div>
            <div class="col-md-2">
                <button id="btnDownloadExcel" class="btn btn-success w-100 shadow-sm">
                    <i class="bi bi-file-earmark-excel"></i> Export Excel
                </button>
            </div>
        </div>

        <!-- FILTERS -->
        <form method="get" asp-action="VarientPerfomances" asp-controller="VarientPerfomance" class="row mb-4 g-3">
            <div class="col-md-3">
                <label class="form-label fw-semibold">Start Date And Time</label>
                <input type="datetime-local" name="startDate" class="form-control"
                       value="@Model.StartDate.ToString("yyyy-MM-ddTHH:mm")" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">End Date And Time</label>
                <input type="datetime-local" name="endDate" class="form-control"
                       value="@Model.EndDate.ToString("yyyy-MM-ddTHH:mm")" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Operational Shift</label>
                <select class="form-select" name="shift">
                    <option value="">All</option>
                    @foreach (var s in ViewBag.Shifts as List<string> ?? new())
                    {
                        <option value="@s" selected="@(Model.Shift == s ? "selected" : null)">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Toll Operator ID</label>
                <select class="form-select" name="tollOperatorID">
                    <option value="">All</option>
                    @foreach (var t in ViewBag.TollOperators as List<string> ?? new())
                    {
                        <option value="@t" selected="@(Model.TollOperatorID == t ? "selected" : null)">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-3 mt-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel"></i> Filter
                </button>
            </div>
        </form>

        <!-- TABLE -->
        <div class="table-responsive">
            <table class="table table-bordered table-hover text-center align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>Operational Shift Date</th>
                        <th>Operational Shift</th>
                        <th>Toll Operator ID</th>
                        <th>Cash Expected</th>
                        <th>Cash Declared</th>
                        <th>Cash Declared Difference</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.items != null && Model.items.Any())
                    {
                        // ✅ filter out any subtotal/grand total rows coming from API
                        var filteredItems = Model.items
                        .Where(x =>
                        !(x.TollOperator == "—"
                        || x.ShiftDescription.StartsWith("TOTAL", StringComparison.OrdinalIgnoreCase)))
                        .ToList();

                        // ✅ Group operator rows by shift
                        var grouped = filteredItems.GroupBy(x => x.ShiftDescription);

                        foreach (var shiftGroup in grouped)
                        {
                            // === Operator Rows ===
                            foreach (var item in shiftGroup)
                            {
                                <tr>
                                    <td>@item.ShiftDate?.ToString("dd-MM-yyyy")</td>
                                    <td>@item.ShiftDescription</td>
                                    <td>@item.TollOperator</td>
                                    <td>@item.NominalTariff</td>
                                    <td>@item.NettAmount</td>
                                    <td>@item.Difference</td>
                                </tr>
                            }

                            // === Subtotal per Shift ===
                            var shiftExpected = shiftGroup.Sum(x => x.NominalTariff);
                            var shiftDeclared = shiftGroup.Sum(x => x.NettAmount);
                            var shiftDiff = shiftGroup.Sum(x => x.Difference);

                            <tr class="fw-bold table-light">
                                <td colspan="3" class="text-end">Total for @shiftGroup.Key</td>
                                <td>@shiftExpected</td>
                                <td>@shiftDeclared</td>
                                <td>@shiftDiff</td>
                            </tr>
                        }

                        <!-- === Grand Total (uses your precomputed vars) === -->
                        <tr class="fw-bold table-secondary">
                            <td colspan="3" class="text-end">GRAND TOTAL</td>
                            <td>@grandExpected</td>
                            <td>@grandDeclared</td>
                            <td>@grandDiff</td>
                        </tr>

                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-muted text-center">No records found.</td>
                        </tr>
                    }
                </tbody>


            </table>
        </div>

        <!-- PAGINATION -->
        <div class="mt-4 d-flex flex-column flex-md-row justify-content-between align-items-center border-top pt-3">
            <div class="text-muted mb-2 mb-md-0">
                Showing page <strong>@Model.page</strong> of <strong>@Model.totalPages</strong> |
                Total records: <strong>@Model.totalCount</strong>
            </div>

            <nav aria-label="Page navigation">
                <ul class="pagination mb-0">
                    <li class="page-item @(Model.page <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           href="@Url.Action("VarientPerfomances", "VarientPerfomance", new { page = Model.page - 1, pageSize = Model.pageSize, startDate = Model.StartDate, endDate = Model.EndDate, shift = Model.Shift, tollOperatorID = Model.TollOperatorID })">
                            &laquo; Previous
                        </a>
                    </li>

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == Model.page ? "active" : "")">
                            <a class="page-link"
                               href="@Url.Action("VarientPerfomances", "VarientPerfomance", new { page = i, pageSize = Model.pageSize, startDate = Model.StartDate, endDate = Model.EndDate, shift = Model.Shift, tollOperatorID = Model.TollOperatorID })">@i</a>
                        </li>
                    }

                    <li class="page-item @(Model.page >= Model.totalPages ? "disabled" : "")">
                        <a class="page-link"
                           href="@Url.Action("VarientPerfomances", "VarientPerfomance", new { page = Model.page + 1, pageSize = Model.pageSize, startDate = Model.StartDate, endDate = Model.EndDate, shift = Model.Shift, tollOperatorID = Model.TollOperatorID })">
                            Next &raquo;
                        </a>
                    </li>
                </ul>
            </nav>
        </div>

        <!-- FOOTER -->
        <hr />
        <div class="mt-4 p-3 border-top ">
            <table class="table table-borderless w-100 mb-0 align-middle">
                <tr>
                    <td class="fw-bold text-dark">Satff Performance Report</td>
                    <td><strong>Date and Time:</strong> @reportGeneratedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    <td><strong>User ID:</strong> @currentUser</td>
                    <td class="text-end">
                        Page <strong>@Model.page</strong> of <strong>@Model.totalPages</strong>
                    </td>
                </tr>
                <tr>
                    <td colspan="4">
                        <small class="text-muted">
                            Reports Module Version Number: <strong>@reportVersion</strong>
                        </small>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>


<!-- ===== EXPORT SCRIPTS ===== -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", () => {

        // ================================
        // 1. DYNAMIC BASE API URL (ALL PCs)
        // ================================
        const baseApiUrl = '@ViewData["VarientPerformanceApi"]';

        function buildExportUrl() {
            const params = new URLSearchParams({
                startDate: '@Model.StartDate.ToString("yyyy-MM-ddTHH:mm:ss")',
                endDate: '@Model.EndDate.ToString("yyyy-MM-ddTHH:mm:ss")',
                shift: '@Model.Shift',
                tollOperatorID: '@Model.TollOperatorID',
                exportAll: true,
                page: 1,
                pageSize: 999999
            });

            return `${baseApiUrl}?${params.toString()}`;
        }

        // Utility: clean and filter core operator rows
        function getCoreRows(data) {
            return data.filter(x =>
                !(x.TollOperator === "—" ||
                  (x.ShiftDescription || "").toUpperCase().startsWith("TOTAL"))
            );
        }

        // Compute Grand Totals
        function computeGrandTotals(rows) {
            const expected = rows.reduce((a, b) => a + (b.NominalTariff || 0), 0);
            const declared = rows.reduce((a, b) => a + (b.NettAmount || 0), 0);
            const diff = expected - declared;

            return { expected, declared, diff };
        }

        // =========================================================
        // 2. EXCEL EXPORT (Clean, Styled, Shift Subtotals + Grand)
        // =========================================================
        document.getElementById("btnDownloadExcel").addEventListener("click", async () => {
            const allUrl = buildExportUrl();

            const fullResult = await fetch(allUrl).then(r => r.json());
            const data = fullResult.Items ?? fullResult.items ?? [];

            if (!data.length) {
                alert("No data to export.");
                return;
            }

            const operatorRows = getCoreRows(data);
            const { expected, declared, diff } = computeGrandTotals(operatorRows);

            const ws_data = [];
            ws_data.push([
                "Operational Shift Date",
                "Operational Shift",
                "Toll Operator ID",
                "Cash Expected",
                "Cash Declared",
                "Cash Declared Difference"
            ]);

            // Group by shift
            const grouped = operatorRows.reduce((acc, x) => {
                if (!acc[x.ShiftDescription]) acc[x.ShiftDescription] = [];
                acc[x.ShiftDescription].push(x);
                return acc;
            }, {});

            // Build data rows
            Object.keys(grouped).forEach(shift => {
                let e = 0, d = 0, df = 0;

                grouped[shift].forEach(row => {
                    ws_data.push([
                        new Date(row.ShiftDate).toLocaleDateString(),
                        row.ShiftDescription,
                        row.TollOperator,
                        (row.NominalTariff ?? 0).toFixed(2),
                        (row.NettAmount ?? 0).toFixed(2),
                        (row.Difference ?? 0).toFixed(2)
                    ]);

                    e += row.NominalTariff || 0;
                    d += row.NettAmount || 0;
                    df += row.Difference || 0;
                });

                ws_data.push(["", "", `Total for ${shift}`, e.toFixed(2), d.toFixed(2), df.toFixed(2)]);
                ws_data.push([]);
            });

            // GRAND TOTAL
            ws_data.push([
                "",
                "",
                "GRAND TOTAL",
                expected.toFixed(2),
                declared.toFixed(2),
                diff.toFixed(2)
            ]);

            // Write Excel
            const ws = XLSX.utils.aoa_to_sheet(ws_data);
            ws["!cols"] = Array(6).fill({ wch: 22 });

            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "Variant Performance");

            XLSX.writeFile(
                wb,
                `Variant_Performance_Report_${new Date().toISOString().replace(/[:.]/g, "-")}.xlsx`
            );
        });

           // =========================================================
    // 3. PDF EXPORT (Styled like Razor, includes grand total row)
    // =========================================================
    document.getElementById("btnDownloadPdf").addEventListener("click", async () => {

        const allUrl = buildExportUrl();

        const fullResult = await fetch(allUrl).then(r => r.json());
        const data = fullResult.Items ?? fullResult.items ?? [];

        if (!data.length) {
            alert("No data to export.");
            return;
        }

        const operatorRows = getCoreRows(data);
        const { expected, declared, diff } = computeGrandTotals(operatorRows);

        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "a4" });

        const pageWidth = doc.internal.pageSize.getWidth();
        const pageHeight = doc.internal.pageSize.getHeight();
        const margin = 40;

        // ====================================================
        // LOGOS (same as other reports)
        // ====================================================
        const loadImage = src => new Promise(res => {
            const img = new Image(); img.crossOrigin = 'Anonymous';
            img.onload = () => res(img);
            img.onerror = () => res(null);
            img.src = src;
        });

        const [leftLogo, rightLogo] = await Promise.all([
            loadImage('/images/lCC Logo.jpg'),
            loadImage('/images/ICT-Works Logo.jpg')
        ]);

        if (leftLogo) doc.addImage(leftLogo, 'JPEG', margin, 25, 80, 80);
        if (rightLogo) doc.addImage(rightLogo, 'JPEG', pageWidth - margin - 80, 25, 80, 80);

        // ====================================================
        // TITLE
        // ====================================================
        doc.setFont("helvetica", "bold");
        doc.setFontSize(16);
        doc.text("LEKKI CONCESSION COMPANY LIMITED", pageWidth / 2, 50, { align: "center" });
        doc.text("VARIANT PERFORMANCE REPORT", pageWidth / 2, 80, { align: "center" });

        // ====================================================
        // FILTERS
        // ====================================================
        let y = 130;
        doc.setFontSize(10);
        doc.text("Filters Used:", margin, y);
        y += 14;

        const filters = {
            "Start Date And Time": '@Model.StartDate.ToString("dd/MM/yyyy HH:mm")',
            "End Date And Time": '@Model.EndDate.ToString("dd/MM/yyyy HH:mm")',
            "Operational Shift": '@(string.IsNullOrEmpty(Model.Shift) ? "All" : Model.Shift)',
            "Toll Operator ID": '@(string.IsNullOrEmpty(Model.TollOperatorID) ? "All" : Model.TollOperatorID)'
        };

        Object.entries(filters).forEach(([key, val]) => {
            doc.text(`${key}: ${val}`, margin, y);
            y += 12;
        });

        // ====================================================
        // BUILD TABLE BODY EXACTLY LIKE RAZOR
        // ====================================================
        const tableBody = [];

        // 1. Group by shift
        const grouped = operatorRows.reduce((acc, x) => {
            if (!acc[x.ShiftDescription]) acc[x.ShiftDescription] = [];
            acc[x.ShiftDescription].push(x);
            return acc;
        }, {});

        // 2. Add operator rows + subtotal rows
        Object.keys(grouped).forEach(shift => {

            let shiftExpected = 0;
            let shiftDeclared = 0;
            let shiftDiff = 0;

            grouped[shift].forEach(row => {
                tableBody.push([
                    new Date(row.ShiftDate).toLocaleDateString(),
                    row.ShiftDescription,
                    row.TollOperator,
                    (row.NominalTariff ?? 0).toFixed(2),
                    (row.NettAmount ?? 0).toFixed(2),
                    (row.Difference ?? 0).toFixed(2)
                ]);

                shiftExpected += row.NominalTariff || 0;
                shiftDeclared += row.NettAmount || 0;
                shiftDiff += row.Difference || 0;
            });

            // === SUBTOTAL ROW ===
            tableBody.push([
                "",
                `Total for ${shift}`,
                "",
                shiftExpected.toFixed(2),
                shiftDeclared.toFixed(2),
                shiftDiff.toFixed(2)
            ]);

            tableBody.push(["", "", "", "", "", ""]); // spacing row
        });

        // 3. === GRAND TOTAL ROW (MATCHES RAZOR) ===
        tableBody.push([
            "",
            "GRAND TOTAL",
            "",
            expected.toFixed(2),
            declared.toFixed(2),
            diff.toFixed(2)
        ]);

        // ====================================================
        // AUTO TABLE (exact same layout as Razor)
        // ====================================================
        const headers = [
            "Operational Shift Date",
            "Operational Shift",
            "Toll Operator ID",
            "Cash Expected",
            "Cash Declared",
            "Cash Declared Difference"
        ];

        doc.autoTable({
            head: [headers],
            body: tableBody,
            startY: y + 10,
            theme: "grid",
            headStyles: { fillColor: [41, 128, 185], textColor: 255 },
            styles: { fontSize: 9, halign: "center", cellPadding: 4 },
            margin: { left: margin, right: margin }
        });

        // ====================================================
        // FOOTER (matches Transaction/Discrepancy)
        // ====================================================
        const footerY = pageHeight - 40;

        doc.setFontSize(10);
        doc.text("Variant Performance Report", margin, footerY);
        doc.text(`Date: @reportGeneratedAt.ToString("dd/MM/yyyy HH:mm:ss")`, pageWidth / 2.5, footerY);
        doc.text(`User: @currentUser`, pageWidth / 1.6, footerY);

        const pageCount = doc.internal.getNumberOfPages();
        doc.text(`Page 1 of ${pageCount}`, pageWidth - margin, footerY, { align: "right" });

        doc.text(`Version: @reportVersion`, margin, footerY + 12);

        // ====================================================
        // SAVE FILE
        // ====================================================
        doc.save(`Variant_Performance_Report_${new Date().toISOString().replace(/[:.]/g, "-")}.pdf`);
    });


    });
</script>
