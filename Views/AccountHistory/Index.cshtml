@model MIS.Web.Models.AccountHistory.AccountHistoryInputModel
@using System.Globalization
@removeTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Account History Report";
    var reportGeneratedAt = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
    var currentUserId = User.Identity?.Name ?? "Lucky";
    var reportVersion = "1.0.0";
}

<div class="card shadow-lg p-4 mb-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
        <h3 class="text-primary fw-bold">Account History Report</h3>
    </div>

    <!-- FILTER SECTION -->
    <form id="accountForm" method="get" class="row g-3 mb-4">
        <div class="col-md-4">
            <label class="form-label fw-semibold">Select Account</label>
            <select name="accountNumber" id="accountSelect" class="form-select">
                <option value="">-- Select Account --</option>
                @if (ViewBag.Accounts != null)
                {
                    foreach (var acc in ViewBag.Accounts)
                    {
                        <option value="@acc" @(Model.AccountNumber == acc ? "selected" : "")>@acc</option>
                    }
                }
            </select>
        </div>
    </form>

    <!-- EXPORT BUTTONS -->
    @if (Model?.PageData?.Items != null && Model.PageData.Items.Any())
    {
        <div class="text-end mt-3">
            <button id="btnExportPdf" class="btn btn-danger me-2">
                <i class="bi bi-file-earmark-pdf"></i> Export PDF
            </button>
            <button id="btnExportExcel" class="btn btn-success">
                <i class="bi bi-file-earmark-excel"></i> Export Excel
            </button>
        </div>
    }

    <!-- ACCOUNT INFO -->
    @if (!string.IsNullOrEmpty(Model?.AccountNumber))
    {
        <div class="card mb-4 border-primary">
            <div class="card-header bg-primary text-white fw-bold">Account Information</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <strong>Account Number:</strong> @Model.AccountNumber <br />
                        <strong>Account Holder:</strong> @Model.AccountHolder <br />
                        <strong>Account Status:</strong> @Model.AccountStatus
                    </div>
                    <div class="col-md-6">
                        <strong>Account Type:</strong> @Model.AccountType <br />
                        <strong>Mobile Number:</strong> @Model.MobileNumber <br />
                        <strong>Email:</strong> @Model.Email
                    </div>
                    <div class="col-md-12 mt-2">
                        <strong>Account Balance:</strong>
                        <span class="fw-bold text-success">
                            @Model.AccountBalance.ToString("N2", CultureInfo.InvariantCulture)
                        </span>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- DATA TABLE -->
    @if (Model?.PageData?.Items != null && Model.PageData.Items.Any())
    {
        var totalAmount = Model.PageData.Items.Sum(i => i.TopUpAmount + i.TransactionAmount);
        <div class="table-responsive">
            <table id="accountHistoryTable" class="table table-bordered table-hover text-center align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Lane Name</th>
                        <th>Transaction Type</th>
                        <th>Transaction Amount</th>
                        <th>Top-Up Amount</th>
                        <th>User Balance</th>
                        <th>Payment Method</th>
                        <th>Date & Time</th>
                        <th>Registered Identifier</th>
                        <th>Number Plate</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.PageData.Items)
                    {
                        <tr>
                            <td>@item.LaneName</td>
                            <td>@item.TransactionType</td>
                            <td>@item.TransactionAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@item.TopUpAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@item.UserBalance.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@item.PaymentMethod</td>
                            <td>@(item.TransactionDateTime?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                            <td>@item.RegisteredIdentifier</td>
                            <td>@item.NumberPlate</td>
                        </tr>
                    }
                    <tr class="fw-bold table-light">
                        <td colspan="2" class="text-end">Total:</td>
                        <td colspan="2">@totalAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                        <td colspan="5"></td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
    else if (!string.IsNullOrEmpty(Model?.AccountNumber))
    {
        <div class="alert alert-warning text-center">No records found for this account.</div>
    }

    <!-- FOOTER -->
    <div class="mt-4 p-3 border-top bg-light small text-muted">
        <div class="row">
            <div class="col-md-4"><strong>Report:</strong> Account History Report</div>
            <div class="col-md-4"><strong>Generated:</strong> @reportGeneratedAt</div>
            <div class="col-md-4 text-end">
                <strong>User:</strong> @currentUserId <br />
                Version: @reportVersion
            </div>
        </div>
    </div>

    
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.1.0-rc.0/js/select2.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.1.0-rc.0/css/select2.min.css" rel="stylesheet" />

    <script>
        $(document).ready(function () {
            $('#accountSelect').select2({
                placeholder: '-- Select Account --',
                allowClear: true,
                width: '100%'
            });

            $('#accountSelect').on('change', function () {
                $('#accountForm').submit();
            });
        });
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>

    <script>
        // === PDF EXPORT ===
        document.getElementById("btnExportPdf")?.addEventListener("click", async function () {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "a4" });
            const pageWidth = doc.internal.pageSize.getWidth();
            const margin = 40;

            const leftLogo = new Image();
            leftLogo.src = '/images/lCC Logo.jpg';
            const rightLogo = new Image();
            rightLogo.src = '/images/ICT-Works Logo.jpg';
            await new Promise(r => { leftLogo.onload = rightLogo.onload = r; });
            doc.addImage(leftLogo, "JPEG", margin, 20, 60, 60);
            doc.addImage(rightLogo, "JPEG", pageWidth - 100, 20, 60, 60);

            doc.setFontSize(14);
            doc.text("ACCOUNT HISTORY REPORT", pageWidth / 2, 50, { align: "center" });

            const account = document.querySelector("#accountSelect").value || "N/A";
            const filters = [`Account: ${account}`];
            doc.setFontSize(10);
            doc.text(filters, margin, 100);

            doc.autoTable({
                html: "#accountHistoryTable",
                startY: 120,
                theme: "grid",
                headStyles: { fillColor: [13, 110, 253], textColor: 255 },
                styles: { fontSize: 8, cellPadding: 3 },
                didDrawPage: function () {
                    const pageCount = doc.internal.getNumberOfPages();
                    const pageHeight = doc.internal.pageSize.height;
                    doc.setFontSize(8);
                    doc.text(`User: ${"@currentUserId"}`, margin, pageHeight - 20);
                    doc.text(`Generated: ${"@reportGeneratedAt"}`, pageWidth / 2.5, pageHeight - 20);
                    doc.text(`Page ${pageCount}`, pageWidth - margin, pageHeight - 20, { align: "right" });
                }
            });

            doc.save(`Account_History_Report_${new Date().toISOString().replace(/[:.]/g, '-')}.pdf`);
        });

        // === EXCEL EXPORT ===
        document.getElementById("btnExportExcel")?.addEventListener("click", function () {
            const wb = XLSX.utils.table_to_book(document.querySelector("#accountHistoryTable"), { sheet: "AccountHistory" });
            XLSX.writeFile(wb, `Account_History_Report_${new Date().toISOString().replace(/[:.]/g, '-')}.xlsx`);
        });
    </script>
}
