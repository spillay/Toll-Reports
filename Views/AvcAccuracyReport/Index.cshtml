@model MIS.Web.Models.AvcAccuracy.PageAvcAccuracyReportModel
@using System.Globalization
@using System.Linq
@removeTagHelper "Microsoft.AspNetCore.Mvc.TagHelpers.OptionTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers"

@{
    ViewData["Title"] = "AVC Accuracy Report";

    var lanes = Model?.Lanes ?? new List<MIS.Web.Models.AvcAccuracy.AvcAccuracyLaneRowModel>();
    var total = Model?.GrandTotal ?? new MIS.Web.Models.AvcAccuracy.AvcAccuracyTotalsModel();

    var reportGeneratedAt = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
    var currentUserId = User.FindFirst("firstName")?.Value ?? User.Identity?.Name ?? "Unknown User";
    var reportVersion = "3.0.0.0";
    var reportName = "AVC REPORT";

    var orderedClasses = total.Classes?
        .OrderBy(x => x.DisplayOrder)
        .ToList()
        ?? new List<MIS.Web.Models.AvcAccuracy.AvcAccuracyClassCellModel>();

    string shiftText = Model.SelectedShiftIds != null && Model.SelectedShiftIds.Any()
        ? string.Join(", ", Model.ShiftOptions.Where(x => Model.SelectedShiftIds.Contains(x.Id)).Select(x => x.Name))
        : "-All-";

    string laneText = Model.SelectedLaneIds != null && Model.SelectedLaneIds.Any()
        ? string.Join(", ", Model.LaneOptions.Where(x => Model.SelectedLaneIds.Contains(x.Id)).Select(x => x.Name))
        : "-All-";

    string classText = Model.SelectedClassIds != null && Model.SelectedClassIds.Any()
        ? string.Join(", ", Model.ClassOptions.Where(x => Model.SelectedClassIds.Contains(x.Id)).Select(x => x.Name))
        : "-All-";

    string Count(decimal value) => value.ToString("N0", CultureInfo.InvariantCulture);
    string Percent(decimal value) => value.ToString("N2", CultureInfo.InvariantCulture) + "%";

    MIS.Web.Models.AvcAccuracy.AvcAccuracyClassCellModel EmptyClassCell()
        => new MIS.Web.Models.AvcAccuracy.AvcAccuracyClassCellModel();

    var totalColumnCount = 1 + (orderedClasses.Count * 2) + 2 + 3;
}

<style>
    .avc-checkbox-panel {
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        padding: 0.75rem;
        max-height: 180px;
        overflow-y: auto;
        background-color: #fff;
    }

    .avc-report-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1300px;
    }

        .avc-report-table th,
        .avc-report-table td {
            border: 1px solid #000 !important;
            padding: 6px 8px;
            text-align: center;
            vertical-align: middle;
            white-space: nowrap;
            font-size: 13px;
        }

        .avc-report-table thead th {
            font-weight: 700;
        }

    .avc-group-header {
        background-color: #e9ecef !important;
        font-weight: 700;
    }

    .avc-sub-header {
        background-color: #f8f9fa !important;
        font-style: italic;
        font-weight: 600;
    }

    .avc-lane-title {
        background-color: #f8f9fa !important;
        font-weight: 700;
        text-align: left !important;
    }

    .avc-left-text {
        text-align: left !important;
        font-weight: 600;
    }

    .avc-total-row td {
        font-weight: 700;
        background-color: #f8f9fa !important;
    }

    .avc-filter-summary td {
        padding: 4px 8px;
        vertical-align: top;
    }

   
</style>

<div class="card shadow-lg p-4 mb-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
        <h2 class="mb-0 fw-bold text-primary text-center w-100">AVC ACCURACY REPORT</h2>
    </div>

    <!-- EXPORT BUTTONS -->
    <div class="row mb-3 no-print">
        <div class="col-md-2 me-2">
            <button id="btnDownloadPdf" class="btn btn-danger w-100 shadow-sm" type="button">
                Export PDF
            </button>
        </div>

        <div class="col-md-2">
            <button id="btnDownloadExcel" class="btn btn-success w-100 shadow-sm" type="button">
                Export Excel
            </button>
        </div>
    </div>

    <!-- FILTER FORM -->
    <form method="get" asp-controller="AvcAccuracyReport" asp-action="Index" class="no-print">
        <div class="row g-3 mb-4">

            <div class="col-md-3">
                <label class="form-label fw-semibold">Start Date & Time</label>
                <input type="datetime-local"
                       name="startDate"
                       class="form-control"
                       value="@(Model.StartDate == default ? "" : Model.StartDate.ToString("yyyy-MM-ddTHH:mm"))" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">End Date & Time</label>
                <input type="datetime-local"
                       name="endDate"
                       class="form-control"
                       value="@(Model.EndDate == default ? "" : Model.EndDate.ToString("yyyy-MM-ddTHH:mm"))" />
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Operational Shift</label>
                <div class="avc-checkbox-panel">
                    @if (Model.ShiftOptions != null && Model.ShiftOptions.Any())
                    {
                        foreach (var item in Model.ShiftOptions.OrderBy(x => x.Name))
                        {
                            var isChecked = Model.SelectedShiftIds != null && Model.SelectedShiftIds.Contains(item.Id);

                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="shift_@item.Id"
                                       name="shiftIds"
                                       value="@item.Id"
                                @(isChecked ? "checked" : "") />
                                <label class="form-check-label" for="shift_@item.Id">@item.Name</label>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted">No shift options available.</div>
                    }
                </div>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Lane</label>
                <div class="avc-checkbox-panel">
                    @if (Model.LaneOptions != null && Model.LaneOptions.Any())
                    {
                        foreach (var item in Model.LaneOptions.OrderBy(x => x.Name))
                        {
                            var isChecked = Model.SelectedLaneIds != null && Model.SelectedLaneIds.Contains(item.Id);

                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="lane_@item.Id"
                                       name="laneIds"
                                       value="@item.Id"
                                @(isChecked ? "checked" : "") />
                                <label class="form-check-label" for="lane_@item.Id">@item.Name</label>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted">No lane options available.</div>
                    }
                </div>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Class</label>
                <div class="avc-checkbox-panel">
                    @if (Model.ClassOptions != null && Model.ClassOptions.Any())
                    {
                        foreach (var item in Model.ClassOptions.OrderBy(x => x.Name))
                        {
                            var isChecked = Model.SelectedClassIds != null && Model.SelectedClassIds.Contains(item.Id);

                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="class_@item.Id"
                                       name="classIds"
                                       value="@item.Id"
                                @(isChecked ? "checked" : "") />
                                <label class="form-check-label" for="class_@item.Id">@item.Name</label>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted">No class options available.</div>
                    }
                </div>
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Apply Filters</button>
            </div>
        </div>
    </form>

    <!-- FILTER SUMMARY -->
    <table class="table table-borderless mb-3 avc-filter-summary">
        <tr>
            <td style="width:220px;"><strong>Start Date and Time:</strong></td>
            <td>@(Model.StartDate == default ? "" : Model.StartDate.ToString("dd/MM/yyyy hh:mm tt"))</td>
        </tr>
        <tr>
            <td><strong>End Date and Time:</strong></td>
            <td>@(Model.EndDate == default ? "" : Model.EndDate.ToString("dd/MM/yyyy hh:mm tt"))</td>
        </tr>
        <tr>
            <td><strong>Operational Shift:</strong></td>
            <td>@shiftText</td>
        </tr>
        <tr>
            <td><strong>Lane:</strong></td>
            <td>@laneText</td>
        </tr>
        <tr>
            <td><strong>Class:</strong></td>
            <td>@classText</td>
        </tr>
    </table>

    <!-- REPORT TABLE -->
    <div class="table-responsive">
        <table id="reportTable" class="table table-bordered avc-report-table">
            <thead>
                <tr class="avc-group-header">
                    <th rowspan="2">Lane ID</th>

                    @foreach (var cls in orderedClasses)
                    {
                        <th colspan="2">@cls.ClassName</th>
                    }

                    <th colspan="2">Total Accuracy</th>
                    <th rowspan="2">Total Traffic</th>
                    <th rowspan="2">Total Class Error</th>
                    <th rowspan="2">Total Error</th>
                </tr>
                <tr class="avc-sub-header">
                    @foreach (var cls in orderedClasses)
                    {
                        <th>Actual</th>
                        <th>Adjusted</th>
                    }

                    <th>Actual</th>
                    <th>Adjusted</th>
                </tr>
            </thead>
            <tbody>
                @if (lanes.Any())
                {
                    foreach (var laneRow in lanes.OrderBy(x => x.LaneId))
                    {
                        var laneClasses = orderedClasses
                            .Select(c => laneRow.Classes.FirstOrDefault(x => x.ClassId == c.ClassId) ?? EmptyClassCell())
                            .ToList();

                        <tr>
                            <td class="avc-lane-title">@laneRow.LaneId</td>
                            <td colspan="@(totalColumnCount - 1)"></td>
                        </tr>

                        <tr>
                            <td class="avc-left-text">Traffic Count</td>

                            @foreach (var cls in laneClasses)
                            {
                                <td>@Count(cls.ActualCount)</td>
                                <td>@Count(cls.AdjustedCount)</td>
                            }

                            <td>@Count(laneRow.TotalActualCount)</td>
                            <td>@Count(laneRow.TotalAdjustedCount)</td>
                            <td>@Count(laneRow.TotalTraffic)</td>
                            <td>@Count(laneRow.TotalClassError)</td>
                            <td></td>
                        </tr>

                        <tr>
                            <td class="avc-left-text">Percentage Accuracy</td>

                            @foreach (var cls in laneClasses)
                            {
                                <td>@Percent(cls.ActualPercentage)</td>
                                <td>@Percent(cls.AdjustedPercentage)</td>
                            }

                            <td>@Percent(laneRow.TotalAccuracyActual)</td>
                            <td>@Percent(laneRow.TotalAccuracyAdjusted)</td>
                            <td></td>
                            <td>@Percent(laneRow.TotalError)</td>
                            <td>@Percent(laneRow.TotalError)</td>
                        </tr>
                    }

                    var totalClasses = orderedClasses
                        .Select(c => total.Classes.FirstOrDefault(x => x.ClassId == c.ClassId) ?? EmptyClassCell())
                        .ToList();

                    <tr class="avc-total-row">
                        <td class="avc-lane-title">Total</td>
                        <td colspan="@(totalColumnCount - 1)"></td>
                    </tr>

                    <tr class="avc-total-row">
                        <td class="avc-left-text">Traffic Count</td>

                        @foreach (var cls in totalClasses)
                        {
                            <td>@Count(cls.ActualCount)</td>
                            <td>@Count(cls.AdjustedCount)</td>
                        }

                        <td>@Count(total.TotalActualCount)</td>
                        <td>@Count(total.TotalAdjustedCount)</td>
                        <td>@Count(total.TotalTraffic)</td>
                        <td>@Count(total.TotalClassError)</td>
                        <td></td>
                    </tr>

                    <tr class="avc-total-row">
                        <td class="avc-left-text">Percentage Accuracy</td>

                        @foreach (var cls in totalClasses)
                        {
                            <td>@Percent(cls.ActualPercentage)</td>
                            <td>@Percent(cls.AdjustedPercentage)</td>
                        }

                        <td>@Percent(total.TotalAccuracyActual)</td>
                        <td>@Percent(total.TotalAccuracyAdjusted)</td>
                        <td></td>
                        <td>@Percent(total.TotalError)</td>
                        <td>@Percent(total.TotalError)</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="@totalColumnCount" class="text-muted">No data available for the selected filters.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- SCREEN FOOTER -->
    <div class="mt-4 border-top pt-3">
        <table class="table table-borderless mb-0">
            <tr>
                <td><strong>@reportName</strong></td>
                <td><strong>Date And Time:</strong> @reportGeneratedAt</td>
                <td><strong>User ID:</strong> @currentUserId</td>
                <td class="text-end"><strong>Page 1 of 1</strong></td>
            </tr>
            <tr>
                <td colspan="4">
                    <small class="text-muted">
                        Reports Module Version Number: <strong>@reportVersion</strong>
                    </small>
                </td>
            </tr>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", async () => {
        const { jsPDF } = window.jspdf;

        const REPORT_TITLE = "AVC ACCURACY REPORT";
        const COMPANY_NAME = "LEKKI CONCESSION COMPANY LIMITED";
        const COMPANY_SUBTITLE = "LEKKI-IKOYI LINK BRIDGE";

        const GENERATED_ON = "@reportGeneratedAt";
        const GENERATED_BY = "@currentUserId";
        const REPORT_VERSION = "@reportVersion";

        const FILTERS_USED = {
        "Start Date and Time": "@(Model.StartDate == default ? "" : Model.StartDate.ToString("dd/MM/yyyy hh:mm tt"))",
        "End Date and Time": "@(Model.EndDate == default ? "" : Model.EndDate.ToString("dd/MM/yyyy hh:mm tt"))",
        "Operational Shift": "@shiftText",
        "Lane": "@laneText",
        "Class": "@classText"
        };

        const TABLE_ID = "reportTable";
        const EXCEL_BUTTON_ID = "btnDownloadExcel";
        const PDF_BUTTON_ID = "btnDownloadPdf";

        const LEFT_LOGO_PATH = "/images/lCC Logo.jpg";
        const RIGHT_LOGO_PATH = "/images/ICT-Works Logo.jpg";

        function getTable() {
        return document.getElementById(TABLE_ID);
        }

        function fileStamp() {
        return new Date().toISOString().replace(/[:.]/g, "-");
        }

        function getSafeText(value) {
        return (value ?? "").toString().replace(/\s+/g, " ").trim();
        }

        function loadImage(src) {
        return new Promise(resolve => {
        const img = new Image();
        img.crossOrigin = "Anonymous";
        img.onload = () => resolve(img);
        img.onerror = () => resolve(null);
        img.src = src;
        });
        }

        function hasTableData() {
        const table = getTable();
        if (!table) return false;

        const bodyRows = table.querySelectorAll("tbody tr");
        if (!bodyRows.length) return false;

        return Array.from(bodyRows).some(tr =>
        Array.from(tr.querySelectorAll("td")).some(td => getSafeText(td.innerText) !== "")
        );
        }

        function extractFullTableData() {
        const rows = [];
        const table = getTable();

        if (!table) return rows;

        table.querySelectorAll("tr").forEach(tr => {
        const row = [];
        tr.querySelectorAll("th, td").forEach(cell => {
        row.push(getSafeText(cell.innerText));
        });

        if (row.length > 0) {
        rows.push(row);
        }
        });

        return rows;
        }

        function extractTableHeaders() {
        const headers = [];
        const table = getTable();

        if (!table) return headers;

        table.querySelectorAll("thead tr").forEach(tr => {
        const row = [];
        tr.querySelectorAll("th").forEach(th => {
        row.push(getSafeText(th.innerText));
        });

        if (row.length > 0) {
        headers.push(row);
        }
        });

        return headers;
        }

        function extractStructuredBodyRows() {
        const rows = [];
        const table = getTable();

        if (!table) return rows;

        table.querySelectorAll("tbody tr").forEach(tr => {
        const cells = [];
        tr.querySelectorAll("td").forEach(td => {
        cells.push(getSafeText(td.innerText));
        });

        if (cells.length > 0) {
        const firstCell = cells[0] || "";

        rows.push({
        cells,
        firstCell,
        isTotalRow: tr.classList.contains("avc-total-row"),
        isLaneTitleRow: firstCell !== "" && cells.slice(1).every(x => x === ""),
        isMetricRow:
        firstCell === "Traffic Count" ||
        firstCell === "Percentage Accuracy",
        rawClassName: tr.className || ""
        });
        }
        });

        return rows;
        }

        function buildExcelData() {
        const data = [];

        data.push([COMPANY_NAME]);
        data.push([COMPANY_SUBTITLE]);
        data.push([REPORT_TITLE]);
        data.push([]);

        data.push(["Start Date and Time:", FILTERS_USED["Start Date and Time"]]);
        data.push(["End Date and Time:", FILTERS_USED["End Date and Time"]]);
        data.push(["Operational Shift:", FILTERS_USED["Operational Shift"]]);
        data.push(["Lane:", FILTERS_USED["Lane"]]);
        data.push(["Class:", FILTERS_USED["Class"]]);
        data.push([]);

        extractFullTableData().forEach(row => data.push(row));

        data.push([]);
        data.push(["Date and Time:", GENERATED_ON]);
        data.push(["User ID:", GENERATED_BY]);
        data.push(["Reports Module Version Number:", REPORT_VERSION]);

        return data;
        }

        function addPdfHeader(doc, pageWidth, margin, startY, leftLogo, rightLogo) {
        if (leftLogo) {
        doc.addImage(leftLogo, "JPEG", margin, startY, 60, 60);
        }

        if (rightLogo) {
        doc.addImage(rightLogo, "JPEG", pageWidth - 88, startY, 60, 60);
        }

        doc.setFont("helvetica", "bold");
        doc.setFontSize(14);
        doc.text(COMPANY_NAME, pageWidth / 2, startY + 12, { align: "center" });
        doc.text(COMPANY_SUBTITLE, pageWidth / 2, startY + 30, { align: "center" });
        doc.text(REPORT_TITLE, pageWidth / 2, startY + 48, { align: "center" });
        }

        function addPdfFilters(doc, margin, startY) {
        let y = startY;

        doc.setFont("helvetica", "normal");
        doc.setFontSize(10);

        Object.entries(FILTERS_USED).forEach(([key, value]) => {
        doc.text(`${key}: ${value}`, margin, y);
        y += 14;
        });

        return y;
        }

        function addPdfFooters(doc, pageWidth, pageHeight, margin) {
        const totalPages = doc.getNumberOfPages();

        for (let pageNumber = 1; pageNumber <= totalPages; pageNumber++) {
        doc.setPage(pageNumber);

        const footerY = pageHeight - 28;

        doc.setFont("helvetica", "normal");
        doc.setFontSize(9);
        doc.text(REPORT_TITLE, margin, footerY);
        doc.text(`Generated On: ${GENERATED_ON}`, pageWidth / 2 - 70, footerY);
        doc.text(`Generated By: ${GENERATED_BY}`, pageWidth - 180, footerY);
        doc.text(`Page ${pageNumber} of ${totalPages}`, pageWidth - 85, footerY);

        doc.setFontSize(8);
        doc.text(`Reports Module Version Number: ${REPORT_VERSION}`, margin, footerY + 12);
        }
        }

        function exportExcel() {
        if (!hasTableData()) {
        alert("No data available to export.");
        return;
        }

        const wb = XLSX.utils.book_new();
        const ws = XLSX.utils.aoa_to_sheet(buildExcelData());

        ws["!cols"] = Array.from({ length: 40 }, () => ({ wch: 16 }));

        XLSX.utils.book_append_sheet(wb, ws, "AVC Accuracy Report");
        XLSX.writeFile(wb, `AVC_Accuracy_Report_${fileStamp()}.xlsx`);
        }

        function exportPdf(leftLogo, rightLogo) {
        if (!hasTableData()) {
        alert("No data available to export.");
        return;
        }

        const doc = new jsPDF("l", "pt", "a4");
        const pageWidth = doc.internal.pageSize.getWidth();
        const pageHeight = doc.internal.pageSize.getHeight();
        const margin = 28;
        const startY = 30;

        addPdfHeader(doc, pageWidth, margin, startY, leftLogo, rightLogo);

        const filtersEndY = addPdfFilters(doc, margin, startY + 80);

        const headerRows = extractTableHeaders();
        const structuredBodyRows = extractStructuredBodyRows();
        const bodyRows = structuredBodyRows.map(x => x.cells);

        doc.autoTable({
        startY: filtersEndY + 8,
        head: headerRows.length ? headerRows : [["Report"]],
        body: bodyRows,
        styles: {
        fontSize: 7,
        cellPadding: 3,
        lineColor: [0, 0, 0],
        lineWidth: 0.5,
        textColor: [0, 0, 0],
        halign: "center",
        valign: "middle",
        overflow: "linebreak"
        },
        headStyles: {
        fillColor: [230, 230, 230],
        textColor: [0, 0, 0],
        fontStyle: "bold",
        halign: "center",
        valign: "middle"
        },
        theme: "grid",
        margin: {
        left: margin,
        right: margin,
        bottom: 55
        },
        didParseCell: function (data) {
        if (data.section !== "body") return;

        const rowInfo = structuredBodyRows[data.row.index];
        if (!rowInfo) return;

        if (rowInfo.isLaneTitleRow) {
        data.cell.styles.fillColor = [248, 249, 250];
        data.cell.styles.fontStyle = "bold";

        if (data.column.index === 0) {
        data.cell.styles.halign = "left";
        }
        }

        if (rowInfo.isMetricRow && data.column.index === 0) {
        data.cell.styles.fontStyle = "bold";
        data.cell.styles.halign = "left";
        }

        if (rowInfo.isTotalRow) {
        data.cell.styles.fillColor = [248, 249, 250];
        data.cell.styles.fontStyle = "bold";

        if (data.column.index === 0) {
        data.cell.styles.halign = "left";
        }
        }
        }
        });

        addPdfFooters(doc, pageWidth, pageHeight, margin);
        doc.save(`AVC_Accuracy_Report_${fileStamp()}.pdf`);
        }

        const [leftLogo, rightLogo] = await Promise.all([
        loadImage(LEFT_LOGO_PATH),
        loadImage(RIGHT_LOGO_PATH)
        ]);

        document.getElementById(EXCEL_BUTTON_ID)?.addEventListener("click", exportExcel);

        document.getElementById(PDF_BUTTON_ID)?.addEventListener("click", () => {
        exportPdf(leftLogo, rightLogo);
        });
        });
    </script>
}