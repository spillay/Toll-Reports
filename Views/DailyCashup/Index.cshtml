@model MIS.Web.Models.DailyCashup.PageDailyCashupModel
@removeTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    var startQuery = Context.Request.Query["StartDate"].ToString();
    var endQuery = Context.Request.Query["EndDate"].ToString();
    var shiftQuery = Context.Request.Query["OperationalShift"].ToString();
    var operatorQuery = Context.Request.Query["TollOperators"].ToString();
}

<div class="card shadow-lg mb-4">
    <div class="card-body">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
            <h2 class="mb-0 fw-bold text-primary">Daily Cashup Report</h2>
            <div>
                <button id="btnExportPDF" class="btn btn-danger btn-sm me-2">
                    <i class="bi bi-file-earmark-pdf"></i> Export PDF
                </button>
                <button id="btnExportExcel" class="btn btn-success btn-sm">
                    <i class="bi bi-file-earmark-excel"></i> Export Excel
                </button>
            </div>
        </div>

        <!-- Filters -->
        <form method="get" asp-controller="DailyCashup" asp-action="Index" class="row g-3 mb-3">
            <div class="col-md-3">
                <label class="form-label">Start Date</label>
                <input type="datetime-local" name="StartDate" class="form-control"
                       value="@(!string.IsNullOrEmpty(startQuery)
                                 ? startQuery
                                 : Model?.StartDate.ToString("yyyy-MM-ddTHH:mm"))" />
            </div>

            <div class="col-md-3">
                <label class="form-label">End Date</label>
                <input type="datetime-local" name="EndDate" class="form-control"
                       value="@(!string.IsNullOrEmpty(endQuery)
                                 ? endQuery
                                 : Model?.EndDate.ToString("yyyy-MM-ddTHH:mm"))" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Shift</label>
                <select name="OperationalShift" class="form-select">
                    <option value="">-- All --</option>
                    @foreach (var shift in ViewBag.Shifts ?? new List<string>())
                    {
                        var isSelected = shiftQuery == shift;
                        <option value="@shift" selected="@(isSelected ? "selected" : null)">@shift</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Toll Operator</label>
                <select name="TollOperators" class="form-select">
                    <option value="">-- All --</option>
                    @foreach (var op in ViewBag.TollOperators ?? new List<string>())
                    {
                        var isSelected = operatorQuery == op;
                        <option value="@op" selected="@(isSelected ? "selected" : null)">@op</option>
                    }
                </select>
            </div>

            <div class="col-md-12 text-end">
                <button type="submit" class="btn btn-primary px-4">Filter</button>
            </div>
        </form>

        <!-- Table -->
        @if (Model?.Items != null && Model.Items.Any())
        {
            <div class="table-responsive">
                <table id="dailyCashupTable" class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Operational Shift</th>
                            <th>Toll Operator ID</th>
                            <th class="text-end">Lane Cash</th>
                            <th class="text-end">Top-ups</th>
                            <th class="text-end">Total Cash Expected</th>
                            <th class="text-end">Cash Declared</th>
                            <th class="text-end">Surplus / Shortage</th>
                            <th class="text-end">Total Banked</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var grouped = Model.Items.GroupBy(i => i.ShiftDescription).ToList();
                            double dayTotalLaneCash = 0;
                            double dayTotalExpected = 0;
                            double dayTotalDeclared = 0;
                            double dayTotalDifference = 0;
                            double dayTotalBanked = 0;
                        }

                        @foreach (var group in grouped)
                        {
                            double shiftLaneCash = 0;
                            double shiftExpected = 0;
                            double shiftDeclared = 0;
                            double shiftDifference = 0;
                            double shiftBanked = 0;

                            <tr class="table-secondary fw-bold">
                                <td colspan="8">Shift: @group.Key</td>
                            </tr>

                            foreach (var item in group)
                            {
                                double difference = item.ActualAmount - item.TotalDeclared;
                                double totalBanked = item.NettAmount + difference;

                                shiftLaneCash += item.NettAmount;
                                shiftExpected += item.ActualAmount;
                                shiftDeclared += item.TotalDeclared;
                                shiftDifference += difference;
                                shiftBanked += totalBanked;

                                string diffClass = difference > 0 ? "text-primary fw-bold"
                                    : difference < 0 ? "text-danger fw-bold" : "text-muted fw-bold";

                                string formattedDiff = difference < 0
                                    ? $"-{Math.Abs(difference).ToString("N2")}"
                                    : difference.ToString("N2");

                                <tr>
                                    <td>@item.ShiftDescription</td>
                                    <td>@item.TollOperator</td>
                                    <td class="text-end">@item.NettAmount.ToString("N2")</td>
                                    <td class="text-end">0.00</td>
                                    <td class="text-end">@item.ActualAmount.ToString("N2")</td>
                                    <td class="text-end">@item.TotalDeclared.ToString("N2")</td>
                                    <td class="text-end @diffClass">@formattedDiff</td>
                                    <td class="text-end fw-bold">@totalBanked.ToString("N2")</td>
                                </tr>
                            }

                            <tr class="fw-bold table-light">
                                <td colspan="7" class="text-end">Total @group.Key</td>
                                <td class="text-end">@shiftBanked.ToString("N2")</td>
                            </tr>

                            dayTotalLaneCash += shiftLaneCash;
                            dayTotalExpected += shiftExpected;
                            dayTotalDeclared += shiftDeclared;
                            dayTotalDifference += shiftDifference;
                            dayTotalBanked += shiftBanked;
                        }

                        <tr class="fw-bold text-white" style="background-color:#1b4b72;">
                            <td colspan="7" class="text-end">Operational Day Total</td>
                            <td class="text-end">@dayTotalBanked.ToString("N2")</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.totalPages > 1)
            {
                var startDateVal = !string.IsNullOrEmpty(startQuery) ? startQuery : Model.StartDate.ToString("yyyy-MM-ddTHH:mm:ss");
                var endDateVal = !string.IsNullOrEmpty(endQuery) ? endQuery : Model.EndDate.ToString("yyyy-MM-ddTHH:mm:ss");

                <div class="d-flex justify-content-center mt-3">
                    <nav aria-label="Page navigation">
                        <ul class="pagination">
                            <li class="page-item @(Model.page <= 1 ? "disabled" : "")">
                                <a class="page-link"
                                   href="@Url.Action("Index", new {
                                       page = Model.page - 1,
                                       pageSize = Model.pageSize,
                                       StartDate = startDateVal,
                                       EndDate = endDateVal,
                                       OperationalShift = shiftQuery,
                                       TollOperators = operatorQuery
                                   })">« Previous</a>
                            </li>

                            @for (int i = Math.Max(1, Model.page - 1); i <= Math.Min(Model.totalPages, Model.page + 1); i++)
                            {
                                <li class="page-item @(Model.page == i ? "active" : "")">
                                    <a class="page-link"
                                       href="@Url.Action("Index", new {
                                           page = i,
                                           pageSize = Model.pageSize,
                                           StartDate = startDateVal,
                                           EndDate = endDateVal,
                                           OperationalShift = shiftQuery,
                                           TollOperators = operatorQuery
                                       })">@i</a>
                                </li>
                            }

                            <li class="page-item @(Model.page >= Model.totalPages ? "disabled" : "")">
                                <a class="page-link"
                                   href="@Url.Action("Index", new {
                                       page = Model.page + 1,
                                       pageSize = Model.pageSize,
                                       StartDate = startDateVal,
                                       EndDate = endDateVal,
                                       OperationalShift = shiftQuery,
                                       TollOperators = operatorQuery
                                   })">Next »</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }

            <!-- Footer -->
            <div class="border-top pt-3 mt-3 small text-muted">
                <div class="row">
                    <div class="col-md-6 fw-bold">
                        Daily Cash Report
                        <div class="text-secondary">Reports Module Version: 1.0.0</div>
                    </div>
                    <div class="col-md-3">
                        <strong>Date and Time:</strong> @DateTime.Now.ToString("dd-MM-yyyy HH:mm:ss")
                    </div>
                    <div class="col-md-3 text-end">
                        <strong>User ID:</strong> @(User?.Identity?.Name ?? "Lucky")
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning text-center">
                No data found for the selected range.
            </div>
        }
    </div>
</div>

@section Scripts {
    <!-- Dependencies -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>

    <script>

        document.getElementById("btnExportPDF").addEventListener("click", async function () {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "a4" });

            const pageWidth = doc.internal.pageSize.getWidth();
            const pageHeight = doc.internal.pageSize.getHeight();
            const margin = 40;

            // Report metadata
            const reportGeneratedAt = new Date().toLocaleString();
            const currentUser = '@(User?.Identity?.Name ?? "Lucky")';
            const reportVersion = "1.0.0";

            // Filters
            const filters = {
                "Start Date": "@(Model?.StartDate.ToString("dd/MM/yyyy HH:mm") ?? "-")",
                "End Date": "@(Model?.EndDate.ToString("dd/MM/yyyy HH:mm") ?? "-")",
                "Shift": "@(shiftQuery ?? "All")",
                "Operator": "@(operatorQuery ?? "All")"
            };

            // Load logos
            const logoWidth = 90, logoHeight = 90, logoY = 25;
            const leftLogo = '/images/LCC Logo.jpg';
            const rightLogo = '/images/ICT-Works Logo.jpg';
            const loadImage = src => new Promise(resolve => {
                const img = new Image();
                img.crossOrigin = 'Anonymous';
                img.onload = () => resolve(img);
                img.onerror = () => resolve(null);
                img.src = src;
            });
            const [lLogo, rLogo] = await Promise.all([loadImage(leftLogo), loadImage(rightLogo)]);
            if (lLogo) doc.addImage(lLogo, 'JPEG', margin, logoY, logoWidth, logoHeight);
            if (rLogo) doc.addImage(rLogo, 'JPEG', pageWidth - margin - logoWidth, logoY, logoWidth, logoHeight);

            // Title
            doc.setFont("helvetica", "bold");
            doc.setFontSize(16);
            doc.text("Daily Cashup Report", pageWidth / 2, logoY + 50, { align: "center" });

            // Filters section
            let y = logoY + logoHeight + 10;
            doc.setFont("helvetica", "normal");
            doc.setFontSize(10);
            doc.text("Filters Used:", margin, y);
            y += 14;
            for (const [key, value] of Object.entries(filters)) {
                doc.text(`${key}: ${value}`, margin, y);
                y += 14;
            }

            // Table data
            const cashupData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Items ?? new List<MIS.Web.Models.DailyCashup.DailyCashupModel>()));
            const headers = [
                "Operational Shift",
                "Toll Operator ID",
                "Lane Cash",
                "Top-ups",
                "Total Cash Expected",
                "Cash Declared",
                "Surplus / Shortage",
                "Total Banked"
            ];

            const rows = (cashupData || []).map(d => [
                d.ShiftDescription,
                d.TollOperator,
                (Number(d.NettAmount) || 0).toFixed(2),
                "0.00",
                (Number(d.ActualAmount) || 0).toFixed(2),
                (Number(d.TotalDeclared) || 0).toFixed(2),
                (Number(d.ActualAmount - d.TotalDeclared) || 0).toFixed(2),
                (Number(d.NettAmount + (d.ActualAmount - d.TotalDeclared)) || 0).toFixed(2)
            ]);

            // Draw the table
            doc.autoTable({
                head: [headers],
                body: rows,
                startY: y + 10,
                theme: 'grid',
                styles: { fontSize: 9, cellPadding: 4 },
                headStyles: { fillColor: [41, 128, 185], textColor: 255, halign: "center" },
                columnStyles: { 0: { halign: "left" }, 1: { halign: "left" } },
                margin: { left: margin, right: margin },
                didDrawPage: function (data) {
                    const pageCount = doc.internal.getNumberOfPages();
                    const currentPage = doc.internal.getCurrentPageInfo().pageNumber;
                    const footerY = pageHeight - 50;

                    doc.setFont("helvetica", "normal");
                    doc.setFontSize(10);
                    doc.text("Daily Cashup Report", margin, footerY);
                    doc.text(`Date and Time: ${reportGeneratedAt}`, pageWidth / 2.5, footerY);
                    doc.text(`User ID: ${currentUser}`, pageWidth / 1.5, footerY);
                    doc.text(`Page ${currentPage} of ${pageCount}`, pageWidth - margin, footerY, { align: 'right' });
                    doc.setFontSize(9);
                    doc.text(`Reports Module Version Number: ${reportVersion}`, margin, footerY + 14);
                }
            });

            // Save the PDF
            doc.save(`Daily_Cashup_Report_${new Date().toISOString().replace(/[:.]/g, '-')}.pdf`);
        });


        document.getElementById("btnExportExcel").addEventListener("click", function () {
        const cashupData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Items ?? new List<MIS.Web.Models.DailyCashup.DailyCashupModel>()));
            if (!cashupData.length) { alert("No data to export."); return; }

            const wb = XLSX.utils.book_new();
            const headers = [["Operational Shift", "Toll Operator ID", "Lane Cash", "Top-ups", "Total Cash Expected", "Cash Declared", "Surplus / Shortage", "Total Banked"]];
            const rows = cashupData.map(d => [
                d.ShiftDescription,
                d.TollOperator,
                d.NettAmount?.toFixed(2) ?? "0.00",
                "0.00",
                d.ActualAmount?.toFixed(2) ?? "0.00",
                d.TotalDeclared?.toFixed(2) ?? "0.00",
                (d.ActualAmount - d.TotalDeclared)?.toFixed(2) ?? "0.00",
                (d.NettAmount + (d.ActualAmount - d.TotalDeclared))?.toFixed(2) ?? "0.00"
            ]);

            const ws = XLSX.utils.aoa_to_sheet([...headers, ...rows]);
            XLSX.utils.book_append_sheet(wb, ws, "Daily Cashup Report");
            XLSX.writeFile(wb, `Daily_Cashup_Report_${new Date().toISOString().replace(/[:.]/g, '-')}.xlsx`);
        });
    </script>
}

