@model MIS.Web.Models.EndOfDay.PageEndOfDayModel
@using System.Text.Json
@using MIS.Web.Models.EndOfDay

@{
    ViewData["Title"] = "End Of Day Report";

    var generatedAt = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
    var userId = User.FindFirst("firstName")?.Value ?? (User.Identity?.Name ?? "Unknown User");
    var version = "3.0.0.0";
    var reportName = "END OF DAY REPORT";

    var report = Model?.Report ?? new EndOfDayReportViewModel();
    var selectedReportDate = Model?.ReportDate ?? DateTime.Today;
    var selectedShiftId = Model?.ShiftId;
    var reportRows = (report.Rows ?? new List<EndOfDayReportRowViewModel>())
        .Select(row => new EndOfDayReportRowViewModel
        {
            Col1 = row.Col1 ?? string.Empty,
            Col2 = row.Col2 ?? string.Empty,
            Col3 = row.Col3 ?? string.Empty,
            Col4 = row.Col4 ?? string.Empty,
            Col5 = row.Col5 ?? string.Empty,
            Col6 = row.Col6 ?? string.Empty,
            Col7 = row.Col7 ?? string.Empty,
            Col8 = row.Col8 ?? string.Empty
        })
        .ToList();

    foreach (var row in reportRows)
    {
        if (
            string.Equals(row.Col2?.Trim(), "Date and Time:", StringComparison.OrdinalIgnoreCase))
        {
            row.Col3 = generatedAt;
        }

        if (string.Equals(row.Col2?.Trim(), "User ID:", StringComparison.OrdinalIgnoreCase))
        {
            row.Col3 = userId;
        }

        if ((row.Col2 ?? string.Empty).Contains("Reports Module Version Number", StringComparison.OrdinalIgnoreCase))
        {
            row.Col2 = $"Reports Module Version Number: {version}";
        }
    }

    string CssForRow(EndOfDayReportRowViewModel row)
    {
        var col1 = (row.Col1 ?? string.Empty).Trim();
        var col2 = (row.Col2 ?? string.Empty).Trim();

        if (string.Equals(col1, "LEKKI CONCESSION COMPANY LIMITED", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(col1, "LEKKI-IKOYI LINK BRIDGE", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(col1, reportName, StringComparison.OrdinalIgnoreCase))
        {
            return "report-title-row";
        }

        if (string.Equals(col1, "THEORETICAL INCOME", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(col1, "LESS: EXEMPTS", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(col1, "LESS: DISCOUNT", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(col1, "OTHER INCOME", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(col1, "Accounted for as follows:", StringComparison.OrdinalIgnoreCase))
        {
            return "report-section-row";
        }

        if (string.Equals(col2, "Class M", StringComparison.OrdinalIgnoreCase))
        {
            return "report-header-row";
        }

        if (col1.StartsWith("TOTAL", StringComparison.OrdinalIgnoreCase) ||
            col1.StartsWith("(A)", StringComparison.OrdinalIgnoreCase) ||
            col1.StartsWith("(B)", StringComparison.OrdinalIgnoreCase) ||
            col1.StartsWith("UN-RECONCILED", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(col1, "Discount provided", StringComparison.OrdinalIgnoreCase))
        {
            return "report-total-row";
        }

        return string.Empty;
    }

    string CellText(string? value) => value ?? string.Empty;

    bool IsStoredProcedureTitleRow(EndOfDayReportRowViewModel row)
    {
        var col1 = (row.Col1 ?? string.Empty).Trim();

        return string.Equals(col1, "LEKKI CONCESSION COMPANY LIMITED", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(col1, "LEKKI-IKOYI LINK BRIDGE", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(col1, reportName, StringComparison.OrdinalIgnoreCase);
    }

    bool IsStoredProcedureFooterRow(EndOfDayReportRowViewModel row)
    {
        var col1 = (row.Col1 ?? string.Empty).Trim();
        var col2 = (row.Col2 ?? string.Empty).Trim();

        return string.Equals(col1, "End of Day Report", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(col2, "User ID:", StringComparison.OrdinalIgnoreCase) ||
               col2.Contains("Reports Module Version", StringComparison.OrdinalIgnoreCase);
    }

    bool IsEmptyReportRow(EndOfDayReportRowViewModel row) =>
        string.IsNullOrWhiteSpace(row.Col1) &&
        string.IsNullOrWhiteSpace(row.Col2) &&
        string.IsNullOrWhiteSpace(row.Col3) &&
        string.IsNullOrWhiteSpace(row.Col4) &&
        string.IsNullOrWhiteSpace(row.Col5) &&
        string.IsNullOrWhiteSpace(row.Col6) &&
        string.IsNullOrWhiteSpace(row.Col7) &&
        string.IsNullOrWhiteSpace(row.Col8);

    var previewRows = reportRows
        .Where(row => !IsStoredProcedureTitleRow(row))
        .Where(row => !IsStoredProcedureFooterRow(row))
        .ToList();

    while (previewRows.Any() && IsEmptyReportRow(previewRows[0]))
    {
        previewRows.RemoveAt(0);
    }

    while (previewRows.Any() && IsEmptyReportRow(previewRows[^1]))
    {
        previewRows.RemoveAt(previewRows.Count - 1);
    }
}

<style>
    .eod-report-table {
        table-layout: fixed;
        width: 100%;
        font-size: 0.92rem;
    }

    .eod-report-table td {
        border: 1px solid #dee2e6;
        padding: 0.45rem 0.55rem;
        vertical-align: middle;
        word-break: break-word;
    }

    .eod-report-table .report-title-row td {
        border-color: transparent;
        font-weight: 700;
        text-align: center;
    }

    .eod-report-table .report-section-row td {
        background-color: #2980b9;
        color: #fff;
        font-weight: 700;
    }

    .eod-report-table .report-header-row td {
        background-color: #2980b9;
        color: #fff;
        font-weight: 700;
        text-align: center;
    }

    .eod-report-table .report-total-row td {
        background-color: #e9ecef;
        font-weight: 700;
    }
</style>

<div class="card shadow-lg p-4 mb-4">
    <div class="border-bottom pb-2 mb-3 text-center">
        <h2 class="fw-bold text-primary mb-0">END OF DAY REPORT</h2>
    </div>

    <div class="row mb-4">
        <div class="col-md-2 me-2">
            <button id="btnDownloadPdf" type="button" class="btn btn-danger w-100 shadow-sm">
                <i class="bi bi-file-earmark-pdf"></i> Export PDF
            </button>
        </div>

        <div class="col-md-2">
            <button id="btnDownloadExcel" type="button" class="btn btn-success w-100 shadow-sm">
                <i class="bi bi-file-earmark-excel"></i> Export Excel
            </button>
        </div>
    </div>

    <form method="get" asp-action="Index" asp-controller="EndOfDayReport" class="row g-3 mb-4">
        <div class="col-md-3">
            <label class="form-label fw-semibold">Report Date</label>
            <input type="date"
                   name="reportDate"
                   class="form-control"
                   value="@selectedReportDate.ToString("yyyy-MM-dd")"
                   required />
        </div>

        <div class="col-md-3">
            <label class="form-label fw-semibold">Shift ID</label>
            <input type="number"
                   name="shiftId"
                   class="form-control"
                   value="@(selectedShiftId?.ToString() ?? "")"
                   placeholder="Optional" />
        </div>

        <div class="col-md-3 d-flex align-items-end">
            <button class="btn btn-primary w-100 shadow-sm" type="submit">Apply Filter</button>
        </div>
    </form>

    @if (previewRows.Any())
    {
        <div class="table-responsive">
            <table id="eodReportTable" class="table table-bordered eod-report-table align-middle">
                <tbody>
                    @foreach (var row in previewRows)
                    {
                        <tr class="@CssForRow(row)">
                            <td>@CellText(row.Col1)</td>
                            <td>@CellText(row.Col2)</td>
                            <td>@CellText(row.Col3)</td>
                            <td>@CellText(row.Col4)</td>
                            <td>@CellText(row.Col5)</td>
                            <td>@CellText(row.Col6)</td>
                            <td>@CellText(row.Col7)</td>
                            <td>@CellText(row.Col8)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-warning mb-0">
            No End Of Day data found for the selected date and shift.
        </div>
    }

    <hr />
    <div class="mt-4 p-3 border-top">
        <table class="table table-borderless w-100 mb-0 align-middle">
            <tr>
                <td class="fw-bold text-dark">End of Day Report</td>
                <td><strong>Date and Time:</strong> @generatedAt</td>
                <td><strong>User:</strong> @userId</td>
                <td class="text-end">
                    Page <strong>1</strong> of <strong>1</strong>
                </td>
            </tr>
            <tr>
                <td colspan="4">
                    <small class="text-muted">
                        Reports Module Version Number: <strong>@version</strong>
                    </small>
                </td>
            </tr>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const reportRows = @Html.Raw(JsonSerializer.Serialize(reportRows));
            const reportName = @Html.Raw(JsonSerializer.Serialize(reportName));
            const generatedAt = @Html.Raw(JsonSerializer.Serialize(generatedAt));
            const userId = @Html.Raw(JsonSerializer.Serialize(userId));
            const version = @Html.Raw(JsonSerializer.Serialize(version));
            const leftLogoUrl = "/images/LCC Logo.jpg";
            const rightLogoUrl = "/images/ICT-Works Logo.jpg";

            function getExportRows() {
                return reportRows.map(row => [
                    row.Col1 || "",
                    row.Col2 || "",
                    row.Col3 || "",
                    row.Col4 || "",
                    row.Col5 || "",
                    row.Col6 || "",
                    row.Col7 || "",
                    row.Col8 || ""
                ]);
            }

            function isTitleRow(row) {
                const col1 = String(row[0] || "").trim().toUpperCase();
                return col1 === "LEKKI CONCESSION COMPANY LIMITED" ||
                    col1 === "LEKKI-IKOYI LINK BRIDGE" ||
                    col1 === "END OF DAY REPORT";
            }

            function isStoredProcedureFooterRow(row) {
                const col1 = String(row[0] || "").trim().toUpperCase();
                const col2 = String(row[1] || "").trim().toUpperCase();

                return col1 === "END OF DAY REPORT" ||
                    col2 === "USER ID:" ||
                    col2.includes("REPORTS MODULE VERSION");
            }

            function isEmptyRow(row) {
                return row.every(value => String(value || "").trim() === "");
            }

            function getPdfRows() {
                const rows = getExportRows()
                    .filter(row => !isTitleRow(row))
                    .filter(row => !isStoredProcedureFooterRow(row));

                while (rows.length > 0 && isEmptyRow(rows[0])) {
                    rows.shift();
                }

                while (rows.length > 0 && isEmptyRow(rows[rows.length - 1])) {
                    rows.pop();
                }

                return rows;
            }

            function isSectionRow(row) {
                const col1 = String(row[0] || "").trim().toUpperCase();
                return col1 === "THEORETICAL INCOME" ||
                    col1 === "LESS: EXEMPTS" ||
                    col1 === "LESS: DISCOUNT" ||
                    col1 === "OTHER INCOME" ||
                    col1 === "ACCOUNTED FOR AS FOLLOWS:";
            }

            function isHeaderRow(row) {
                return String(row[1] || "").trim().toUpperCase() === "CLASS M";
            }

            function isTotalRow(row) {
                const col1 = String(row[0] || "").trim().toUpperCase();
                return col1.startsWith("TOTAL") ||
                    col1.startsWith("(A)") ||
                    col1.startsWith("(B)") ||
                    col1.startsWith("UN-RECONCILED") ||
                    col1 === "DISCOUNT PROVIDED";
            }

            function loadImage(src) {
                return new Promise(resolve => {
                    const img = new Image();
                    img.crossOrigin = "Anonymous";
                    img.onload = () => resolve(img);
                    img.onerror = () => resolve(null);
                    img.src = src;
                });
            }

            function drawPdfHeader(doc, pageWidth, margin, leftLogo, rightLogo) {
                const topY = 25;

                if (leftLogo) {
                    doc.addImage(leftLogo, "JPEG", margin, topY, 80, 80);
                }

                if (rightLogo) {
                    doc.addImage(rightLogo, "JPEG", pageWidth - margin - 80, topY, 80, 80);
                }

                let y = 60;

                doc.setFont("helvetica", "bold");
                doc.setFontSize(14);
                doc.text("LEKKI CONCESSION COMPANY LIMITED", pageWidth / 2, y, { align: "center" });

                y += 18;
                doc.setFontSize(12);
                doc.text("LEKKI-IKOYI LINK BRIDGE", pageWidth / 2, y, { align: "center" });

                y += 26;
                doc.setFontSize(16);
                doc.text(reportName, pageWidth / 2, y, { align: "center" });

                return y + 35;
            }

            function addPdfFooter(doc, pageWidth, pageHeight, margin) {
                const totalPages = doc.getNumberOfPages();

                for (let i = 1; i <= totalPages; i++) {
                    doc.setPage(i);

                    const footerY = pageHeight - 30;

                    doc.setDrawColor(180);
                    doc.line(margin, footerY - 14, pageWidth - margin, footerY - 14);

                    doc.setFont("helvetica", "normal");
                    doc.setFontSize(10);

                    doc.text("End of Day Report", margin, footerY);
                    doc.text(`Date and Time: ${generatedAt}`, pageWidth / 2.25, footerY);
                    doc.text(`User: ${userId}`, pageWidth / 1.5, footerY);
                    doc.text(`Page ${i} of ${totalPages}`, pageWidth - margin, footerY, { align: "right" });

                    doc.setFontSize(9);
                    doc.text(`Reports Module Version Number: ${version}`, margin, footerY + 14);
                }
            }

            function exportExcel() {
                if (!reportRows.length) {
                    alert("No data to export.");
                    return;
                }

                const workbook = XLSX.utils.book_new();
                const worksheet = XLSX.utils.aoa_to_sheet(getExportRows());

                worksheet["!cols"] = [
                    { wch: 42 },
                    { wch: 18 },
                    { wch: 18 },
                    { wch: 14 },
                    { wch: 14 },
                    { wch: 14 },
                    { wch: 14 },
                    { wch: 16 }
                ];

                XLSX.utils.book_append_sheet(workbook, worksheet, "EndOfDay");
                XLSX.writeFile(workbook, "EndOfDayReport.xlsx");
            }

            async function exportPdf() {
                const pdfRows = getPdfRows();

                if (!pdfRows.length) {
                    alert("No data to export.");
                    return;
                }

                const { jsPDF } = window.jspdf;
                const doc = new jsPDF({
                    orientation: "landscape",
                    unit: "pt",
                    format: "a4"
                });

                const pageWidth = doc.internal.pageSize.getWidth();
                const pageHeight = doc.internal.pageSize.getHeight();
                const margin = 40;

                const [leftLogo, rightLogo] = await Promise.all([
                    loadImage(leftLogoUrl),
                    loadImage(rightLogoUrl)
                ]);

                const tableStartY = drawPdfHeader(doc, pageWidth, margin, leftLogo, rightLogo);

                doc.autoTable({
                    body: pdfRows,
                    startY: tableStartY,
                    theme: "grid",
                    styles: {
                        fontSize: 8,
                        cellPadding: 4,
                        textColor: [0, 0, 0],
                        lineColor: [190, 190, 190],
                        lineWidth: 0.4
                    },
                    columnStyles: {
                        0: { cellWidth: 205 },
                        1: { cellWidth: 90 },
                        2: { cellWidth: 90 },
                        3: { cellWidth: 75 },
                        4: { cellWidth: 75 },
                        5: { cellWidth: 75 },
                        6: { cellWidth: 75 },
                        7: { cellWidth: 85 }
                    },
                    margin: {
                        left: margin,
                        right: margin,
                        bottom: 60
                    },
                    didParseCell: function (data) {
                        const row = data.row.raw || [];

                        if (isTitleRow(row)) {
                            data.cell.styles.fontStyle = "bold";
                            data.cell.styles.halign = "center";
                            data.cell.styles.lineColor = [255, 255, 255];
                        }

                        if (isSectionRow(row) || isHeaderRow(row)) {
                            data.cell.styles.fontStyle = "bold";
                            data.cell.styles.fillColor = [41, 128, 185];
                            data.cell.styles.textColor = [255, 255, 255];
                        }

                        if (isHeaderRow(row)) {
                            data.cell.styles.halign = "center";
                        }

                        if (isTotalRow(row)) {
                            data.cell.styles.fontStyle = "bold";
                            data.cell.styles.fillColor = [230, 230, 230];
                            data.cell.styles.textColor = [0, 0, 0];
                        }
                    }
                });

                addPdfFooter(doc, pageWidth, pageHeight, margin);
                doc.save("EndOfDayReport.pdf");
            }

            document.getElementById("btnDownloadExcel")?.addEventListener("click", () => {
                try {
                    exportExcel();
                } catch (error) {
                    console.error("Excel export failed:", error);
                    alert("Failed to export Excel.");
                }
            });

            document.getElementById("btnDownloadPdf")?.addEventListener("click", async () => {
                try {
                    await exportPdf();
                } catch (error) {
                    console.error("PDF export failed:", error);
                    alert("Failed to export PDF.");
                }
            });
        });
    </script>
}
