@model MIS.Web.Models.EndOfDay.PageEndOfDayModel
@using MIS.Web.Models.EndOfDay

@{
    ViewData["Title"] = "End Of Day Report";

    var generatedAt = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
    var userId = User.FindFirst("firstName")?.Value ?? "Unknown User";
    var version = "3.0.0.0";
    var reportName = "END OF DAY REPORT";

    var currentPage = 1;
    var totalPages = 1;

    var report = Model?.Report ?? new EndOfDayReportViewModel();
    var theoretical = report.TheoreticalIncome ?? new List<TheoreticalIncomeRowViewModel>();
    var discounts = report.Discounts ?? new DiscountsViewModel();
    var exempts = report.Exempts ?? new ExemptsViewModel();
    var other = report.OtherIncome ?? new OtherIncomeViewModel();
    var recon = report.Reconciliation ?? new ReconciliationViewModel();
    var totals = report.Totals ?? new EndOfDayTotalsViewModel();

    var monthLabel = !string.IsNullOrWhiteSpace(report.MonthLabel)
        ? report.MonthLabel
        : Model.StartDate.ToString("MMMM yyyy");

    var operationalDayLabel = !string.IsNullOrWhiteSpace(report.OperationalDayLabel)
        ? report.OperationalDayLabel
        : Model.StartDate.ToString("dd MMMM yyyy");

    var shiftName = !string.IsNullOrWhiteSpace(report.ShiftName)
        ? report.ShiftName
        : "-All-";

    var map = theoretical
        .Where(x => !string.IsNullOrWhiteSpace(x.Metric))
        .GroupBy(x => x.Metric.Trim().ToLower())
        .ToDictionary(g => g.Key, g => g.First());

    TheoreticalIncomeRowViewModel? GetRow(string key)
        => map.TryGetValue(key.Trim().ToLower(), out var row) ? row : null;

    var traffic = GetRow("traffic");
    var nominal = GetRow("nominal tariff");
    var trafficNominal = GetRow("traffic x nominal tariff");
    var penalty = GetRow("cash penalty");
    var totalTheoreticalRow = GetRow("total theoretical income");

    decimal totalTheo = totals.TotalTheoreticalIncome > 0
        ? totals.TotalTheoreticalIncome
        : (totalTheoreticalRow?.Total ?? ((trafficNominal?.Total ?? 0) + (penalty?.Total ?? 0)));

    decimal exemptsTotal = totals.TotalExemptAmount > 0
        ? totals.TotalExemptAmount
        : exempts.TotalExemptAmount;

    decimal anonTotal = discounts.Anonymous5.Total;
    decimal indivTotal = discounts.Individual10.Total;
    decimal corpTotal = discounts.Corporate10.Total;
    decimal staffTotal = discounts.Staff100.Total;

    decimal providedTotal = totals.TotalDiscountAmount > 0
        ? totals.TotalDiscountAmount
        : discounts.TotalDiscountAmount;

    decimal totalDiscountedIncome = totals.TotalDiscountedIncome > 0
        ? totals.TotalDiscountedIncome
        : (totalTheo - providedTotal);

    decimal totalIncomeA = totals.TotalIncomeA > 0
        ? totals.TotalIncomeA
        : (totalDiscountedIncome + other.TotalOtherIncome);

    decimal totalAccountedB = totals.TotalAccountedB > 0
        ? totals.TotalAccountedB
        : recon.TotalAccounted;

    decimal unreconciled = totals.UnreconciledDiscrepancy != 0
        ? totals.UnreconciledDiscrepancy
        : (totalIncomeA - totalAccountedB);

    string F(decimal value) => value.ToString("N2");
}

<div class="card shadow-lg p-4 mb-4">
    <div class="border-bottom pb-2 mb-3 text-center">
        <h2 class="fw-bold text-primary mb-0">END OF DAY REPORT</h2>
    </div>

    <div class="row mb-4">
        <div class="col-md-2 me-2">
            <button id="btnDownloadPdf" type="button" class="btn btn-danger w-100 shadow-sm">
                <i class="bi bi-file-earmark-pdf"></i> Export PDF
            </button>
        </div>

        <div class="col-md-2">
            <button id="btnDownloadExcel" type="button" class="btn btn-success w-100 shadow-sm">
                <i class="bi bi-file-earmark-excel"></i> Export Excel
            </button>
        </div>
    </div>

    <form method="get" asp-action="Index" asp-controller="EndOfDayReport" class="row g-3 mb-4">
        <div class="col-md-3">
            <label class="form-label fw-semibold">Report Date</label>
            <input type="date"
                   name="reportDate"
                   class="form-control"
                   value="@Model.ReportDate.ToString("yyyy-MM-dd")"
                   required />
        </div>

        <div class="col-md-3">
            <label class="form-label fw-semibold">Shift ID</label>
            <input type="number"
                   name="shiftId"
                   class="form-control"
                   value="@(Model.ShiftId?.ToString() ?? "")"
                   placeholder="Optional" />
        </div>

        <div class="col-md-3 d-flex align-items-end">
            <button class="btn btn-primary w-100 shadow-sm" type="submit">Apply Filter</button>
        </div>
    </form>

    <div class="mb-4 small">
        <div><strong>Month:</strong> @monthLabel</div>
        <div><strong>Start Date and Time:</strong> @Model.StartDate.ToString("dd/MM/yyyy HH:mm")</div>
        <div><strong>End Date and Time:</strong> @Model.EndDate.ToString("dd/MM/yyyy HH:mm")</div>
        <div><strong>Operational Day:</strong> @(report.IsOperationalDay ? "Yes" : "No") @operationalDayLabel</div>
        <div><strong>Operational Shift:</strong> @shiftName</div>
    </div>

    <h5 class="fw-bold text-secondary mt-4 mb-2">THEORETICAL INCOME</h5>
    <div class="table-responsive">
        <table class="table table-bordered align-middle text-end">
            <thead class="table-light text-center">
                <tr>
                    <th class="text-start">Metric</th>
                    <th>Class M</th>
                    <th>Class 1</th>
                    <th>Class 2</th>
                    <th>Class 3</th>
                    <th>Class 4</th>
                    <th>Class D</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="fw-semibold text-start">Traffic</td>
                    <td>@F(traffic?.ClassM ?? 0)</td>
                    <td>@F(traffic?.Class1 ?? 0)</td>
                    <td>@F(traffic?.Class2 ?? 0)</td>
                    <td>@F(traffic?.Class3 ?? 0)</td>
                    <td>@F(traffic?.Class4 ?? 0)</td>
                    <td>@F(traffic?.ClassD ?? 0)</td>
                    <td>@F(traffic?.Total ?? 0)</td>
                </tr>

                <tr>
                    <td class="fw-semibold text-start">Nominal Tariff</td>
                    <td>@F(nominal?.ClassM ?? 0)</td>
                    <td>@F(nominal?.Class1 ?? 0)</td>
                    <td>@F(nominal?.Class2 ?? 0)</td>
                    <td>@F(nominal?.Class3 ?? 0)</td>
                    <td>@F(nominal?.Class4 ?? 0)</td>
                    <td>@F(nominal?.ClassD ?? 0)</td>
                    <td></td>
                </tr>

                <tr class="fw-bold">
                    <td class="text-start"><em>Traffic x Nominal Tariff</em></td>
                    <td>@F(trafficNominal?.ClassM ?? 0)</td>
                    <td>@F(trafficNominal?.Class1 ?? 0)</td>
                    <td>@F(trafficNominal?.Class2 ?? 0)</td>
                    <td>@F(trafficNominal?.Class3 ?? 0)</td>
                    <td>@F(trafficNominal?.Class4 ?? 0)</td>
                    <td>@F(trafficNominal?.ClassD ?? 0)</td>
                    <td>@F(trafficNominal?.Total ?? 0)</td>
                </tr>

                <tr>
                    <td class="fw-semibold text-start">Cash Penalty</td>
                    <td>@F(penalty?.ClassM ?? 0)</td>
                    <td>@F(penalty?.Class1 ?? 0)</td>
                    <td>@F(penalty?.Class2 ?? 0)</td>
                    <td>@F(penalty?.Class3 ?? 0)</td>
                    <td>@F(penalty?.Class4 ?? 0)</td>
                    <td>@F(penalty?.ClassD ?? 0)</td>
                    <td>@F(penalty?.Total ?? 0)</td>
                </tr>

                <tr class="fw-bold table-light">
                    <td class="text-start">TOTAL THEORETICAL INCOME</td>
                    <td colspan="6"></td>
                    <td>@F(totalTheo)</td>
                </tr>

                <tr>
                    <td class="fw-semibold text-start">LESS: EXEMPTS</td>
                    <td>@F(exempts.ClassM)</td>
                    <td>@F(exempts.Class1)</td>
                    <td>@F(exempts.Class2)</td>
                    <td>@F(exempts.Class3)</td>
                    <td>@F(exempts.Class4)</td>
                    <td>@F(exempts.ClassD)</td>
                    <td>@F(exemptsTotal)</td>
                </tr>

                <tr class="table-light fw-bold">
                    <td colspan="8" class="text-start">LESS: DISCOUNT</td>
                </tr>

                <tr>
                    <td class="text-start">Anonymous 5%</td>
                    <td>@F(discounts.Anonymous5.ClassM)</td>
                    <td>@F(discounts.Anonymous5.Class1)</td>
                    <td>@F(discounts.Anonymous5.Class2)</td>
                    <td>@F(discounts.Anonymous5.Class3)</td>
                    <td>@F(discounts.Anonymous5.Class4)</td>
                    <td>@F(discounts.Anonymous5.ClassD)</td>
                    <td>@F(-anonTotal)</td>
                </tr>

                <tr>
                    <td class="text-start">Individual 10%</td>
                    <td>@F(discounts.Individual10.ClassM)</td>
                    <td>@F(discounts.Individual10.Class1)</td>
                    <td>@F(discounts.Individual10.Class2)</td>
                    <td>@F(discounts.Individual10.Class3)</td>
                    <td>@F(discounts.Individual10.Class4)</td>
                    <td>@F(discounts.Individual10.ClassD)</td>
                    <td>@F(-indivTotal)</td>
                </tr>

                <tr>
                    <td class="text-start">Corporate 10%</td>
                    <td>@F(discounts.Corporate10.ClassM)</td>
                    <td>@F(discounts.Corporate10.Class1)</td>
                    <td>@F(discounts.Corporate10.Class2)</td>
                    <td>@F(discounts.Corporate10.Class3)</td>
                    <td>@F(discounts.Corporate10.Class4)</td>
                    <td>@F(discounts.Corporate10.ClassD)</td>
                    <td>@F(-corpTotal)</td>
                </tr>

                <tr>
                    <td class="text-start">Staff 100%</td>
                    <td>@F(discounts.Staff100.ClassM)</td>
                    <td>@F(discounts.Staff100.Class1)</td>
                    <td>@F(discounts.Staff100.Class2)</td>
                    <td>@F(discounts.Staff100.Class3)</td>
                    <td>@F(discounts.Staff100.Class4)</td>
                    <td>@F(discounts.Staff100.ClassD)</td>
                    <td>@F(-staffTotal)</td>
                </tr>

                <tr class="fw-bold">
                    <td class="text-start">Discount Provided</td>
                    <td colspan="6"></td>
                    <td>@F(-providedTotal)</td>
                </tr>

                <tr class="fw-bold table-light">
                    <td class="text-start">TOTAL DISCOUNTED INCOME</td>
                    <td colspan="6"></td>
                    <td>@F(totalDiscountedIncome)</td>
                </tr>
            </tbody>
        </table>
    </div>

    <h5 class="fw-bold text-secondary mt-4 mb-2">OTHER INCOME</h5>
    <div class="table-responsive">
        <table class="table table-bordered align-middle text-end">
            <tbody>
                <tr class="fw-bold table-light">
                    <td class="text-start">OTHER INCOME</td>
                    <td>@F(other.TotalOtherIncome)</td>
                </tr>

                <tr>
                    <td class="text-start">Account Payments (Top-up)</td>
                    <td>@F(other.AccountPaymentsTopUp > 0 ? other.AccountPaymentsTopUp : other.TotalTopupAmount)</td>
                </tr>

                <tr><td class="text-start ps-4">Cash</td><td>@F(other.CashTopupAmount)</td></tr>
                <tr><td class="text-start ps-4">Switch</td><td>@F(other.SwitchTopupAmount)</td></tr>
                <tr><td class="text-start ps-4">Digital (EFT)</td><td>@F(other.DigitalTopupAmount)</td></tr>
                <tr><td class="text-start">Cash Declared Surplus</td><td>@F(other.CashDeclaredSurplus != 0 ? other.CashDeclaredSurplus : other.CashSurplusShortage)</td></tr>

                <tr class="fw-bold table-light">
                    <td class="text-start">(A) TOTAL INCOME</td>
                    <td>@F(totalIncomeA)</td>
                </tr>
            </tbody>
        </table>
    </div>

    <h5 class="fw-bold text-secondary mt-4 mb-2">Accounted for as follows:</h5>
    <div class="table-responsive">
        <table class="table table-bordered align-middle text-end">
            <tbody>
                <tr><td class="text-start">Cash Declared</td><td>@F(recon.CashDeclared)</td></tr>
                <tr><td class="text-start">Cash Banked</td><td>@F(recon.CashBanked)</td></tr>
                <tr><td class="text-start">Cash Banked (Surplus) Shortage</td><td>@F(recon.CashBankedSurplusShortage)</td></tr>
                <tr><td class="text-start">Switch</td><td>@F(recon.SwitchAmount)</td></tr>
                <tr><td class="text-start">Digital</td><td>@F(recon.DigitalAmount)</td></tr>

                <tr class="fw-bold table-light">
                    <td class="text-start">Pre-Paid Account Transactions</td>
                    <td>@F(recon.PrePaidTotal)</td>
                </tr>

                <tr><td class="text-start ps-4">Smart Card</td><td>@F(recon.SmartCardAmount)</td></tr>
                <tr><td class="text-start ps-4">ETC TAG</td><td>@F(recon.ETCTagAmount)</td></tr>

                <tr class="fw-bold table-light">
                    <td class="text-start">Other Lane Transactions</td>
                    <td>@F(recon.OtherLaneTotal)</td>
                </tr>

                <tr><td class="text-start ps-4">Violation</td><td>@F(recon.ViolationAmount)</td></tr>
                <tr><td class="text-start ps-4">Exemptions</td><td>@F(recon.ExemptionsAmount)</td></tr>

                <tr><td class="text-start">Collector Debt</td><td>@F(recon.CollectorDebt)</td></tr>
                <tr><td class="text-start">Cash Declared Shortages</td><td>@F(recon.CashShortages)</td></tr>

                <tr class="fw-bold table-light">
                    <td class="text-start">(B) TOTAL ACCOUNTED FOR</td>
                    <td>@F(totalAccountedB)</td>
                </tr>

                <tr class="fw-bold">
                    <td class="text-start">UN-RECONCILED DISCREPANCY</td>
                    <td>@F(unreconciled)</td>
                </tr>
            </tbody>
        </table>

        <table id="eodExportTableTheo" class="d-none">
            <thead>
                <tr>
                    <th>Metric</th>
                    <th>Class M</th>
                    <th>Class 1</th>
                    <th>Class 2</th>
                    <th>Class 3</th>
                    <th>Class 4</th>
                    <th>Class D</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                <tr><td>Traffic</td><td>@F(traffic?.ClassM ?? 0)</td><td>@F(traffic?.Class1 ?? 0)</td><td>@F(traffic?.Class2 ?? 0)</td><td>@F(traffic?.Class3 ?? 0)</td><td>@F(traffic?.Class4 ?? 0)</td><td>@F(traffic?.ClassD ?? 0)</td><td>@F(traffic?.Total ?? 0)</td></tr>
                <tr><td>Nominal Tariff</td><td>@F(nominal?.ClassM ?? 0)</td><td>@F(nominal?.Class1 ?? 0)</td><td>@F(nominal?.Class2 ?? 0)</td><td>@F(nominal?.Class3 ?? 0)</td><td>@F(nominal?.Class4 ?? 0)</td><td>@F(nominal?.ClassD ?? 0)</td><td></td></tr>
                <tr><td>Traffic x Nominal Tariff</td><td>@F(trafficNominal?.ClassM ?? 0)</td><td>@F(trafficNominal?.Class1 ?? 0)</td><td>@F(trafficNominal?.Class2 ?? 0)</td><td>@F(trafficNominal?.Class3 ?? 0)</td><td>@F(trafficNominal?.Class4 ?? 0)</td><td>@F(trafficNominal?.ClassD ?? 0)</td><td>@F(trafficNominal?.Total ?? 0)</td></tr>
                <tr><td>Cash Penalty</td><td>@F(penalty?.ClassM ?? 0)</td><td>@F(penalty?.Class1 ?? 0)</td><td>@F(penalty?.Class2 ?? 0)</td><td>@F(penalty?.Class3 ?? 0)</td><td>@F(penalty?.Class4 ?? 0)</td><td>@F(penalty?.ClassD ?? 0)</td><td>@F(penalty?.Total ?? 0)</td></tr>
                <tr><td><b>Total Theoretical Income</b></td><td colspan="6"></td><td>@F(totalTheo)</td></tr>
                <tr><td>Exempts</td><td>@F(exempts.ClassM)</td><td>@F(exempts.Class1)</td><td>@F(exempts.Class2)</td><td>@F(exempts.Class3)</td><td>@F(exempts.Class4)</td><td>@F(exempts.ClassD)</td><td>@F(exemptsTotal)</td></tr>
                <tr><td>Anonymous 5%</td><td>@F(discounts.Anonymous5.ClassM)</td><td>@F(discounts.Anonymous5.Class1)</td><td>@F(discounts.Anonymous5.Class2)</td><td>@F(discounts.Anonymous5.Class3)</td><td>@F(discounts.Anonymous5.Class4)</td><td>@F(discounts.Anonymous5.ClassD)</td><td>@F(-anonTotal)</td></tr>
                <tr><td>Individual 10%</td><td>@F(discounts.Individual10.ClassM)</td><td>@F(discounts.Individual10.Class1)</td><td>@F(discounts.Individual10.Class2)</td><td>@F(discounts.Individual10.Class3)</td><td>@F(discounts.Individual10.Class4)</td><td>@F(discounts.Individual10.ClassD)</td><td>@F(-indivTotal)</td></tr>
                <tr><td>Corporate 10%</td><td>@F(discounts.Corporate10.ClassM)</td><td>@F(discounts.Corporate10.Class1)</td><td>@F(discounts.Corporate10.Class2)</td><td>@F(discounts.Corporate10.Class3)</td><td>@F(discounts.Corporate10.Class4)</td><td>@F(discounts.Corporate10.ClassD)</td><td>@F(-corpTotal)</td></tr>
                <tr><td>Staff 100%</td><td>@F(discounts.Staff100.ClassM)</td><td>@F(discounts.Staff100.Class1)</td><td>@F(discounts.Staff100.Class2)</td><td>@F(discounts.Staff100.Class3)</td><td>@F(discounts.Staff100.Class4)</td><td>@F(discounts.Staff100.ClassD)</td><td>@F(-staffTotal)</td></tr>
                <tr><td><b>Total Discounted Income</b></td><td colspan="6"></td><td>@F(totalDiscountedIncome)</td></tr>
            </tbody>
        </table>

        <table id="eodExportTableOther" class="d-none">
            <thead>
                <tr><th>Metric</th><th>Total</th></tr>
            </thead>
            <tbody>
                <tr><td>Account Payments (Top-up)</td><td>@F(other.AccountPaymentsTopUp > 0 ? other.AccountPaymentsTopUp : other.TotalTopupAmount)</td></tr>
                <tr><td>Cash</td><td>@F(other.CashTopupAmount)</td></tr>
                <tr><td>Switch</td><td>@F(other.SwitchTopupAmount)</td></tr>
                <tr><td>Digital (EFT)</td><td>@F(other.DigitalTopupAmount)</td></tr>
                <tr><td>Cash Declared Surplus</td><td>@F(other.CashDeclaredSurplus != 0 ? other.CashDeclaredSurplus : other.CashSurplusShortage)</td></tr>
                <tr><td><b>Total Income (A)</b></td><td>@F(totalIncomeA)</td></tr>
            </tbody>
        </table>

        <table id="eodExportTableAccounted" class="d-none">
            <thead>
                <tr><th>Metric</th><th>Total</th></tr>
            </thead>
            <tbody>
                <tr><td>Cash Declared</td><td>@F(recon.CashDeclared)</td></tr>
                <tr><td>Cash Banked</td><td>@F(recon.CashBanked)</td></tr>
                <tr><td>Cash Banked (Surplus) Shortage</td><td>@F(recon.CashBankedSurplusShortage)</td></tr>
                <tr><td>Switch</td><td>@F(recon.SwitchAmount)</td></tr>
                <tr><td>Digital</td><td>@F(recon.DigitalAmount)</td></tr>
                <tr><td>Prepaid: Smart Card</td><td>@F(recon.SmartCardAmount)</td></tr>
                <tr><td>Prepaid: ETC Tag</td><td>@F(recon.ETCTagAmount)</td></tr>
                <tr><td>Violations</td><td>@F(recon.ViolationAmount)</td></tr>
                <tr><td>Exemptions</td><td>@F(recon.ExemptionsAmount)</td></tr>
                <tr><td>Collector Debt</td><td>@F(recon.CollectorDebt)</td></tr>
                <tr><td>Cash Declared Shortages</td><td>@F(recon.CashShortages)</td></tr>
                <tr><td><b>Total Accounted (B)</b></td><td>@F(totalAccountedB)</td></tr>
                <tr><td><b>Un-Reconciled Discrepancy</b></td><td>@F(unreconciled)</td></tr>
            </tbody>
        </table>
    </div>

    <div class="mt-4 border-top pt-3">
        <table class="table table-borderless mb-0">
            <tr>
                <td><strong>@reportName</strong></td>
                <td><strong>Date And Time:</strong> @generatedAt</td>
                <td><strong>User ID:</strong> @userId</td>
                <td class="text-end"><strong>Page @currentPage of @totalPages</strong></td>
            </tr>
            <tr>
                <td colspan="4">
                    <small class="text-muted">
                        Reports Module Version Number: <strong>@version</strong>
                    </small>
                </td>
            </tr>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", async () => {
        const { jsPDF } = window.jspdf;

        const REPORT_TITLE = "END OF DAY REPORT";
        const COMPANY_LINE_1 = "LEKKI CONCESSION COMPANY LIMITED";
        const COMPANY_LINE_2 = "LEKKI-IKOYI LINK BRIDGE";

        const GENERATED_AT = "@generatedAt";
        const USER_ID = "@userId";
        const REPORT_VERSION = "@version";

        const MONTH_TEXT = "@monthLabel";
        const START_TEXT = "@Model.StartDate.ToString("dd/MM/yyyy HH:mm")";
        const END_TEXT = "@Model.EndDate.ToString("dd/MM/yyyy HH:mm")";
        const OPERATIONAL_DAY_TEXT = "@((report.IsOperationalDay ? "Yes" : "No") + " " + operationalDayLabel)";
        const OPERATIONAL_SHIFT_TEXT = "@shiftName";

        const LEFT_LOGO_URL = "/images/LCC Logo.jpg";
        const RIGHT_LOGO_URL = "/images/ICT-Works Logo.jpg";

        function getPageWidth(doc) {
        return doc.internal.pageSize.getWidth();
        }

        function getPageHeight(doc) {
        return doc.internal.pageSize.getHeight();
        }

        function loadImage(src) {
        return new Promise(resolve => {
        const img = new Image();
        img.crossOrigin = "Anonymous";
        img.onload = () => resolve(img);
        img.onerror = () => resolve(null);
        img.src = src;
        });
        }

        function drawPdfHeader(doc, margin, leftLogo, rightLogo) {
        const pageWidth = getPageWidth(doc);

        if (leftLogo) doc.addImage(leftLogo, "JPEG", margin, 20, 70, 70);
        if (rightLogo) doc.addImage(rightLogo, "JPEG", pageWidth - margin - 70, 20, 70, 70);

        doc.setFont("helvetica", "bold");
        doc.setFontSize(14);
        doc.text(COMPANY_LINE_1, pageWidth / 2, 40, { align: "center" });

        doc.setFontSize(12);
        doc.text(COMPANY_LINE_2, pageWidth / 2, 60, { align: "center" });

        doc.setFontSize(13);
        doc.text(REPORT_TITLE, pageWidth / 2, 80, { align: "center" });

        return 110;
        }

        function drawPdfMetadata(doc, margin, startY) {
        let y = startY;

        doc.setFont("helvetica", "normal");
        doc.setFontSize(10);

        const lines = [
        `Month: ${MONTH_TEXT}`,
        `Start Date and Time: ${START_TEXT}`,
        `End Date and Time: ${END_TEXT}`,
        `Operational Day: ${OPERATIONAL_DAY_TEXT}`,
        `Operational Shift: ${OPERATIONAL_SHIFT_TEXT}`
        ];

        lines.forEach(line => {
        doc.text(line, margin, y);
        y += 15;
        });

        return y + 5;
        }

        function drawSectionTitle(doc, title, margin, y) {
        doc.setFont("helvetica", "bold");
        doc.setFontSize(11);
        doc.text(title, margin, y);
        return y + 10;
        }

        function addPdfFooter(doc, margin) {
        const pageWidth = getPageWidth(doc);
        const pageHeight = getPageHeight(doc);
        const totalPages = doc.internal.getNumberOfPages();

        for (let i = 1; i <= totalPages; i++) {
        doc.setPage(i);

        const footerTopY = pageHeight - 32;
        const footerBottomY = pageHeight - 18;

        doc.setDrawColor(180);
        doc.line(margin, pageHeight - 42, pageWidth - margin, pageHeight - 42);

        doc.setFont("helvetica", "normal");
        doc.setFontSize(9);

        doc.text(REPORT_TITLE, margin, footerTopY);
        doc.text(`Date And Time: ${GENERATED_AT}`, pageWidth / 2, footerTopY, { align: "center" });
        doc.text(`Page ${i} of ${totalPages}`, pageWidth - margin, footerTopY, { align: "right" });

        doc.text(`User ID: ${USER_ID}`, margin, footerBottomY);
        doc.text(`Reports Module Version Number: ${REPORT_VERSION}`, pageWidth - margin, footerBottomY, { align: "right" });
        }
        }

        async function exportPdf() {
        const doc = new jsPDF("p", "pt", "a4");
        const margin = 40;

        const [logoLeft, logoRight] = await Promise.all([
        loadImage(LEFT_LOGO_URL),
        loadImage(RIGHT_LOGO_URL)
        ]);

        let y = drawPdfHeader(doc, margin, logoLeft, logoRight);
        y = drawPdfMetadata(doc, margin, y);

        y = drawSectionTitle(doc, "THEORETICAL INCOME", margin, y);
        doc.autoTable({
        startY: y,
        html: "#eodExportTableTheo",
        theme: "grid",
        styles: { fontSize: 9, halign: "right", cellPadding: 4 },
        headStyles: { fillColor: [230, 230, 230], textColor: 0, halign: "center" },
        margin: { left: margin, right: margin, bottom: 55 }
        });

        y = doc.lastAutoTable.finalY + 25;
        y = drawSectionTitle(doc, "OTHER INCOME", margin, y);
        doc.autoTable({
        startY: y,
        html: "#eodExportTableOther",
        theme: "grid",
        styles: { fontSize: 9, halign: "right", cellPadding: 4 },
        headStyles: { fillColor: [230, 230, 230], textColor: 0, halign: "center" },
        margin: { left: margin, right: margin, bottom: 55 }
        });

        y = doc.lastAutoTable.finalY + 25;
        y = drawSectionTitle(doc, "ACCOUNTED FOR AS FOLLOWS", margin, y);
        doc.autoTable({
        startY: y,
        html: "#eodExportTableAccounted",
        theme: "grid",
        styles: { fontSize: 9, halign: "right", cellPadding: 4 },
        headStyles: { fillColor: [230, 230, 230], textColor: 0, halign: "center" },
        margin: { left: margin, right: margin, bottom: 55 }
        });

        addPdfFooter(doc, margin);
        doc.save("EndOfDayReport.pdf");
        }

        function getTableRows(selector) {
        return Array.from(document.querySelectorAll(`${selector} tbody tr`))
        .map(row => Array.from(row.children).map(cell => cell.innerText.trim()));
        }

        function exportExcel() {
        const wb = XLSX.utils.book_new();
        const wsData = [];

        wsData.push([COMPANY_LINE_1]);
        wsData.push([COMPANY_LINE_2]);
        wsData.push([REPORT_TITLE]);
        wsData.push([]);
        wsData.push([`Month: ${MONTH_TEXT}`]);
        wsData.push([`Start Date and Time: ${START_TEXT}`]);
        wsData.push([`End Date and Time: ${END_TEXT}`]);
        wsData.push([`Operational Day: ${OPERATIONAL_DAY_TEXT}`]);
        wsData.push([`Operational Shift: ${OPERATIONAL_SHIFT_TEXT}`]);
        wsData.push([]);
        wsData.push([]);

        wsData.push(["THEORETICAL INCOME"]);
        wsData.push(["Metric", "Class M", "Class 1", "Class 2", "Class 3", "Class 4", "Class D", "Total"]);
        getTableRows("#eodExportTableTheo").forEach(row => wsData.push(row));

        wsData.push([]);
        wsData.push([]);

        wsData.push(["OTHER INCOME"]);
        wsData.push(["Metric", "Total"]);
        getTableRows("#eodExportTableOther").forEach(row => wsData.push(row));

        wsData.push([]);
        wsData.push([]);

        wsData.push(["ACCOUNTED FOR AS FOLLOWS"]);
        wsData.push(["Metric", "Total"]);
        getTableRows("#eodExportTableAccounted").forEach(row => wsData.push(row));

        wsData.push([]);
        wsData.push(["Date and Time:", GENERATED_AT]);
        wsData.push(["User ID:", USER_ID]);
        wsData.push(["Reports Module Version Number:", REPORT_VERSION]);

        const sheet = XLSX.utils.aoa_to_sheet(wsData);
        sheet["!cols"] = [
        { wch: 35 }, { wch: 12 }, { wch: 12 }, { wch: 12 },
        { wch: 12 }, { wch: 12 }, { wch: 12 }, { wch: 16 }
        ];

        XLSX.utils.book_append_sheet(wb, sheet, "EndOfDay");
        XLSX.writeFile(wb, "EndOfDayReport.xlsx");
        }

        document.getElementById("btnDownloadPdf")?.addEventListener("click", async () => {
        try {
        await exportPdf();
        } catch (error) {
        console.error("PDF export failed:", error);
        alert("Failed to export PDF.");
        }
        });

        document.getElementById("btnDownloadExcel")?.addEventListener("click", () => {
        try {
        exportExcel();
        } catch (error) {
        console.error("Excel export failed:", error);
        alert("Failed to export Excel.");
        }
        });
        });
    </script>
}