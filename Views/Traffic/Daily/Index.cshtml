@model MIS.Web.Models.Traffic.Daily.PageDailyTrafficModel
@using System.Text.Json

@{
    ViewData["Title"] = "Daily Traffic Report";

    var reportGeneratedAt = DateTime.Now;
    var currentUser = User.FindFirst("firstName")?.Value ?? "Unknown User";
    var reportVersion = "3.0.0.0";

    var input = Model.Filters ?? new MIS.Web.Models.Traffic.Daily.DailyTrafficInputModel();
    var classifications = Model.Classifications ?? new List<string>();

    var hasData = Model.Items != null && Model.Items.Any();

    var groupedList = hasData
        ? Model.Items!
            .GroupBy(x => x.Date.Date)
            .OrderBy(g => g.Key)
            .ToList()
        : new List<IGrouping<DateTime, MIS.Web.Models.Traffic.Daily.DailyTrafficModel>>();

    var totalsPerClass = classifications.ToDictionary(c => c, c => 0);

    if (hasData)
    {
        foreach (var group in groupedList)
        {
            foreach (var cls in classifications)
            {
                var count = group
                    .Where(x => x.Classification == cls)
                    .Sum(x => x.Count);

                totalsPerClass[cls] += count;
            }
        }
    }

    var grandTotal = totalsPerClass.Values.Sum();
    var numberOfDays = groupedList.Count;

    var averages = classifications.ToDictionary(
        cls => cls,
        cls => numberOfDays > 0
            ? groupedList.Average(g => g.Where(x => x.Classification == cls).Sum(x => x.Count))
            : 0
    );

    var maximums = classifications.ToDictionary(
        cls => cls,
        cls => numberOfDays > 0
            ? groupedList.Max(g => g.Where(x => x.Classification == cls).Sum(x => x.Count))
            : 0
    );

    var averageTotal = numberOfDays > 0
        ? groupedList.Average(g => g.Sum(x => x.Count))
        : 0;

    var maximumTotal = numberOfDays > 0
        ? groupedList.Max(g => g.Sum(x => x.Count))
        : 0;

    var percentagesForPeriod = classifications.ToDictionary(
        cls => cls,
        cls => grandTotal > 0
            ? (double)totalsPerClass[cls] / grandTotal * 100
            : 0
    );

    double totalPercentForPeriod = grandTotal > 0 ? 100 : 0;
}

<div class="card shadow-lg mb-4">
    <div class="card-body">

        <!-- Header -->
        <div class="text-center mb-3 border-bottom pb-2">
            <h2 class="mb-0 fw-bold text-primary">DAILY TRAFFIC REPORT</h2>
        </div>

        <!-- Export Buttons -->
        <div class="row mb-3">
            <div class="col-md-2 me-2">
                <button id="btnDownloadPdf" class="btn btn-danger w-100">
                    <i class="bi bi-file-earmark-pdf"></i> Export PDF
                </button>
            </div>
            <div class="col-md-2">
                <button id="btnDownloadExcel" class="btn btn-success w-100">
                    <i class="bi bi-file-earmark-excel"></i> Export Excel
                </button>
            </div>
        </div>

        <!-- Filter Form -->
        @await Html.PartialAsync("~/Views/Traffic/Daily/_DailyTrafficFilters.cshtml", Model)

        <!-- Data Table -->
        <div class="table-responsive mt-3">
            <table class="table table-bordered table-striped text-center align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th></th>
                        @foreach (var cls in classifications)
                        {
                            <th>@cls</th>
                        }
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @if (hasData)
                    {
                        foreach (var group in groupedList)
                        {
                            var countsByClass = classifications.ToDictionary(
                            cls => cls,
                            cls => group.Where(x => x.Classification == cls).Sum(x => x.Count)
                            );

                            var rowTotal = countsByClass.Values.Sum();

                            <tr>
                                <td>@group.Key.ToString("dd/MM/yyyy")</td>
                                <td>Traffic</td>
                                @foreach (var cls in classifications)
                                {
                                    <td>@countsByClass[cls]</td>
                                }
                                <td>@rowTotal</td>
                            </tr>

                            <tr>
                                <td></td>
                                <td>Percentage</td>
                                @foreach (var cls in classifications)
                                {
                                    var pct = grandTotal > 0
                                    ? ((double)countsByClass[cls] / grandTotal * 100).ToString("0.00")
                                    : "0.00";
                                    <td>@pct%</td>
                                }
                                @{
                                    var rowPct = grandTotal > 0
                                    ? ((double)rowTotal / grandTotal * 100).ToString("0.00")
                                    : "0.00";
                                }
                                <td>@rowPct%</td>
                            </tr>
                        }

                        <!-- TOTAL ROW -->
                        <tr class="table-secondary fw-bold">
                            <td>Total for the Period</td>
                            <td></td>
                            @foreach (var cls in classifications)
                            {
                                <td>@totalsPerClass[cls]</td>
                            }
                            <td>@grandTotal</td>
                        </tr>

                        <!-- PERCENTAGE ROW -->
                        <tr class="table-secondary fw-bold">
                            <td>Percentage for the Period</td>
                            <td></td>
                            @foreach (var cls in classifications)
                            {
                                <td>@percentagesForPeriod[cls].ToString("0.00")%</td>
                            }
                            <td>@totalPercentForPeriod.ToString("0.00")%</td>
                        </tr>

                        <!-- AVERAGE -->
                        <tr class="table-secondary fw-bold">
                            <td>Average</td>
                            <td></td>
                            @foreach (var cls in classifications)
                            {
                                <td>@Math.Round(averages[cls], 0)</td>
                            }
                            <td>@Math.Round(averageTotal, 0)</td>
                        </tr>

                        <!-- MAXIMUM -->
                        <tr class="table-secondary fw-bold">
                            <td>Maximum</td>
                            <td></td>
                            @foreach (var cls in classifications)
                            {
                                <td>@maximums[cls]</td>
                            }
                            <td>@maximumTotal</td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(classifications.Count + 3)" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                No data available for the selected filters.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- HEADER BLOCK -->
        <div class="border-bottom pb-2 mb-3">
            <table class="table table-borderless mb-0 w-100">
                <tr class="align-top">
                    <td style="width: 35%;">
                        <strong>Daily Traffic Report</strong><br />
                    </td>

                    <td style="width: 30%;">
                        <strong>Date and Time:</strong>
                        <em>@reportGeneratedAt.ToString("dd/MM/yyyy HH:mm:ss")</em>
                    </td>

                    <td style="width: 25%;">
                        <strong>User ID:</strong>
                        <em>@currentUser</em>
                    </td>

                    <td style="width: 10%; white-space: nowrap;" class="text-end">
                        Page 1 of 1
                    </td>
                </tr>

                <tr>
                    <td colspan="4">
                        <strong>Reports Module Version Number:</strong>
                        <span>@reportVersion</span>
                    </td>
                </tr>
            </table>
        </div>

    </div>
</div>

<!-- Scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>

<script>
    const trafficData = @Html.Raw(JsonSerializer.Serialize(Model.Items ?? new List<MIS.Web.Models.Traffic.Daily.DailyTrafficModel>()));
    const classifications = @Html.Raw(JsonSerializer.Serialize(Model.Classifications ?? new List<string>()));
    const reportVersion = "@reportVersion";
    const currentUser = "@currentUser";
    const generatedAt = "@reportGeneratedAt.ToString("dd/MM/yyyy HH:mm:ss")";

    function formatDisplayDate(dateString) {
        if (!dateString) return "";
        const date = new Date(dateString);
        if (isNaN(date.getTime())) return dateString;

        const dd = String(date.getDate()).padStart(2, '0');
        const mm = String(date.getMonth() + 1).padStart(2, '0');
        const yyyy = date.getFullYear();

        return `${dd}/${mm}/${yyyy}`;
    }

    function groupTrafficData(data) {
        const grouped = {};

        data.forEach(item => {
            const rawDate = item.Date || item.date;
            const dateKey = rawDate ? rawDate.split("T")[0] : "";

            if (!grouped[dateKey]) {
                grouped[dateKey] = [];
            }

            grouped[dateKey].push({
                classification: item.Classification || item.classification,
                count: item.Count || item.count || 0
            });
        });

        return grouped;
    }

    function buildTrafficStats(grouped, classifications) {
        const dates = Object.keys(grouped).sort();
        const daysCount = dates.length;

        const totals = classifications.map(cls =>
            dates.reduce((sum, date) => {
                const classTotalForDay = grouped[date]
                    .filter(x => x.classification === cls)
                    .reduce((daySum, item) => daySum + (item.count || 0), 0);

                return sum + classTotalForDay;
            }, 0)
        );

        const grandTotal = totals.reduce((sum, value) => sum + value, 0);

        const avgPerClass = classifications.map((cls, index) =>
            daysCount > 0 ? Math.round(totals[index] / daysCount) : 0
        );

        const maxPerClass = classifications.map(cls =>
            daysCount > 0
                ? Math.max(...dates.map(date =>
                    grouped[date]
                        .filter(x => x.classification === cls)
                        .reduce((sum, item) => sum + (item.count || 0), 0)
                ))
                : 0
        );

        const avgTotal = daysCount > 0
            ? Math.round(
                dates.reduce((sum, date) =>
                    sum + grouped[date].reduce((daySum, item) => daySum + (item.count || 0), 0), 0
                ) / daysCount
            )
            : 0;

        const maxTotal = daysCount > 0
            ? Math.max(...dates.map(date =>
                grouped[date].reduce((sum, item) => sum + (item.count || 0), 0)
            ))
            : 0;

        return {
            dates,
            daysCount,
            totals,
            grandTotal,
            avgPerClass,
            maxPerClass,
            avgTotal,
            maxTotal
        };
    }

    function buildTrafficRows(grouped, classifications, stats) {
        const rows = [];

        stats.dates.forEach(date => {
            const list = grouped[date];
            const rowTotal = list.reduce((sum, item) => sum + (item.count || 0), 0);

            const trafficRow = [formatDisplayDate(date), "Traffic"];
            classifications.forEach(cls => {
                const value = list
                    .filter(x => x.classification === cls)
                    .reduce((sum, item) => sum + (item.count || 0), 0);

                trafficRow.push(value);
            });
            trafficRow.push(rowTotal);
            rows.push(trafficRow);

            const percentRow = ["", "Percentage"];
            classifications.forEach(cls => {
                const value = list
                    .filter(x => x.classification === cls)
                    .reduce((sum, item) => sum + (item.count || 0), 0);

                const pct = stats.grandTotal > 0 ? (value / stats.grandTotal * 100) : 0;
                percentRow.push(`${pct.toFixed(2)}%`);
            });

            const rowPct = stats.grandTotal > 0 ? (rowTotal / stats.grandTotal * 100) : 0;
            percentRow.push(`${rowPct.toFixed(2)}%`);
            rows.push(percentRow);
        });

        rows.push(["", "Total for the Period", ...stats.totals, stats.grandTotal]);

        const footerPct = ["", "Percentage for the Period"];
        stats.totals.forEach(total => {
            const pct = stats.grandTotal > 0 ? (total / stats.grandTotal * 100) : 0;
            footerPct.push(`${pct.toFixed(2)}%`);
        });
        footerPct.push(stats.grandTotal > 0 ? "100.00%" : "0.00%");
        rows.push(footerPct);

        rows.push(["", "Average", ...stats.avgPerClass, stats.avgTotal]);
        rows.push(["", "Maximum", ...stats.maxPerClass, stats.maxTotal]);

        return rows;
    }

    document.getElementById("btnDownloadPdf").addEventListener("click", async function () {
        if (!trafficData.length) {
            alert("No data available to export.");
            return;
        }

        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "a4" });

        const pageWidth = doc.internal.pageSize.getWidth();
        const pageHeight = doc.internal.pageSize.getHeight();
        const margin = 40;

        const logoWidth = 90;
        const logoHeight = 90;
        const logoY = 25;

        const leftLogoPath = '/images/lCC Logo.jpg';
        const rightLogoPath = '/images/ICT-Works Logo.jpg';

        const loadImage = src => new Promise(resolve => {
            const img = new Image();
            img.crossOrigin = 'Anonymous';
            img.onload = () => resolve(img);
            img.onerror = () => resolve(null);
            img.src = src;
        });

        const [leftLogo, rightLogo] = await Promise.all([
            loadImage(leftLogoPath),
            loadImage(rightLogoPath)
        ]);

        if (leftLogo) {
            doc.addImage(leftLogo, 'JPEG', margin, logoY, logoWidth, logoHeight);
        }

        if (rightLogo) {
            doc.addImage(rightLogo, 'JPEG', pageWidth - margin - logoWidth, logoY, logoWidth, logoHeight);
        }

        doc.setFont("helvetica", "bold");
        doc.setFontSize(18);
        doc.text("LEKKI CONCESSION COMPANY LIMITED", pageWidth / 2, logoY + 35, { align: "center" });

        doc.setFontSize(14);
        doc.text("LEKKI-IKOYI LINK BRIDGE", pageWidth / 2, logoY + 55, { align: "center" });

        doc.setFontSize(13);
        doc.text("DAILY TRAFFIC REPORT", pageWidth / 2, logoY + 75, { align: "center" });

        const startY = logoY + logoHeight + 50;
        doc.setFont("helvetica", "normal");
        doc.setFontSize(10);

        const filters = {
            "Start Date": '@Model.Filters.StartDate.ToString("dd/MM/yyyy")',
            "End Date": '@Model.Filters.EndDate.ToString("dd/MM/yyyy")',
            "Classification": '@(Model.Filters.ClassificationList != null && Model.Filters.ClassificationList.Any() ? string.Join(", ", Model.Filters.ClassificationList) : "All")',
            "Operational Day": '@(Model.Filters.OperationalDay ? "Yes" : "No")'
        };

        let y = startY;
        doc.text("Filters Used:", margin, y);
        y += 14;

        for (const [key, value] of Object.entries(filters)) {
            doc.text(`${key}: ${value}`, margin, y);
            y += 12;
        }

        const grouped = groupTrafficData(trafficData);
        const stats = buildTrafficStats(grouped, classifications);
        const headers = ["Date", "", ...classifications, "Total"];
        const rows = buildTrafficRows(grouped, classifications, stats);

        doc.autoTable({
            head: [headers],
            body: rows,
            startY: y + 10,
            theme: 'grid',
            headStyles: { fillColor: [41, 128, 185], textColor: 255 },
            styles: { fontSize: 9, cellPadding: 4, overflow: 'linebreak' },
            columnStyles: {
                0: { cellWidth: 70 },
                1: { cellWidth: 100 }
            },
            didDrawPage: function () {
                const pageCount = doc.internal.getNumberOfPages();
                const currentPage = doc.internal.getCurrentPageInfo().pageNumber;
                const footerY = pageHeight - 30;

                doc.setFont("helvetica", "normal");
                doc.setFontSize(9);

                doc.text("LEKKI CONCESSION COMPANY LIMITED", margin, footerY);
                doc.text(`Generated: ${new Date().toLocaleString()}`, pageWidth / 2.5, footerY);
                doc.text(`User ID: ${currentUser}`, pageWidth - margin - 120, footerY);
                doc.text(`Page ${currentPage} of ${pageCount}`, pageWidth - margin, footerY, { align: "right" });

                doc.text(`Reports Module Version: ${reportVersion}`, margin, footerY + 12);
            }
        });

        doc.save(`Daily_Traffic_Report_${new Date().toISOString().replace(/[:.]/g, '-')}.pdf`);
    });

    document.getElementById("btnDownloadExcel").addEventListener("click", function () {
        if (!trafficData.length) {
            alert("No data available to export.");
            return;
        }

        const grouped = groupTrafficData(trafficData);
        const stats = buildTrafficStats(grouped, classifications);

        const headers = ["Date", "", ...classifications, "Total"];
        const excelRows = buildTrafficRows(grouped, classifications, stats);

        const wb = XLSX.utils.book_new();
        const ws = XLSX.utils.aoa_to_sheet([headers, ...excelRows]);

        ws['!cols'] = headers.map((_, index) => ({
            wch: index === 0 ? 14 : index === 1 ? 24 : 15
        }));

        XLSX.utils.book_append_sheet(wb, ws, "Daily Traffic Report");

        const filename = `Daily_Traffic_Report_${new Date().toISOString().replace(/[:.]/g, '-')}.xlsx`;
        XLSX.writeFile(wb, filename);
    });
</script>