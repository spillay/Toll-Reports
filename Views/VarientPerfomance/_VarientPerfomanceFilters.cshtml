@using System.Linq

@{
    var allShifts = ViewBag.AllShifts as List<string> ?? new List<string>();
    var allOperators = ViewBag.AllOperators as List<string> ?? new List<string>();

    // If you followed my earlier model update:
    var selectedShifts = Model.OperationalShift ?? new List<string>();
    var selectedOperators = Model.TollOperators ?? new List<string>();
}

<!-- Operational Shift (Checklist) -->
<div class="col-md-3">
    <label class="form-label fw-semibold">Operational Shift</label>

    <div class="border rounded p-2" style="max-height:160px; overflow:auto;">
        @foreach (var s in allShifts)
        {
            var id = "shift_" + s.Replace(" ", "_");
            <div class="form-check">
                <input class="form-check-input" type="checkbox"
                       name="operationalShift" value="@s"
                       id="@id"
                       @(selectedShifts.Contains(s) ? "checked" : "") />
                <label class="form-check-label" for="@id">@s</label>
            </div>
        }
    </div>

    <div class="mt-1 d-flex gap-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleAll('operationalShift', true)">Select All</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleAll('operationalShift', false)">Clear</button>
    </div>
</div>

<!-- Toll Operator ID (Checklist) -->
<div class="col-md-3">
    <label class="form-label fw-semibold">Toll Operator ID</label>

    <div class="border rounded p-2" style="max-height:160px; overflow:auto;">
        @foreach (var op in allOperators)
        {
            var id = "op_" + op.Replace(" ", "_");
            <div class="form-check">
                <input class="form-check-input" type="checkbox"
                       name="tollOperators" value="@op"
                       id="@id"
                       @(selectedOperators.Contains(op) ? "checked" : "") />
                <label class="form-check-label" for="@id">@op</label>
            </div>
        }
    </div>

    <div class="mt-1 d-flex gap-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleAll('tollOperators', true)">Select All</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleAll('tollOperators', false)">Clear</button>
    </div>
</div>

<script>
    function toggleAll(name, checked) {
      document.querySelectorAll(`input[type="checkbox"][name="${name}"]`)
        .forEach(cb => cb.checked = checked);
    }
</script>