@model MIS.Web.Models.VarientPerfomanceInputModel

<form method="get" asp-action="VarientPerfomances" asp-controller="VarientPerfomance">
    <div class="row mb-3">

        <!-- Start Date & Time -->
        <div class="col-md-3">
            <label for="StartDate" class="form-label">Start Date & Time</label>
            <input type="datetime-local" id="StartDate" name="startDate" class="form-control"
                   value="@Model.StartDate.ToString("yyyy-MM-ddTHH:mm")" />
        </div>

        <!-- End Date & Time -->
        <div class="col-md-3">
            <label for="EndDate" class="form-label">End Date & Time</label>
            <input type="datetime-local" id="EndDate" name="endDate" class="form-control"
                   value="@Model.EndDate.ToString("yyyy-MM-ddTHH:mm")" />
        </div>

        <!-- Operational Shift -->
        <div class="col-md-3">
            <label for="Shift" class="form-label">Operational Shift</label>
            <select id="Shift" name="shift" class="form-select" asp-items="@(new SelectList(ViewBag.Shifts, Model.Shift))">
                <option value="">All</option>
            </select>
        </div>

        <!-- Toll Operator ID -->
        <div class="col-md-3">
            <label for="TollOperatorID" class="form-label">Toll Operator ID</label>
            <select id="TollOperatorID" name="tollOperatorID" class="form-select" asp-items="@(new SelectList(ViewBag.TollOperators, Model.TollOperatorID))">
                <option value="">All</option>
            </select>
        </div>

        <!-- Filter Button -->
        <div class="col-md-3 mt-3 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>

    </div>
</form>
